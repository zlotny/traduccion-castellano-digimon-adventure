{
  "file_id": "3537",
  "format": "etdf",
  "kind": "ETDF",
  "text_count": 43,
  "dialog": [
    {
      "index": 0,
      "english": "タケル！みんな！　一体どこに……？",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 4040,
      "_bytes": 46,
      "translation": ""
    },
    {
      "index": 1,
      "english": "……",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 4087,
      "_bytes": 4,
      "translation": ""
    },
    {
      "index": 2,
      "english": "太一！　さっきからボーっとして……みんなを探す気はあるのか？",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 4092,
      "_bytes": 86,
      "translation": ""
    },
    {
      "index": 3,
      "english": "ヤマト、それよりもこの島がどこに向かっているか、気にならないか？",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 4179,
      "_bytes": 86,
      "translation": ""
    },
    {
      "index": 4,
      "english": "それより？",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 4266,
      "_bytes": 10,
      "translation": ""
    },
    {
      "index": 5,
      "english": "デビモンが言っていた海のむこうの世界、そこに向かってるんじゃないかって……",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 4277,
      "_bytes": 106,
      "translation": ""
    },
    {
      "index": 6,
      "english": "みんなを探すことより大事なことなんてあるのかよ！　",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 4384,
      "_bytes": 70,
      "translation": ""
    },
    {
      "index": 7,
      "english": "海のむこうの世界に行けば、みんなと会える方法が見つかるかもしれないだろ",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 4455,
      "_bytes": 120,
      "translation": ""
    },
    {
      "index": 8,
      "english": "タケルがいない今のオレの気持ち、オマエにわかるはずが無いよな！",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 4576,
      "_bytes": 86,
      "translation": ""
    },
    {
      "index": 9,
      "english": "なんだと？！　この！",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 4663,
      "_bytes": 20,
      "translation": ""
    },
    {
      "index": 10,
      "english": "止めてよ！",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 4684,
      "_bytes": 16,
      "translation": ""
    },
    {
      "index": 11,
      "english": "ケンカしてる場合じゃないでしょ！",
      "speaker_id": 2221,
      "line_type": 2,
      "_offset": 4701,
      "_bytes": 42,
      "translation": ""
    },
    {
      "index": 12,
      "english": "この！　ヤマト……！！",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 4744,
      "_bytes": 22,
      "translation": ""
    },
    {
      "index": 13,
      "english": "タケルはひとりじゃ何も出来ないんだよ",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 4767,
      "_bytes": 52,
      "translation": ""
    },
    {
      "index": 14,
      "english": "……",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 4820,
      "_bytes": 4,
      "translation": ""
    },
    {
      "index": 15,
      "english": "ウラアアアアっ！",
      "speaker_id": 4091,
      "line_type": 2,
      "_offset": 4825,
      "_bytes": 16,
      "translation": ""
    },
    {
      "index": 16,
      "english": "モジャモンだ！",
      "speaker_id": 2221,
      "line_type": 2,
      "_offset": 4842,
      "_bytes": 14,
      "translation": ""
    },
    {
      "index": 17,
      "english": "うあっ！",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 4857,
      "_bytes": 8,
      "translation": ""
    },
    {
      "index": 18,
      "english": "ヤマト！　あぶないっ！",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 4866,
      "_bytes": 22,
      "translation": ""
    },
    {
      "index": 19,
      "english": "間一髪だった　怪我は無いか、ヤマト？",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 4889,
      "_bytes": 66,
      "translation": ""
    },
    {
      "index": 20,
      "english": "太一……　ああ、大丈夫だ……",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 4956,
      "_bytes": 54,
      "translation": ""
    },
    {
      "index": 21,
      "english": "黒い歯車！　デビモンに操られてるよ！",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 5011,
      "_bytes": 66,
      "translation": ""
    },
    {
      "index": 22,
      "english": "ウニャアアア！！",
      "speaker_id": 4091,
      "line_type": 2,
      "_offset": 5078,
      "_bytes": 16,
      "translation": ""
    },
    {
      "index": 23,
      "english": "お腹が空いてて力が入らない",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 5095,
      "_bytes": 58,
      "translation": ""
    },
    {
      "index": 24,
      "english": "進化出来れば……",
      "speaker_id": 2221,
      "line_type": 2,
      "_offset": 5154,
      "_bytes": 34,
      "translation": ""
    },
    {
      "index": 25,
      "english": "おーい！　食べ物を持って来たよ！風邪に効く薬草もね",
      "speaker_id": 4081,
      "line_type": 2,
      "_offset": 5189,
      "_bytes": 104,
      "translation": ""
    },
    {
      "index": 26,
      "english": "グッドタイミングだぜ、ユキダルモン！",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 5294,
      "_bytes": 36,
      "translation": ""
    },
    {
      "index": 27,
      "english": "アムアム……",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 5331,
      "_bytes": 12,
      "translation": ""
    },
    {
      "index": 28,
      "english": "お腹いっぱいだあ　これで戦えるぞ！",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 5344,
      "_bytes": 52,
      "translation": ""
    },
    {
      "index": 29,
      "english": "ニギャアアア！！",
      "speaker_id": 4091,
      "line_type": 2,
      "_offset": 5397,
      "_bytes": 16,
      "translation": ""
    },
    {
      "index": 30,
      "english": "ぐぎゃあああ！！",
      "speaker_id": 4091,
      "line_type": 2,
      "_offset": 5414,
      "_bytes": 16,
      "translation": ""
    },
    {
      "index": 31,
      "english": "やったあああ！！",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 5431,
      "_bytes": 16,
      "translation": ""
    },
    {
      "index": 32,
      "english": "太一、あれを見ろ！崩れたところから黒い歯車が！",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 5448,
      "_bytes": 92,
      "translation": ""
    },
    {
      "index": 33,
      "english": "この歯車がヤマトとタケルを離れ離れに！",
      "speaker_id": 2221,
      "line_type": 2,
      "_offset": 5541,
      "_bytes": 66,
      "translation": ""
    },
    {
      "index": 34,
      "english": "フォックスファイヤー！！",
      "speaker_id": 2221,
      "line_type": 2,
      "_offset": 5608,
      "_bytes": 24,
      "translation": ""
    },
    {
      "index": 35,
      "english": "！！　なんだ？！",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 5633,
      "_bytes": 16,
      "translation": ""
    },
    {
      "index": 36,
      "english": "歯車が逆回りしてる……！",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 5650,
      "_bytes": 54,
      "translation": ""
    },
    {
      "index": 37,
      "english": "もしかして、島が戻っているんじゃ……？",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 5705,
      "_bytes": 54,
      "translation": ""
    },
    {
      "index": 38,
      "english": "ムゲンマウンテンが近づいてる！！",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 5760,
      "_bytes": 40,
      "translation": ""
    },
    {
      "index": 39,
      "english": "あそこにはデビモンがいる！",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 5801,
      "_bytes": 26,
      "translation": ""
    },
    {
      "index": 40,
      "english": "ケンカしてる場合じゃなさそうだな！",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 5828,
      "_bytes": 44,
      "translation": ""
    },
    {
      "index": 41,
      "english": "タケルもきっと頑張ってるよ！",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 5873,
      "_bytes": 38,
      "translation": ""
    },
    {
      "index": 42,
      "english": "ああ！　あいつはオレの弟だもんな！",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 5912,
      "_bytes": 46,
      "translation": ""
    }
  ]
}