{
  "file_id": "3519",
  "format": "etdf",
  "kind": "ETDF",
  "text_count": 175,
  "dialog": [
    {
      "index": 0,
      "english": "その年の夏は地球全体がおかしかった",
      "speaker_id": 9003,
      "line_type": 1,
      "_offset": 14088,
      "_bytes": 74,
      "translation": ""
    },
    {
      "index": 1,
      "english": "東南アジアでは雨が降らず水田が枯れ、",
      "speaker_id": 9003,
      "line_type": 1,
      "_offset": 14163,
      "_bytes": 80,
      "translation": ""
    },
    {
      "index": 2,
      "english": "中東では大雨による洪水が発生……",
      "speaker_id": 9003,
      "line_type": 1,
      "_offset": 14244,
      "_bytes": 82,
      "translation": ""
    },
    {
      "index": 3,
      "english": "アメリカでは記録的な冷夏となった",
      "speaker_id": 9003,
      "line_type": 1,
      "_offset": 14327,
      "_bytes": 56,
      "translation": ""
    },
    {
      "index": 4,
      "english": "サマーキャンプにいた７人は",
      "speaker_id": 9003,
      "line_type": 1,
      "_offset": 14384,
      "_bytes": 34,
      "translation": ""
    },
    {
      "index": 5,
      "english": "何も知らずにいた……",
      "speaker_id": 9003,
      "line_type": 1,
      "_offset": 14419,
      "_bytes": 34,
      "translation": ""
    },
    {
      "index": 6,
      "english": "それは誰も知らない世界での",
      "speaker_id": 9003,
      "line_type": 1,
      "_offset": 14454,
      "_bytes": 50,
      "translation": ""
    },
    {
      "index": 7,
      "english": "冒険の始まりになることを……",
      "speaker_id": 9003,
      "line_type": 1,
      "_offset": 14505,
      "_bytes": 48,
      "translation": ""
    },
    {
      "index": 8,
      "english": "すごい雪だったけど……",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 14554,
      "_bytes": 30,
      "translation": ""
    },
    {
      "index": 9,
      "english": "やっと止んだみたいだな",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 14585,
      "_bytes": 28,
      "translation": ""
    },
    {
      "index": 10,
      "english": "この場所をあまり離れないように",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 14614,
      "_bytes": 48,
      "translation": ""
    },
    {
      "index": 11,
      "english": "みんなに声をかけた方がよさそうですね",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 14663,
      "_bytes": 52,
      "translation": ""
    },
    {
      "index": 12,
      "english": "ダメですね……　電波が届かない……",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 14716,
      "_bytes": 52,
      "translation": ""
    },
    {
      "index": 13,
      "english": "吹雪が止んだら繋がると思ったんですが",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 14769,
      "_bytes": 68,
      "translation": ""
    },
    {
      "index": 14,
      "english": "タケル！　雪で滑って転ばないように",
      "speaker_id": 1021,
      "line_type": 4,
      "_offset": 14838,
      "_bytes": 58,
      "translation": ""
    },
    {
      "index": 15,
      "english": "気を付けるんだぞ！",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 14897,
      "_bytes": 30,
      "translation": ""
    },
    {
      "index": 16,
      "english": "うう……　寒いわね……　雪だなんて",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 14928,
      "_bytes": 50,
      "translation": ""
    },
    {
      "index": 17,
      "english": "とても夏とは思えない……　",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 14979,
      "_bytes": 42,
      "translation": ""
    },
    {
      "index": 18,
      "english": "太一！　早く大人がいるところに戻ろう",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 15022,
      "_bytes": 72,
      "translation": ""
    },
    {
      "index": 19,
      "english": "ここにいるとみんな心配するから……",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 15095,
      "_bytes": 46,
      "translation": ""
    },
    {
      "index": 20,
      "english": "きゃ～！　きれい……！",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 15142,
      "_bytes": 22,
      "translation": ""
    },
    {
      "index": 21,
      "english": "積もったばかりの雪が光ってるみたい",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 15165,
      "_bytes": 56,
      "translation": ""
    },
    {
      "index": 22,
      "english": "わあ～！　ユキだ～！　スゴーーイ！！",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 15222,
      "_bytes": 36,
      "translation": ""
    },
    {
      "index": 23,
      "english": "わあ～！　ユキだ～！　スゴーーイ！！",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 15259,
      "_bytes": 36,
      "translation": ""
    },
    {
      "index": 24,
      "english": "あれは……！　わああ……！！",
      "speaker_id": 9001,
      "line_type": 2,
      "_offset": 15296,
      "_bytes": 28,
      "translation": ""
    },
    {
      "index": 25,
      "english": "キレイなオーロラ！　ロマンチック！！",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 15325,
      "_bytes": 36,
      "translation": ""
    },
    {
      "index": 26,
      "english": "初めて見たぜ！",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15362,
      "_bytes": 28,
      "translation": ""
    },
    {
      "index": 27,
      "english": "そんな……、変ですよ！",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 15391,
      "_bytes": 30,
      "translation": ""
    },
    {
      "index": 28,
      "english": "日本でオーロラなんてありえません！",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 15422,
      "_bytes": 44,
      "translation": ""
    },
    {
      "index": 29,
      "english": "おい！　……あれ！",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15467,
      "_bytes": 18,
      "translation": ""
    },
    {
      "index": 30,
      "english": "なにか光った！",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 15486,
      "_bytes": 22,
      "translation": ""
    },
    {
      "index": 31,
      "english": "こっちに近づいて来るぞ！",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15509,
      "_bytes": 38,
      "translation": ""
    },
    {
      "index": 32,
      "english": "あっ！！",
      "speaker_id": 9001,
      "line_type": 2,
      "_offset": 15548,
      "_bytes": 8,
      "translation": ""
    },
    {
      "index": 33,
      "english": "うわああっ！！",
      "speaker_id": 9001,
      "line_type": 2,
      "_offset": 15557,
      "_bytes": 14,
      "translation": ""
    },
    {
      "index": 34,
      "english": "みんな、伏せろっ！！",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 15572,
      "_bytes": 26,
      "translation": ""
    },
    {
      "index": 35,
      "english": "みんな、ケガはないか？",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15599,
      "_bytes": 22,
      "translation": ""
    },
    {
      "index": 36,
      "english": "なんとかな……　大丈夫か、タケル？",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 15622,
      "_bytes": 50,
      "translation": ""
    },
    {
      "index": 37,
      "english": "うん、大丈夫だよ！",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 15673,
      "_bytes": 34,
      "translation": ""
    },
    {
      "index": 38,
      "english": "い、一体……　なんなんだ……？",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 15708,
      "_bytes": 42,
      "translation": ""
    },
    {
      "index": 39,
      "english": "イン石ですか……？",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 15751,
      "_bytes": 26,
      "translation": ""
    },
    {
      "index": 40,
      "english": "なに……？　これ？",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 15778,
      "_bytes": 18,
      "translation": ""
    },
    {
      "index": 41,
      "english": "これが、空から降って来たのか……？",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15797,
      "_bytes": 54,
      "translation": ""
    },
    {
      "index": 42,
      "english": "携帯でもないし……",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 15852,
      "_bytes": 30,
      "translation": ""
    },
    {
      "index": 43,
      "english": "お、おい！　なんだよ、アレは！",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 15883,
      "_bytes": 30,
      "translation": ""
    },
    {
      "index": 44,
      "english": "吸い込まれる！！",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15914,
      "_bytes": 28,
      "translation": ""
    },
    {
      "index": 45,
      "english": "うわあああああああっ！！",
      "speaker_id": 9001,
      "line_type": 2,
      "_offset": 15943,
      "_bytes": 24,
      "translation": ""
    },
    {
      "index": 46,
      "english": "タイチ……　タイチ……",
      "speaker_id": 9002,
      "line_type": 2,
      "_offset": 15968,
      "_bytes": 22,
      "translation": ""
    },
    {
      "index": 47,
      "english": "ん、ん……　だ、大丈夫だ……",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15991,
      "_bytes": 44,
      "translation": ""
    },
    {
      "index": 48,
      "english": "ん……？！　う、うわあああああっ！！な、なんだ？！　こいつは？！",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16036,
      "_bytes": 66,
      "translation": ""
    },
    {
      "index": 49,
      "english": "太一、気がついた！　よかった！",
      "speaker_id": 2111,
      "line_type": 2,
      "_offset": 16103,
      "_bytes": 46,
      "translation": ""
    },
    {
      "index": 50,
      "english": "しゃべった！　オレの名前知ってる！！なんだ？！　おまえ？！",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16150,
      "_bytes": 76,
      "translation": ""
    },
    {
      "index": 51,
      "english": "ボク、コロモン！　太一、待ってた！",
      "speaker_id": 2111,
      "line_type": 2,
      "_offset": 16227,
      "_bytes": 50,
      "translation": ""
    },
    {
      "index": 52,
      "english": "コロモン？　オレを待ってた……？",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16278,
      "_bytes": 38,
      "translation": ""
    },
    {
      "index": 53,
      "english": "ウン！",
      "speaker_id": 2111,
      "line_type": 2,
      "_offset": 16317,
      "_bytes": 6,
      "translation": ""
    },
    {
      "index": 54,
      "english": "そりゃ、一体どういうことなんだ？第一オレの名前どうして知ってる？",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16324,
      "_bytes": 100,
      "translation": ""
    },
    {
      "index": 55,
      "english": "太一さん！",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 16425,
      "_bytes": 20,
      "translation": ""
    },
    {
      "index": 56,
      "english": "おお！　光子郎！",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16446,
      "_bytes": 30,
      "translation": ""
    },
    {
      "index": 57,
      "english": "よかった……　ボク一人ぼっちになったかと思って……",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 16477,
      "_bytes": 62,
      "translation": ""
    },
    {
      "index": 58,
      "english": "ウチがついてるやないですか",
      "speaker_id": 2411,
      "line_type": 2,
      "_offset": 16540,
      "_bytes": 26,
      "translation": ""
    },
    {
      "index": 59,
      "english": "うわ！　光子郎、そいつは……？",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16567,
      "_bytes": 44,
      "translation": ""
    },
    {
      "index": 60,
      "english": "ウチ、モチモンいいます　よろしゅう！",
      "speaker_id": 2411,
      "line_type": 2,
      "_offset": 16612,
      "_bytes": 36,
      "translation": ""
    },
    {
      "index": 61,
      "english": "ここで気が付いてからずっとついて来るんですよ　何がなんだか……",
      "speaker_id": 2411,
      "line_type": 2,
      "_offset": 16649,
      "_bytes": 90,
      "translation": ""
    },
    {
      "index": 62,
      "english": "ここ？　……ここって？",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16740,
      "_bytes": 22,
      "translation": ""
    },
    {
      "index": 63,
      "english": "ここはファイル島ですわ！",
      "speaker_id": 2411,
      "line_type": 2,
      "_offset": 16763,
      "_bytes": 32,
      "translation": ""
    },
    {
      "index": 64,
      "english": "彼らはそう言ってますけど……",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 16796,
      "_bytes": 42,
      "translation": ""
    },
    {
      "index": 65,
      "english": "うーん……　確かめてみなきゃな……",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16839,
      "_bytes": 42,
      "translation": ""
    },
    {
      "index": 66,
      "english": "よし、あの木に登れば何か見えるかもな",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16882,
      "_bytes": 64,
      "translation": ""
    },
    {
      "index": 67,
      "english": "いよっ！　……っと！",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16947,
      "_bytes": 20,
      "translation": ""
    },
    {
      "index": 68,
      "english": "太一さん、なにか見えますか？",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 16968,
      "_bytes": 44,
      "translation": ""
    },
    {
      "index": 69,
      "english": "ふーむ……　あ、あっちに海だぞ！こんな山見覚えない……　ここどこだ？",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17013,
      "_bytes": 96,
      "translation": ""
    },
    {
      "index": 70,
      "english": "ねえ！　太一、なにしてる？",
      "speaker_id": 2111,
      "line_type": 2,
      "_offset": 17110,
      "_bytes": 36,
      "translation": ""
    },
    {
      "index": 71,
      "english": "え？　ああ……　あ、あれはっ！！",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17147,
      "_bytes": 32,
      "translation": ""
    },
    {
      "index": 72,
      "english": "キシャアアアーーーー！！",
      "speaker_id": 9003,
      "line_type": 2,
      "_offset": 17180,
      "_bytes": 24,
      "translation": ""
    },
    {
      "index": 73,
      "english": "ふえええええっ！！",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17205,
      "_bytes": 18,
      "translation": ""
    },
    {
      "index": 74,
      "english": "いてて……　なんなんだ、アイツは？",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17224,
      "_bytes": 34,
      "translation": ""
    },
    {
      "index": 75,
      "english": "あ、アカン……！　あれはクワガーモン！えらい凶悪なデジモンや！！",
      "speaker_id": 2411,
      "line_type": 2,
      "_offset": 17259,
      "_bytes": 80,
      "translation": ""
    },
    {
      "index": 76,
      "english": "太一さん、こっちに来ます！",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 17340,
      "_bytes": 42,
      "translation": ""
    },
    {
      "index": 77,
      "english": "フシャアアー！",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17383,
      "_bytes": 14,
      "translation": ""
    },
    {
      "index": 78,
      "english": "太一さん！　大丈夫ですか？",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 17398,
      "_bytes": 52,
      "translation": ""
    },
    {
      "index": 79,
      "english": "ああ、オレは大丈夫だ……ここを離れよう！　みんなを探すんだ！",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17451,
      "_bytes": 94,
      "translation": ""
    },
    {
      "index": 80,
      "english": "はいっ！",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 17546,
      "_bytes": 8,
      "translation": ""
    },
    {
      "index": 81,
      "english": "くそ～っ！　まだ追ってくるぞ！",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17555,
      "_bytes": 36,
      "translation": ""
    },
    {
      "index": 82,
      "english": "こっち！　こっちや！　",
      "speaker_id": 2411,
      "line_type": 2,
      "_offset": 17592,
      "_bytes": 22,
      "translation": ""
    },
    {
      "index": 83,
      "english": "ここは……",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 17615,
      "_bytes": 10,
      "translation": ""
    },
    {
      "index": 84,
      "english": "しっ！　クワガーモンをやり過ごそう",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17626,
      "_bytes": 40,
      "translation": ""
    },
    {
      "index": 85,
      "english": "……",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 17667,
      "_bytes": 4,
      "translation": ""
    },
    {
      "index": 86,
      "english": "……",
      "speaker_id": 2111,
      "line_type": 2,
      "_offset": 17672,
      "_bytes": 4,
      "translation": ""
    },
    {
      "index": 87,
      "english": "……",
      "speaker_id": 2411,
      "line_type": 2,
      "_offset": 17677,
      "_bytes": 4,
      "translation": ""
    },
    {
      "index": 88,
      "english": "もう、大丈夫みたいよ！",
      "speaker_id": 9002,
      "line_type": 2,
      "_offset": 17682,
      "_bytes": 38,
      "translation": ""
    },
    {
      "index": 89,
      "english": "はっ！",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17721,
      "_bytes": 6,
      "translation": ""
    },
    {
      "index": 90,
      "english": "はっ！",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 17728,
      "_bytes": 6,
      "translation": ""
    },
    {
      "index": 91,
      "english": "誰か、そこにいるのか？",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17735,
      "_bytes": 30,
      "translation": ""
    },
    {
      "index": 92,
      "english": "空！　無事だったのか！",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17766,
      "_bytes": 38,
      "translation": ""
    },
    {
      "index": 93,
      "english": "そっちこそ危なかったね……",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 17805,
      "_bytes": 34,
      "translation": ""
    },
    {
      "index": 94,
      "english": "ヤマト！　おまえも……",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17840,
      "_bytes": 22,
      "translation": ""
    },
    {
      "index": 95,
      "english": "太一……　みんなもいたのか",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 17863,
      "_bytes": 36,
      "translation": ""
    },
    {
      "index": 96,
      "english": "うわああああっ！　みんなっ～～～！",
      "speaker_id": 9002,
      "line_type": 2,
      "_offset": 17900,
      "_bytes": 34,
      "translation": ""
    },
    {
      "index": 97,
      "english": "丈！　……よくわからないけどみんな、どうやら無事みたいだな！",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17935,
      "_bytes": 80,
      "translation": ""
    },
    {
      "index": 98,
      "english": "ヤマト！　オマエの持ってるそれ……",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 18016,
      "_bytes": 40,
      "translation": ""
    },
    {
      "index": 99,
      "english": "ああ……　こいつか……",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 18057,
      "_bytes": 22,
      "translation": ""
    },
    {
      "index": 100,
      "english": "ボク、ツノモンです……",
      "speaker_id": 2211,
      "line_type": 2,
      "_offset": 18080,
      "_bytes": 22,
      "translation": ""
    },
    {
      "index": 101,
      "english": "なんで顔が赤くなってるんだ？",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 18103,
      "_bytes": 44,
      "translation": ""
    },
    {
      "index": 102,
      "english": "どうやら恥ずかしがり屋らしい",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 18148,
      "_bytes": 40,
      "translation": ""
    },
    {
      "index": 103,
      "english": "……",
      "speaker_id": 2211,
      "line_type": 2,
      "_offset": 18189,
      "_bytes": 4,
      "translation": ""
    },
    {
      "index": 104,
      "english": "みんな性格はバラバラってことか",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 18194,
      "_bytes": 42,
      "translation": ""
    },
    {
      "index": 105,
      "english": "太一、ヘンなヤツが追いかけて来る……",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 18237,
      "_bytes": 58,
      "translation": ""
    },
    {
      "index": 106,
      "english": "ヘンなヤツじゃないよっ！プカモンだよ！",
      "speaker_id": 2611,
      "line_type": 2,
      "_offset": 18296,
      "_bytes": 40,
      "translation": ""
    },
    {
      "index": 107,
      "english": "ぬわあああっ！　なんだこいつ……",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 18337,
      "_bytes": 32,
      "translation": ""
    },
    {
      "index": 108,
      "english": "こいつじゃなくて、プカモンだっての！",
      "speaker_id": 2611,
      "line_type": 2,
      "_offset": 18370,
      "_bytes": 36,
      "translation": ""
    },
    {
      "index": 109,
      "english": "丈、随分仲良くなったじゃないか！",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 18407,
      "_bytes": 64,
      "translation": ""
    },
    {
      "index": 110,
      "english": "ずっと追い回されて、もうヘトヘトだよ",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 18472,
      "_bytes": 50,
      "translation": ""
    },
    {
      "index": 111,
      "english": "なあ、空！　こいつ植物みたいだな",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 18523,
      "_bytes": 54,
      "translation": ""
    },
    {
      "index": 112,
      "english": "うふふ！　ピョコモンって言うのよ",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 18578,
      "_bytes": 38,
      "translation": ""
    },
    {
      "index": 113,
      "english": "アタシ、ピョコモン！　",
      "speaker_id": 2311,
      "line_type": 2,
      "_offset": 18617,
      "_bytes": 22,
      "translation": ""
    },
    {
      "index": 114,
      "english": "空、ピョコモンって女の子なのか？",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 18640,
      "_bytes": 56,
      "translation": ""
    },
    {
      "index": 115,
      "english": "そもそも性別ってあるのかしら……？",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 18697,
      "_bytes": 46,
      "translation": ""
    },
    {
      "index": 116,
      "english": "そのうちわかってくるのかな……",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 18744,
      "_bytes": 30,
      "translation": ""
    },
    {
      "index": 117,
      "english": "見たことがない多様な生物がこんなにいるなんて……　ここは一体……？",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 18775,
      "_bytes": 108,
      "translation": ""
    },
    {
      "index": 118,
      "english": "さっきからずっと考え込んでるんや話したいこといっぱいやのに",
      "speaker_id": 2411,
      "line_type": 2,
      "_offset": 18884,
      "_bytes": 84,
      "translation": ""
    },
    {
      "index": 119,
      "english": "夢中になり始めたら止まらないからな",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 18969,
      "_bytes": 60,
      "translation": ""
    },
    {
      "index": 120,
      "english": "（んっ？　見たことがない子だ……誰かの知り合いかな……？）",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 19030,
      "_bytes": 92,
      "translation": ""
    },
    {
      "index": 121,
      "english": "ええっと、オレたちも自己紹介するかオレ八神太一、御台場小学校の５年生だ",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 19123,
      "_bytes": 156,
      "translation": ""
    },
    {
      "index": 122,
      "english": "おんなじ５年生の武之内空よ！",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 19280,
      "_bytes": 70,
      "translation": ""
    },
    {
      "index": 123,
      "english": "同じく５年の石田ヤマトだ",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 19351,
      "_bytes": 50,
      "translation": ""
    },
    {
      "index": 124,
      "english": "城戸丈、６年だ！",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 19402,
      "_bytes": 42,
      "translation": ""
    },
    {
      "index": 125,
      "english": "４年の泉光子郎です",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 19445,
      "_bytes": 50,
      "translation": ""
    },
    {
      "index": 126,
      "english": "ええっと……　それから……",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 19496,
      "_bytes": 26,
      "translation": ""
    },
    {
      "index": 127,
      "english": "ボク、高石タケル！　小学校２年生だよ",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 19523,
      "_bytes": 78,
      "translation": ""
    },
    {
      "index": 128,
      "english": "ふ～ん、タケルって名前なのか……じゃあ、オレたちともヨロシクな！",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 19602,
      "_bytes": 76,
      "translation": ""
    },
    {
      "index": 129,
      "english": "うん！　ヨロシクね！",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 19679,
      "_bytes": 20,
      "translation": ""
    },
    {
      "index": 130,
      "english": "これで全員だっけ？",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 19700,
      "_bytes": 30,
      "translation": ""
    },
    {
      "index": 131,
      "english": "ちょっと待って……",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 19731,
      "_bytes": 24,
      "translation": ""
    },
    {
      "index": 132,
      "english": "４年生のミミさんがいません！",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 19756,
      "_bytes": 40,
      "translation": ""
    },
    {
      "index": 133,
      "english": "きゃあああーーーっ！",
      "speaker_id": 9002,
      "line_type": 2,
      "_offset": 19797,
      "_bytes": 20,
      "translation": ""
    },
    {
      "index": 134,
      "english": "これは、ミミさんの声じゃ……？",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 19818,
      "_bytes": 38,
      "translation": ""
    },
    {
      "index": 135,
      "english": "あっちだ！",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 19857,
      "_bytes": 10,
      "translation": ""
    },
    {
      "index": 136,
      "english": "うぇ～～ん、みんな……！",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 19868,
      "_bytes": 24,
      "translation": ""
    },
    {
      "index": 137,
      "english": "ミミ、大丈夫？",
      "speaker_id": 2511,
      "line_type": 2,
      "_offset": 19893,
      "_bytes": 30,
      "translation": ""
    },
    {
      "index": 138,
      "english": "キシャアアッーーー！！",
      "speaker_id": 9003,
      "line_type": 2,
      "_offset": 19924,
      "_bytes": 22,
      "translation": ""
    },
    {
      "index": 139,
      "english": "よしっ！　こんどはみんなで戦うんだ！",
      "speaker_id": 2111,
      "line_type": 2,
      "_offset": 19947,
      "_bytes": 46,
      "translation": ""
    },
    {
      "index": 140,
      "english": "おおっーー！！",
      "speaker_id": 9001,
      "line_type": 2,
      "_offset": 19994,
      "_bytes": 14,
      "translation": ""
    },
    {
      "index": 141,
      "english": "コロモンっ！！",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 20009,
      "_bytes": 14,
      "translation": ""
    },
    {
      "index": 142,
      "english": "ギシャ！　ギシャアアッ！",
      "speaker_id": 9002,
      "line_type": 2,
      "_offset": 20024,
      "_bytes": 24,
      "translation": ""
    },
    {
      "index": 143,
      "english": "アイツ……まだやるって言うのか？！",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 20049,
      "_bytes": 40,
      "translation": ""
    },
    {
      "index": 144,
      "english": "くそっ……　このままじゃ……",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 20090,
      "_bytes": 28,
      "translation": ""
    },
    {
      "index": 145,
      "english": "……行かなきゃ　……ボクたちが戦わなきゃいけないんだっ！！",
      "speaker_id": 2111,
      "line_type": 2,
      "_offset": 20119,
      "_bytes": 76,
      "translation": ""
    },
    {
      "index": 146,
      "english": "そうや！　ウチらはそのために待っとったんや！！",
      "speaker_id": 2411,
      "line_type": 2,
      "_offset": 20196,
      "_bytes": 54,
      "translation": ""
    },
    {
      "index": 147,
      "english": "みんなの力を合わせれば！",
      "speaker_id": 2311,
      "line_type": 2,
      "_offset": 20251,
      "_bytes": 40,
      "translation": ""
    },
    {
      "index": 148,
      "english": "行くぞ～～～っ！",
      "speaker_id": 2111,
      "line_type": 2,
      "_offset": 20292,
      "_bytes": 22,
      "translation": ""
    },
    {
      "index": 149,
      "english": "コロモーーーーーンッ！！",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 20315,
      "_bytes": 24,
      "translation": ""
    },
    {
      "index": 150,
      "english": "な、なんだ？！",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 20340,
      "_bytes": 14,
      "translation": ""
    },
    {
      "index": 151,
      "english": "みんなの姿が変わっちゃった……！",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 20355,
      "_bytes": 48,
      "translation": ""
    },
    {
      "index": 152,
      "english": "こんな、急成長……　ありえません！　",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 20404,
      "_bytes": 60,
      "translation": ""
    },
    {
      "index": 153,
      "english": "トコモン！　大丈夫？！",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 20465,
      "_bytes": 38,
      "translation": ""
    },
    {
      "index": 154,
      "english": "タケル、見ててよ！",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 20504,
      "_bytes": 24,
      "translation": ""
    },
    {
      "index": 155,
      "english": "許さないんだから！",
      "speaker_id": 2521,
      "line_type": 2,
      "_offset": 20529,
      "_bytes": 26,
      "translation": ""
    },
    {
      "index": 156,
      "english": "覚悟しなはれや！",
      "speaker_id": 2421,
      "line_type": 2,
      "_offset": 20556,
      "_bytes": 26,
      "translation": ""
    },
    {
      "index": 157,
      "english": "今度はこっちの番だ！",
      "speaker_id": 2221,
      "line_type": 2,
      "_offset": 20583,
      "_bytes": 38,
      "translation": ""
    },
    {
      "index": 158,
      "english": "オイラだって！",
      "speaker_id": 2621,
      "line_type": 2,
      "_offset": 20622,
      "_bytes": 14,
      "translation": ""
    },
    {
      "index": 159,
      "english": "アタシたちの力見なさい！",
      "speaker_id": 2321,
      "line_type": 2,
      "_offset": 20637,
      "_bytes": 40,
      "translation": ""
    },
    {
      "index": 160,
      "english": "みんな、行くぞっ！　",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 20678,
      "_bytes": 26,
      "translation": ""
    },
    {
      "index": 161,
      "english": "や、やった……！！",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 20705,
      "_bytes": 18,
      "translation": ""
    },
    {
      "index": 162,
      "english": "太一～！！",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 20724,
      "_bytes": 20,
      "translation": ""
    },
    {
      "index": 163,
      "english": "オマエ、すごいぞっ！　よくやった！！",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 20745,
      "_bytes": 36,
      "translation": ""
    },
    {
      "index": 164,
      "english": "見てくれた？　空、やったぁ！！",
      "speaker_id": 2321,
      "line_type": 2,
      "_offset": 20782,
      "_bytes": 44,
      "translation": ""
    },
    {
      "index": 165,
      "english": "あなたも、みんなもよく頑張ったわ！",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 20827,
      "_bytes": 44,
      "translation": ""
    },
    {
      "index": 166,
      "english": "トコモン、すごく強かったよ！",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 20872,
      "_bytes": 36,
      "translation": ""
    },
    {
      "index": 167,
      "english": "ボクも思わず手に汗握っちゃったね！",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 20909,
      "_bytes": 64,
      "translation": ""
    },
    {
      "index": 168,
      "english": "だけど、一瞬で大きくなれなるならなんで最初っから使わなかったんだよ",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 20974,
      "_bytes": 110,
      "translation": ""
    },
    {
      "index": 169,
      "english": "違うよ！　「あれ」はボクたちだけじゃムリなんだ……！",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 21085,
      "_bytes": 62,
      "translation": ""
    },
    {
      "index": 170,
      "english": "？？　お前たちの力じゃない……？",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 21148,
      "_bytes": 50,
      "translation": ""
    },
    {
      "index": 171,
      "english": "クワガーモンっ！　まだ生きてるぞ！！",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 21199,
      "_bytes": 42,
      "translation": ""
    },
    {
      "index": 172,
      "english": "危ないっ！",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 21242,
      "_bytes": 18,
      "translation": ""
    },
    {
      "index": 173,
      "english": "キシャアアーーーッ！",
      "speaker_id": 9003,
      "line_type": 2,
      "_offset": 21261,
      "_bytes": 20,
      "translation": ""
    },
    {
      "index": 174,
      "english": "うわああああっ！！",
      "speaker_id": 9001,
      "line_type": 2,
      "_offset": 21282,
      "_bytes": 18,
      "translation": ""
    }
  ]
}