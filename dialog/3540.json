{
  "file_id": "3540",
  "format": "etdf",
  "kind": "ETDF",
  "text_count": 169,
  "dialog": [
    {
      "index": 0,
      "english": "Waaaaaaaaaaaaah!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 14344,
      "_bytes": 16,
      "translation": "¡Uuuuuuuuuaaaaaaaaaah!"
    },
    {
      "index": 1,
      "english": "T.K...",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 14361,
      "_bytes": 9,
      "translation": "T.K..."
    },
    {
      "index": 2,
      "english": "We got separated from Matt and\nthe others...waaaaaah!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 14371,
      "_bytes": 55,
      "translation": "¡Nos separamos de Matt y de los\ndemás...uaaaaaah!"
    },
    {
      "index": 3,
      "english": "At a time like this...if I were\nPiyomon... I could evolve and\nfly and get us back...",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 14427,
      "_bytes": 84,
      "translation": "En momentos así...si fuese\nPiyomon...Digievolucionaría\npara volar hacia ellos..."
    },
    {
      "index": 4,
      "english": "Mattoooooo!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 14512,
      "_bytes": 13,
      "translation": "¡Maaaaattt!"
    },
    {
      "index": 5,
      "english": "But...why...why can't I evolve?\nWaaaaaaaah!",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 14526,
      "_bytes": 43,
      "translation": "Pero...¡no puedo digievolucionar!\n¡¡Buaaaahh!!"
    },
    {
      "index": 6,
      "english": "W-what's wrong? Patamon...",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 14570,
      "_bytes": 26,
      "translation": "¿Q-Qué ocurre? Patamon..."
    },
    {
      "index": 7,
      "english": "Because, because...if I could\nevolve, I could fly in the sky...!",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 14597,
      "_bytes": 64,
      "translation": "Porque, porque... ¡Si pudiera\ndigievolucionar, podría...!"
    },
    {
      "index": 8,
      "english": "Huh...I wonder where Matt is...",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 14662,
      "_bytes": 33,
      "translation": "Uh...Me pregunto dónde está Matt."
    },
    {
      "index": 9,
      "english": "I don't even know where we are\nnow...",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 14696,
      "_bytes": 37,
      "translation": "No sé ni dónde estamos ahora..."
    },
    {
      "index": 10,
      "english": "Where should we go?",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 14734,
      "_bytes": 19,
      "translation": "¿A dónde vamos?"
    },
    {
      "index": 11,
      "english": "Doesn't matter... I'll go wherever\nyou go, T.K.",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 14754,
      "_bytes": 50,
      "translation": "No importa...Iré a donde sea\ncontigo, T.K."
    },
    {
      "index": 12,
      "english": "Okay, this way.",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 14805,
      "_bytes": 15,
      "translation": "Vale, por aquí."
    },
    {
      "index": 13,
      "english": "Okay...",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 14821,
      "_bytes": 7,
      "translation": "Vale..."
    },
    {
      "index": 14,
      "english": "...Wah! So pretty...!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 14829,
      "_bytes": 21,
      "translation": "...¡Oh! ¡Qué bonito...!"
    },
    {
      "index": 15,
      "english": "Yeah...",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 14851,
      "_bytes": 7,
      "translation": "Sí..."
    },
    {
      "index": 16,
      "english": "Let's go in!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 14859,
      "_bytes": 12,
      "translation": "¡Vayamos!"
    },
    {
      "index": 17,
      "english": "Yeah!",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 14872,
      "_bytes": 5,
      "translation": "¡Sí!"
    },
    {
      "index": 18,
      "english": "T.K...! What's over there?",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 14878,
      "_bytes": 29,
      "translation": "¡T.K.! ¿Qué hay ahí?"
    },
    {
      "index": 19,
      "english": "It's a cradle...",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 14908,
      "_bytes": 16,
      "translation": "Una cuna..."
    },
    {
      "index": 20,
      "english": "It's a village of newborn Digimon!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 14925,
      "_bytes": 34,
      "translation": "¡Es un pueblo de Digimon bebé!"
    },
    {
      "index": 21,
      "english": "Why don't we try taking care of\nthem, T.K?",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 14960,
      "_bytes": 45,
      "translation": "¿Por qué no los cuidamos, T.K.?"
    },
    {
      "index": 22,
      "english": "Should we? Help me out, Patamon!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 15006,
      "_bytes": 32,
      "translation": "¿Deberíamos? ¡Ayúdame, Patamon!"
    },
    {
      "index": 23,
      "english": "Okay!",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 15039,
      "_bytes": 5,
      "translation": "¡Vale!"
    },
    {
      "index": 24,
      "english": "*Bo, bo!*",
      "speaker_id": 9003,
      "line_type": 2,
      "_offset": 15045,
      "_bytes": 9,
      "translation": "¡Bo, bo!"
    },
    {
      "index": 25,
      "english": "It's a Botamon! It's a Digimon\nbaby!",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 15055,
      "_bytes": 36,
      "translation": "¡Es un Botamon! ¡Un bebé Digimon!"
    },
    {
      "index": 26,
      "english": "How cuuuuuute! It's so fuzzy.",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 15092,
      "_bytes": 29,
      "translation": "¡Qué bonitooo! Es peludito."
    },
    {
      "index": 27,
      "english": "That's because it's a newborn!",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 15122,
      "_bytes": 30,
      "translation": "¡Eso es por ser recién nacido!"
    },
    {
      "index": 28,
      "english": "*Pu, pu!*",
      "speaker_id": 9003,
      "line_type": 2,
      "_offset": 15153,
      "_bytes": 9,
      "translation": "¡Pu, pu!"
    },
    {
      "index": 29,
      "english": "This one's a Punimon!",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 15163,
      "_bytes": 21,
      "translation": "¡Y este es Punimon!"
    },
    {
      "index": 30,
      "english": "Wow! It's going \"puni, puni\"!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 15185,
      "_bytes": 29,
      "translation": "¡Guau! ¡Y dice \"puni puni\"!"
    },
    {
      "index": 31,
      "english": "*Achoo! Achoo!*",
      "speaker_id": 9003,
      "line_type": 2,
      "_offset": 15215,
      "_bytes": 15,
      "translation": "¡Achú! ¡Achú!"
    },
    {
      "index": 32,
      "english": "Haha! Is this a baby, too?\nIt looks like an old man with a\nbeard.",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 15231,
      "_bytes": 65,
      "translation": "¡Jaja! ¿Es un bebé, también?\nParece un señor mayor con barba."
    },
    {
      "index": 33,
      "english": "Don't say things like that! It's a\nrespectable baby.",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 15297,
      "_bytes": 52,
      "translation": "¡No digas esas cosas! ¡Es un bebé\nrespetable!"
    },
    {
      "index": 34,
      "english": "What's this?... There's a card\ninserted here.\n\"Rub me\", it says.",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 15350,
      "_bytes": 64,
      "translation": "¿Qué es esto?... Hay una tarjeta.\nDice: \"Acaríciame\"."
    },
    {
      "index": 35,
      "english": "Rub what?",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 15415,
      "_bytes": 9,
      "translation": "¿El qué?"
    },
    {
      "index": 36,
      "english": "The DigiEgg, right?",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 15425,
      "_bytes": 19,
      "translation": "El DigiHuevo, ¿no?"
    },
    {
      "index": 37,
      "english": "All right, wanna try it?",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 15445,
      "_bytes": 24,
      "translation": "Vale, ¿probamos?"
    },
    {
      "index": 38,
      "english": "Okay...rub, rub...one more time,\nrub, rub...",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 15470,
      "_bytes": 44,
      "translation": "Vale...así, así... un poco más,\nasí..."
    },
    {
      "index": 39,
      "english": "*Po, po!*",
      "speaker_id": 9003,
      "line_type": 2,
      "_offset": 15515,
      "_bytes": 9,
      "translation": "¡Po, po!"
    },
    {
      "index": 40,
      "english": "It's hatched!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 15525,
      "_bytes": 13,
      "translation": "¡Se abrió!"
    },
    {
      "index": 41,
      "english": "Yay!",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 15539,
      "_bytes": 4,
      "translation": "¡Sí!"
    },
    {
      "index": 42,
      "english": "Ah, but there's no cradle for this\none...",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 15544,
      "_bytes": 41,
      "translation": "Ah, pero este no tiene una\ncuna..."
    },
    {
      "index": 43,
      "english": "Hm...is there an extra one\nanywhere...?",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 15586,
      "_bytes": 39,
      "translation": "Hm...¿habrá alguna de sobra?"
    },
    {
      "index": 44,
      "english": "Hey, you!",
      "speaker_id": 9002,
      "line_type": 2,
      "_offset": 15626,
      "_bytes": 9,
      "translation": "¡Eh, tú!"
    },
    {
      "index": 45,
      "english": "H-huh?",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 15636,
      "_bytes": 6,
      "translation": "¿Ehh?"
    },
    {
      "index": 46,
      "english": "Who's there?",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 15643,
      "_bytes": 12,
      "translation": "¿Quién va?"
    },
    {
      "index": 47,
      "english": "How dare you coddle my beloved\nbabies!",
      "speaker_id": 4141,
      "line_type": 2,
      "_offset": 15656,
      "_bytes": 38,
      "translation": "¡Cómo te atreves a mimar a mis\nbebés!"
    },
    {
      "index": 48,
      "english": "What's wrong with coddling them?",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 15695,
      "_bytes": 32,
      "translation": "¿Qué tiene de malo mimarlos?"
    },
    {
      "index": 49,
      "english": "That's because... \"coddling\" can\nalso mean something like\n\"bullying\"!",
      "speaker_id": 4141,
      "line_type": 2,
      "_offset": 15728,
      "_bytes": 69,
      "translation": "¡Porque... \"mimar\" puede ser...\n\"maltratar\"!"
    },
    {
      "index": 50,
      "english": "That's weird!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 15798,
      "_bytes": 13,
      "translation": "¡Qué raro!"
    },
    {
      "index": 51,
      "english": "...Whatever. Get ready!",
      "speaker_id": 4141,
      "line_type": 2,
      "_offset": 15812,
      "_bytes": 23,
      "translation": "...Da igual. ¡Prepárate!"
    },
    {
      "index": 52,
      "english": "!!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 15836,
      "_bytes": 2,
      "translation": "!!"
    },
    {
      "index": 53,
      "english": "We won! Wanna go at it again?\nWe'll do it as much as you want.",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 15839,
      "_bytes": 62,
      "translation": "¡Ganamos! ¿Quieres otra?\n¡Podemos estar así cuanto tiempo\nquieras!"
    },
    {
      "index": 54,
      "english": "Gh, looks like I misjudged you. A\ndefeat's a defeat. Welcome to the\nVillage of Beginnings.",
      "speaker_id": 4141,
      "line_type": 2,
      "_offset": 15902,
      "_bytes": 90,
      "translation": "Te he subestimado. Una derrota es\nuna derrota. Bienvenidos a la\nCiudad de los Bebés."
    },
    {
      "index": 55,
      "english": "Good, good! I really don't like\nfighting.",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 15993,
      "_bytes": 41,
      "translation": "¡Bien, bien! No me gusta nada\nluchar."
    },
    {
      "index": 56,
      "english": "If kids fight, they make up pretty\nquickly, but adults...",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 16035,
      "_bytes": 57,
      "translation": "Si los niños se pelean, hacen\nlas paces. Los mayores..."
    },
    {
      "index": 57,
      "english": "T.K...?",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 16093,
      "_bytes": 10,
      "translation": "¿T.K...?"
    },
    {
      "index": 58,
      "english": "You're stronger than you look.\nEven the smallest grain of pepper\ncan still prick the tongue, eh?",
      "speaker_id": 4141,
      "line_type": 2,
      "_offset": 16104,
      "_bytes": 96,
      "translation": "Eres más fuerte de lo que\npareces. Hasta un grano de\npimienta puede picar, ¿verdad?"
    },
    {
      "index": 59,
      "english": "By the way, do you know how we can\nget back up that mountain?",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 16201,
      "_bytes": 61,
      "translation": "Por cierto, ¿sabes cómo podemos\nvolver a esa montaña?"
    },
    {
      "index": 60,
      "english": "You mean Infinity Mountain?",
      "speaker_id": 4141,
      "line_type": 2,
      "_offset": 16263,
      "_bytes": 27,
      "translation": "¿El Monte Mugen?"
    },
    {
      "index": 61,
      "english": "Yeah!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 16291,
      "_bytes": 5,
      "translation": "¡Sí!"
    },
    {
      "index": 62,
      "english": "I suggest you don't, because\nDevimon's there...",
      "speaker_id": 4141,
      "line_type": 2,
      "_offset": 16297,
      "_bytes": 47,
      "translation": "Te sugiero que no vayas, ahí\nestá Devimon..."
    },
    {
      "index": 63,
      "english": "I have to ask Devimon where he's\ntaken Matt and the others.",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 16345,
      "_bytes": 61,
      "translation": "Tenemos que preguntarle dónde\nestán Matt y los otros."
    },
    {
      "index": 64,
      "english": "He's not the type to just listen\nquietly. No matter what you ask\nhim, you'll have to defeat him.",
      "speaker_id": 4141,
      "line_type": 2,
      "_offset": 16407,
      "_bytes": 96,
      "translation": "No es de los que escuchan. Sea\ncomo sea, tendrás que\nderrotarle."
    },
    {
      "index": 65,
      "english": "I don't want to fight!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 16504,
      "_bytes": 22,
      "translation": "¡No quiero luchar!"
    },
    {
      "index": 66,
      "english": "I'm sure there must be another\nway.",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 16527,
      "_bytes": 35,
      "translation": "Seguro que hay otro modo."
    },
    {
      "index": 67,
      "english": "I feel like something will\nhappen...if we join our hearts\ntogether...",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 16563,
      "_bytes": 69,
      "translation": "Siento que algo ocurrirá...\nSi unimos nuestros corazones..."
    },
    {
      "index": 68,
      "english": "Something will...\nhappen...?...Maybe...!",
      "speaker_id": 4141,
      "line_type": 2,
      "_offset": 16633,
      "_bytes": 40,
      "translation": "¿Algo... ocurrirá?\n¡Quizás...!"
    },
    {
      "index": 69,
      "english": "?!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 16674,
      "_bytes": 2,
      "translation": "?!"
    },
    {
      "index": 70,
      "english": "Where are you going?",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 16677,
      "_bytes": 20,
      "translation": "¿Adónde vas?"
    },
    {
      "index": 71,
      "english": "To Gear Savannah, it's nearby!\nThere's a Yokomon village\nthere...",
      "speaker_id": 4141,
      "line_type": 2,
      "_offset": 16698,
      "_bytes": 66,
      "translation": "¡A la Sabana Gear, está cerca!\nAllí hay un pueblo Yokomon..."
    },
    {
      "index": 72,
      "english": "The village that Meramon protects,\nright?",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 16765,
      "_bytes": 41,
      "translation": "El pueblo protegido por Meramon,\n¿verdad?"
    },
    {
      "index": 73,
      "english": "I'm going to tell them what you\njust said! If our hearts unite, \nmaybe the island will recombine!",
      "speaker_id": 4141,
      "line_type": 2,
      "_offset": 16807,
      "_bytes": 97,
      "translation": "¡Les diré lo que me has dicho! ¡Si\nnuestros corazones se unen,\nquizás la isla se una de nuevo!"
    },
    {
      "index": 74,
      "english": "The split pieces will come back...",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 16905,
      "_bytes": 34,
      "translation": "Los trozos se vuelven a unir..."
    },
    {
      "index": 75,
      "english": "It's just a hunch...but I want to\nbelieve it!",
      "speaker_id": 4141,
      "line_type": 2,
      "_offset": 16940,
      "_bytes": 45,
      "translation": "¡Es una corazonada... pero quiero\ncreer!"
    },
    {
      "index": 76,
      "english": "Yeah! I'll believe in it, too!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 16986,
      "_bytes": 30,
      "translation": "¡Sí! ¡Creeré en ello yo también!"
    },
    {
      "index": 77,
      "english": "Be careful!",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 17017,
      "_bytes": 11,
      "translation": "¡Cuídate!"
    },
    {
      "index": 78,
      "english": "...Matt...",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 17029,
      "_bytes": 12,
      "translation": "...Matt..."
    },
    {
      "index": 79,
      "english": "*Waaah, waaaah!*",
      "speaker_id": 9003,
      "line_type": 2,
      "_offset": 17042,
      "_bytes": 16,
      "translation": "¡Buaaah, buaaah!"
    },
    {
      "index": 80,
      "english": "What's wrong?",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 17059,
      "_bytes": 13,
      "translation": "¿Qué ocurre?"
    },
    {
      "index": 81,
      "english": "Nice to meet you.",
      "speaker_id": 2111,
      "line_type": 2,
      "_offset": 17073,
      "_bytes": 17,
      "translation": "Encantado."
    },
    {
      "index": 82,
      "english": "Whoa! It evolved!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 17091,
      "_bytes": 17,
      "translation": "¡Uah! ¡Evolucionó!"
    },
    {
      "index": 83,
      "english": "Congrats!",
      "speaker_id": 9001,
      "line_type": 2,
      "_offset": 17109,
      "_bytes": 9,
      "translation": "¡Viva!"
    },
    {
      "index": 84,
      "english": "Congrats!",
      "speaker_id": 9901,
      "line_type": 2,
      "_offset": 17119,
      "_bytes": 9,
      "translation": "¡Viva!"
    },
    {
      "index": 85,
      "english": "Congrats!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 17129,
      "_bytes": 9,
      "translation": "¡Viva!"
    },
    {
      "index": 86,
      "english": "(Someday I'm going to evolve,\ntoo. But if I do, can I spend time\nlike this with T.K?)",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 17139,
      "_bytes": 88,
      "translation": "(Algún día digievolucionaré. Pero,\nsi lo hago, ¿podré pasar tiempo\nasí con T.K.?)"
    },
    {
      "index": 87,
      "english": "Patamon? Do you want to evolve,\ntoo?",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 17228,
      "_bytes": 36,
      "translation": "¿Patamon? ¿Quieres digievolucionar?"
    },
    {
      "index": 88,
      "english": "I'm fine like this! I'll stay like\nthis with you forever, T.K!",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 17265,
      "_bytes": 65,
      "translation": "¡Estoy bien así! ¡Así estaré\ncontigo para siempre, T.K.!"
    },
    {
      "index": 89,
      "english": "Okay, it's a promise! We'll be\nfriends forever!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 17331,
      "_bytes": 47,
      "translation": "¡Vale, es una promesa!\n¡Amigos para siempre!"
    },
    {
      "index": 90,
      "english": "we'll be friends forever!",
      "speaker_id": 9901,
      "line_type": 2,
      "_offset": 17379,
      "_bytes": 25,
      "translation": "¡Amigos para siempre!"
    },
    {
      "index": 91,
      "english": "we'll be friends forever!",
      "speaker_id": 9901,
      "line_type": 2,
      "_offset": 17405,
      "_bytes": 25,
      "translation": "¡Amigos para siempre!"
    },
    {
      "index": 92,
      "english": "...The Chosen Children...",
      "speaker_id": 9002,
      "line_type": 2,
      "_offset": 17431,
      "_bytes": 25,
      "translation": "...Los Niños Elegidos..."
    },
    {
      "index": 93,
      "english": "Kill...the Chosen Children!",
      "speaker_id": 4071,
      "line_type": 2,
      "_offset": 17457,
      "_bytes": 27,
      "translation": "¡Matar... a los Niños Elegidos!"
    },
    {
      "index": 94,
      "english": "T.K! It's Leomon!",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 17485,
      "_bytes": 20,
      "translation": "¡T.K.! ¡Es Leomon!"
    },
    {
      "index": 95,
      "english": "Huh?!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 17506,
      "_bytes": 5,
      "translation": "¡¿Eh?!"
    },
    {
      "index": 96,
      "english": "T.K, over here!",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 17512,
      "_bytes": 18,
      "translation": "T.K., ¡por aquí!"
    },
    {
      "index": 97,
      "english": "With Leomon here...what are we\nsupposed to do?",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 17531,
      "_bytes": 46,
      "translation": "Con Leomon aquí... ¿qué debemos\nhacer?"
    },
    {
      "index": 98,
      "english": "Leomon's normally a good Digimon,\nso we have to get the black gear's\npower out of him!",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 17578,
      "_bytes": 86,
      "translation": "¡Leomon es normalmente un Digimon\nbueno, tenemos que sacarle esa\nrueda negra!"
    },
    {
      "index": 99,
      "english": "But... how?",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 17665,
      "_bytes": 11,
      "translation": "Y... ¿cómo?"
    },
    {
      "index": 100,
      "english": "Can you hear me, brats? You're\nscared and hiding, aren't you?\nCome out!",
      "speaker_id": 4061,
      "line_type": 2,
      "_offset": 17677,
      "_bytes": 71,
      "translation": "¿Me oís, mocosos? Estáis\nescondidos, ¿no?\n¡Salid!"
    },
    {
      "index": 101,
      "english": "Ogremon's here, too!",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 17749,
      "_bytes": 20,
      "translation": "¡Ogremon está aquí!"
    },
    {
      "index": 102,
      "english": "If you don't come out, who knows\nwhat we'll do to this town!",
      "speaker_id": 4061,
      "line_type": 2,
      "_offset": 17770,
      "_bytes": 60,
      "translation": "¡Si no salís, no sé qué podría\nocurrirle a este pueblo!"
    },
    {
      "index": 103,
      "english": "What do we do, Patamon...?",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 17831,
      "_bytes": 26,
      "translation": "¿Qué hacemos, Patamon...?"
    },
    {
      "index": 104,
      "english": "(If we get the black gear out of\nLeomon, I'm sure he'll fight\nOgremon for us!)",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 17858,
      "_bytes": 78,
      "translation": "(¡Si sacamos la rueda negra de\nLeomon, seguro que luchará contra\nOgremon!)"
    },
    {
      "index": 105,
      "english": "(But if that fails, I don't know\nif I can protect T.K...)",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 17937,
      "_bytes": 60,
      "translation": "(Pero si eso falla, no sé si\npodré proteger a T.K...)"
    },
    {
      "index": 106,
      "english": "Kill...the Chosen Children!",
      "speaker_id": 4071,
      "line_type": 2,
      "_offset": 17998,
      "_bytes": 27,
      "translation": "Matar...¡Niños Elegidos!"
    },
    {
      "index": 107,
      "english": "Uh-oh!",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 18026,
      "_bytes": 6,
      "translation": "¡Oh-oh!"
    },
    {
      "index": 108,
      "english": "T.Kuuuuu!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 18033,
      "_bytes": 12,
      "translation": "¡T.K.!"
    },
    {
      "index": 109,
      "english": "Matt!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 18046,
      "_bytes": 7,
      "translation": "¡Matt!"
    },
    {
      "index": 110,
      "english": "You're safe!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 18054,
      "_bytes": 12,
      "translation": "¡Estás bien!"
    },
    {
      "index": 111,
      "english": "Yeah!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 18067,
      "_bytes": 5,
      "translation": "¡Sí!"
    },
    {
      "index": 112,
      "english": "He was here, too...?",
      "speaker_id": 4061,
      "line_type": 2,
      "_offset": 18073,
      "_bytes": 20,
      "translation": "¿Estaba también aquí?"
    },
    {
      "index": 113,
      "english": "And the Digimon babies are all\nevacuated!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 18094,
      "_bytes": 41,
      "translation": "¡Y los bebés Digimon están a\nsalvo!"
    },
    {
      "index": 114,
      "english": "What?!",
      "speaker_id": 4061,
      "line_type": 2,
      "_offset": 18136,
      "_bytes": 6,
      "translation": "¡¿Qué?!"
    },
    {
      "index": 115,
      "english": "So, what are you going to do,\nOgremon?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 18143,
      "_bytes": 38,
      "translation": "¿Qué vas a hacer, Ogremon?"
    },
    {
      "index": 116,
      "english": "Ughhhh...",
      "speaker_id": 4061,
      "line_type": 2,
      "_offset": 18182,
      "_bytes": 9,
      "translation": "Ugh..."
    },
    {
      "index": 117,
      "english": "The Chosen Children...",
      "speaker_id": 4071,
      "line_type": 2,
      "_offset": 18192,
      "_bytes": 22,
      "translation": "Los Niños Elegidos..."
    },
    {
      "index": 118,
      "english": "Leomon! You're supposed to be a\ngood Digimon! Shake off those\nblack gears!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 18215,
      "_bytes": 74,
      "translation": "¡Leomon! ¡Se supone que eres un\nDigimon bueno! ¡Deshazte de esas\nruedas negras!"
    },
    {
      "index": 119,
      "english": "...The children...",
      "speaker_id": 4071,
      "line_type": 2,
      "_offset": 18290,
      "_bytes": 18,
      "translation": "...Los niños..."
    },
    {
      "index": 120,
      "english": "Guuuuuuuhhh!!",
      "speaker_id": 4071,
      "line_type": 2,
      "_offset": 18309,
      "_bytes": 13,
      "translation": "¡¡Guuuuuuhh!!"
    },
    {
      "index": 121,
      "english": "More black gears!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 18323,
      "_bytes": 17,
      "translation": "¡Ruedas negras!"
    },
    {
      "index": 122,
      "english": "Gaaaaaaahhh!",
      "speaker_id": 4071,
      "line_type": 2,
      "_offset": 18341,
      "_bytes": 12,
      "translation": "¡Gaaaaaahh!"
    },
    {
      "index": 123,
      "english": "Thank you! I'm so glad you came to\nhelp, Matt!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 18354,
      "_bytes": 48,
      "translation": "¡Gracias! ¡Qué bien que vinieras\na ayudarme, Matt!"
    },
    {
      "index": 124,
      "english": "We're in this together, don't\nworry about it!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 18403,
      "_bytes": 45,
      "translation": "¡Estamos juntos en esto, no te\npreocupes!"
    },
    {
      "index": 125,
      "english": "Thanks for helping me find T.K,\nTai!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 18449,
      "_bytes": 42,
      "translation": "¡Gracias por ayudarme a buscar\na T.K., Tai!"
    },
    {
      "index": 126,
      "english": "You're the one who wanted to find\nT.K so badly, after all!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 18492,
      "_bytes": 61,
      "translation": "¡Eras tú el que tenía más ganas de\nencontrarle, sin duda!"
    },
    {
      "index": 127,
      "english": "Really and truly, thank you,\nTai!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 18554,
      "_bytes": 36,
      "translation": "¡De verdad de la buena, gracias,\nTai!"
    },
    {
      "index": 128,
      "english": "K-kill the Chosen Children...",
      "speaker_id": 4071,
      "line_type": 2,
      "_offset": 18591,
      "_bytes": 29,
      "translation": "M-Matar... Niños Elegidos..."
    },
    {
      "index": 129,
      "english": "It's not working! We can't get\nthose black gears out of Leomon!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 18621,
      "_bytes": 63,
      "translation": "¡No funciona! ¡No podemos sacarle\nlas ruedas negras!"
    },
    {
      "index": 130,
      "english": "What should we do...?",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 18685,
      "_bytes": 21,
      "translation": "¿Qué podemos hacer...?"
    },
    {
      "index": 131,
      "english": "Taiiiiiiii!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 18707,
      "_bytes": 14,
      "translation": "¡Taiiiii!"
    },
    {
      "index": 132,
      "english": "Izzy! Mimi!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 18722,
      "_bytes": 16,
      "translation": "¡Izzy! ¡Mimi!"
    },
    {
      "index": 133,
      "english": "We've got some useful info!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 18739,
      "_bytes": 27,
      "translation": "¡Traemos información!"
    },
    {
      "index": 134,
      "english": "We have the power of the holy\ndevice!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 18767,
      "_bytes": 37,
      "translation": "¡Es sobre el dispositivo sagrado!"
    },
    {
      "index": 135,
      "english": "The holy device?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 18805,
      "_bytes": 16,
      "translation": "¿Sagrado?"
    },
    {
      "index": 136,
      "english": "The devices that came down from\nthe sky!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 18822,
      "_bytes": 40,
      "translation": "¡Los que nos cayeron del cielo!"
    },
    {
      "index": 137,
      "english": "The devices that came down from\nthe sky!",
      "speaker_id": 8011,
      "line_type": 4,
      "_offset": 18863,
      "_bytes": 40,
      "translation": "¡Los que nos cayeron del cielo!"
    },
    {
      "index": 138,
      "english": "These?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 18904,
      "_bytes": 6,
      "translation": "¿Esto?"
    },
    {
      "index": 139,
      "english": "The holy device can drive out the\ndarkness!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 18911,
      "_bytes": 43,
      "translation": "¡Pueden repeler la oscuridad!"
    },
    {
      "index": 140,
      "english": "The holy device can drive out the\ndarkness!",
      "speaker_id": 9901,
      "line_type": 2,
      "_offset": 18955,
      "_bytes": 43,
      "translation": "¡Pueden repeler a la oscuridad!"
    },
    {
      "index": 141,
      "english": "All right! Lemme try it!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 18999,
      "_bytes": 24,
      "translation": "¡Vale! ¡Déjame probar!"
    },
    {
      "index": 142,
      "english": "Kill...the Chosen Children...",
      "speaker_id": 4071,
      "line_type": 2,
      "_offset": 19024,
      "_bytes": 29,
      "translation": "Matar...Niños Elegidos..."
    },
    {
      "index": 143,
      "english": "Now!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 19054,
      "_bytes": 4,
      "translation": "¡Ya!"
    },
    {
      "index": 144,
      "english": "Lemme try, too!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 19059,
      "_bytes": 15,
      "translation": "¡Yo también!"
    },
    {
      "index": 145,
      "english": "Ughhhhhh!! I, I...",
      "speaker_id": 4071,
      "line_type": 2,
      "_offset": 19075,
      "_bytes": 18,
      "translation": "¡¡Ugghhh!! Yo, yo..."
    },
    {
      "index": 146,
      "english": "T-this is bad! The brats...",
      "speaker_id": 4061,
      "line_type": 2,
      "_offset": 19094,
      "_bytes": 27,
      "translation": "¡Oh no! Esos idiotas..."
    },
    {
      "index": 147,
      "english": "Gaaaaaaahhh!",
      "speaker_id": 4071,
      "line_type": 2,
      "_offset": 19122,
      "_bytes": 12,
      "translation": "¡Gaaaaahhh!"
    },
    {
      "index": 148,
      "english": "We did it!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 19135,
      "_bytes": 10,
      "translation": "¡Hecho!"
    },
    {
      "index": 149,
      "english": "The divine powers have triumphed!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 19146,
      "_bytes": 33,
      "translation": "¡El poder divino triunfa!"
    },
    {
      "index": 150,
      "english": "You've gotta be kidding me! I\ncan't take on these guys on my\nown!",
      "speaker_id": 4061,
      "line_type": 2,
      "_offset": 19180,
      "_bytes": 65,
      "translation": "¡Tiene que ser una broma! ¡No puedo\ncargarme a estos yo solo!"
    },
    {
      "index": 151,
      "english": "A long time ago, some rumors\nstarted circulating about our\nworld being covered in darkness...",
      "speaker_id": 4071,
      "line_type": 2,
      "_offset": 19246,
      "_bytes": 93,
      "translation": "Hace mucho tiempo, circularon\nrumores de que el mundo se cubría\nde oscuridad..."
    },
    {
      "index": 152,
      "english": "And the \"Chosen Children\" from\nanother world would come to save\nit...",
      "speaker_id": 4071,
      "line_type": 2,
      "_offset": 19340,
      "_bytes": 69,
      "translation": "Y los \"Niños Elegidos\" de otro\nmundo vendrían a salvarlo..."
    },
    {
      "index": 153,
      "english": "So you're saying that we're these\n\"Chosen Children\".",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 19410,
      "_bytes": 52,
      "translation": "Así que dices que somos esos\n\"Niños Elegidos\"."
    },
    {
      "index": 154,
      "english": "But you don't have any proof.",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 19463,
      "_bytes": 29,
      "translation": "Pero no tienes pruebas."
    },
    {
      "index": 155,
      "english": "The \"Chosen Children\" are those\nwith the power to evolve their\nDigimon.",
      "speaker_id": 4071,
      "line_type": 2,
      "_offset": 19493,
      "_bytes": 71,
      "translation": "Los \"Niños Elegidos\" son\ncapaces de digievolucionar a sus\nDigimon."
    },
    {
      "index": 156,
      "english": "So you mean that if we extinguish\nthe powers of darkness, we'll\nbecome unnecessary in this world!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 19565,
      "_bytes": 97,
      "translation": "¡Entonces si eliminamos la\noscuridad significa que no\nseremos ya necesarios!"
    },
    {
      "index": 157,
      "english": "What do you mean by that?",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 19663,
      "_bytes": 25,
      "translation": "¿A qué te refieres?"
    },
    {
      "index": 158,
      "english": "In other words... we may be able\nto return to our original world.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 19689,
      "_bytes": 65,
      "translation": "En otras palabras... podremos\nvolver a nuestro mundo."
    },
    {
      "index": 159,
      "english": "Really?",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 19755,
      "_bytes": 7,
      "translation": "¿Sí?"
    },
    {
      "index": 160,
      "english": "So...in order to do that...",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 19763,
      "_bytes": 27,
      "translation": "Así que... para eso..."
    },
    {
      "index": 161,
      "english": "You must defeat Devimon, who is at\nthe center of the powers of\ndarkness.",
      "speaker_id": 4071,
      "line_type": 2,
      "_offset": 19791,
      "_bytes": 72,
      "translation": "Debéis derrotar a Devimon, que\nes el centro de los poderes\noscuros."
    },
    {
      "index": 162,
      "english": "Let's do it, everyone! We won't be\nable to survive here unless we\ndefeat him.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 19864,
      "_bytes": 77,
      "translation": "¡Hagámoslo! No podremos sobrevivir\naquí a no ser que le derrotemos."
    },
    {
      "index": 163,
      "english": "You're right...and we have the\nholy devices, as well...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 19942,
      "_bytes": 55,
      "translation": "Tienes razón... y tenemos los\ndispositivos, también..."
    },
    {
      "index": 164,
      "english": "Mimi will try her hardest, too!\nIt's scary, but I wanna go home...",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 19998,
      "_bytes": 66,
      "translation": "¡Mimi lo dará todo, también!\nDa miedo, pero quiero irme a\ncasa..."
    },
    {
      "index": 165,
      "english": "Yeah. We've got no choice but to\ndo it!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 20065,
      "_bytes": 39,
      "translation": "Sí. ¡No tenemos otra opción!"
    },
    {
      "index": 166,
      "english": "I will assist you, as well.",
      "speaker_id": 4071,
      "line_type": 2,
      "_offset": 20105,
      "_bytes": 27,
      "translation": "Os ayudaré, también."
    },
    {
      "index": 167,
      "english": "All right, it's decided!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 20133,
      "_bytes": 24,
      "translation": "¡Vale, está decidido!"
    },
    {
      "index": 168,
      "english": "Hey, Tai, how far are we gonna\nkeep going?!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 20158,
      "_bytes": 46,
      "translation": "Eh, Tai, ¡¿cuándo vamos a parar?!"
    }
  ]
}