      "index": 153,
      "english": "The \"Chosen Children\" are those\nwith the power to evolve their\nDigimon.",
      "_offset": 7344,
      "_length": 71,
      "speaker_id": 0,
      "translation": "Los \"Niños Elegidos\" son\ncapaces de digievolucionar a sus\nDigimon."
    },
