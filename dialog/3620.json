{
  "file_id": "3620",
  "format": "etdf",
  "kind": "ETDF",
  "text_count": 62,
  "dialog": [
    {
      "index": 0,
      "english": "So? Do you feel Gankuumon's\npresence here?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 7144,
      "_bytes": 42,
      "translation": "¿Y bien? ¿Sientes la presencia\nde Gankoomon aquí?"
    },
    {
      "index": 1,
      "english": "Nope. Not from here, anyway.",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 7187,
      "_bytes": 28,
      "translation": "No. Al menos no de aquí."
    },
    {
      "index": 2,
      "english": "Hm... By the way, Hackmon, are you\ndoing okay?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 7216,
      "_bytes": 46,
      "translation": "Oye, Hackmon, ¿estás\nbien?"
    },
    {
      "index": 3,
      "english": "...",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 7263,
      "_bytes": 3,
      "translation": "..."
    },
    {
      "index": 4,
      "english": "Looks like it's gonna be a bit\nlonger.",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 7267,
      "_bytes": 38,
      "translation": "Parece que tardará un\npoco más."
    },
    {
      "index": 5,
      "english": "!!",
      "speaker_id": 9001,
      "line_type": 2,
      "_offset": 7306,
      "_bytes": 2,
      "translation": "!!"
    },
    {
      "index": 6,
      "english": "Uh-oh!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 7309,
      "_bytes": 6,
      "translation": "¡Oh, oh!"
    },
    {
      "index": 7,
      "english": "We're surrounded!",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 7316,
      "_bytes": 17,
      "translation": "¡Nos rodearon!"
    },
    {
      "index": 8,
      "english": "We've got Hackmon with us, and\nhe's wounded. How are we gonna\nescape with him?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 7334,
      "_bytes": 78,
      "translation": "Llevamos a Hackmon herido.\n¿Cómo vamos a escapar\ncon él?"
    },
    {
      "index": 9,
      "english": "What are we gonna do...",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 7413,
      "_bytes": 23,
      "translation": "¿Qué vamos a hacer...?"
    },
    {
      "index": 10,
      "english": "Take that!",
      "speaker_id": 7111,
      "line_type": 2,
      "_offset": 7437,
      "_bytes": 10,
      "translation": "¡Toma esto!"
    },
    {
      "index": 11,
      "english": "Hey! Are you guys okay?",
      "speaker_id": 7051,
      "line_type": 2,
      "_offset": 7448,
      "_bytes": 23,
      "translation": "¡Oye! ¿Estáis bien?"
    },
    {
      "index": 12,
      "english": "Who are you?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 7472,
      "_bytes": 12,
      "translation": "¿Quién eres?"
    },
    {
      "index": 13,
      "english": "I'm Taiki Kudou!",
      "speaker_id": 7051,
      "line_type": 2,
      "_offset": 7485,
      "_bytes": 16,
      "translation": "¡Soy Taiki Kudou!"
    },
    {
      "index": 14,
      "english": "And I'm Shoutmon, the Digimon\nKing!",
      "speaker_id": 7111,
      "line_type": 2,
      "_offset": 7502,
      "_bytes": 35,
      "translation": "¡Y yo soy Shoutmon, el Rey\nDigimon!"
    },
    {
      "index": 15,
      "english": "The Digimon King?",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 7538,
      "_bytes": 17,
      "translation": "¿El Rey Digimon?"
    },
    {
      "index": 16,
      "english": "Well, first, let's try to get out\nof here! Ready, Shoutmon?",
      "speaker_id": 7051,
      "line_type": 2,
      "_offset": 7556,
      "_bytes": 59,
      "translation": "¡Bueno, primero salgamos\nde aquí! ¿Listo, Shoutmon?"
    },
    {
      "index": 17,
      "english": "Hah! Take that!",
      "speaker_id": 7111,
      "line_type": 2,
      "_offset": 7616,
      "_bytes": 15,
      "translation": "¡Ja! ¡Toma esto!"
    },
    {
      "index": 18,
      "english": "All right, now's our chance!",
      "speaker_id": 7051,
      "line_type": 2,
      "_offset": 7632,
      "_bytes": 28,
      "translation": "¡Bien, esta es la ocasión!"
    },
    {
      "index": 19,
      "english": "Y-Yeah!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 7661,
      "_bytes": 7,
      "translation": "¡S-Sí!"
    },
    {
      "index": 20,
      "english": "So that's what happened...",
      "speaker_id": 7051,
      "line_type": 2,
      "_offset": 7669,
      "_bytes": 26,
      "translation": "Así que fue eso..."
    },
    {
      "index": 21,
      "english": "Gankuumon was the one who brought\nus here, huh...",
      "speaker_id": 7051,
      "line_type": 2,
      "_offset": 7696,
      "_bytes": 49,
      "translation": "Así que fue Gankoomon quien\nnos trajo aquí..."
    },
    {
      "index": 22,
      "english": "Seems like Hackmon knows who that\nGankuumon guy is.",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 7746,
      "_bytes": 51,
      "translation": "Parece que Hackmon sabe\nquién es ese tal Gankoomon."
    },
    {
      "index": 23,
      "english": "...",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 7798,
      "_bytes": 3,
      "translation": "..."
    },
    {
      "index": 24,
      "english": "He's probably got some kind of\nplan.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 7802,
      "_bytes": 36,
      "translation": "Seguro que tiene algún\nplan."
    },
    {
      "index": 25,
      "english": "Ever since we were brought here,\nI've been trying to gather\ninformation...",
      "speaker_id": 7051,
      "line_type": 2,
      "_offset": 7839,
      "_bytes": 74,
      "translation": "Desde que nos trajeron aquí,\nhe intentado reunir\ninformación..."
    },
    {
      "index": 26,
      "english": "But thanks to you guys, I think I\nhave a good grasp of the\nsituation.",
      "speaker_id": 7051,
      "line_type": 2,
      "_offset": 7914,
      "_bytes": 69,
      "translation": "Pero gracias a vosotros,\ncreo que ya entiendo bien\nla situación."
    },
    {
      "index": 27,
      "english": "Well, by running into us by\naccident, anyway.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 7984,
      "_bytes": 45,
      "translation": "Bueno, más bien por\ntopar con nosotros."
    },
    {
      "index": 28,
      "english": "Why don't you guys help us out?\nWe'll look for a way out together!",
      "speaker_id": 7051,
      "line_type": 2,
      "_offset": 8030,
      "_bytes": 66,
      "translation": "¿Por qué no nos ayudáis?\n¡Buscaremos la salida juntos!"
    },
    {
      "index": 29,
      "english": "Sure! Sounds good!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 8097,
      "_bytes": 18,
      "translation": "¡Claro que sí!"
    },
    {
      "index": 30,
      "english": "You've just established an\nalliance with Team Xros Heart!",
      "speaker_id": 7111,
      "line_type": 2,
      "_offset": 8116,
      "_bytes": 57,
      "translation": "¡Acabáis de haceros aliados\ndel equipo Xros Heart!"
    },
    {
      "index": 31,
      "english": "Xros... Heart?",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 8174,
      "_bytes": 14,
      "translation": "Xros... ¿Heart?"
    },
    {
      "index": 32,
      "english": "Yeah, it's the team name for all\nof our friends.",
      "speaker_id": 7051,
      "line_type": 2,
      "_offset": 8189,
      "_bytes": 48,
      "translation": "Sí, es el nombre del equipo\nde todos mis amigos."
    },
    {
      "index": 33,
      "english": "Taiki's our General! He's the one\nwho leads me and my friends into\nbattle!",
      "speaker_id": 7111,
      "line_type": 2,
      "_offset": 8238,
      "_bytes": 74,
      "translation": "¡Taiki es nuestro General!\n¡El que nos lleva a mí y a\nmis amigos a la batalla!"
    },
    {
      "index": 34,
      "english": "Wow...",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 8313,
      "_bytes": 6,
      "translation": "Hala..."
    },
    {
      "index": 35,
      "english": "Seems like your Digimon really\nlikes you.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 8320,
      "_bytes": 41,
      "translation": "Parece que tu Digimon\nte quiere de verdad."
    },
    {
      "index": 36,
      "english": "Taiki's the kind of person who\ncan't leave someone behind when\nthey're in trouble!",
      "speaker_id": 7111,
      "line_type": 2,
      "_offset": 8362,
      "_bytes": 82,
      "translation": "¡Taiki es de los que nunca\nabandonan a nadie cuando\nestá en apuros!"
    },
    {
      "index": 37,
      "english": "Well... you get angry with me\nsometimes, though.",
      "speaker_id": 7051,
      "line_type": 2,
      "_offset": 8445,
      "_bytes": 48,
      "translation": "Bueno... a veces te\nenfadas conmigo."
    },
    {
      "index": 38,
      "english": "...",
      "speaker_id": 9002,
      "line_type": 2,
      "_offset": 8494,
      "_bytes": 3,
      "translation": "..."
    },
    {
      "index": 39,
      "english": "!!",
      "speaker_id": 9001,
      "line_type": 2,
      "_offset": 8498,
      "_bytes": 2,
      "translation": "!!"
    },
    {
      "index": 40,
      "english": "You dare to make a copy of *me*?",
      "speaker_id": 7111,
      "line_type": 2,
      "_offset": 8501,
      "_bytes": 32,
      "translation": "¿Te atreves a copiarme a mí?"
    },
    {
      "index": 41,
      "english": "Don't let your guard down,\nShoutmon!",
      "speaker_id": 7051,
      "line_type": 2,
      "_offset": 8534,
      "_bytes": 36,
      "translation": "¡No bajes la guardia,\nShoutmon!"
    },
    {
      "index": 42,
      "english": "Right!",
      "speaker_id": 7111,
      "line_type": 2,
      "_offset": 8571,
      "_bytes": 6,
      "translation": "¡Vale!"
    },
    {
      "index": 43,
      "english": "Let's go, Agumon!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 8578,
      "_bytes": 17,
      "translation": "¡Vamos, Agumon!"
    },
    {
      "index": 44,
      "english": "Okay, Tai!",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 8596,
      "_bytes": 13,
      "translation": "¡Vale, Tai!"
    },
    {
      "index": 45,
      "english": "Didja see that? That's the power\nof the *real* Digimon King!",
      "speaker_id": 7111,
      "line_type": 2,
      "_offset": 8610,
      "_bytes": 60,
      "translation": "¿Viste eso? ¡Es el poder\ndel verdadero Rey Digimon!"
    },
    {
      "index": 46,
      "english": "We did it!",
      "speaker_id": 7051,
      "line_type": 2,
      "_offset": 8671,
      "_bytes": 10,
      "translation": "¡Ganamos!"
    },
    {
      "index": 47,
      "english": "You did great too, Agumon.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 8682,
      "_bytes": 26,
      "translation": "Tú también lo hiciste\ngenial, Agumon."
    },
    {
      "index": 48,
      "english": "Heh heh!",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 8709,
      "_bytes": 8,
      "translation": "¡Je je!"
    },
    {
      "index": 49,
      "english": "Well, I guess we're splitting up\nhere. Thanks for all the help!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 8718,
      "_bytes": 63,
      "translation": "Bueno, aquí nos separamos.\n¡Gracias por la ayuda!"
    },
    {
      "index": 50,
      "english": "Likewise!",
      "speaker_id": 7051,
      "line_type": 2,
      "_offset": 8782,
      "_bytes": 9,
      "translation": "¡Lo mismo digo!"
    },
    {
      "index": 51,
      "english": "I'm worried about Hackmon. He\nstill can't even talk...",
      "speaker_id": 7111,
      "line_type": 2,
      "_offset": 8792,
      "_bytes": 54,
      "translation": "Me preocupa Hackmon. Aún\nno puede ni hablar..."
    },
    {
      "index": 52,
      "english": "It's okay! Leave him to us!",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 8847,
      "_bytes": 27,
      "translation": "¡Tranquilo! ¡Déjanoslo!"
    },
    {
      "index": 53,
      "english": "All right, take care of him!",
      "speaker_id": 7111,
      "line_type": 2,
      "_offset": 8875,
      "_bytes": 28,
      "translation": "¡Vale, cuidadlo bien!"
    },
    {
      "index": 54,
      "english": "All right, see you!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 8904,
      "_bytes": 19,
      "translation": "¡Vale, nos vemos!"
    },
    {
      "index": 55,
      "english": "Oh yeah, by the way... there's\nsomeone else who came with us.",
      "speaker_id": 7051,
      "line_type": 2,
      "_offset": 8924,
      "_bytes": 61,
      "translation": "Ah, por cierto... vino\nalguien más con nosotros."
    },
    {
      "index": 56,
      "english": "I wonder where he ran off to...",
      "speaker_id": 7111,
      "line_type": 2,
      "_offset": 8986,
      "_bytes": 31,
      "translation": "Me pregunto adónde fue..."
    },
    {
      "index": 57,
      "english": "If you run into him, take care of\nhim for me, okay? He'll help you\nout, too.",
      "speaker_id": 7051,
      "line_type": 2,
      "_offset": 9018,
      "_bytes": 76,
      "translation": "Si os lo encontráis,\ncuidádmelo, ¿vale? A vosotros\ntambién os ayudará."
    },
    {
      "index": 58,
      "english": "All right, I'll remember that!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 9095,
      "_bytes": 30,
      "translation": "¡Vale, lo recordaré!"
    },
    {
      "index": 59,
      "english": "　　　　　　【Area 1】",
      "speaker_id": 9003,
      "line_type": 4,
      "_offset": 9126,
      "_bytes": 22,
      "translation": "Zona 1"
    },
    {
      "index": 60,
      "english": "　　　　　　【Area 2】",
      "speaker_id": 9003,
      "line_type": 4,
      "_offset": 9149,
      "_bytes": 22,
      "translation": "Zona 2"
    },
    {
      "index": 61,
      "english": "　　　　　　【Area 3】",
      "speaker_id": 9003,
      "line_type": 4,
      "_offset": 9172,
      "_bytes": 22,
      "translation": "Zona 3"
    }
  ]
}