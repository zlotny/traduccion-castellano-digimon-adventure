{
  "file_id": "ID03533",
  "text_count": 31,
  "dialog": [
    {
      "index": 0,
      "english": "��������That's... whoa, an iceberg!\nWe're gonna crash,\nwe're gonna craaaaaash!",
      "_offset": 1619,
      "_length": 78,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 1,
      "english": "Whoaaaaaaaaa!",
      "_offset": 1698,
      "_length": 13,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 2,
      "english": "Owwww. Agumon, are you okay?",
      "_offset": 1712,
      "_length": 28,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 3,
      "english": "Yeah. The snow cushioned me,\nbut...",
      "_offset": 1741,
      "_length": 35,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 4,
      "english": "I-it's coooold! We're gonna\nfreeze.",
      "_offset": 1777,
      "_length": 35,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 5,
      "english": "I've got an idea! Want me to warm\nyou up, Taichi?",
      "_offset": 1813,
      "_length": 49,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 6,
      "english": "Oh! You mean with your Baby Flame!\nOkay, but be careful.",
      "_offset": 1863,
      "_length": 56,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 7,
      "english": "Got it! Baby Flame!",
      "_offset": 1920,
      "_length": 19,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 8,
      "english": "Hot, hot! Hoooooooot!",
      "_offset": 1940,
      "_length": 21,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 9,
      "english": "Agh, I overdid it! Sorry, Taichi!",
      "_offset": 1962,
      "_length": 33,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 10,
      "english": "I wonder where we're headed...\nI don't know about anything but\nthe island.",
      "_offset": 1996,
      "_length": 74,
      "speaker_id": 255,
      "translation": ""
    },
    {
      "index": 11,
      "english": "Devimon said something\nabout beyond the sea...",
      "_offset": 2071,
      "_length": 46,
      "speaker_id": 255,
      "translation": ""
    },
    {
      "index": 12,
      "english": "Where did everyone go...?",
      "_offset": 2118,
      "_length": 25,
      "speaker_id": 255,
      "translation": ""
    },
    {
      "index": 13,
      "english": "Yuuuuukidaaaarumoooooooon!",
      "_offset": 2144,
      "_length": 26,
      "speaker_id": 255,
      "translation": ""
    },
    {
      "index": 14,
      "english": "It's Yukidarumon! He's being\ncontrolled by a black gear!",
      "_offset": 2171,
      "_length": 56,
      "speaker_id": 255,
      "translation": ""
    },
    {
      "index": 15,
      "english": "Huh... Why was I rampaging?",
      "_offset": 2228,
      "_length": 27,
      "speaker_id": 255,
      "translation": ""
    },
    {
      "index": 16,
      "english": "We did it! We destroyed the black\ngear!",
      "_offset": 2256,
      "_length": 39,
      "speaker_id": 255,
      "translation": ""
    },
    {
      "index": 17,
      "english": "You're not hurt, are you? I saw a\nkid like you and a Gabumon fall\nover there.",
      "_offset": 2296,
      "_length": 77,
      "speaker_id": 255,
      "translation": ""
    },
    {
      "index": 18,
      "english": "Is Yamato on that island?!",
      "_offset": 2374,
      "_length": 26,
      "speaker_id": 255,
      "translation": ""
    },
    {
      "index": 19,
      "english": "But how are we gonna get there? I\ncan't swim...",
      "_offset": 2401,
      "_length": 47,
      "speaker_id": 255,
      "translation": ""
    },
    {
      "index": 20,
      "english": "Well, as my way of thanking you,\nI'll help you get there!",
      "_offset": 2449,
      "_length": 57,
      "speaker_id": 255,
      "translation": ""
    },
    {
      "index": 21,
      "english": "Can you do that?",
      "_offset": 2507,
      "_length": 16,
      "speaker_id": 255,
      "translation": ""
    },
    {
      "index": 22,
      "english": "Yeah. I'll freeze the sea to make\nan ice bridge to the next island.",
      "_offset": 2524,
      "_length": 67,
      "speaker_id": 255,
      "translation": ""
    },
    {
      "index": 23,
      "english": "I see! With a bridge, we can just\nwalk there!",
      "_offset": 2592,
      "_length": 45,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 24,
      "english": "So? Should we go?",
      "_offset": 2638,
      "_length": 17,
      "speaker_id": 255,
      "translation": ""
    },
    {
      "index": 25,
      "english": "It's not like we have anything\nleft to do here...",
      "_offset": 2656,
      "_length": 49,
      "speaker_id": 255,
      "translation": ""
    },
    {
      "index": 26,
      "english": "Let's explore a bit more first.",
      "_offset": 2706,
      "_length": 31,
      "speaker_id": 255,
      "translation": ""
    },
    {
      "index": 27,
      "english": "All right! Let's go look for Yamato!",
      "_offset": 2738,
      "_length": 36,
      "speaker_id": 255,
      "translation": ""
    },
    {
      "index": 28,
      "english": "Got it. I'll be waiting here, so\ncall me when you're ready.",
      "_offset": 2775,
      "_length": 59,
      "speaker_id": 255,
      "translation": ""
    },
    {
      "index": 29,
      "english": "Thanks, Yukidarumon!",
      "_offset": 2835,
      "_length": 20,
      "speaker_id": 255,
      "translation": ""
    },
    {
      "index": 30,
      "english": "Okay! Let's go!",
      "_offset": 2856,
      "_length": 15,
      "speaker_id": 255,
      "translation": ""
    }
  ]
}