{
  "file_id": "3587",
  "format": "etdf",
  "kind": "ETDF",
  "text_count": 113,
  "dialog": [
    {
      "index": 0,
      "english": "Hey! Tai's writing an email!\nWhat's it say?",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 13240,
      "_bytes": 46,
      "translation": "¡Eh! ¡Tai está escribiendo un\ncorreo! ¿Qué dice?"
    },
    {
      "index": 1,
      "english": "\"Dear Sora, it was my fault, so\ndon't be angry anymore...\"",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 13287,
      "_bytes": 58,
      "translation": "\"Querida Sora, fue culpa mía,\nno sigas enfadada...\""
    },
    {
      "index": 2,
      "english": "Don't read my emails! Hey, are you\ngoing somewhere?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 13346,
      "_bytes": 51,
      "translation": "¡No leas mis emails! Oye, ¿vas\na algún sitio?"
    },
    {
      "index": 3,
      "english": "I'm going to a friend's birthday\nparty! I'm getting her this\npresent!",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 13398,
      "_bytes": 69,
      "translation": "¡Voy al cumpleaños de una\namiga! ¡Le llevo este regalo!"
    },
    {
      "index": 4,
      "english": "Hmmmm? Gimme!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 13468,
      "_bytes": 13,
      "translation": "¿Eh? ¡A ver!"
    },
    {
      "index": 5,
      "english": "No!",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 13482,
      "_bytes": 3,
      "translation": "¡No!"
    },
    {
      "index": 6,
      "english": "You can't just keep it to\nyourself!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 13486,
      "_bytes": 35,
      "translation": "¡No puedes quedártelo para\nti sola!"
    },
    {
      "index": 7,
      "english": "If you wanna send an email, all\nyou gotta do is click here!",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 13522,
      "_bytes": 59,
      "translation": "¡Si quieres mandar un email,\nsolo hay que pulsar aquí!"
    },
    {
      "index": 8,
      "english": "Don't just *send* it!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 13582,
      "_bytes": 21,
      "translation": "¡No lo MANDES así!"
    },
    {
      "index": 9,
      "english": "Why not?",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 13604,
      "_bytes": 8,
      "translation": "¿Por qué?"
    },
    {
      "index": 10,
      "english": "Huh? Mail rejected? Come *on*,\nSora...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 13613,
      "_bytes": 38,
      "translation": "¿Eh? ¿Email rechazado? Venga\nya, Sora..."
    },
    {
      "index": 11,
      "english": "Hey, Izzy!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 13652,
      "_bytes": 15,
      "translation": "¡Eh, Izzy!"
    },
    {
      "index": 12,
      "english": "*pant* *pant* The egg...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 13668,
      "_bytes": 24,
      "translation": "(jadeos) El huevo..."
    },
    {
      "index": 13,
      "english": "Huh?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 13693,
      "_bytes": 4,
      "translation": "¿Eh?"
    },
    {
      "index": 14,
      "english": "The egg... hatched!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 13698,
      "_bytes": 19,
      "translation": "¡El huevo... ha eclosionado!"
    },
    {
      "index": 15,
      "english": "The heck is this? It's like a\nsquishy little jellyfish.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 13718,
      "_bytes": 55,
      "translation": "¿Qué narices es esto? Parece\nuna medusita blandita."
    },
    {
      "index": 16,
      "english": "It's a species of Digimon that\nI've never seen before.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 13774,
      "_bytes": 54,
      "translation": "Es una especie de Digimon\nque nunca había visto."
    },
    {
      "index": 17,
      "english": "Huh, it's pretty cute! So what\nabout it?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 13829,
      "_bytes": 40,
      "translation": "¡Vaya, qué mono! ¿Y qué\npasa con él?"
    },
    {
      "index": 18,
      "english": "It seems that the egg was formed\nfrom the combination of many\ncomputer bugs.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 13870,
      "_bytes": 76,
      "translation": "Parece que el huevo se formó\njuntando muchos errores\ninformáticos."
    },
    {
      "index": 19,
      "english": "The jellyfish evolved!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 13947,
      "_bytes": 22,
      "translation": "¡La medusa evolucionó!"
    },
    {
      "index": 20,
      "english": "It grows by eating data...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 13970,
      "_bytes": 26,
      "translation": "Crece comiendo datos..."
    },
    {
      "index": 21,
      "english": "It's only a Baby, but at this rate\nit'll eat up all the data on the\nInternet!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 13997,
      "_bytes": 77,
      "translation": "¡Solo es un Bebé, pero a este\npaso se comerá todos los\ndatos de Internet!"
    },
    {
      "index": 22,
      "english": "What'll happen if it eats data?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 14075,
      "_bytes": 31,
      "translation": "¿Qué pasará si come datos?"
    },
    {
      "index": 23,
      "english": "Everything will go haywire!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 14107,
      "_bytes": 27,
      "translation": "¡Todo se volverá un caos!"
    },
    {
      "index": 24,
      "english": "What?!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 14135,
      "_bytes": 6,
      "translation": "¡¿Qué?!"
    },
    {
      "index": 25,
      "english": "Hey, can't we find a way to get\nrid of the jellyfish from inside\nthe Internet?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 14142,
      "_bytes": 78,
      "translation": "Oye, ¿no hay forma de\neliminar la medusa desde\ndentro de Internet?"
    },
    {
      "index": 26,
      "english": "We can't...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 14221,
      "_bytes": 11,
      "translation": "No podemos."
    },
    {
      "index": 27,
      "english": "I was emailing a friend in LA who \nsaid they were in contact with \nvarious organizations, but...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 14233,
      "_bytes": 96,
      "translation": "Le escribí a una amiga de LA\nque dijo que conocía a varias\norganizaciones, pero..."
    },
    {
      "index": 28,
      "english": "They couldn't get anyone to\nlisten...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 14330,
      "_bytes": 37,
      "translation": "Nadie quiso hacerle caso..."
    },
    {
      "index": 29,
      "english": "Ack! It evolved again!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 14368,
      "_bytes": 22,
      "translation": "¡Evolucionó de nuevo!"
    },
    {
      "index": 30,
      "english": "Now it's in its Child form.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 14391,
      "_bytes": 27,
      "translation": "Ahora es Novato."
    },
    {
      "index": 31,
      "english": "Uh-oh! Izzy!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 14419,
      "_bytes": 17,
      "translation": "¡Cuidado, Izzy!"
    },
    {
      "index": 32,
      "english": "We have to get rid of him somehow!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 14437,
      "_bytes": 34,
      "translation": "¡Hay que deshacerse de él como sea!"
    },
    {
      "index": 33,
      "english": "But how?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 14472,
      "_bytes": 8,
      "translation": "¿Cómo?"
    },
    {
      "index": 34,
      "english": "Well...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 14481,
      "_bytes": 7,
      "translation": "Pues..."
    },
    {
      "index": 35,
      "english": "Ugh... Times like this, I wish\nAgumon were here...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 14489,
      "_bytes": 50,
      "translation": "Uf... Ojalá Agumon\nestuviera aquí..."
    },
    {
      "index": 36,
      "english": "Tai!",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 14540,
      "_bytes": 7,
      "translation": "¡Tai!"
    },
    {
      "index": 37,
      "english": "Huh? Agumon?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 14548,
      "_bytes": 12,
      "translation": "¿Eh? ¿Agumon?"
    },
    {
      "index": 38,
      "english": "Tai!",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 14561,
      "_bytes": 7,
      "translation": "¡Tai!"
    },
    {
      "index": 39,
      "english": "Agumon! Agumon, it's you!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 14569,
      "_bytes": 25,
      "translation": "¡Agumon! Agumon, ¡eres tú!"
    },
    {
      "index": 40,
      "english": "Tai! We're receiving a\ntransmission from the Digital\nWorld!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 14595,
      "_bytes": 62,
      "translation": "¡Tai! ¡Recibimos una\ntransmisión del Digimundo!"
    },
    {
      "index": 41,
      "english": "Tai!",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 14658,
      "_bytes": 7,
      "translation": "¡Tai!"
    },
    {
      "index": 42,
      "english": "It's been a while.",
      "speaker_id": 5011,
      "line_type": 2,
      "_offset": 14666,
      "_bytes": 18,
      "translation": "Cuánto tiempo."
    },
    {
      "index": 43,
      "english": "Gennai!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 14685,
      "_bytes": 7,
      "translation": "¡Gennai!"
    },
    {
      "index": 44,
      "english": "How're you doin', Izzy?",
      "speaker_id": 2421,
      "line_type": 2,
      "_offset": 14693,
      "_bytes": 28,
      "translation": "¿Qué tal, Izzy?"
    },
    {
      "index": 45,
      "english": "Tentomon!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 14722,
      "_bytes": 9,
      "translation": "¡Tentomon!"
    },
    {
      "index": 46,
      "english": "Hey!",
      "speaker_id": 2321,
      "line_type": 2,
      "_offset": 14732,
      "_bytes": 4,
      "translation": "¡Eh!"
    },
    {
      "index": 47,
      "english": "Piyomon! Gabumon! Palmon! Hey,\neveryone's here!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 14737,
      "_bytes": 47,
      "translation": "¡Piyomon! ¡Gabumon! ¡Palmon!\n¡Estáis todos aquí!"
    },
    {
      "index": 48,
      "english": "So, I assume you already know\nabout it, right?",
      "speaker_id": 5011,
      "line_type": 2,
      "_offset": 14785,
      "_bytes": 46,
      "translation": "Supongo que ya lo sabíais,\n¿no?"
    },
    {
      "index": 49,
      "english": "There's a new Digimon on the\nInternet.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 14832,
      "_bytes": 38,
      "translation": "Hay un Digimon nuevo en\nInternet."
    },
    {
      "index": 50,
      "english": "See, I thought you would.",
      "speaker_id": 5011,
      "line_type": 2,
      "_offset": 14871,
      "_bytes": 25,
      "translation": "Ya me lo imaginaba."
    },
    {
      "index": 51,
      "english": "This isn't looking good, Tai!\nIt's a really dangerous Digimon!",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 14897,
      "_bytes": 65,
      "translation": "¡Esto pinta mal, Tai! ¡Es un\nDigimon muy peligroso!"
    },
    {
      "index": 52,
      "english": "Yeah! But how are we supposed to\ntake care of it?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 14963,
      "_bytes": 49,
      "translation": "Ya, ¿pero cómo se supone\nque lo paremos?"
    },
    {
      "index": 53,
      "english": "We'll fight, Tai!",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 15013,
      "_bytes": 20,
      "translation": "¡Lucharemos, Tai!"
    },
    {
      "index": 54,
      "english": "But...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15034,
      "_bytes": 6,
      "translation": "Pero..."
    },
    {
      "index": 55,
      "english": "We'll go into the Internet.",
      "speaker_id": 2221,
      "line_type": 2,
      "_offset": 15041,
      "_bytes": 27,
      "translation": "Entraremos en Internet."
    },
    {
      "index": 56,
      "english": "You're the ones who saved our\nworld...",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 15069,
      "_bytes": 38,
      "translation": "Vosotros salvasteis nuestro\nmundo..."
    },
    {
      "index": 57,
      "english": "so this time 'round, we'll be the\nones to save yours!",
      "speaker_id": 2421,
      "line_type": 2,
      "_offset": 15108,
      "_bytes": 53,
      "translation": "...¡así que esta vez os salvaremos\nnosotros a vosotros!"
    },
    {
      "index": 58,
      "english": "Tentomon!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 15162,
      "_bytes": 9,
      "translation": "¡Tentomon!"
    },
    {
      "index": 59,
      "english": "Okay, guys!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15172,
      "_bytes": 11,
      "translation": "¡Va, chicos!"
    },
    {
      "index": 60,
      "english": "We're counting on you. Got your\nDigivice, Izzy?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15184,
      "_bytes": 52,
      "translation": "Contamos con vosotros. ¿Tienes\ntu Digivice, Izzy?"
    },
    {
      "index": 61,
      "english": "Got your Digivice, Izzy?",
      "speaker_id": 8011,
      "line_type": 4,
      "_offset": 15237,
      "_bytes": 29,
      "translation": "¿Tienes tu dispositivo, Izzy?"
    },
    {
      "index": 62,
      "english": "Of course!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 15267,
      "_bytes": 10,
      "translation": "¡Claro!"
    },
    {
      "index": 63,
      "english": "Of course!",
      "speaker_id": 9901,
      "line_type": 2,
      "_offset": 15278,
      "_bytes": 10,
      "translation": "¡Claro!"
    },
    {
      "index": 64,
      "english": "Okay! We've got our Digivices, so\nyou'll be able to evolve!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15289,
      "_bytes": 59,
      "translation": "¡Vale! ¡Con los Digivices,\npodréis evolucionar!"
    },
    {
      "index": 65,
      "english": "Okay!",
      "speaker_id": 6061,
      "line_type": 2,
      "_offset": 15349,
      "_bytes": 5,
      "translation": "¡Vale!"
    },
    {
      "index": 66,
      "english": "I'll be sending the Digimon in, so\nhang tight.",
      "speaker_id": 5011,
      "line_type": 2,
      "_offset": 15355,
      "_bytes": 46,
      "translation": "Voy a mandaros a los Digimon,\naguantad ahí."
    },
    {
      "index": 67,
      "english": "I'll get in touch with the others!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15402,
      "_bytes": 34,
      "translation": "¡Voy a avisar a los demás!"
    },
    {
      "index": 68,
      "english": "None of them are home... Hey,\nIzzy, can you call Sora for\nme?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15437,
      "_bytes": 66,
      "translation": "Ninguno está en casa... Oye,\nIzzy, ¿llamas a Sora por mí?"
    },
    {
      "index": 69,
      "english": "Did something happen?",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 15504,
      "_bytes": 21,
      "translation": "¿Pasó algo?"
    },
    {
      "index": 70,
      "english": "Nothing in particular, just...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15526,
      "_bytes": 30,
      "translation": "Nada en especial, solo..."
    },
    {
      "index": 71,
      "english": "Did you two just happen to get in\na fight?",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 15557,
      "_bytes": 42,
      "translation": "Os habéis peleado los dos,\n¿o qué?"
    },
    {
      "index": 72,
      "english": "It wasn't a fight! Anyway, isn't\nit time?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15600,
      "_bytes": 41,
      "translation": "¡No fue una pelea! ¿No es ya\nla hora?"
    },
    {
      "index": 73,
      "english": "Transmission complete!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 15642,
      "_bytes": 22,
      "translation": "¡Transmisión completa!"
    },
    {
      "index": 74,
      "english": "Tai! Izzy! We'll be there\nsoon!",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 15665,
      "_bytes": 39,
      "translation": "¡Tai! ¡Izzy! ¡Enseguida\nllegamos!"
    },
    {
      "index": 75,
      "english": "Tai! Izzy! We'll be there\nsoon!",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 15705,
      "_bytes": 39,
      "translation": "¡Tai! ¡Izzy! ¡Enseguida\nllegamos!"
    },
    {
      "index": 76,
      "english": "We're counting on you, Agumon!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15745,
      "_bytes": 30,
      "translation": "¡Contamos contigo, Agumon!"
    },
    {
      "index": 77,
      "english": "It hasn't noticed us yet! Let's\nlaunch a surprise attack!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 15776,
      "_bytes": 57,
      "translation": "¡Aún no nos ha visto! ¡Vamos a\nsorprenderlo!"
    },
    {
      "index": 78,
      "english": "Right-o! I'm goin' in!",
      "speaker_id": 2421,
      "line_type": 2,
      "_offset": 15834,
      "_bytes": 22,
      "translation": "¡Vale! ¡Voy para dentro!"
    },
    {
      "index": 79,
      "english": "Why's there Digimon all over?",
      "speaker_id": 2421,
      "line_type": 2,
      "_offset": 15857,
      "_bytes": 29,
      "translation": "¿Por qué hay tantos Digimon?"
    },
    {
      "index": 80,
      "english": "The mysterious Digimon may have\ncaused them to appear...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 15887,
      "_bytes": 56,
      "translation": "El Digimon misterioso puede\nhaberlos hecho aparecer..."
    },
    {
      "index": 81,
      "english": "It must have copied data from the\nDigital World.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 15944,
      "_bytes": 48,
      "translation": "Debe de haber copiado datos\ndel Digimundo."
    },
    {
      "index": 82,
      "english": "Well, we'll just have to clear\nthem out!",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 15993,
      "_bytes": 40,
      "translation": "¡Bueno, tendremos que\nlimpiarlos!"
    },
    {
      "index": 83,
      "english": "Okay, do it!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16034,
      "_bytes": 12,
      "translation": "¡Vale, hazlo!"
    },
    {
      "index": 84,
      "english": "Now's the time!",
      "speaker_id": 2421,
      "line_type": 2,
      "_offset": 16047,
      "_bytes": 15,
      "translation": "¡Es la hora!"
    },
    {
      "index": 85,
      "english": "It's a Child, so you guys should\nevolve to Adult!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16063,
      "_bytes": 49,
      "translation": "¡Es Novato, evolucionad\na Campeón!"
    },
    {
      "index": 86,
      "english": "Okay!",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 16113,
      "_bytes": 5,
      "translation": "¡Vale!"
    },
    {
      "index": 87,
      "english": "Roger!",
      "speaker_id": 2421,
      "line_type": 2,
      "_offset": 16119,
      "_bytes": 6,
      "translation": "¡Vale!"
    },
    {
      "index": 88,
      "english": "Get him!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16126,
      "_bytes": 8,
      "translation": "¡A por él!"
    },
    {
      "index": 89,
      "english": "Ha! Piece of cake!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16135,
      "_bytes": 18,
      "translation": "¡Ja! ¡Pan comido!"
    },
    {
      "index": 90,
      "english": "Wait a minute!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 16154,
      "_bytes": 14,
      "translation": "¡Un momento!"
    },
    {
      "index": 91,
      "english": "Did he just evolve again?!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16169,
      "_bytes": 26,
      "translation": "¡¿Evolucionó otra vez?!"
    },
    {
      "index": 92,
      "english": "We'll still be okay... it's an\nAdult, just like them.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 16196,
      "_bytes": 53,
      "translation": "Aún estamos bien... es Campeón,\ncomo ellos."
    },
    {
      "index": 93,
      "english": "Somethin's up! What are we gonna\ndo?",
      "speaker_id": 2431,
      "line_type": 2,
      "_offset": 16250,
      "_bytes": 36,
      "translation": "¡Algo pasa! ¿Qué hacemos\nahora?"
    },
    {
      "index": 94,
      "english": "Kabuterimon! Aaaaagh!",
      "speaker_id": 2131,
      "line_type": 2,
      "_offset": 16287,
      "_bytes": 21,
      "translation": "¡Kabuterimon! ¡Aaaaagh!"
    },
    {
      "index": 95,
      "english": "Greymon!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16309,
      "_bytes": 8,
      "translation": "¡Greymon!"
    },
    {
      "index": 96,
      "english": "Tai! I just realized! It's\nactually a Perfect-level Digimon!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 16318,
      "_bytes": 63,
      "translation": "¡Tai! ¡Me acabo de dar cuenta!\n¡Es un Digimon Cuerpo Perfecto!"
    },
    {
      "index": 97,
      "english": "So that means...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16382,
      "_bytes": 16,
      "translation": "Eso significa..."
    },
    {
      "index": 98,
      "english": "It evolved twice back then!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 16399,
      "_bytes": 27,
      "translation": "¡Evolucionó dos veces ya!"
    },
    {
      "index": 99,
      "english": "That's not good... okay, we'll\nhave to evolve them to Perfect\ntoo!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16427,
      "_bytes": 66,
      "translation": "¡Mal asunto! Tendrán que\nevolucionar a Cuerpo Perfecto."
    },
    {
      "index": 100,
      "english": "Aaaaaagh!",
      "speaker_id": 2141,
      "line_type": 2,
      "_offset": 16494,
      "_bytes": 9,
      "translation": "¡Aaaaaagh!"
    },
    {
      "index": 101,
      "english": "Ack!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16504,
      "_bytes": 4,
      "translation": "¡Ay!"
    },
    {
      "index": 102,
      "english": "Did it just attack them while they\nwere evolving?",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 16509,
      "_bytes": 49,
      "translation": "¿Los atacó mientras\nevolucionaban?"
    },
    {
      "index": 103,
      "english": "Are you okay, Agumon?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16559,
      "_bytes": 21,
      "translation": "¿Estás bien, Agumon?"
    },
    {
      "index": 104,
      "english": "Sorry... Tai...",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 16581,
      "_bytes": 18,
      "translation": "Perdona... Tai..."
    },
    {
      "index": 105,
      "english": "Tentomon...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 16600,
      "_bytes": 11,
      "translation": "Tentomon..."
    },
    {
      "index": 106,
      "english": "That guy's out of our league...",
      "speaker_id": 2421,
      "line_type": 2,
      "_offset": 16612,
      "_bytes": 31,
      "translation": "Ese tío nos queda grande..."
    },
    {
      "index": 107,
      "english": "You two need to rest for a bit.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 16644,
      "_bytes": 31,
      "translation": "Descansad los dos un poco."
    },
    {
      "index": 108,
      "english": "But then... where are they gonna\nhide...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16676,
      "_bytes": 40,
      "translation": "Pero entonces... ¿dónde se\nesconderán...?"
    },
    {
      "index": 109,
      "english": "It's been a while since we've\nfought beside them.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 16717,
      "_bytes": 49,
      "translation": "Hacía tiempo que no\nluchábamos junto a ellos."
    },
    {
      "index": 110,
      "english": "And what about that?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16767,
      "_bytes": 20,
      "translation": "¿Y qué hay de eso?"
    },
    {
      "index": 111,
      "english": "It might take a while for them to\nevolve to Perfect again.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 16788,
      "_bytes": 58,
      "translation": "Puede que tarden en volver\na ser Cuerpo Perfecto."
    },
    {
      "index": 112,
      "english": "We'll just have to stick to Adult\nfor now. Let's do it!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16847,
      "_bytes": 55,
      "translation": "De momento nos quedamos en\nCampeón. ¡Vamos allá!"
    }
  ]
}