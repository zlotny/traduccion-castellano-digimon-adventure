{
  "file_id": "3588",
  "text_count": 129,
  "dialog": [
    {
      "index": 0,
      "english": "��������Ugh! How cheap! You can't just\nattack them while they're\nevolving!",
      "_offset": 6801,
      "_length": 74,
      "speaker_id": 5,
      "translation": "Serás rastrero! No podéis\natacarnos mientras evolucionamos!"
    },
    {
      "index": 1,
      "english": "Tai! We've got an email from\nSingapore!",
      "_offset": 6876,
      "_length": 42,
      "speaker_id": 1,
      "translation": "Tai! Nos ha llegado un email\nde Singapur!"
    },
    {
      "index": 2,
      "english": "\"Two on one, and you still lost?\nWeaklings.\"",
      "_offset": 6919,
      "_length": 44,
      "speaker_id": 3,
      "translation": "\"Dos contra uno y perdisteis?\nDebiluchos.\""
    },
    {
      "index": 3,
      "english": "Oh, shut up.",
      "_offset": 6964,
      "_length": 12,
      "speaker_id": 2,
      "translation": "Ah, cállate."
    },
    {
      "index": 4,
      "english": "We have another email from\nInfermon!",
      "_offset": 6977,
      "_length": 36,
      "speaker_id": 4,
      "translation": "Otro email de Infermon!"
    },
    {
      "index": 5,
      "english": "What? \"hellohellohello\"? The heck\nis that?",
      "_offset": 7014,
      "_length": 42,
      "speaker_id": 1,
      "translation": "Qué? \"holaholahola\"? Y esto\nqué es?"
    },
    {
      "index": 6,
      "english": "The source email address is...",
      "_offset": 7057,
      "_length": 30,
      "speaker_id": 2,
      "translation": "La dirección de origen es..."
    },
    {
      "index": 7,
      "english": "This is bad! It's in the telephone\nlines! We have to contact\neveryone!",
      "_offset": 7088,
      "_length": 70,
      "speaker_id": 2,
      "translation": "Esto es grave! Está en las\nlíneas telefónicas! Hay que\navisar a todos!"
    },
    {
      "index": 8,
      "english": "Hah! Well, as long as we know\nwhere he is, that's good enough!",
      "_offset": 7159,
      "_length": 62,
      "speaker_id": 9,
      "translation": "Ja! Bueno, con saber dónde\nestá ya nos vale!"
    },
    {
      "index": 9,
      "english": "Okay! All we gotta do is get\neveryone together, and it'll be an\neasy win for us!",
      "_offset": 7222,
      "_length": 80,
      "speaker_id": 2,
      "translation": "Vale! Solo hay que reunir a\ntodos y la victoria será\npan comido!"
    },
    {
      "index": 10,
      "english": "Kari! I know you're at a\nbirthday party, but you need to\nget home as soon as possible!",
      "_offset": 7303,
      "_length": 88,
      "speaker_id": 11,
      "translation": "Kari! Sé que estás en un\ncumpleaños, pero tienes que\nvolver a casa cuanto antes!"
    },
    {
      "index": 11,
      "english": "Ugh! I can't get to Joe or Matt\nor Mimi, they're all on the phone\nwith someone else...",
      "_offset": 7392,
      "_length": 88,
      "speaker_id": 8,
      "translation": "Uf! No consigo hablar con\nJoe, Matt ni Mimi, están todos\nal teléfono con alguien más..."
    },
    {
      "index": 12,
      "english": "Hello? Yagami residence.",
      "_offset": 7481,
      "_length": 24,
      "speaker_id": 1,
      "translation": "Diga? Casa Yagami."
    },
    {
      "index": 13,
      "english": "HELLOHELLOHELLO...",
      "_offset": 7506,
      "_length": 18,
      "speaker_id": 2,
      "translation": "HOLAHOLAHOLA..."
    },
    {
      "index": 14,
      "english": "Is this a prank call? The heck is\nthis?",
      "_offset": 7525,
      "_length": 39,
      "speaker_id": 1,
      "translation": "Es una broma? Qué es esto?"
    },
    {
      "index": 15,
      "english": "Didn't I tell you he was clogging\nup the telephone lines?",
      "_offset": 7565,
      "_length": 57,
      "speaker_id": 3,
      "translation": "No te dije que estaba\nsaturando las líneas?"
    },
    {
      "index": 16,
      "english": "So what's that supposed to mean?",
      "_offset": 7623,
      "_length": 32,
      "speaker_id": 2,
      "translation": "Y eso qué significa?"
    },
    {
      "index": 17,
      "english": "Infermon's snuck into the\nswitchboards and punctured the\ncircuits!",
      "_offset": 7656,
      "_length": 66,
      "speaker_id": 2,
      "translation": "Infermon se coló en las\ncentralitas y reventó los\ncircuitos!"
    },
    {
      "index": 18,
      "english": "That's bad! We can't call anyone,\nand we're totally cut off from\nthem!",
      "_offset": 7723,
      "_length": 70,
      "speaker_id": 1,
      "translation": "Qué mal! No podemos llamar\na nadie, estamos totalmente\nincomunicados!"
    },
    {
      "index": 19,
      "english": "And it's not just the phone lines!\nThe Internet... ah!",
      "_offset": 7794,
      "_length": 54,
      "speaker_id": 4,
      "translation": "Y no son solo las líneas!\nInternet... ah!"
    },
    {
      "index": 20,
      "english": "What's wrong?",
      "_offset": 7849,
      "_length": 13,
      "speaker_id": 1,
      "translation": "Qué pasa?"
    },
    {
      "index": 21,
      "english": "I got cut off from the Internet.",
      "_offset": 7863,
      "_length": 32,
      "speaker_id": 5,
      "translation": "Se me ha cortado Internet."
    },
    {
      "index": 22,
      "english": "What?!",
      "_offset": 7896,
      "_length": 6,
      "speaker_id": 1,
      "translation": "Qué?!"
    },
    {
      "index": 23,
      "english": "That's it! Let me get back to my\nhouse for a bit...",
      "_offset": 7903,
      "_length": 51,
      "speaker_id": 2,
      "translation": "Ya está! Voy a pasar por mi\ncasa un momento..."
    },
    {
      "index": 24,
      "english": "Hey, Mom... It's all over...",
      "_offset": 7955,
      "_length": 28,
      "speaker_id": 64,
      "translation": "Oye, mamá... Se acabó..."
    },
    {
      "index": 25,
      "english": "What's over?",
      "_offset": 7984,
      "_length": 12,
      "speaker_id": 131,
      "translation": "Qué acabó?"
    },
    {
      "index": 26,
      "english": "The phone lines... can't\nconnect...",
      "_offset": 7997,
      "_length": 35,
      "speaker_id": 174,
      "translation": "Las líneas... no conectan..."
    },
    {
      "index": 27,
      "english": "Really?",
      "_offset": 8033,
      "_length": 7,
      "speaker_id": 219,
      "translation": "Ah, sí?"
    },
    {
      "index": 28,
      "english": "Hey, Tai. Maybe it's because of\nthis?",
      "_offset": 8041,
      "_length": 40,
      "speaker_id": 232,
      "translation": "Oye, Tai. Será por esto?"
    },
    {
      "index": 29,
      "english": "What...?",
      "_offset": 8082,
      "_length": 8,
      "speaker_id": 13,
      "translation": "Qué...?"
    },
    {
      "index": 30,
      "english": "Look at the news! Phone lines are\nbeing disconnected all over the\nmetropolitan area...",
      "_offset": 8091,
      "_length": 86,
      "speaker_id": 56,
      "translation": "Mira las noticias! Se están\ncortando las líneas por toda\nel área metropolitana..."
    },
    {
      "index": 31,
      "english": "I know... I know why, too...",
      "_offset": 8178,
      "_length": 28,
      "speaker_id": 87,
      "translation": "Lo sé... Y sé por qué..."
    },
    {
      "index": 32,
      "english": "Really? Well, it says to dial 117\nin case of emergency.",
      "_offset": 8207,
      "_length": 55,
      "speaker_id": 158,
      "translation": "Ah sí? Pues dice que\nmarques el 117 en emergencias."
    },
    {
      "index": 33,
      "english": "Isn't it supposed to be 171?\n...Hey, wait!",
      "_offset": 8263,
      "_length": 42,
      "speaker_id": 221,
      "translation": "No era el 171? ...Eh, espera!"
    },
    {
      "index": 34,
      "english": "Okay, got Matt, got Sora. Next\nis... Mimi!",
      "_offset": 8306,
      "_length": 44,
      "speaker_id": 46,
      "translation": "Bien, Matt y Sora listos.\nAhora... Mimi!"
    },
    {
      "index": 35,
      "english": "Oh, by the way, Mimi's in Hawaii.",
      "_offset": 8351,
      "_length": 33,
      "speaker_id": 135,
      "translation": "Por cierto, Mimi está\nen Hawái."
    },
    {
      "index": 36,
      "english": "H-Hawaii?!",
      "_offset": 8385,
      "_length": 10,
      "speaker_id": 224,
      "translation": "Ha-Hawái?!"
    },
    {
      "index": 37,
      "english": "She sent a postcard! See?",
      "_offset": 8396,
      "_length": 25,
      "speaker_id": 249,
      "translation": "Mandó una postal! Mira!"
    },
    {
      "index": 38,
      "english": "No reply... Tai, you idiot.",
      "_offset": 8422,
      "_length": 30,
      "speaker_id": 12,
      "translation": "No contesta... Idiota,\nTai."
    },
    {
      "index": 39,
      "english": "It's not working... Nobody's\nresponding...",
      "_offset": 8453,
      "_length": 42,
      "speaker_id": 52,
      "translation": "No funciona... Nadie\ncontesta..."
    },
    {
      "index": 40,
      "english": "It's kind of hard to get us all\ntogether at once, isn't it...",
      "_offset": 8496,
      "_length": 61,
      "speaker_id": 110,
      "translation": "Cuesta bastante reunirnos a\ntodos de golpe, eh..."
    },
    {
      "index": 41,
      "english": "So, what were you up to?",
      "_offset": 8558,
      "_length": 24,
      "speaker_id": 143,
      "translation": "Bueno, y tú qué hacías?"
    },
    {
      "index": 42,
      "english": "So, what were you up to?",
      "_offset": 8583,
      "_length": 24,
      "speaker_id": 210,
      "translation": "Bueno, y tú qué hacías?"
    },
    {
      "index": 43,
      "english": "I got a satellite mobile phone.",
      "_offset": 8608,
      "_length": 31,
      "speaker_id": 25,
      "translation": "Tengo un móvil por satélite."
    },
    {
      "index": 44,
      "english": "Satellite?",
      "_offset": 8640,
      "_length": 10,
      "speaker_id": 80,
      "translation": "Satélite?"
    },
    {
      "index": 45,
      "english": "Rather than using switchboards, we\ncan connect directly to foreign\naccess points.",
      "_offset": 8651,
      "_length": 81,
      "speaker_id": 94,
      "translation": "En vez de usar centralitas,\nconectamos directo a puntos\nde acceso extranjeros."
    },
    {
      "index": 46,
      "english": "we can connect directly to foreign\naccess points.",
      "_offset": 8733,
      "_length": 49,
      "speaker_id": 127,
      "translation": "conectamos a puntos de\nacceso extranjeros."
    },
    {
      "index": 47,
      "english": "Then why don't we use that to get\nin touch with Matt and the\nothers?",
      "_offset": 8783,
      "_length": 70,
      "speaker_id": 134,
      "translation": "Y por qué no lo usamos para\ncontactar con Matt y los\ndemás?"
    },
    {
      "index": 48,
      "english": "That won't work. Domestic calls\nstill have to use the\nswitchboards.",
      "_offset": 8854,
      "_length": 67,
      "speaker_id": 186,
      "translation": "No sirve. Las llamadas\nnacionales siguen usando\ncentralitas."
    },
    {
      "index": 49,
      "english": "Man...",
      "_offset": 8922,
      "_length": 6,
      "speaker_id": 215,
      "translation": "Vaya."
    },
    {
      "index": 50,
      "english": "By the way, did you get any\nresponse via the 171 system?",
      "_offset": 8929,
      "_length": 56,
      "speaker_id": 228,
      "translation": "Por cierto, contestó alguien\npor el sistema del 171?"
    },
    {
      "index": 51,
      "english": "Oh! I forgot!",
      "_offset": 8986,
      "_length": 13,
      "speaker_id": 8,
      "translation": "Me olvidé!"
    },
    {
      "index": 52,
      "english": "Oh! I forgot!",
      "_offset": 9000,
      "_length": 13,
      "speaker_id": 16,
      "translation": "Me olvidé!"
    },
    {
      "index": 53,
      "english": "Hello, this is Matt... I have no\nidea why you're calling all of a\nsudden.",
      "_offset": 9014,
      "_length": 75,
      "speaker_id": 57,
      "translation": "Diga, soy Matt... No tengo\nni idea de por qué llamáis\nde repente."
    },
    {
      "index": 54,
      "english": "We did it!",
      "_offset": 9090,
      "_length": 10,
      "speaker_id": 66,
      "translation": "Contacto!"
    },
    {
      "index": 55,
      "english": "Good ol' Matt!",
      "_offset": 9101,
      "_length": 16,
      "speaker_id": 153,
      "translation": "Ese es mi Matt!"
    },
    {
      "index": 56,
      "english": "Do you two have your Digivices?",
      "_offset": 9118,
      "_length": 31,
      "speaker_id": 182,
      "translation": "Tenéis los Digivices\nlos dos?"
    },
    {
      "index": 57,
      "english": "Of course we do!",
      "_offset": 9150,
      "_length": 16,
      "speaker_id": 238,
      "translation": "Claro que sí!"
    },
    {
      "index": 58,
      "english": "Hey, what's going on?",
      "_offset": 9167,
      "_length": 21,
      "speaker_id": 25,
      "translation": "Eh, qué está pasando?"
    },
    {
      "index": 59,
      "english": "Please get to a computer as soon\nas you can. There's a new Digimon\non the Internet.",
      "_offset": 9189,
      "_length": 83,
      "speaker_id": 70,
      "translation": "Buscad un ordenador cuanto\nantes. Hay un Digimon nuevo\nen Internet."
    },
    {
      "index": 60,
      "english": "It's time for us to fight!",
      "_offset": 9273,
      "_length": 26,
      "speaker_id": 104,
      "translation": "Es hora de luchar!"
    },
    {
      "index": 61,
      "english": "We have our Digivices, but...\nGrandma's place doesn't have a\ncomputer.",
      "_offset": 9300,
      "_length": 70,
      "speaker_id": 115,
      "translation": "Tenemos los Digivices, pero...\nen casa de la abuela no hay\nordenador."
    },
    {
      "index": 62,
      "english": "What?!",
      "_offset": 9371,
      "_length": 6,
      "speaker_id": 141,
      "translation": "Qué?!"
    },
    {
      "index": 63,
      "english": "We're in Shimane, so there aren't\nany...",
      "_offset": 9378,
      "_length": 40,
      "speaker_id": 172,
      "translation": "Estamos en Shimane, no hay\nninguno aquí."
    },
    {
      "index": 64,
      "english": "We're done for. We're totally done\nfor.",
      "_offset": 9419,
      "_length": 39,
      "speaker_id": 215,
      "translation": "Estamos perdidos. Totalmente\nperdidos."
    },
    {
      "index": 65,
      "english": "Please, do whatever you can to\nfind a computer!",
      "_offset": 9459,
      "_length": 47,
      "speaker_id": 21,
      "translation": "Por favor, buscad como sea\nun ordenador!"
    },
    {
      "index": 66,
      "english": "There's got to be at least one\ncomputer in all of Shimane!",
      "_offset": 9507,
      "_length": 58,
      "speaker_id": 46,
      "translation": "Tiene que haber al menos un\nordenador en toda Shimane!"
    },
    {
      "index": 67,
      "english": "Okay! We're on!",
      "_offset": 9566,
      "_length": 15,
      "speaker_id": 71,
      "translation": "Vale! Ya está!"
    },
    {
      "index": 68,
      "english": "Thank you, satellite cell phone!",
      "_offset": 9582,
      "_length": 32,
      "speaker_id": 103,
      "translation": "Gracias, móvil por satélite!"
    },
    {
      "index": 69,
      "english": "Huh? He's gone... Did he leave the\nphone lines?",
      "_offset": 9615,
      "_length": 47,
      "speaker_id": 114,
      "translation": "Eh? Desapareció... Habrá\nsalido de las líneas?"
    },
    {
      "index": 70,
      "english": "H-Hey...",
      "_offset": 9663,
      "_length": 8,
      "speaker_id": 196,
      "translation": "E-Eh..."
    },
    {
      "index": 71,
      "english": "There he is! He's in... America!",
      "_offset": 9672,
      "_length": 32,
      "speaker_id": 246,
      "translation": "Ahí está! Está en... América!"
    },
    {
      "index": 72,
      "english": "Isn't there anyone out there who\ncan stop him?",
      "_offset": 9705,
      "_length": 46,
      "speaker_id": 61,
      "translation": "No hay nadie ahí fuera que\npueda detenerlo?"
    },
    {
      "index": 73,
      "english": "This obviously isn't just a\ncomputer bug anymore. I'm sure\nsome adults have realized this.",
      "_offset": 9752,
      "_length": 90,
      "speaker_id": 129,
      "translation": "Esto ya no es un simple fallo\ninformático. Seguro que algún\nadulto se ha dado cuenta."
    },
    {
      "index": 74,
      "english": "But I doubt there is anyone who\nrealizes that this is a Digimon.",
      "_offset": 9843,
      "_length": 64,
      "speaker_id": 136,
      "translation": "Pero dudo que alguien sepa\nque esto es un Digimon."
    },
    {
      "index": 75,
      "english": "So then what are we gonna do?",
      "_offset": 9908,
      "_length": 29,
      "speaker_id": 193,
      "translation": "Entonces qué hacemos?"
    },
    {
      "index": 76,
      "english": "The only thing we can do is make\nour Digimon fight them again...",
      "_offset": 9938,
      "_length": 64,
      "speaker_id": 207,
      "translation": "Solo podemos hacer que\nnuestros Digimon luchen de\nnuevo..."
    },
    {
      "index": 77,
      "english": "That's easier said than done...",
      "_offset": 10003,
      "_length": 31,
      "speaker_id": 221,
      "translation": "Eso es fácil de decir..."
    },
    {
      "index": 78,
      "english": "Matt!",
      "_offset": 10035,
      "_length": 7,
      "speaker_id": 41,
      "translation": "Matt!"
    },
    {
      "index": 79,
      "english": "Sorry to keep you waiting!",
      "_offset": 10043,
      "_length": 26,
      "speaker_id": 52,
      "translation": "Siento la espera!"
    },
    {
      "index": 80,
      "english": "You found a computer!",
      "_offset": 10070,
      "_length": 21,
      "speaker_id": 69,
      "translation": "Hallaste ordenador!"
    },
    {
      "index": 81,
      "english": "Tai, I'll be taking your oolong\ntea.",
      "_offset": 10092,
      "_length": 39,
      "speaker_id": 101,
      "translation": "Tai, me tomo tu té oolong."
    },
    {
      "index": 82,
      "english": "Hey, haven't you been drinking too\nmuch of that stuff?",
      "_offset": 10132,
      "_length": 54,
      "speaker_id": 118,
      "translation": "Oye, no has bebido ya\ndemasiado de eso?"
    },
    {
      "index": 83,
      "english": "The others are still out of the\npicture, eh?",
      "_offset": 10187,
      "_length": 44,
      "speaker_id": 140,
      "translation": "Los demás siguen sin\naparecer, eh?"
    },
    {
      "index": 84,
      "english": "We'll just have to fight by\nourselves for now!",
      "_offset": 10232,
      "_length": 46,
      "speaker_id": 224,
      "translation": "Por ahora tendremos que\nluchar nosotros solos!"
    },
    {
      "index": 85,
      "english": "Agumon! Tentomon!",
      "_offset": 10279,
      "_length": 17,
      "speaker_id": 251,
      "translation": "Agumon! Tentomon!"
    },
    {
      "index": 86,
      "english": "Hm?",
      "_offset": 10297,
      "_length": 3,
      "speaker_id": 66,
      "translation": "Mm?"
    },
    {
      "index": 87,
      "english": "It's Gabumon and Patamon!",
      "_offset": 10301,
      "_length": 25,
      "speaker_id": 73,
      "translation": "Son Gabumon y Patamon!"
    },
    {
      "index": 88,
      "english": "We're here!",
      "_offset": 10327,
      "_length": 11,
      "speaker_id": 114,
      "translation": "Llegamos!"
    },
    {
      "index": 89,
      "english": "Sorry we're late!",
      "_offset": 10339,
      "_length": 17,
      "speaker_id": 154,
      "translation": "Perdón, tarde!"
    },
    {
      "index": 90,
      "english": "We're counting on you, Gabumon!",
      "_offset": 10357,
      "_length": 31,
      "speaker_id": 202,
      "translation": "Confiamos en ti, Gabumon!"
    },
    {
      "index": 91,
      "english": "You can do it, Patamon!",
      "_offset": 10389,
      "_length": 23,
      "speaker_id": 5,
      "translation": "Tú puedes, Patamon!"
    },
    {
      "index": 92,
      "english": "I'll lead you there!",
      "_offset": 10413,
      "_length": 20,
      "speaker_id": 21,
      "translation": "Yo os guío!"
    },
    {
      "index": 93,
      "english": "Okay!",
      "_offset": 10434,
      "_length": 5,
      "speaker_id": 54,
      "translation": "Vale!"
    },
    {
      "index": 94,
      "english": "We'll beat him up for real this\ntime!",
      "_offset": 10440,
      "_length": 37,
      "speaker_id": 102,
      "translation": "Esta vez le vamos a dar de\nverdad!"
    },
    {
      "index": 95,
      "english": "Another email from Infermon! It\nreads: \"THIS-A-WAY\"...",
      "_offset": 10478,
      "_length": 54,
      "speaker_id": 111,
      "translation": "Otro email de Infermon! Pone:\n\"POR-AQUÍ\"..."
    },
    {
      "index": 96,
      "english": "He's toying with us!",
      "_offset": 10533,
      "_length": 20,
      "speaker_id": 144,
      "translation": "Se ríe de nosotros!"
    },
    {
