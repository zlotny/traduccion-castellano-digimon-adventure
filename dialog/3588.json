{
  "file_id": "3588",
  "format": "etdf",
  "kind": "ETDF",
  "text_count": 129,
  "dialog": [
    {
      "index": 0,
      "english": "Ugh! How cheap! You can't just\nattack them while they're\nevolving!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16216,
      "_bytes": 66,
      "translation": "¡Serás rastrero! ¡No puedes\natacarlos mientras evolucionan!"
    },
    {
      "index": 1,
      "english": "Tai! We've got an email from\nSingapore!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 16283,
      "_bytes": 42,
      "translation": "¡Tai! ¡Nos ha llegado un email\nde Singapur!"
    },
    {
      "index": 2,
      "english": "\"Two on one, and you still lost?\nWeaklings.\"",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 16326,
      "_bytes": 44,
      "translation": "\"¿Dos contra uno y perdisteis?\nDebiluchos.\""
    },
    {
      "index": 3,
      "english": "Oh, shut up.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16371,
      "_bytes": 12,
      "translation": "Ah, cállate."
    },
    {
      "index": 4,
      "english": "We have another email from\nInfermon!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 16384,
      "_bytes": 36,
      "translation": "¡Otro email de Infermon!"
    },
    {
      "index": 5,
      "english": "What? \"hellohellohello\"? The heck\nis that?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16421,
      "_bytes": 42,
      "translation": "¿Qué? ¿\"holaholahola\"? ¿Y esto\nqué es?"
    },
    {
      "index": 6,
      "english": "The source email address is...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 16464,
      "_bytes": 30,
      "translation": "La dirección de origen es..."
    },
    {
      "index": 7,
      "english": "This is bad! It's in the telephone\nlines! We have to contact\neveryone!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 16495,
      "_bytes": 70,
      "translation": "¡Esto es grave! ¡Está en las\nlíneas telefónicas! ¡Hay que\navisar a todos!"
    },
    {
      "index": 8,
      "english": "Hah! Well, as long as we know\nwhere he is, that's good enough!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16566,
      "_bytes": 62,
      "translation": "¡Ja! ¡Bueno, con saber dónde\nestá ya nos vale!"
    },
    {
      "index": 9,
      "english": "Okay! All we gotta do is get\neveryone together, and it'll be an\neasy win for us!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16629,
      "_bytes": 80,
      "translation": "¡Vale! ¡Solo hay que reunir a\ntodos y la victoria será\npan comido!"
    },
    {
      "index": 10,
      "english": "Kari! I know you're at a\nbirthday party, but you need to\nget home as soon as possible!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16710,
      "_bytes": 88,
      "translation": "¡Kari! ¡Sé que estás en un\ncumpleaños, pero tienes que\nvolver a casa cuanto antes!"
    },
    {
      "index": 11,
      "english": "Ugh! I can't get to Joe or Matt\nor Mimi, they're all on the phone\nwith someone else...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16799,
      "_bytes": 88,
      "translation": "¡Uf! No consigo hablar con\nJoe, Matt ni Mimi, están todos\nal teléfono con alguien más..."
    },
    {
      "index": 12,
      "english": "Hello? Yagami residence.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16888,
      "_bytes": 24,
      "translation": "¿Diga? Casa Yagami."
    },
    {
      "index": 13,
      "english": "HELLOHELLOHELLO...",
      "speaker_id": 9002,
      "line_type": 2,
      "_offset": 16913,
      "_bytes": 18,
      "translation": "HOLAHOLAHOLA..."
    },
    {
      "index": 14,
      "english": "Is this a prank call? The heck is\nthis?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16932,
      "_bytes": 39,
      "translation": "¿Es una broma? ¿Qué es esto?"
    },
    {
      "index": 15,
      "english": "Didn't I tell you he was clogging\nup the telephone lines?",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 16972,
      "_bytes": 57,
      "translation": "¿No te dije que estaba\nsaturando las líneas?"
    },
    {
      "index": 16,
      "english": "So what's that supposed to mean?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17030,
      "_bytes": 32,
      "translation": "¿Y eso qué significa?"
    },
    {
      "index": 17,
      "english": "Infermon's snuck into the\nswitchboards and punctured the\ncircuits!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 17063,
      "_bytes": 66,
      "translation": "¡Infermon se coló en las\ncentralitas y reventó los\ncircuitos!"
    },
    {
      "index": 18,
      "english": "That's bad! We can't call anyone,\nand we're totally cut off from\nthem!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17130,
      "_bytes": 70,
      "translation": "¡Qué mal! ¡No podemos llamar\na nadie, estamos totalmente\nincomunicados!"
    },
    {
      "index": 19,
      "english": "And it's not just the phone lines!\nThe Internet... ah!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 17201,
      "_bytes": 54,
      "translation": "¡Y no son solo las líneas!\n¡Internet... ah!"
    },
    {
      "index": 20,
      "english": "What's wrong?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17256,
      "_bytes": 13,
      "translation": "¿Qué pasa?"
    },
    {
      "index": 21,
      "english": "I got cut off from the Internet.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 17270,
      "_bytes": 32,
      "translation": "Se me ha cortado Internet."
    },
    {
      "index": 22,
      "english": "What?!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17303,
      "_bytes": 6,
      "translation": "¡¿Qué?!"
    },
    {
      "index": 23,
      "english": "That's it! Let me get back to my\nhouse for a bit...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 17310,
      "_bytes": 51,
      "translation": "¡Ya está! Voy a pasar por mi\ncasa un momento..."
    },
    {
      "index": 24,
      "english": "Hey, Mom... It's all over...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17362,
      "_bytes": 28,
      "translation": "Oye, mamá... Se acabó..."
    },
    {
      "index": 25,
      "english": "What's over?",
      "speaker_id": 6101,
      "line_type": 2,
      "_offset": 17391,
      "_bytes": 12,
      "translation": "¿Qué acabó?"
    },
    {
      "index": 26,
      "english": "The phone lines... can't\nconnect...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17404,
      "_bytes": 35,
      "translation": "Las líneas... no conectan..."
    },
    {
      "index": 27,
      "english": "Really?",
      "speaker_id": 6101,
      "line_type": 2,
      "_offset": 17440,
      "_bytes": 7,
      "translation": "Ah, ¿sí?"
    },
    {
      "index": 28,
      "english": "Hey, Tai. Maybe it's because of\nthis?",
      "speaker_id": 6101,
      "line_type": 2,
      "_offset": 17448,
      "_bytes": 40,
      "translation": "Oye, Tai. ¿Será por esto?"
    },
    {
      "index": 29,
      "english": "What...?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17489,
      "_bytes": 8,
      "translation": "¿Qué...?"
    },
    {
      "index": 30,
      "english": "Look at the news! Phone lines are\nbeing disconnected all over the\nmetropolitan area...",
      "speaker_id": 6101,
      "line_type": 2,
      "_offset": 17498,
      "_bytes": 86,
      "translation": "¡Mira las noticias! Se están\ncortando las líneas por toda\nel área metropolitana..."
    },
    {
      "index": 31,
      "english": "I know... I know why, too...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17585,
      "_bytes": 28,
      "translation": "Lo sé... Y sé por qué..."
    },
    {
      "index": 32,
      "english": "Really? Well, it says to dial 117\nin case of emergency.",
      "speaker_id": 6101,
      "line_type": 2,
      "_offset": 17614,
      "_bytes": 55,
      "translation": "Ah, ¿sí? Pues dice que\nmarques el 117 en emergencias."
    },
    {
      "index": 33,
      "english": "Isn't it supposed to be 171?\n...Hey, wait!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17670,
      "_bytes": 42,
      "translation": "¿No era el 171? ...¡Eh, espera!"
    },
    {
      "index": 34,
      "english": "Okay, got Matt, got Sora. Next\nis... Mimi!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17713,
      "_bytes": 44,
      "translation": "Bien, Matt y Sora listos.\nAhora... ¡Mimi!"
    },
    {
      "index": 35,
      "english": "Oh, by the way, Mimi's in Hawaii.",
      "speaker_id": 6101,
      "line_type": 2,
      "_offset": 17758,
      "_bytes": 33,
      "translation": "Por cierto, Mimi está en Hawái."
    },
    {
      "index": 36,
      "english": "H-Hawaii?!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17792,
      "_bytes": 10,
      "translation": "¡¿Ha-Hawái?!"
    },
    {
      "index": 37,
      "english": "She sent a postcard! See?",
      "speaker_id": 6101,
      "line_type": 2,
      "_offset": 17803,
      "_bytes": 25,
      "translation": "¡Mandó una postal! ¡Mira!"
    },
    {
      "index": 38,
      "english": "No reply... Tai, you idiot.",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 17829,
      "_bytes": 30,
      "translation": "No contesta... Idiota, Tai."
    },
    {
      "index": 39,
      "english": "It's not working... Nobody's\nresponding...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17860,
      "_bytes": 42,
      "translation": "No funciona... Nadie\ncontesta..."
    },
    {
      "index": 40,
      "english": "It's kind of hard to get us all\ntogether at once, isn't it...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 17903,
      "_bytes": 61,
      "translation": "Cuesta bastante reunirnos a\ntodos de golpe, eh..."
    },
    {
      "index": 41,
      "english": "So, what were you up to?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17965,
      "_bytes": 24,
      "translation": "Bueno, ¿y tú qué hacías?"
    },
    {
      "index": 42,
      "english": "So, what were you up to?",
      "speaker_id": 8051,
      "line_type": 4,
      "_offset": 17990,
      "_bytes": 24,
      "translation": "Bueno, ¿y tú qué hacías?"
    },
    {
      "index": 43,
      "english": "I got a satellite mobile phone.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 18015,
      "_bytes": 31,
      "translation": "Tengo un móvil por satélite."
    },
    {
      "index": 44,
      "english": "Satellite?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 18047,
      "_bytes": 10,
      "translation": "¿Satélite?"
    },
    {
      "index": 45,
      "english": "Rather than using switchboards, we\ncan connect directly to foreign\naccess points.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 18058,
      "_bytes": 81,
      "translation": "En vez de usar centralitas,\nconectamos directo a puntos\nde acceso extranjeros."
    },
    {
      "index": 46,
      "english": "we can connect directly to foreign\naccess points.",
      "speaker_id": 9901,
      "line_type": 2,
      "_offset": 18140,
      "_bytes": 49,
      "translation": "conectamos a puntos de\nacceso extranjeros."
    },
    {
      "index": 47,
      "english": "Then why don't we use that to get\nin touch with Matt and the\nothers?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 18190,
      "_bytes": 70,
      "translation": "¿Y por qué no lo usamos para\ncontactar con Matt y los\ndemás?"
    },
    {
      "index": 48,
      "english": "That won't work. Domestic calls\nstill have to use the\nswitchboards.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 18261,
      "_bytes": 67,
      "translation": "No sirve. Las llamadas\nnacionales siguen usando\ncentralitas."
    },
    {
      "index": 49,
      "english": "Man...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 18329,
      "_bytes": 6,
      "translation": "Vaya."
    },
    {
      "index": 50,
      "english": "By the way, did you get any\nresponse via the 171 system?",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 18336,
      "_bytes": 56,
      "translation": "Por cierto, ¿contestó alguien\npor el sistema del 171?"
    },
    {
      "index": 51,
      "english": "Oh! I forgot!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 18393,
      "_bytes": 13,
      "translation": "¡Me olvidé!"
    },
    {
      "index": 52,
      "english": "Oh! I forgot!",
      "speaker_id": 1071,
      "line_type": 4,
      "_offset": 18407,
      "_bytes": 13,
      "translation": "¡Me olvidé!"
    },
    {
      "index": 53,
      "english": "Hello, this is Matt... I have no\nidea why you're calling all of a\nsudden.",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 18421,
      "_bytes": 75,
      "translation": "Diga, soy Matt... No tengo\nni idea de por qué llamáis\nde repente."
    },
    {
      "index": 54,
      "english": "We did it!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 18497,
      "_bytes": 10,
      "translation": "¡Contacto!"
    },
    {
      "index": 55,
      "english": "Good ol' Matt!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 18508,
      "_bytes": 16,
      "translation": "¡Ese es mi Matt!"
    },
    {
      "index": 56,
      "english": "Do you two have your Digivices?",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 18525,
      "_bytes": 31,
      "translation": "¿Tenéis los Digivices los dos?"
    },
    {
      "index": 57,
      "english": "Of course we do!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 18557,
      "_bytes": 16,
      "translation": "¡Claro que sí!"
    },
    {
      "index": 58,
      "english": "Hey, what's going on?",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 18574,
      "_bytes": 21,
      "translation": "Eh, ¿qué está pasando?"
    },
    {
      "index": 59,
      "english": "Please get to a computer as soon\nas you can. There's a new Digimon\non the Internet.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 18596,
      "_bytes": 83,
      "translation": "Buscad un ordenador cuanto\nantes. Hay un Digimon nuevo\nen Internet."
    },
    {
      "index": 60,
      "english": "It's time for us to fight!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 18680,
      "_bytes": 26,
      "translation": "¡Es hora de luchar!"
    },
    {
      "index": 61,
      "english": "We have our Digivices, but...\nGrandma's place doesn't have a\ncomputer.",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 18707,
      "_bytes": 70,
      "translation": "Tenemos los Digivices, pero...\nen casa de la abuela no hay\nordenador."
    },
    {
      "index": 62,
      "english": "What?!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 18778,
      "_bytes": 6,
      "translation": "¡¿Qué?!"
    },
    {
      "index": 63,
      "english": "We're in Shimane, so there aren't\nany...",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 18785,
      "_bytes": 40,
      "translation": "Estamos en Shimane, no hay\nninguno aquí."
    },
    {
      "index": 64,
      "english": "We're done for. We're totally done\nfor.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 18826,
      "_bytes": 39,
      "translation": "Estamos perdidos. Totalmente\nperdidos."
    },
    {
      "index": 65,
      "english": "Please, do whatever you can to\nfind a computer!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 18866,
      "_bytes": 47,
      "translation": "¡Por favor, buscad como sea\nun ordenador!"
    },
    {
      "index": 66,
      "english": "There's got to be at least one\ncomputer in all of Shimane!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 18914,
      "_bytes": 58,
      "translation": "¡Tiene que haber al menos un\nordenador en toda Shimane!"
    },
    {
      "index": 67,
      "english": "Okay! We're on!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 18973,
      "_bytes": 15,
      "translation": "¡Vale! ¡Ya está!"
    },
    {
      "index": 68,
      "english": "Thank you, satellite cell phone!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 18989,
      "_bytes": 32,
      "translation": "¡Gracias, móvil por satélite!"
    },
    {
      "index": 69,
      "english": "Huh? He's gone... Did he leave the\nphone lines?",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 19022,
      "_bytes": 47,
      "translation": "¿Eh? Desapareció... ¿Habrá\nsalido de las líneas?"
    },
    {
      "index": 70,
      "english": "H-Hey...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 19070,
      "_bytes": 8,
      "translation": "E-Eh..."
    },
    {
      "index": 71,
      "english": "There he is! He's in... America!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 19079,
      "_bytes": 32,
      "translation": "¡Ahí está! Está en... ¡América!"
    },
    {
      "index": 72,
      "english": "Isn't there anyone out there who\ncan stop him?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 19112,
      "_bytes": 46,
      "translation": "¿No hay nadie ahí fuera que\npueda detenerlo?"
    },
    {
      "index": 73,
      "english": "This obviously isn't just a\ncomputer bug anymore. I'm sure\nsome adults have realized this.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 19159,
      "_bytes": 90,
      "translation": "Esto ya no es un simple fallo\ninformático. Seguro que algún\nadulto se ha dado cuenta."
    },
    {
      "index": 74,
      "english": "But I doubt there is anyone who\nrealizes that this is a Digimon.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 19250,
      "_bytes": 64,
      "translation": "Pero dudo que alguien sepa\nque esto es un Digimon."
    },
    {
      "index": 75,
      "english": "So then what are we gonna do?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 19315,
      "_bytes": 29,
      "translation": "¿Entonces qué hacemos?"
    },
    {
      "index": 76,
      "english": "The only thing we can do is make\nour Digimon fight them again...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 19345,
      "_bytes": 64,
      "translation": "Solo podemos hacer que\nnuestros Digimon luchen de\nnuevo..."
    },
    {
      "index": 77,
      "english": "That's easier said than done...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 19410,
      "_bytes": 31,
      "translation": "Eso es fácil de decir..."
    },
    {
      "index": 78,
      "english": "Matt!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 19442,
      "_bytes": 7,
      "translation": "¡Matt!"
    },
    {
      "index": 79,
      "english": "Sorry to keep you waiting!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 19450,
      "_bytes": 26,
      "translation": "¡Siento la espera!"
    },
    {
      "index": 80,
      "english": "You found a computer!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 19477,
      "_bytes": 21,
      "translation": "¡Encontraste uno!"
    },
    {
      "index": 81,
      "english": "Tai, I'll be taking your oolong\ntea.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 19499,
      "_bytes": 39,
      "translation": "Tai, me tomo tu té oolong."
    },
    {
      "index": 82,
      "english": "Hey, haven't you been drinking too\nmuch of that stuff?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 19539,
      "_bytes": 54,
      "translation": "Oye, ¿no has bebido ya\ndemasiado de eso?"
    },
    {
      "index": 83,
      "english": "The others are still out of the\npicture, eh?",
      "speaker_id": 2421,
      "line_type": 2,
      "_offset": 19594,
      "_bytes": 44,
      "translation": "Los demás siguen sin\naparecer, ¿eh?"
    },
    {
      "index": 84,
      "english": "We'll just have to fight by\nourselves for now!",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 19639,
      "_bytes": 46,
      "translation": "¡Por ahora tendremos que\nluchar nosotros solos!"
    },
    {
      "index": 85,
      "english": "Agumon! Tentomon!",
      "speaker_id": 2221,
      "line_type": 2,
      "_offset": 19686,
      "_bytes": 17,
      "translation": "¡Agumon! ¡Tentomon!"
    },
    {
      "index": 86,
      "english": "Hm?",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 19704,
      "_bytes": 3,
      "translation": "¿Mm?"
    },
    {
      "index": 87,
      "english": "It's Gabumon and Patamon!",
      "speaker_id": 2421,
      "line_type": 2,
      "_offset": 19708,
      "_bytes": 25,
      "translation": "¡Son Gabumon y Patamon!"
    },
    {
      "index": 88,
      "english": "We're here!",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 19734,
      "_bytes": 11,
      "translation": "¡Llegamos!"
    },
    {
      "index": 89,
      "english": "Sorry we're late!",
      "speaker_id": 2221,
      "line_type": 2,
      "_offset": 19746,
      "_bytes": 17,
      "translation": "¡Perdón por el retraso!"
    },
    {
      "index": 90,
      "english": "We're counting on you, Gabumon!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 19764,
      "_bytes": 31,
      "translation": "¡Confiamos en ti, Gabumon!"
    },
    {
      "index": 91,
      "english": "You can do it, Patamon!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 19796,
      "_bytes": 23,
      "translation": "¡Tú puedes, Patamon!"
    },
    {
      "index": 92,
      "english": "I'll lead you there!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 19820,
      "_bytes": 20,
      "translation": "¡Yo os guío!"
    },
    {
      "index": 93,
      "english": "Okay!",
      "speaker_id": 9001,
      "line_type": 2,
      "_offset": 19841,
      "_bytes": 5,
      "translation": "¡Vale!"
    },
    {
      "index": 94,
      "english": "We'll beat him up for real this\ntime!",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 19847,
      "_bytes": 37,
      "translation": "¡Esta vez le vamos a dar de\nverdad!"
    },
    {
      "index": 95,
      "english": "Another email from Infermon! It\nreads: \"THIS-A-WAY\"...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 19885,
      "_bytes": 54,
      "translation": "¡Otro email de Infermon! Pone:\n\"POR-AQUÍ\"..."
    },
    {
      "index": 96,
      "english": "He's toying with us!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 19940,
      "_bytes": 20,
      "translation": "¡Se ríe de nosotros!"
    },
    {
      "index": 97,
      "english": "Let's get him, Matt!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 19961,
      "_bytes": 22,
      "translation": "¡Vamos a por él, Matt!"
    },
    {
      "index": 98,
      "english": "Go straight to Ultimate!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 19984,
      "_bytes": 24,
      "translation": "¡Ve directo a Cuerpo Supremo!"
    },
    {
      "index": 99,
      "english": "We'll back you up!",
      "speaker_id": 2421,
      "line_type": 2,
      "_offset": 20009,
      "_bytes": 18,
      "translation": "¡Te apoyamos!"
    },
    {
      "index": 100,
      "english": "We'll always be there to help!",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 20028,
      "_bytes": 30,
      "translation": "¡Siempre estaremos para ayudar!"
    },
    {
      "index": 101,
      "english": "You evolve too, Patamon!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 20059,
      "_bytes": 24,
      "translation": "¡Evoluciona tú también, Patamon!"
    },
    {
      "index": 102,
      "english": "Okay!",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 20084,
      "_bytes": 5,
      "translation": "¡Vale!"
    },
    {
      "index": 103,
      "english": "It evolved!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 20090,
      "_bytes": 11,
      "translation": "¡Evolucionó!"
    },
    {
      "index": 104,
      "english": "It's so fast...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 20102,
      "_bytes": 15,
      "translation": "Qué rápido..."
    },
    {
      "index": 105,
      "english": "Patamon!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 20118,
      "_bytes": 8,
      "translation": "¡Patamon!"
    },
    {
      "index": 106,
      "english": "Patamon! Aaaaaah!",
      "speaker_id": 2421,
      "line_type": 2,
      "_offset": 20127,
      "_bytes": 17,
      "translation": "¡Patamon! ¡Aaaaaah!"
    },
    {
      "index": 107,
      "english": "Patamon? Are you okay?",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 20145,
      "_bytes": 22,
      "translation": "¿Patamon? ¿Estás bien?"
    },
    {
      "index": 108,
      "english": "Tentomon!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 20168,
      "_bytes": 9,
      "translation": "¡Tentomon!"
    },
    {
      "index": 109,
      "english": "Don't worry 'bout me! What 'bout\nPatamon?",
      "speaker_id": 2421,
      "line_type": 2,
      "_offset": 20178,
      "_bytes": 41,
      "translation": "¡No te preocupes por mí! ¿Y\nPatamon qué?"
    },
    {
      "index": 110,
      "english": "Patamon! I'm coming, Patamon!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 20220,
      "_bytes": 29,
      "translation": "¡Patamon! ¡Ya voy, Patamon!"
    },
    {
      "index": 111,
      "english": "Look what you did to Patamon!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 20250,
      "_bytes": 29,
      "translation": "¡Mira cómo dejaste a Patamon!"
    },
    {
      "index": 112,
      "english": "We'll get you for that!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 20280,
      "_bytes": 23,
      "translation": "¡Nos las vas a pagar!"
    },
    {
      "index": 113,
      "english": "Tentomon! Take care of Patamon!\nWarGreymon, after it!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 20304,
      "_bytes": 53,
      "translation": "¡Tentomon! ¡Cuida de Patamon!\nWarGreymon, ¡a por él!"
    },
    {
      "index": 114,
      "english": "T-Tai...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 20358,
      "_bytes": 11,
      "translation": "T-Tai..."
    },
    {
      "index": 115,
      "english": "Go! Beat it up cold!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 20370,
      "_bytes": 20,
      "translation": "¡Vamos! ¡Sin piedad!"
    },
    {
      "index": 116,
      "english": "Tai!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 20391,
      "_bytes": 7,
      "translation": "¡Tai!"
    },
    {
      "index": 117,
      "english": "What?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 20399,
      "_bytes": 5,
      "translation": "¿Qué?"
    },
    {
      "index": 118,
      "english": "I can't...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 20405,
      "_bytes": 10,
      "translation": "No puedo..."
    },
    {
      "index": 119,
      "english": "Can't what?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 20416,
      "_bytes": 11,
      "translation": "¿Qué cosa?"
    },
    {
      "index": 120,
      "english": "I have to... use the bathroom!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 20428,
      "_bytes": 30,
      "translation": "¡Tengo que... ir al baño!"
    },
    {
      "index": 121,
      "english": "Now's not the time for that!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 20459,
      "_bytes": 28,
      "translation": "¡Ahora no toca eso!"
    },
    {
      "index": 122,
      "english": "All right, take this!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 20488,
      "_bytes": 21,
      "translation": "¡Muy bien, toma esto!"
    },
    {
      "index": 123,
      "english": "Come on! Come on, come on...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 20510,
      "_bytes": 28,
      "translation": "¡Vamos! Vamos, vamos..."
    },
    {
      "index": 124,
      "english": "No!... Ack!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 20539,
      "_bytes": 11,
      "translation": "¡No!... ¡Aj!"
    },
    {
      "index": 125,
      "english": "Tai! What happened? WarGreymon\nstopped moving!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 20551,
      "_bytes": 49,
      "translation": "¡Tai! ¿Qué ha pasado?\n¡WarGreymon dejó de moverse!"
    },
    {
      "index": 126,
      "english": "Did it freeze?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 20601,
      "_bytes": 14,
      "translation": "¿Se ha colgado?"
    },
    {
      "index": 127,
      "english": "Tai, they should be able to\nevolve to Ultimate now.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 20616,
      "_bytes": 54,
      "translation": "Tai, ya deberían poder\nevolucionar a Cuerpo Supremo."
    },
    {
      "index": 128,
      "english": "Okay! We'll go all-out!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 20671,
      "_bytes": 23,
      "translation": "¡Vale! ¡A por todas!"
    }
  ]
}