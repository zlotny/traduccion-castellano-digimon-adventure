{
  "file_id": "3589",
  "format": "etdf",
  "kind": "ETDF",
  "text_count": 107,
  "dialog": [
    {
      "index": 0,
      "english": "Tai! What happened? WarGreymon\nstopped moving!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 14680,
      "_bytes": 49,
      "translation": "¡Tai! ¿Qué ha pasado?\n¡WarGreymon dejó de moverse!"
    },
    {
      "index": 1,
      "english": "Huh? What?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 14730,
      "_bytes": 10,
      "translation": "¿Eh? ¿Qué?"
    },
    {
      "index": 2,
      "english": "Sorry about that...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 14741,
      "_bytes": 19,
      "translation": "Perdón por eso..."
    },
    {
      "index": 3,
      "english": "Izzy, the computer's not\nworking.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 14761,
      "_bytes": 38,
      "translation": "Izzy, el ordenador no\nfunciona."
    },
    {
      "index": 4,
      "english": "What happened?!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 14800,
      "_bytes": 15,
      "translation": "¡¿Qué ha pasado?!"
    },
    {
      "index": 5,
      "english": "I didn't do anything? Why'd you\nhave to go to the bathroom at the\nmost important time?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 14816,
      "_bytes": 86,
      "translation": "¡Yo no hice nada! ¿Por qué\ntuviste que ir al baño\njusto en el momento clave?"
    },
    {
      "index": 6,
      "english": "It's not working... What did you\ndo? Why did you make it freeze?",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 14903,
      "_bytes": 64,
      "translation": "No funciona... ¿Qué hiciste?\n¿Por qué se ha colgado?"
    },
    {
      "index": 7,
      "english": "It wasn't on purpose!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 14968,
      "_bytes": 21,
      "translation": "¡No fue a propósito!"
    },
    {
      "index": 8,
      "english": "See, this is why you get into\nfights with Sora!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 14990,
      "_bytes": 47,
      "translation": "¡Por eso es por lo que te\npeleas con Sora!"
    },
    {
      "index": 9,
      "english": "I... I didn't... I just wanted to\nget her a present...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15038,
      "_bytes": 54,
      "translation": "Yo... yo no... solo quería\nregalarle algo..."
    },
    {
      "index": 10,
      "english": "A present?",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 15093,
      "_bytes": 10,
      "translation": "¿Un regalo?"
    },
    {
      "index": 11,
      "english": "Her birthday was coming up, so I\ngot her a hairpin, but...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15104,
      "_bytes": 58,
      "translation": "Se acercaba su cumple y le\ncompré una horquilla, pero..."
    },
    {
      "index": 12,
      "english": "She started saying stuff like \"Oh,\nso you don't think this hat looks\ngood on me?\"...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15163,
      "_bytes": 84,
      "translation": "Y empezó con que \"Ah, ¿o sea\nque esta gorra no me\nqueda bien?\"..."
    },
    {
      "index": 13,
      "english": "So that was it?",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 15248,
      "_bytes": 15,
      "translation": "¿Era por eso?"
    },
    {
      "index": 14,
      "english": "But I apologized, you know!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15264,
      "_bytes": 27,
      "translation": "¡Pero si ya me disculpé!"
    },
    {
      "index": 15,
      "english": "It's back!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 15292,
      "_bytes": 10,
      "translation": "¡Ha vuelto!"
    },
    {
      "index": 16,
      "english": "Aaaaaah... WarGreymon!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15303,
      "_bytes": 22,
      "translation": "Aaaaaah... ¡WarGreymon!"
    },
    {
      "index": 17,
      "english": "Tai! Izzy! You idiots!\nWhat were you up to?",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 15326,
      "_bytes": 51,
      "translation": "¡Tai! ¡Izzy! ¡Seréis idiotas!\n¿Qué estabais haciendo?"
    },
    {
      "index": 18,
      "english": "WarGreymon! WarGreymon!\nWarGreymooooooon!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15378,
      "_bytes": 41,
      "translation": "¡WarGreymon! ¡WarGreymon!\n¡WarGreymooooooon!"
    },
    {
      "index": 19,
      "english": "T-Tai...",
      "speaker_id": 2151,
      "line_type": 2,
      "_offset": 15420,
      "_bytes": 11,
      "translation": "T-Tai..."
    },
    {
      "index": 20,
      "english": "If I could be there... If I could\nbe right next to you...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15432,
      "_bytes": 57,
      "translation": "Si pudiera estar allí... Si\npudiera estar a tu lado..."
    },
    {
      "index": 21,
      "english": "\"You lost again?\"",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 15490,
      "_bytes": 17,
      "translation": "\"¿Otra derrota?\""
    },
    {
      "index": 22,
      "english": "What?!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15508,
      "_bytes": 6,
      "translation": "¡¿Qué?!"
    },
    {
      "index": 23,
      "english": "That was from Canberra...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 15515,
      "_bytes": 25,
      "translation": "Ese era de Canberra..."
    },
    {
      "index": 24,
      "english": "\"You were almost there, too. What\nthe heck?\"",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 15541,
      "_bytes": 44,
      "translation": "\"Tú también estabas cerca.\n¿Qué te pasó?\""
    },
    {
      "index": 25,
      "english": "This one's from Berlin...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 15586,
      "_bytes": 25,
      "translation": "Este es de Berlín..."
    },
    {
      "index": 26,
      "english": "Put a lid on it!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15612,
      "_bytes": 16,
      "translation": "¡Cállate ya!"
    },
    {
      "index": 27,
      "english": "I'm just reading all the emails!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 15629,
      "_bytes": 32,
      "translation": "¡Solo estoy leyendo los emails!"
    },
    {
      "index": 28,
      "english": "Why, you, Izzy...!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15662,
      "_bytes": 23,
      "translation": "¡Serás, Izzy...!"
    },
    {
      "index": 29,
      "english": "Hey, stop it! Right now's not the\ntime to be fighting!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 15686,
      "_bytes": 54,
      "translation": "¡Eh, parad ya! ¡Ahora no es\nmomento de pelearos!"
    },
    {
      "index": 30,
      "english": "Hmph! Stupid emails...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15741,
      "_bytes": 22,
      "translation": "Bah, estos emails..."
    },
    {
      "index": 31,
      "english": "We've received another email from\nDiablomon!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 15764,
      "_bytes": 44,
      "translation": "¡Nos ha llegado otro email de\nDiaboromon!"
    },
    {
      "index": 32,
      "english": "\"WHO'S GOT THE CLOCK?\" ...That's\nall it says.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 15809,
      "_bytes": 45,
      "translation": "\"¿QUIÉN TIENE EL RELOJ?\"\nY no dice nada más."
    },
    {
      "index": 33,
      "english": "The clock?",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 15855,
      "_bytes": 10,
      "translation": "¿El reloj?"
    },
    {
      "index": 34,
      "english": "It's copying itself!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 15866,
      "_bytes": 20,
      "translation": "¡Se copia a sí mismo!"
    },
    {
      "index": 35,
      "english": "What's that number?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15887,
      "_bytes": 19,
      "translation": "¿Qué número es ese?"
    },
    {
      "index": 36,
      "english": "What are we going to do?!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 15907,
      "_bytes": 25,
      "translation": "¡¿Qué vamos a hacer?!"
    },
    {
      "index": 37,
      "english": "Huh?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15933,
      "_bytes": 4,
      "translation": "¿Eh?"
    },
    {
      "index": 38,
      "english": "I received an email from a\nTaiwanese middle school student...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 15938,
      "_bytes": 61,
      "translation": "Me llegó un email de un\nestudiante de secundaria de\nTaiwán..."
    },
    {
      "index": 39,
      "english": "Thirty minutes ago, an American\nmilitary base fired a missile.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 16000,
      "_bytes": 62,
      "translation": "Hace treinta minutos, una\nbase militar americana lanzó un\nmisil."
    },
    {
      "index": 40,
      "english": "What?!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16063,
      "_bytes": 6,
      "translation": "¡¿Qué?!"
    },
    {
      "index": 41,
      "english": "They said it's a bug in the launch\ncontrol computer, but...I'm sure\nit's because of this!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 16070,
      "_bytes": 89,
      "translation": "¡Dicen que fue un fallo del\nordenador de lanzamiento,\npero seguro que es por esto!"
    },
    {
      "index": 42,
      "english": "So then, this number would be...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16160,
      "_bytes": 32,
      "translation": "Entonces este número sería..."
    },
    {
      "index": 43,
      "english": "Probably when the missile will hit\nits destination...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 16193,
      "_bytes": 53,
      "translation": "Probablemente cuándo\nimpactará el misil..."
    },
    {
      "index": 44,
      "english": "No way...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16247,
      "_bytes": 9,
      "translation": "No puede ser..."
    },
    {
      "index": 45,
      "english": "Only one missile was fired. Its\nname is Peace Keeper.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 16257,
      "_bytes": 53,
      "translation": "Solo se lanzó un misil. Se\nllama Peace Keeper."
    },
    {
      "index": 46,
      "english": "But nobody knows where it's\nheaded, so it could be going\nanywhere...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 16311,
      "_bytes": 68,
      "translation": "Pero nadie sabe hacia dónde\nva, podría caer en\ncualquier sitio..."
    },
    {
      "index": 47,
      "english": "And in nine minutes, it's going to\nexplode somewhere in the world...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 16380,
      "_bytes": 68,
      "translation": "Y en nueve minutos va a\nexplotar en algún lugar del\nmundo..."
    },
    {
      "index": 48,
      "english": "How are we going to defeat all of\nthem?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16449,
      "_bytes": 39,
      "translation": "¿Cómo vamos a vencerlos a\ntodos?"
    },
    {
      "index": 49,
      "english": "Nuclear missiles don't explode if\nthe fuse in them fails to\nactivate...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 16489,
      "_bytes": 71,
      "translation": "Los misiles nucleares no\nexplotan si el detonador no\nse activa..."
    },
    {
      "index": 50,
      "english": "If it's trying to play a game with\nus, only one of them will have the\nclock.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 16561,
      "_bytes": 76,
      "translation": "Si quiere jugar con\nnosotros, solo uno de ellos\ntendrá el reloj."
    },
    {
      "index": 51,
      "english": "And if we defeat that one, then we\ncan stop it...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 16638,
      "_bytes": 49,
      "translation": "Y si derrotamos a ese,\npodremos detenerlo..."
    },
    {
      "index": 52,
      "english": "How are we gonna find that one,\nthen?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16688,
      "_bytes": 37,
      "translation": "¿Y cómo encontramos a ese?"
    },
    {
      "index": 53,
      "english": "We'll just have to take them out,\none at a time...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 16726,
      "_bytes": 50,
      "translation": "Tendremos que ir\neliminándolos uno a uno..."
    },
    {
      "index": 54,
      "english": "That's gonna take way too long!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16777,
      "_bytes": 31,
      "translation": "¡Eso va a tardar demasiado!"
    },
    {
      "index": 55,
      "english": "But there's no other way...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 16809,
      "_bytes": 27,
      "translation": "Pero no hay otra forma..."
    },
    {
      "index": 56,
      "english": "Tai... Tai... Tai!",
      "speaker_id": 2151,
      "line_type": 2,
      "_offset": 16837,
      "_bytes": 27,
      "translation": "Tai... Tai... ¡Tai!"
    },
    {
      "index": 57,
      "english": "Ah!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16865,
      "_bytes": 3,
      "translation": "¡Ah!"
    },
    {
      "index": 58,
      "english": "Tai! Get yourself together,\nTai! Leave it to me...",
      "speaker_id": 2151,
      "line_type": 2,
      "_offset": 16869,
      "_bytes": 56,
      "translation": "¡Tai! ¡Reacciona, Tai! Déjamelo\na mí..."
    },
    {
      "index": 59,
      "english": "WarGreymon...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16926,
      "_bytes": 13,
      "translation": "WarGreymon..."
    },
    {
      "index": 60,
      "english": "Do you know where it is?",
      "speaker_id": 2251,
      "line_type": 2,
      "_offset": 16940,
      "_bytes": 24,
      "translation": "¿Sabes dónde está?"
    },
    {
      "index": 61,
      "english": "MetalGarurumon...",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 16965,
      "_bytes": 17,
      "translation": "MetalGarurumon..."
    },
    {
      "index": 62,
      "english": "I'll send you the address now!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 16983,
      "_bytes": 30,
      "translation": "¡Te mando la dirección ahora!"
    },
    {
      "index": 63,
      "english": "Please!",
      "speaker_id": 2151,
      "line_type": 2,
      "_offset": 17014,
      "_bytes": 7,
      "translation": "¡Por favor!"
    },
    {
      "index": 64,
      "english": "Yeah... It's our only choice...\nI'm sorry...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17022,
      "_bytes": 44,
      "translation": "Sí... Es nuestra única\nopción. Lo siento..."
    },
    {
      "index": 65,
      "english": "No, don't...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 17067,
      "_bytes": 12,
      "translation": "No lo hagas..."
    },
    {
      "index": 66,
      "english": "We're getting so many emails...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 17080,
      "_bytes": 31,
      "translation": "Nos llegan muchísimos emails..."
    },
    {
      "index": 67,
      "english": "\"You can do it, WarGreymon!\"\nThat's from Costa Rica...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 17112,
      "_bytes": 54,
      "translation": "\"¡Tú puedes, WarGreymon!\" Ese\nes de Costa Rica..."
    },
    {
      "index": 68,
      "english": "From the Philippines, \"You gotta\nwin, MetalGarurumon!\"",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 17167,
      "_bytes": 54,
      "translation": "Desde Filipinas, \"¡Tienes que\nganar, MetalGarurumon!\""
    },
    {
      "index": 69,
      "english": "They're coming in like a flood.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 17222,
      "_bytes": 31,
      "translation": "Llegan a raudales."
    },
    {
      "index": 70,
      "english": "We can't give up... until the\nend...",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 17254,
      "_bytes": 36,
      "translation": "No podemos rendirnos\nhasta el final."
    },
    {
      "index": 71,
      "english": "There's no way we can give up...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17291,
      "_bytes": 32,
      "translation": "No vamos a rendirnos..."
    },
    {
      "index": 72,
      "english": "How many of them are there?!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 17324,
      "_bytes": 28,
      "translation": "¡¿Cuántos hay?!"
    },
    {
      "index": 73,
      "english": "Eight thousand... no, sixteen\nthousand... It keeps copying\nitself!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 17353,
      "_bytes": 66,
      "translation": "Ocho mil... no, dieciséis\nmil... ¡Sigue copiándose!"
    },
    {
      "index": 74,
      "english": "Aaaaaah!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 17420,
      "_bytes": 8,
      "translation": "¡Aaaaaah!"
    },
    {
      "index": 75,
      "english": "WarGreymon...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17429,
      "_bytes": 13,
      "translation": "WarGreymon..."
    },
    {
      "index": 76,
      "english": "Something's wrong with the way\nWarGreymon and MetalGarurumon are\nmoving!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 17443,
      "_bytes": 72,
      "translation": "¡Algo va mal con los\nmovimientos de WarGreymon y\nMetalGarurumon!"
    },
    {
      "index": 77,
      "english": "It's because of all the emails\ncoming from all over the world!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 17516,
      "_bytes": 62,
      "translation": "¡Es por todos los emails que\nllegan de todo el mundo!"
    },
    {
      "index": 78,
      "english": "The sheer amount of emails is\ntaking up processing speed!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 17579,
      "_bytes": 57,
      "translation": "¡Tantos emails están\nconsumiendo velocidad de\nproceso!"
    },
    {
      "index": 79,
      "english": "To everyone around the world,\nWarGreymon and MetalGarurumon's\nresponse time is too low!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 17637,
      "_bytes": 87,
      "translation": "A todo el mundo: ¡el tiempo\nde respuesta de WarGreymon y\nMetalGarurumon es muy bajo!"
    },
    {
      "index": 80,
      "english": "Please! Stop sending us emails!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 17725,
      "_bytes": 31,
      "translation": "¡Por favor! ¡Dejad de escribir!"
    },
    {
      "index": 81,
      "english": "Ah...",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 17757,
      "_bytes": 5,
      "translation": "Ah..."
    },
    {
      "index": 82,
      "english": "WarGreymon...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17763,
      "_bytes": 13,
      "translation": "WarGreymon..."
    },
    {
      "index": 83,
      "english": "Do you want more tea, Izzy?",
      "speaker_id": 6101,
      "line_type": 2,
      "_offset": 17777,
      "_bytes": 32,
      "translation": "¿Quieres más té, Izzy?"
    },
    {
      "index": 84,
      "english": "Ah, sorry. I'll leave you alone...",
      "speaker_id": 6101,
      "line_type": 2,
      "_offset": 17810,
      "_bytes": 34,
      "translation": "Ah, perdón. Te dejo tranquilo..."
    },
    {
      "index": 85,
      "english": "It's no use. The emails keep\ncoming in. We only have five\nminutes left, what are we to do?",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 17845,
      "_bytes": 90,
      "translation": "Es inútil. Siguen llegando\nemails. Solo quedan cinco\nminutos, ¿qué hacemos?"
    },
    {
      "index": 86,
      "english": "WarGreymon...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17936,
      "_bytes": 13,
      "translation": "WarGreymon..."
    },
    {
      "index": 87,
      "english": "MetalGarurumon... It's me,\nMatt... Open your eyes...",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 17950,
      "_bytes": 54,
      "translation": "MetalGarurumon... Soy yo,\nMatt... Abre los ojos..."
    },
    {
      "index": 88,
      "english": "I'm here! I'm here, too!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 18005,
      "_bytes": 24,
      "translation": "¡Estoy aquí! ¡Yo también!"
    },
    {
      "index": 89,
      "english": "I want to fight with you... I\nwon't let you fight alone...I'm\nhere...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 18030,
      "_bytes": 69,
      "translation": "Quiero luchar contigo... No\nte dejaré luchar solo...\nEstoy aquí..."
    },
    {
      "index": 90,
      "english": "MetalGarurumon... let's fight\ntogether!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 18100,
      "_bytes": 39,
      "translation": "MetalGarurumon... ¡luchemos\njuntos!"
    },
    {
      "index": 91,
      "english": "WarGreymon and...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 18140,
      "_bytes": 17,
      "translation": "WarGreymon y..."
    },
    {
      "index": 92,
      "english": "MetalGarurumon...",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 18158,
      "_bytes": 17,
      "translation": "MetalGarurumon..."
    },
    {
      "index": 93,
      "english": "Combined...",
      "speaker_id": 9001,
      "line_type": 2,
      "_offset": 18176,
      "_bytes": 11,
      "translation": "Fusión..."
    },
    {
      "index": 94,
      "english": "There! There's the last one! That\none has the clock!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 18188,
      "_bytes": 52,
      "translation": "¡Ahí! ¡Ese es el último!\n¡Ese tiene el reloj!"
    },
    {
      "index": 95,
      "english": "Matt! Hurry up and find it! We\ndon't have time! Hurry!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 18241,
      "_bytes": 56,
      "translation": "¡Matt! ¡Date prisa y\nencuéntralo! ¡No hay tiempo!\n¡Rápido!"
    },
    {
      "index": 96,
      "english": "It's too fast...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 18298,
      "_bytes": 16,
      "translation": "Es muy rápido..."
    },
    {
      "index": 97,
      "english": "And it still outclasses us in\npower and response time...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 18315,
      "_bytes": 56,
      "translation": "Y nos supera en potencia\ny velocidad de respuesta..."
    },
    {
      "index": 98,
      "english": "What should I do...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 18372,
      "_bytes": 19,
      "translation": "¿Qué hago...?"
    },
    {
      "index": 99,
      "english": "Thirty seconds!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 18392,
      "_bytes": 15,
      "translation": "¡30 segundos!"
    },
    {
      "index": 100,
      "english": "That's it... redirection!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 18408,
      "_bytes": 25,
      "translation": "¡Ya está... redirigirlos!"
    },
    {
      "index": 101,
      "english": "If I redirect all of these emails\nto its address...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 18434,
      "_bytes": 51,
      "translation": "Si redirijo todos estos\nemails a su dirección..."
    },
    {
      "index": 102,
      "english": "Go!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 18486,
      "_bytes": 3,
      "translation": "¡Ya!"
    },
    {
      "index": 103,
      "english": "Ten seconds! Nine... eight...\nseven... six... five... four...\nthree... two... one...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 18490,
      "_bytes": 84,
      "translation": "¡Diez segundos! 9... 8...\n7... 6... 5... 4... 3...\n2... 1..."
    },
    {
      "index": 104,
      "english": "Ah! A response?",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 18575,
      "_bytes": 15,
      "translation": "¡Ah! ¿Respuesta?"
    },
    {
      "index": 105,
      "english": "\"Dear Sora, it was my fault, so\ndon't be angry anymore...\"",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 18591,
      "_bytes": 58,
      "translation": "\"Querida Sora, fue culpa\nmía, no sigas enfadada...\""
    },
    {
      "index": 106,
      "english": "\"Tai Yagami\"...? Oh, what an\nidiot!",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 18650,
      "_bytes": 38,
      "translation": "¿\"Tai Yagami\"...? ¡Será\nidiota!"
    }
  ]
}