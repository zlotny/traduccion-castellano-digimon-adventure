{
  "file_id": "3616",
  "text_count": 106,
  "dialog": [
    {
      "index": 0,
      "english": "Hackmon! You're here, too?!",
      "_offset": 1067,
      "_length": 27,
      "speaker_id": 0,
      "translation": "Hackmon! Tú también?!"
    },
    {
      "index": 1,
      "english": "No way!",
      "_offset": 1095,
      "_length": 7,
      "speaker_id": 0,
      "translation": "Anda!"
    },
    {
      "index": 2,
      "english": "So that *wasn't* actually the\nexit?",
      "_offset": 1103,
      "_length": 35,
      "speaker_id": 0,
      "translation": "Entonces eso no era\nla salida?"
    },
    {
      "index": 3,
      "english": "That's weird... That should have\nbeen the exit...",
      "_offset": 1139,
      "_length": 49,
      "speaker_id": 0,
      "translation": "Qué raro... Eso debería\nhaber sido la salida..."
    },
    {
      "index": 4,
      "english": "We're trapped in here for real...",
      "_offset": 1189,
      "_length": 33,
      "speaker_id": 0,
      "translation": "Estamos atrapados de verdad..."
    },
    {
      "index": 5,
      "english": "No...!",
      "_offset": 1223,
      "_length": 6,
      "speaker_id": 0,
      "translation": "No...!"
    },
    {
      "index": 6,
      "english": "It must be the guy that Hackmon\nwas talking about! The one who\nbrought us here!",
      "_offset": 1230,
      "_length": 79,
      "speaker_id": 0,
      "translation": "Debe ser el tipo del que hablaba\nHackmon! El que nos trajo\naquí!"
    },
    {
      "index": 7,
      "english": "...Ah!",
      "_offset": 1310,
      "_length": 6,
      "speaker_id": 0,
      "translation": "...Ah!"
    },
    {
      "index": 8,
      "english": "Someone's coming...",
      "_offset": 1320,
      "_length": 19,
      "speaker_id": 0,
      "translation": "Viene alguien..."
    },
    {
      "index": 9,
      "english": "Taiiiiiii!",
      "_offset": 1344,
      "_length": 13,
      "speaker_id": 0,
      "translation": "Taiiiiiii!"
    },
    {
      "index": 10,
      "english": "Agumoooooooon!",
      "_offset": 1358,
      "_length": 14,
      "speaker_id": 0,
      "translation": "Agumoooooooon!"
    },
    {
      "index": 11,
      "english": "...Who are *you*?",
      "_offset": 1376,
      "_length": 17,
      "speaker_id": 0,
      "translation": "...Quién eres tú?"
    },
    {
      "index": 12,
      "english": "It really *is* you, Tai! And\nyou're with Agumon!",
      "_offset": 1394,
      "_length": 51,
      "speaker_id": 0,
      "translation": "Eres tú de verdad, Tai! Y\nestás con Agumon!"
    },
    {
      "index": 13,
      "english": "I have no idea what you're talking\nabout!",
      "_offset": 1446,
      "_length": 41,
      "speaker_id": 0,
      "translation": "No tengo ni idea de qué\nhablas!"
    },
    {
      "index": 14,
      "english": "Come on, Tai, calm down! See?\nLook at my goggles!",
      "_offset": 1488,
      "_length": 52,
      "speaker_id": 0,
      "translation": "Vamos, Tai, tranquilo! Mira\nmis gafas!"
    },
    {
      "index": 15,
      "english": "Your goggles?",
      "_offset": 1541,
      "_length": 13,
      "speaker_id": 0,
      "translation": "Tus gafas?"
    },
    {
      "index": 16,
      "english": "They're the goggles you gave me!\nI'm Daisuke Motomiya, your junior!",
      "_offset": 1555,
      "_length": 67,
      "speaker_id": 0,
      "translation": "Son las gafas que me diste!\nSoy Daisuke Motomiya, tu junior!"
    },
    {
      "index": 17,
      "english": "...They're scratched in exactly\nthe same places as mine!",
      "_offset": 1623,
      "_length": 56,
      "speaker_id": 0,
      "translation": "...Tienen los rasguños exactos\nen los mismos sitios!"
    },
    {
      "index": 18,
      "english": "Don't you remember? Fifth-grader\nat Odaiba Elementary! Same class\nas Kari and T.K!",
      "_offset": 1680,
      "_length": 87,
      "speaker_id": 0,
      "translation": "No te acuerdas? Vamos juntos\na Odaiba, en quinto! En la\nmisma clase que Kari y T.K!"
    },
    {
      "index": 19,
      "english": "Wait, but isn't T.K in second\ngrade?",
      "_offset": 1768,
      "_length": 39,
      "speaker_id": 0,
      "translation": "Espera, T.K no está en\nsegundo?"
    },
    {
      "index": 20,
      "english": "Wait, what? That's not... huh?\nYou're shorter than I remember you\nbeing...",
      "_offset": 1808,
      "_length": 74,
      "speaker_id": 0,
      "translation": "Espera, qué? Eso no es...\neh? Eres más bajo de lo que\nrecordaba..."
    },
    {
      "index": 21,
      "english": "...Hey, V-mon, am I dreaming right\nnow?",
      "_offset": 1883,
      "_length": 39,
      "speaker_id": 0,
      "translation": "...Oye, V-mon, estoy soñando\nverdad?"
    },
    {
      "index": 22,
      "english": "Why don't we check? Ey!",
      "_offset": 1923,
      "_length": 23,
      "speaker_id": 0,
      "translation": "Vamos a ver! Ey!"
    },
    {
      "index": 23,
      "english": "O-Ow... Okay, this isn't a\ndream...",
      "_offset": 1947,
      "_length": 35,
      "speaker_id": 0,
      "translation": "Au... vale, esto no es un\nsueño..."
    },
    {
      "index": 24,
      "english": "Daisuke! Oops, I think that was a\nbit too strong...",
      "_offset": 1983,
      "_length": 51,
      "speaker_id": 0,
      "translation": "Daisuke! Uy, creo que ha sido\nun poco fuerte..."
    },
    {
      "index": 25,
      "english": "U-Ugh...",
      "_offset": 2035,
      "_length": 8,
      "speaker_id": 0,
      "translation": "U-Ugh..."
    },
    {
      "index": 26,
      "english": "Daisuke! You're awake!",
      "_offset": 2044,
      "_length": 22,
      "speaker_id": 0,
      "translation": "Daisuke! Despertaste!"
    },
    {
      "index": 27,
      "english": "Are you okay, Daisuke?",
      "_offset": 2067,
      "_length": 22,
      "speaker_id": 0,
      "translation": "Estás bien, Daisuke?"
    },
    {
      "index": 28,
      "english": "Tai...chi...?",
      "_offset": 2090,
      "_length": 13,
      "speaker_id": 0,
      "translation": "Tai...chi...?"
    },
    {
      "index": 29,
      "english": "V-mon told us everything.",
      "_offset": 2104,
      "_length": 25,
      "speaker_id": 0,
      "translation": "V-mon nos lo contó todo."
    },
    {
      "index": 30,
      "english": "So you and V-mon are from three\nyears in the future, huh?",
      "_offset": 2130,
      "_length": 57,
      "speaker_id": 0,
      "translation": "Así que tú y V-mon venís\nde tres años en el futuro?"
    },
    {
      "index": 31,
      "english": "So the Tai here is three years\nyounger than the Tai I know...",
      "_offset": 2188,
      "_length": 67,
      "speaker_id": 0,
      "translation": "Entonces el Tai de aquí\nes tres años más joven que\nel que conozco..."
    },
    {
      "index": 32,
      "english": "What's going on...",
      "_offset": 2256,
      "_length": 18,
      "speaker_id": 0,
      "translation": "Qué pasa aquí..."
    },
    {
      "index": 33,
      "english": "I guess this dimension is\nconnected to other time periods,\ntoo...",
      "_offset": 2275,
      "_length": 65,
      "speaker_id": 0,
      "translation": "Supongo que esta dimensión\ntambién conecta con otras\népocas..."
    },
    {
      "index": 34,
      "english": "...Okay, I really don't get this.",
      "_offset": 2341,
      "_length": 33,
      "speaker_id": 0,
      "translation": "...Vale, esto no lo entiendo."
    },
    {
      "index": 35,
      "english": "So what are you gonna do now,\nDaisuke?",
      "_offset": 2375,
      "_length": 38,
      "speaker_id": 0,
      "translation": "Y ahora qué vas a hacer,\nDaisuke?"
    },
    {
      "index": 36,
      "english": "Isn't it obvious? I'm going with\nyou, Tai!",
      "_offset": 2414,
      "_length": 45,
      "speaker_id": 0,
      "translation": "Está claro! Voy contigo,\nTai!"
    },
    {
      "index": 37,
      "english": "Yeah, yeah!",
      "_offset": 2460,
      "_length": 11,
      "speaker_id": 0,
      "translation": "Sí, sí!"
    },
    {
      "index": 38,
      "english": "I've always wanted to go on an\nadventure with you, like Kari\nand T.K did!",
      "_offset": 2472,
      "_length": 78,
      "speaker_id": 0,
      "translation": "Siempre quise vivir una\naventura contigo, como\nKari y T.K!"
    },
    {
      "index": 39,
      "english": "Huh? Really?!",
      "_offset": 2551,
      "_length": 13,
      "speaker_id": 0,
      "translation": "Eh? En serio!"
    },
    {
      "index": 40,
      "english": "So now that that's decided, it's\ntime to go! Let's go, V-mon!",
      "_offset": 2565,
      "_length": 61,
      "speaker_id": 0,
      "translation": "Ya que está decidido, hora\nde irnos! Vamos, V-mon!"
    },
    {
      "index": 41,
      "english": "Yeah!",
      "_offset": 2627,
      "_length": 5,
      "speaker_id": 0,
      "translation": "Sí!"
    },
    {
      "index": 42,
      "english": "...so on our way back from school,\nwe were captured by a black\nshadow...",
      "_offset": 2633,
      "_length": 72,
      "speaker_id": 0,
      "translation": "...volviendo del cole, nos\natrapó una sombra negra..."
    },
    {
      "index": 43,
      "english": "...and before we knew it, we were\nhere.",
      "_offset": 2706,
      "_length": 39,
      "speaker_id": 0,
      "translation": "...y sin darnos cuenta,\nestábamos aquí."
    },
    {
      "index": 44,
      "english": "That's just like what Hackmon\nsaid.",
      "_offset": 2746,
      "_length": 35,
      "speaker_id": 0,
      "translation": "Es justo lo que decía\nHackmon."
    },
    {
      "index": 45,
      "english": "Hey, hey, Tai!",
      "_offset": 2782,
      "_length": 17,
      "speaker_id": 0,
      "translation": "Oye, oye, Tai!"
    },
    {
      "index": 46,
      "english": "What is it, Hackmon?",
      "_offset": 2800,
      "_length": 20,
      "speaker_id": 0,
      "translation": "Qué pasa, Hackmon?"
    },
    {
      "index": 47,
      "english": "Something's been bothering me for\na while.",
      "_offset": 2821,
      "_length": 42,
      "speaker_id": 0,
      "translation": "Hay algo que me ronda\nla cabeza."
    },
    {
      "index": 48,
      "english": "Would you and Daisuke be Agumon\nand V-mon's attendants?",
      "_offset": 2864,
      "_length": 55,
      "speaker_id": 0,
      "translation": "Tú y Daisuke sois los sirvientes\nde Agumon y V-mon?"
    },
    {
      "index": 49,
      "english": "Me? V-mon's attendant?",
      "_offset": 2920,
      "_length": 22,
      "speaker_id": 0,
      "translation": "Yo sirviente de V-mon?"
    },
    {
      "index": 50,
      "english": "No, no! Agumon's my friend... or\nmore like, my partner...",
      "_offset": 2943,
      "_length": 57,
      "speaker_id": 0,
      "translation": "No, no! Agumon es mi amigo...\no más bien, mi compañero..."
    },
    {
      "index": 51,
      "english": "Hmmm? So then, why don't I have\none?",
      "_offset": 3001,
      "_length": 36,
      "speaker_id": 0,
      "translation": "Entonces, por qué yo no\ntengo uno?"
    },
    {
      "index": 52,
      "english": "Well, when you put it that way...",
      "_offset": 3038,
      "_length": 33,
      "speaker_id": 0,
      "translation": "Bueno, visto así..."
    },
    {
      "index": 53,
      "english": "In my time, I went to the Digital\nWorld, and I lifted up a\nDigimental...",
      "_offset": 3072,
      "_length": 72,
      "speaker_id": 0,
      "translation": "En mi época, fui al\nMundo Digital y alcé\nun Digimental..."
    },
    {
      "index": 54,
      "english": "And that awakened V-mon.",
      "_offset": 3145,
      "_length": 24,
      "speaker_id": 0,
      "translation": "Y eso despertó a V-mon."
    },
    {
      "index": 55,
      "english": "Yeah, yeah!",
      "_offset": 3170,
      "_length": 11,
      "speaker_id": 0,
      "translation": "Sí, sí!"
    },
    {
      "index": 56,
      "english": "Agumon and I met for the first\ntime at File Island.",
      "_offset": 3182,
      "_length": 51,
      "speaker_id": 0,
      "translation": "Agumon y yo nos conocimos\nen la Isla File."
    },
    {
      "index": 57,
      "english": "I was a Koromon back then, though.",
      "_offset": 3234,
      "_length": 34,
      "speaker_id": 0,
      "translation": "Yo era un Koromon entonces."
    },
    {
      "index": 58,
      "english": "Okay, so why don't you become my\npartner, Tai?",
      "_offset": 3269,
      "_length": 49,
      "speaker_id": 0,
      "translation": "Entonces, por qué no eres tú\nmi compañero, Tai?"
    },
    {
      "index": 59,
      "english": "What?!",
      "_offset": 3319,
      "_length": 6,
      "speaker_id": 0,
      "translation": "Qué?!"
    },
    {
      "index": 60,
      "english": "No can do! Tai is *my* partner!",
      "_offset": 3326,
      "_length": 34,
      "speaker_id": 0,
      "translation": "Tai es mi compañero!"
    },
    {
      "index": 61,
      "english": "Then why don't we fight? Whoever\nwins gets to be Tai's partner!",
      "_offset": 3361,
      "_length": 66,
      "speaker_id": 0,
      "translation": "Entonces peleemos! El que gane\nserá el compañero de Tai!"
    },
    {
      "index": 62,
      "english": "I refuse!",
      "_offset": 3428,
      "_length": 9,
      "speaker_id": 0,
      "translation": "Me niego!"
    },
    {
      "index": 63,
      "english": "How greedy!",
      "_offset": 3438,
      "_length": 11,
      "speaker_id": 0,
      "translation": "Qué avaro!"
    },
    {
      "index": 64,
      "english": "Hey, hey, don't just go off on\nyour own like that!",
      "_offset": 3450,
      "_length": 50,
      "speaker_id": 0,
      "translation": "Oye, oye, no te vayas así\npor tu cuenta!"
    },
    {
      "index": 65,
      "english": "Hmph... so then, where's *my*\npartner?",
      "_offset": 3501,
      "_length": 38,
      "speaker_id": 0,
      "translation": "Y entonces, dónde está mi\ncompañero?"
    },
    {
      "index": 66,
      "english": "Hackmon's a real character\nthere...",
      "_offset": 3540,
      "_length": 35,
      "speaker_id": 0,
      "translation": "Hackmon es todo un\npersonaje..."
    },
    {
      "index": 67,
      "english": "Ah! Over there!",
      "_offset": 3576,
      "_length": 15,
      "speaker_id": 0,
      "translation": "Ahí! Mirad!"
    },
    {
      "index": 68,
      "english": "We've finally found the exit...",
      "_offset": 3592,
      "_length": 31,
      "speaker_id": 0,
      "translation": "Por fin, la salida..."
    },
    {
      "index": 69,
      "english": "What?",
      "_offset": 3627,
      "_length": 5,
      "speaker_id": 0,
      "translation": "Qué?"
    },
    {
      "index": 70,
      "english": "Tai!",
      "_offset": 3633,
      "_length": 7,
      "speaker_id": 0,
      "translation": "Tai!"
    },
    {
      "index": 71,
      "english": "Is that... Magnamon?!",
      "_offset": 3641,
      "_length": 21,
      "speaker_id": 0,
      "translation": "Es eso... Magnamon?!"
    },
    {
      "index": 72,
      "english": "Is that a copy of me?",
      "_offset": 3663,
      "_length": 21,
      "speaker_id": 0,
      "translation": "Es una copia mía?"
    },
    {
      "index": 73,
      "english": "What are we gonna do, Tai?",
      "_offset": 3685,
      "_length": 29,
      "speaker_id": 0,
      "translation": "Qué hacemos, Tai?"
    },
    {
      "index": 74,
      "english": "I mean, obviously we're gonna have\nto defeat him, right?",
      "_offset": 3715,
      "_length": 56,
      "speaker_id": 0,
      "translation": "Está claro que hay que\nderrotarlo, no?"
    },
    {
      "index": 75,
      "english": "Okay! I'll watch you, then!",
      "_offset": 3772,
      "_length": 27,
      "speaker_id": 0,
      "translation": "Vale! Yo os miro, entonces!"
    },
    {
      "index": 76,
      "english": "Huh? You're not gonna fight?",
      "_offset": 3800,
      "_length": 28,
      "speaker_id": 0,
      "translation": "Eh? No vas a pelear?"
    },
    {
      "index": 77,
      "english": "I know my limits! I'm not gonna\nfight someone way above my tier!",
      "_offset": 3829,
      "_length": 64,
      "speaker_id": 0,
      "translation": "Conozco mis límites! No voy a\npelear con alguien tan fuerte!"
    },
    {
      "index": 78,
      "english": "Fine, then... Let's go, guys!",
      "_offset": 3894,
      "_length": 29,
      "speaker_id": 0,
      "translation": "Vale, pues... vamos, chicos!"
    },
    {
      "index": 79,
      "english": "Take that, faker!",
      "_offset": 3924,
      "_length": 17,
      "speaker_id": 0,
      "translation": "Toma, farsante!"
    },
    {
      "index": 80,
      "english": "We did it!",
      "_offset": 3942,
      "_length": 10,
      "speaker_id": 0,
      "translation": "Ganamos!"
    },
    {
      "index": 81,
      "english": "We did it, guys!",
      "_offset": 3953,
      "_length": 16,
      "speaker_id": 0,
      "translation": "Ganamos, chicos!"
    },
    {
      "index": 82,
      "english": "All right, let's go!",
      "_offset": 3970,
      "_length": 20,
      "speaker_id": 0,
      "translation": "Bien, vamos!"
    },
    {
      "index": 83,
      "english": "Wait, Tai!",
      "_offset": 3991,
      "_length": 13,
      "speaker_id": 0,
      "translation": "Espera, Tai!"
    },
    {
      "index": 84,
      "english": "Aaaaaah!",
      "_offset": 4005,
      "_length": 8,
      "speaker_id": 0,
      "translation": "Aaaaaah!"
    },
    {
      "index": 85,
      "english": "The heck is this? Are we gonna be\ntrapped here?",
      "_offset": 4014,
      "_length": 47,
      "speaker_id": 0,
      "translation": "Qué es esto? Vamos a quedarnos\natrapados aquí?"
    },
    {
      "index": 86,
      "english": "What happened?",
      "_offset": 4062,
      "_length": 14,
      "speaker_id": 0,
      "translation": "Qué ha pasado?"
    },
    {
      "index": 87,
      "english": "I can't really tell, but maybe\nthere's a door that'll only let us\nthrough.",
      "_offset": 4077,
      "_length": 74,
      "speaker_id": 0,
      "translation": "No estoy seguro, pero tal vez\nhaya una puerta que solo nos\ndeje pasar."
    },
    {
      "index": 88,
      "english": "What?!",
      "_offset": 4152,
      "_length": 6,
      "speaker_id": 0,
      "translation": "Qué?!"
    },
    {
      "index": 89,
      "english": "So, got any ideas for these guys?\nThey're gonna be stuck here.",
      "_offset": 4159,
      "_length": 62,
      "speaker_id": 0,
      "translation": "Alguna idea para estos dos?\nSe quedarán atrapados aquí."
    },
    {
      "index": 90,
      "english": "Nooooo! I thought I could finally\ngo on an adventure with Tai!",
      "_offset": 4222,
      "_length": 65,
      "speaker_id": 0,
      "translation": "Noooo! Pensé que por fin\npodría ir de aventuras con Tai!"
    },
    {
      "index": 91,
      "english": "Listen up, Daisuke!",
      "_offset": 4288,
      "_length": 19,
      "speaker_id": 0,
      "translation": "Escucha, Daisuke!"
    },
    {
      "index": 92,
      "english": "There's gotta be a reason we can't\nget out of here.",
      "_offset": 4308,
      "_length": 51,
      "speaker_id": 0,
      "translation": "Debe haber un motivo por el\nque no podemos salir."
    },
    {
      "index": 93,
      "english": "If we both look for it, we'll run\ninto each other again at some\npoint!",
      "_offset": 4360,
      "_length": 70,
      "speaker_id": 0,
      "translation": "Si los dos lo buscamos, nos\nvolveremos a encontrar\nen algún momento!"
    },
    {
      "index": 94,
      "english": "Is it gonna be that easy?",
      "_offset": 4431,
      "_length": 25,
      "speaker_id": 0,
      "translation": "Será tan fácil?"
    },
    {
      "index": 95,
      "english": "The only thing we can do is\nbelieve!",
      "_offset": 4457,
      "_length": 36,
      "speaker_id": 0,
      "translation": "Lo único que podemos hacer\nes creer!"
    },
    {
      "index": 96,
      "english": "...Yeah, you're right! I'll\nbelieve in that!",
      "_offset": 4494,
      "_length": 44,
      "speaker_id": 0,
      "translation": "...Sí, tienes razón! Voy a\ncreer en eso!"
    },
    {
      "index": 97,
      "english": "Yeah, so let's meet up again\nlater!",
      "_offset": 4539,
      "_length": 35,
      "speaker_id": 0,
      "translation": "Sí, veámonos otra vez\nmás tarde!"
    },
    {
      "index": 98,
      "english": "Taiiiiiii! Take care!",
      "_offset": 4575,
