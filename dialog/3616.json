{
  "file_id": "3616",
  "format": "etdf",
  "kind": "ETDF",
  "text_count": 111,
  "dialog": [
    {
      "index": 0,
      "english": "!!",
      "speaker_id": 9001,
      "line_type": 2,
      "_offset": 8776,
      "_bytes": 2,
      "translation": "!!"
    },
    {
      "index": 1,
      "english": "Hackmon! You're here, too?!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 8779,
      "_bytes": 27,
      "translation": "¡Hackmon! ¡¿Tú también?!"
    },
    {
      "index": 2,
      "english": "No way!",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 8807,
      "_bytes": 7,
      "translation": "¡Anda!"
    },
    {
      "index": 3,
      "english": "So that *wasn't* actually the\nexit?",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 8815,
      "_bytes": 35,
      "translation": "¿Entonces eso no era\nla salida?"
    },
    {
      "index": 4,
      "english": "That's weird... That should have\nbeen the exit...",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 8851,
      "_bytes": 49,
      "translation": "Qué raro... Eso debería\nhaber sido la salida..."
    },
    {
      "index": 5,
      "english": "We're trapped in here for real...",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 8901,
      "_bytes": 33,
      "translation": "Estamos atrapados de verdad..."
    },
    {
      "index": 6,
      "english": "No...!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 8935,
      "_bytes": 6,
      "translation": "¡No...!"
    },
    {
      "index": 7,
      "english": "It must be the guy that Hackmon\nwas talking about! The one who\nbrought us here!",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 8942,
      "_bytes": 79,
      "translation": "¡Debe de ser el tipo del que\nhablaba Hackmon! ¡El que nos\ntrajo aquí!"
    },
    {
      "index": 8,
      "english": "...Ah!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 9022,
      "_bytes": 6,
      "translation": "...¡Ah!"
    },
    {
      "index": 9,
      "english": "!!",
      "speaker_id": 9001,
      "line_type": 2,
      "_offset": 9029,
      "_bytes": 2,
      "translation": "!!"
    },
    {
      "index": 10,
      "english": "Someone's coming...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 9032,
      "_bytes": 19,
      "translation": "Viene alguien..."
    },
    {
      "index": 11,
      "english": "...",
      "speaker_id": 9001,
      "line_type": 2,
      "_offset": 9052,
      "_bytes": 3,
      "translation": "..."
    },
    {
      "index": 12,
      "english": "Taiiiiiii!",
      "speaker_id": 7011,
      "line_type": 2,
      "_offset": 9056,
      "_bytes": 13,
      "translation": "¡Taiiiiiii!"
    },
    {
      "index": 13,
      "english": "Agumoooooooon!",
      "speaker_id": 7071,
      "line_type": 2,
      "_offset": 9070,
      "_bytes": 14,
      "translation": "¡Agumoooooooon!"
    },
    {
      "index": 14,
      "english": "!!",
      "speaker_id": 9001,
      "line_type": 2,
      "_offset": 9085,
      "_bytes": 2,
      "translation": "!!"
    },
    {
      "index": 15,
      "english": "...Who are *you*?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 9088,
      "_bytes": 17,
      "translation": "...¿Quién eres tú?"
    },
    {
      "index": 16,
      "english": "It really *is* you, Tai! And\nyou're with Agumon!",
      "speaker_id": 7011,
      "line_type": 2,
      "_offset": 9106,
      "_bytes": 51,
      "translation": "¡Eres tú de verdad, Tai! ¡Y\nestás con Agumon!"
    },
    {
      "index": 17,
      "english": "I have no idea what you're talking\nabout!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 9158,
      "_bytes": 41,
      "translation": "¡No tengo ni idea de qué\nhablas!"
    },
    {
      "index": 18,
      "english": "Come on, Tai, calm down! See?\nLook at my goggles!",
      "speaker_id": 7011,
      "line_type": 2,
      "_offset": 9200,
      "_bytes": 52,
      "translation": "¡Vamos, Tai, tranquilo! ¡Mira\nmis gafas!"
    },
    {
      "index": 19,
      "english": "Your goggles?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 9253,
      "_bytes": 13,
      "translation": "¿Tus gafas?"
    },
    {
      "index": 20,
      "english": "They're the goggles you gave me!\nI'm Daisuke Motomiya, your junior!",
      "speaker_id": 7011,
      "line_type": 2,
      "_offset": 9267,
      "_bytes": 67,
      "translation": "¡Son las gafas que me diste!\n¡Soy Daisuke Motomiya, tu sucesor!"
    },
    {
      "index": 21,
      "english": "...They're scratched in exactly\nthe same places as mine!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 9335,
      "_bytes": 56,
      "translation": "...¡Tienen los rasguños exactos\nen los mismos sitios!"
    },
    {
      "index": 22,
      "english": "Don't you remember? Fifth-grader\nat Odaiba Elementary! Same class\nas Kari and T.K!",
      "speaker_id": 7011,
      "line_type": 2,
      "_offset": 9392,
      "_bytes": 87,
      "translation": "¿No te acuerdas? ¡Voy a quinto\nen Odaiba! ¡A la misma clase\nque Kari y T.K.!"
    },
    {
      "index": 23,
      "english": "Wait, but isn't T.K in second\ngrade?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 9480,
      "_bytes": 39,
      "translation": "Espera, ¿T.K. no está en\nsegundo?"
    },
    {
      "index": 24,
      "english": "Wait, what? That's not... huh?\nYou're shorter than I remember you\nbeing...",
      "speaker_id": 7011,
      "line_type": 2,
      "_offset": 9520,
      "_bytes": 74,
      "translation": "Espera, ¿qué? Eso no es...\n¿eh? Eres más bajo de lo que\nrecordaba..."
    },
    {
      "index": 25,
      "english": "...Hey, V-mon, am I dreaming right\nnow?",
      "speaker_id": 7011,
      "line_type": 2,
      "_offset": 9595,
      "_bytes": 39,
      "translation": "...Oye, V-mon, ¿estoy soñando?"
    },
    {
      "index": 26,
      "english": "Why don't we check? Ey!",
      "speaker_id": 7071,
      "line_type": 2,
      "_offset": 9635,
      "_bytes": 23,
      "translation": "¡Vamos a ver! ¡Ey!"
    },
    {
      "index": 27,
      "english": "O-Ow... Okay, this isn't a\ndream...",
      "speaker_id": 7011,
      "line_type": 2,
      "_offset": 9659,
      "_bytes": 35,
      "translation": "Au... vale, esto no es un\nsueño..."
    },
    {
      "index": 28,
      "english": "Daisuke! Oops, I think that was a\nbit too strong...",
      "speaker_id": 7071,
      "line_type": 2,
      "_offset": 9695,
      "_bytes": 51,
      "translation": "¡Daisuke! Uy, creo que ha sido\nun poco fuerte..."
    },
    {
      "index": 29,
      "english": "U-Ugh...",
      "speaker_id": 7011,
      "line_type": 2,
      "_offset": 9747,
      "_bytes": 8,
      "translation": "U-Ugh..."
    },
    {
      "index": 30,
      "english": "Daisuke! You're awake!",
      "speaker_id": 7071,
      "line_type": 2,
      "_offset": 9756,
      "_bytes": 22,
      "translation": "¡Daisuke! ¡Despertaste!"
    },
    {
      "index": 31,
      "english": "Are you okay, Daisuke?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 9779,
      "_bytes": 22,
      "translation": "¿Estás bien, Daisuke?"
    },
    {
      "index": 32,
      "english": "Tai...chi...?",
      "speaker_id": 7011,
      "line_type": 2,
      "_offset": 9802,
      "_bytes": 13,
      "translation": "¿Tai...?"
    },
    {
      "index": 33,
      "english": "V-mon told us everything.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 9816,
      "_bytes": 25,
      "translation": "V-mon nos lo contó todo."
    },
    {
      "index": 34,
      "english": "So you and V-mon are from three\nyears in the future, huh?",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 9842,
      "_bytes": 57,
      "translation": "¿Así que tú y V-mon venís\nde tres años en el futuro?"
    },
    {
      "index": 35,
      "english": "So the Tai here is three years\nyounger than the Tai I know...",
      "speaker_id": 7011,
      "line_type": 2,
      "_offset": 9900,
      "_bytes": 67,
      "translation": "Entonces el Tai de aquí\nes tres años más joven que\nel que conozco..."
    },
    {
      "index": 36,
      "english": "What's going on...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 9968,
      "_bytes": 18,
      "translation": "¿Qué pasa aquí...?"
    },
    {
      "index": 37,
      "english": "I guess this dimension is\nconnected to other time periods,\ntoo...",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 9987,
      "_bytes": 65,
      "translation": "Supongo que esta dimensión\ntambién conecta con otras\népocas..."
    },
    {
      "index": 38,
      "english": "...Okay, I really don't get this.",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 10053,
      "_bytes": 33,
      "translation": "...Vale, esto no lo entiendo."
    },
    {
      "index": 39,
      "english": "So what are you gonna do now,\nDaisuke?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 10087,
      "_bytes": 38,
      "translation": "¿Y ahora qué vas a hacer,\nDaisuke?"
    },
    {
      "index": 40,
      "english": "Isn't it obvious? I'm going with\nyou, Tai!",
      "speaker_id": 7011,
      "line_type": 2,
      "_offset": 10126,
      "_bytes": 45,
      "translation": "¡Está claro! ¡Voy contigo,\nTai!"
    },
    {
      "index": 41,
      "english": "Yeah, yeah!",
      "speaker_id": 7071,
      "line_type": 2,
      "_offset": 10172,
      "_bytes": 11,
      "translation": "¡Sí, sí!"
    },
    {
      "index": 42,
      "english": "I've always wanted to go on an\nadventure with you, like Kari\nand T.K did!",
      "speaker_id": 7011,
      "line_type": 2,
      "_offset": 10184,
      "_bytes": 78,
      "translation": "¡Siempre quise vivir una\naventura contigo, como\nKari y T.K.!"
    },
    {
      "index": 43,
      "english": "Huh? Really?!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 10263,
      "_bytes": 13,
      "translation": "¿Eh? ¡¿En serio?!"
    },
    {
      "index": 44,
      "english": "So now that that's decided, it's\ntime to go! Let's go, V-mon!",
      "speaker_id": 7011,
      "line_type": 2,
      "_offset": 10277,
      "_bytes": 61,
      "translation": "¡Ya que está decidido, hora\nde irnos! ¡Vamos, V-mon!"
    },
    {
      "index": 45,
      "english": "Yeah!",
      "speaker_id": 7071,
      "line_type": 2,
      "_offset": 10339,
      "_bytes": 5,
      "translation": "¡Sí!"
    },
    {
      "index": 46,
      "english": "...so on our way back from school,\nwe were captured by a black\nshadow...",
      "speaker_id": 7011,
      "line_type": 2,
      "_offset": 10345,
      "_bytes": 72,
      "translation": "...volviendo del cole, nos\natrapó una sombra negra..."
    },
    {
      "index": 47,
      "english": "...and before we knew it, we were\nhere.",
      "speaker_id": 7071,
      "line_type": 2,
      "_offset": 10418,
      "_bytes": 39,
      "translation": "...y sin darnos cuenta,\nestábamos aquí."
    },
    {
      "index": 48,
      "english": "That's just like what Hackmon\nsaid.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 10458,
      "_bytes": 35,
      "translation": "Es justo lo que decía\nHackmon."
    },
    {
      "index": 49,
      "english": "Hey, hey, Tai!",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 10494,
      "_bytes": 17,
      "translation": "¡Oye, oye, Tai!"
    },
    {
      "index": 50,
      "english": "What is it, Hackmon?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 10512,
      "_bytes": 20,
      "translation": "¿Qué pasa, Hackmon?"
    },
    {
      "index": 51,
      "english": "Something's been bothering me for\na while.",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 10533,
      "_bytes": 42,
      "translation": "Hay algo que me ronda\nla cabeza."
    },
    {
      "index": 52,
      "english": "Would you and Daisuke be Agumon\nand V-mon's attendants?",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 10576,
      "_bytes": 55,
      "translation": "¿Tú y Daisuke sois los sirvientes\nde Agumon y V-mon?"
    },
    {
      "index": 53,
      "english": "Me? V-mon's attendant?",
      "speaker_id": 7011,
      "line_type": 2,
      "_offset": 10632,
      "_bytes": 22,
      "translation": "¿Yo sirviente de V-mon?"
    },
    {
      "index": 54,
      "english": "No, no! Agumon's my friend... or\nmore like, my partner...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 10655,
      "_bytes": 57,
      "translation": "¡No, no! Agumon es mi amigo...\no más bien, mi compañero..."
    },
    {
      "index": 55,
      "english": "Hmmm? So then, why don't I have\none?",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 10713,
      "_bytes": 36,
      "translation": "Entonces, ¿por qué yo no\ntengo uno?"
    },
    {
      "index": 56,
      "english": "Well, when you put it that way...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 10750,
      "_bytes": 33,
      "translation": "Bueno, visto así..."
    },
    {
      "index": 57,
      "english": "In my time, I went to the Digital\nWorld, and I lifted up a\nDigimental...",
      "speaker_id": 7011,
      "line_type": 2,
      "_offset": 10784,
      "_bytes": 72,
      "translation": "En mi época, fui al\nDigimundo y alcé\nun Digimental..."
    },
    {
      "index": 58,
      "english": "And that awakened V-mon.",
      "speaker_id": 7011,
      "line_type": 2,
      "_offset": 10857,
      "_bytes": 24,
      "translation": "Y eso despertó a V-mon."
    },
    {
      "index": 59,
      "english": "Yeah, yeah!",
      "speaker_id": 7071,
      "line_type": 2,
      "_offset": 10882,
      "_bytes": 11,
      "translation": "¡Sí, sí!"
    },
    {
      "index": 60,
      "english": "Agumon and I met for the first\ntime at File Island.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 10894,
      "_bytes": 51,
      "translation": "Agumon y yo nos conocimos\nen la Isla File."
    },
    {
      "index": 61,
      "english": "I was a Koromon back then, though.",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 10946,
      "_bytes": 34,
      "translation": "Yo era un Koromon entonces."
    },
    {
      "index": 62,
      "english": "Okay, so why don't you become my\npartner, Tai?",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 10981,
      "_bytes": 49,
      "translation": "Entonces, ¿por qué no eres tú\nmi compañero, Tai?"
    },
    {
      "index": 63,
      "english": "What?!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 11031,
      "_bytes": 6,
      "translation": "¡¿Qué?!"
    },
    {
      "index": 64,
      "english": "No can do! Tai is *my* partner!",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 11038,
      "_bytes": 34,
      "translation": "¡Tai es mi compañero!"
    },
    {
      "index": 65,
      "english": "Then why don't we fight? Whoever\nwins gets to be Tai's partner!",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 11073,
      "_bytes": 66,
      "translation": "¡Entonces peleemos! ¡El que gane\nserá el compañero de Tai!"
    },
    {
      "index": 66,
      "english": "I refuse!",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 11140,
      "_bytes": 9,
      "translation": "¡Me niego!"
    },
    {
      "index": 67,
      "english": "How greedy!",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 11150,
      "_bytes": 11,
      "translation": "¡Qué avaro!"
    },
    {
      "index": 68,
      "english": "Hey, hey, don't just go off on\nyour own like that!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 11162,
      "_bytes": 50,
      "translation": "¡Oye, oye, no te vayas así\npor tu cuenta!"
    },
    {
      "index": 69,
      "english": "Hmph... so then, where's *my*\npartner?",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 11213,
      "_bytes": 38,
      "translation": "Y entonces, ¿dónde está mi\ncompañero?"
    },
    {
      "index": 70,
      "english": "Hackmon's a real character\nthere...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 11252,
      "_bytes": 35,
      "translation": "Hackmon es todo un\npersonaje..."
    },
    {
      "index": 71,
      "english": "Ah! Over there!",
      "speaker_id": 7071,
      "line_type": 2,
      "_offset": 11288,
      "_bytes": 15,
      "translation": "¡Ahí! ¡Mirad!"
    },
    {
      "index": 72,
      "english": "We've finally found the exit...",
      "speaker_id": 7011,
      "line_type": 2,
      "_offset": 11304,
      "_bytes": 31,
      "translation": "Por fin, la salida..."
    },
    {
      "index": 73,
      "english": "!!",
      "speaker_id": 9001,
      "line_type": 2,
      "_offset": 11336,
      "_bytes": 2,
      "translation": "!!"
    },
    {
      "index": 74,
      "english": "What?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 11339,
      "_bytes": 5,
      "translation": "¿Qué?"
    },
    {
      "index": 75,
      "english": "Tai!",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 11345,
      "_bytes": 7,
      "translation": "¡Tai!"
    },
    {
      "index": 76,
      "english": "Is that... Magnamon?!",
      "speaker_id": 7011,
      "line_type": 2,
      "_offset": 11353,
      "_bytes": 21,
      "translation": "Es eso... ¡¿Magnamon?!"
    },
    {
      "index": 77,
      "english": "Is that a copy of me?",
      "speaker_id": 7071,
      "line_type": 2,
      "_offset": 11375,
      "_bytes": 21,
      "translation": "¿Es una copia mía?"
    },
    {
      "index": 78,
      "english": "What are we gonna do, Tai?",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 11397,
      "_bytes": 29,
      "translation": "¿Qué hacemos, Tai?"
    },
    {
      "index": 79,
      "english": "I mean, obviously we're gonna have\nto defeat him, right?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 11427,
      "_bytes": 56,
      "translation": "Está claro que hay que\nderrotarlo, ¿no?"
    },
    {
      "index": 80,
      "english": "Okay! I'll watch you, then!",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 11484,
      "_bytes": 27,
      "translation": "¡Vale! ¡Yo os miro, entonces!"
    },
    {
      "index": 81,
      "english": "Huh? You're not gonna fight?",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 11512,
      "_bytes": 28,
      "translation": "¿Eh? ¿No vas a pelear?"
    },
    {
      "index": 82,
      "english": "I know my limits! I'm not gonna\nfight someone way above my tier!",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 11541,
      "_bytes": 64,
      "translation": "¡Conozco mis límites! ¡No voy a\npelear con alguien tan fuerte!"
    },
    {
      "index": 83,
      "english": "Fine, then... Let's go, guys!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 11606,
      "_bytes": 29,
      "translation": "¡Vale, pues... vamos, chicos!"
    },
    {
      "index": 84,
      "english": "Take that, faker!",
      "speaker_id": 7011,
      "line_type": 2,
      "_offset": 11636,
      "_bytes": 17,
      "translation": "¡Toma, farsante!"
    },
    {
      "index": 85,
      "english": "We did it!",
      "speaker_id": 7071,
      "line_type": 2,
      "_offset": 11654,
      "_bytes": 10,
      "translation": "¡Ganamos!"
    },
    {
      "index": 86,
      "english": "We did it, guys!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 11665,
      "_bytes": 16,
      "translation": "¡Ganamos, chicos!"
    },
    {
      "index": 87,
      "english": "All right, let's go!",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 11682,
      "_bytes": 20,
      "translation": "¡Bien, vamos!"
    },
    {
      "index": 88,
      "english": "Wait, Tai!",
      "speaker_id": 7011,
      "line_type": 2,
      "_offset": 11703,
      "_bytes": 13,
      "translation": "¡Espera, Tai!"
    },
    {
      "index": 89,
      "english": "Aaaaaah!",
      "speaker_id": 7071,
      "line_type": 2,
      "_offset": 11717,
      "_bytes": 8,
      "translation": "¡Aaaaaah!"
    },
    {
      "index": 90,
      "english": "The heck is this? Are we gonna be\ntrapped here?",
      "speaker_id": 7011,
      "line_type": 2,
      "_offset": 11726,
      "_bytes": 47,
      "translation": "¿Qué es esto? ¿Vamos a quedarnos\natrapados aquí?"
    },
    {
      "index": 91,
      "english": "What happened?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 11774,
      "_bytes": 14,
      "translation": "¿Qué ha pasado?"
    },
    {
      "index": 92,
      "english": "I can't really tell, but maybe\nthere's a door that'll only let us\nthrough.",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 11789,
      "_bytes": 74,
      "translation": "No estoy seguro, pero tal vez\nhaya una puerta que solo nos\ndeje pasar."
    },
    {
      "index": 93,
      "english": "What?!",
      "speaker_id": 7071,
      "line_type": 2,
      "_offset": 11864,
      "_bytes": 6,
      "translation": "¡¿Qué?!"
    },
    {
      "index": 94,
      "english": "So, got any ideas for these guys?\nThey're gonna be stuck here.",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 11871,
      "_bytes": 62,
      "translation": "¿Alguna idea para estos dos?\nSe quedarán atrapados aquí."
    },
    {
      "index": 95,
      "english": "Nooooo! I thought I could finally\ngo on an adventure with Tai!",
      "speaker_id": 7011,
      "line_type": 2,
      "_offset": 11934,
      "_bytes": 65,
      "translation": "¡Noooo! ¡Pensé que por fin\npodría ir de aventuras con Tai!"
    },
    {
      "index": 96,
      "english": "Listen up, Daisuke!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 12000,
      "_bytes": 19,
      "translation": "¡Escucha, Daisuke!"
    },
    {
      "index": 97,
      "english": "There's gotta be a reason we can't\nget out of here.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 12020,
      "_bytes": 51,
      "translation": "Debe de haber un motivo por el\nque no podemos salir."
    },
    {
      "index": 98,
      "english": "If we both look for it, we'll run\ninto each other again at some\npoint!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 12072,
      "_bytes": 70,
      "translation": "¡Si los dos lo buscamos, nos\nvolveremos a encontrar\nen algún momento!"
    },
    {
      "index": 99,
      "english": "Is it gonna be that easy?",
      "speaker_id": 7011,
      "line_type": 2,
      "_offset": 12143,
      "_bytes": 25,
      "translation": "¿Será tan fácil?"
    },
    {
      "index": 100,
      "english": "The only thing we can do is\nbelieve!",
      "speaker_id": 7071,
      "line_type": 2,
      "_offset": 12169,
      "_bytes": 36,
      "translation": "¡Lo único que podemos hacer\nes creer!"
    },
    {
      "index": 101,
      "english": "...Yeah, you're right! I'll\nbelieve in that!",
      "speaker_id": 7011,
      "line_type": 2,
      "_offset": 12206,
      "_bytes": 44,
      "translation": "...¡Sí, tienes razón! ¡Voy a\ncreer en eso!"
    },
    {
      "index": 102,
      "english": "Yeah, so let's meet up again\nlater!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 12251,
      "_bytes": 35,
      "translation": "¡Sí, veámonos otra vez\nmás tarde!"
    },
    {
      "index": 103,
      "english": "Taiiiiiii! Take care!",
      "speaker_id": 7011,
      "line_type": 2,
      "_offset": 12287,
      "_bytes": 24,
      "translation": "¡Taiiiiiii! ¡Cuídate!"
    },
    {
      "index": 104,
      "english": "You too, Daisuke!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 12312,
      "_bytes": 17,
      "translation": "¡Tú también!"
    },
    {
      "index": 105,
      "english": "Even back in elementary school,\nTai was still the same old\nTai...",
      "speaker_id": 7011,
      "line_type": 2,
      "_offset": 12330,
      "_bytes": 71,
      "translation": "Ya en primaria, Tai era\nel mismo Tai de siempre..."
    },
    {
      "index": 106,
      "english": "Let's go, V-mon!",
      "speaker_id": 7011,
      "line_type": 2,
      "_offset": 12402,
      "_bytes": 16,
      "translation": "¡Vamos, V-mon!"
    },
    {
      "index": 107,
      "english": "Yeah, let's go!",
      "speaker_id": 7071,
      "line_type": 2,
      "_offset": 12419,
      "_bytes": 15,
      "translation": "¡Sí, vamos!"
    },
    {
      "index": 108,
      "english": "　　　　　　【Area 1】",
      "speaker_id": 9003,
      "line_type": 4,
      "_offset": 12435,
