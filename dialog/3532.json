  "dialog": [
    {
      "index": 0,
      "english": "��������Excuse me, is anyone here?",
      "_offset": 3953,
      "_length": 34,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 1,
      "english": "A building, here of all places...",
      "_offset": 3988,
      "_length": 33,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 2,
      "english": "Why don't we take a look inside?",
      "_offset": 4022,
      "_length": 32,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 3,
      "english": "There's a pretty picture!",
      "_offset": 4055,
      "_length": 25,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 4,
      "english": "You're right! But why's there a\npicture of an angel?",
      "_offset": 4081,
      "_length": 52,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 5,
      "english": "There can't be any bad Digimon in\na place with a picture of a pretty\nangel!",
      "_offset": 4134,
      "_length": 75,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 6,
      "english": "I guess it can't be helped.",
      "_offset": 4210,
      "_length": 27,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 7,
      "english": "Let's take a good look around this\nplace.",
      "_offset": 4238,
      "_length": 41,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 8,
      "english": "This is...!",
      "_offset": 4280,
      "_length": 11,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 9,
      "english": "I smell food...and it's a feast!",
      "_offset": 4292,
      "_length": 32,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 10,
      "english": "I smell food...and it's a feast!",
      "_offset": 4325,
      "_length": 32,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 11,
      "english": "I smell food...and it's a feast!",
      "_offset": 4358,
      "_length": 32,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 12,
      "english": "Whaaaaat?!",
      "_offset": 4391,
      "_length": 10,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 13,
      "english": "There!",
      "_offset": 4402,
      "_length": 6,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 14,
      "english": "...Oh, wait, T.K!",
      "_offset": 4409,
      "_length": 20,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 15,
      "english": "You're right! There's a whole\nfeast, right here!",
      "_offset": 4430,
      "_length": 48,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 16,
      "english": "No matter how you look at it,\nthis is too good to be true...",
      "_offset": 4479,
      "_length": 60,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 17,
      "english": "Wow, this is tasty!",
      "_offset": 4540,
      "_length": 19,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 18,
      "english": "It's almost a sin for food to be\nthis good!",
      "_offset": 4560,
      "_length": 43,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 19,
      "english": "...I'm gonna eat it! There's\nnothing wrong with wanting to be\nlucky every so often, right?!",
      "_offset": 4604,
      "_length": 91,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 20,
      "english": "Me too!",
      "_offset": 4696,
      "_length": 7,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 21,
      "english": "Me too!",
      "_offset": 4704,
      "_length": 7,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 22,
      "english": "Me too!",
      "_offset": 4712,
      "_length": 7,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 23,
      "english": "Me too!",
      "_offset": 4720,
      "_length": 7,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 24,
      "english": "Let's eaaaaat!",
      "_offset": 4728,
      "_length": 14,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 25,
      "english": "And Tai and his friends stuffed\nthemselves.",
      "_offset": 4743,
      "_length": 46,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 26,
      "english": "I ate so much!",
      "_offset": 4790,
      "_length": 14,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 27,
      "english": "My stomach's so full, I don't\nthink I can eat any more...",
      "_offset": 4805,
      "_length": 57,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 28,
      "english": "It feels like camping school!",
      "_offset": 4863,
      "_length": 29,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 29,
      "english": "We were *supposed* to be at summer\ncamp, but then...",
      "_offset": 4893,
      "_length": 52,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 30,
      "english": "but then...",
      "_offset": 4946,
      "_length": 11,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 31,
      "english": "but then...",
      "_offset": 4958,
      "_length": 11,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 32,
      "english": "Yeah, we left home thinking we'd\nbe going to summer camp.",
      "_offset": 4974,
      "_length": 57,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 33,
      "english": "we left home...",
      "_offset": 5032,
      "_length": 15,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 34,
      "english": "we left home...",
      "_offset": 5048,
      "_length": 15,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 35,
      "english": "We've been lost in this world for\nfive days. The school and town\nassociation must be in an uproar.",
      "_offset": 5068,
      "_length": 98,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 36,
      "english": "We're all worried about home. I\nam, too...",
      "_offset": 5167,
      "_length": 42,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 37,
      "english": "We'll all be able to go home,\nright...?",
      "_offset": 5210,
      "_length": 39,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 38,
      "english": "Papa... Mama...",
      "_offset": 5250,
      "_length": 15,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 39,
      "english": "I wanna go home...",
      "_offset": 5266,
      "_length": 18,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 40,
      "english": "I didn't want to get everyone\ndepressed, but...",
      "_offset": 5285,
      "_length": 47,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 41,
      "english": "(It's gotten late...)",
      "_offset": 5333,
      "_length": 21,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 42,
      "english": "Talk some more with everyone else",
      "_offset": 5355,
      "_length": 33,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 43,
      "english": "Turn in for the night",
      "_offset": 5389,
      "_length": 21,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 44,
      "english": "Let's call it a day!",
      "_offset": 5411,
      "_length": 20,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 45,
      "english": "I'm kinda sleepy.",
      "_offset": 5432,
      "_length": 17,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 46,
      "english": "Okay then, good night!",
      "_offset": 5450,
      "_length": 22,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 47,
      "english": "They're sleeping. They fell into\nthis trap so easily.",
      "_offset": 5473,
      "_length": 53,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 48,
      "english": "I'll crush 'em while they sleep!",
      "_offset": 5527,
      "_length": 32,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 49,
      "english": "Kill...the children!",
      "_offset": 5560,
      "_length": 20,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 50,
      "english": "Hahahaha...!",
      "_offset": 5581,
      "_length": 12,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 51,
      "english": "Hey...Tai, are you awake?",
      "_offset": 5594,
      "_length": 28,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 52,
      "english": "Mmmf...Agumon, what's wrong?",
      "_offset": 5623,
      "_length": 28,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 53,
      "english": "What's wrong? Say it straight.",
      "_offset": 5656,
      "_length": 30,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 54,
      "english": "P-O-O-P! I gotta use the bathroom.",
      "_offset": 5687,
      "_length": 34,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 55,
      "english": "Got it, got it! Can't be helped.",
      "_offset": 5722,
      "_length": 32,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 56,
      "english": "*yawn* Let's hurry up, find the\nbathroom, and go back to bed.",
      "_offset": 5755,
      "_length": 61,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 57,
      "english": "Tai! I said the bathroom!",
      "_offset": 5817,
      "_length": 28,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 58,
      "english": "Ahaha, looks like I'm still\nsleepy.",
      "_offset": 5846,
      "_length": 35,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 59,
      "english": "Ugh! I can't hold it in much\nlonger!",
      "_offset": 5882,
      "_length": 36,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 60,
      "english": "Tai! That's the dining room!",
      "_offset": 5919,
      "_length": 31,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 61,
      "english": "Ahaha...I don't know why, but my\nstomach still feels empty.",
      "_offset": 5951,
      "_length": 59,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 62,
      "english": "Ugh! I can't hold it in much\nlonger!",
      "_offset": 6011,
      "_length": 36,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 63,
      "english": "Why don't you just go to the\nbathroom by yourself?",
      "_offset": 6048,
      "_length": 50,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 64,
      "english": "I'm sure even *you're* too scared\nto go to the bathroom at night.",
      "_offset": 6099,
      "_length": 65,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 65,
      "english": "Don't be silly! I'm a\nfifth-grader.",
      "_offset": 6165,
      "_length": 35,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 66,
      "english": "What's a fifth grader? Tai, you\nuse too many hard words.",
      "_offset": 6201,
      "_length": 59,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 67,
      "english": "Right, you don't have schools\nhere.",
      "_offset": 6261,
      "_length": 35,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 68,
      "english": "Ah! Tai, did you just hear\nsomething?",
      "_offset": 6297,
      "_length": 40,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 69,
      "english": "Huh? No, nothing out of the\nordinary.",
      "_offset": 6338,
      "_length": 37,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 70,
      "english": "I thought I heard someone\nwhispering over there, but...",
      "_offset": 6376,
      "_length": 55,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 71,
      "english": "Come on, it must be your\nimagination.",
      "_offset": 6432,
      "_length": 37,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 72,
      "english": "But I'm sure I heard a voice.",
      "_offset": 6470,
      "_length": 29,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 73,
      "english": "You're scared to go to the\nbathroom, now you're saying there\nare ghosts...",
      "_offset": 6500,
      "_length": 74,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 74,
      "english": "They exist! Ghost Digimon exist!",
      "_offset": 6575,
      "_length": 32,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 75,
      "english": "Those aren't ghosts, those are\nDigimon!",
      "_offset": 6608,
      "_length": 39,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 76,
      "english": "Good, just in time! Don't go back\nby yourself, okay Tai?",
      "_offset": 6648,
      "_length": 59,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 77,
      "english": "Okay, I'll wait outside.",
      "_offset": 6708,
      "_length": 24,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 78,
      "english": "It's weird, I ate so much, so I\nthought there'd be a lot.",
      "_offset": 6733,
      "_length": 57,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 79,
      "english": "I can't do anything but fart.",
      "_offset": 6791,
      "_length": 29,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 80,
      "english": "Ughhaaaah! I can't take it\nanymore!",
      "_offset": 6821,
      "_length": 35,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 81,
      "english": "Aaaaaaaack!",
      "_offset": 6857,
      "_length": 11,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 82,
      "english": "What's wrong?! Did something\nhappen?",
      "_offset": 6869,
      "_length": 36,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 83,
      "english": "That stinks! That reaaaaaaally\nstinks! You...",
      "_offset": 6906,
      "_length": 45,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 84,
      "english": "It's Ogremon!",
      "_offset": 6952,
      "_length": 13,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 85,
      "english": "Run!",
      "_offset": 6966,
      "_length": 4,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 86,
      "english": "Tai, it's dangerous that way...",
      "_offset": 6971,
      "_length": 34,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 87,
      "english": "Kill...the children!",
      "_offset": 7006,
      "_length": 20,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 88,
      "english": "L-Leomon!",
      "_offset": 7027,
      "_length": 9,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 89,
      "english": "It would have been better if you'd\njust slept quietly.",
      "_offset": 7037,
      "_length": 54,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 90,
      "english": "It's Devimon! He's the strongest,\nmost evil Digimon!",
      "_offset": 7092,
      "_length": 52,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 91,
      "english": "This dream is already over.",
      "_offset": 7145,
      "_length": 27,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 92,
      "english": "W-what's going on?!\nThe mansion crumbled, just like\nthat...",
      "_offset": 7173,
      "_length": 59,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 93,
      "english": "Is this Devimon's power?",
      "_offset": 7233,
      "_length": 24,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 94,
      "english": "You can think of this as the end.\nWhat begins now is a nightmare...",
      "_offset": 7258,
      "_length": 67,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 95,
      "english": "What's going on?! What on earth?",
      "_offset": 7326,
      "_length": 32,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 96,
      "english": "What?! Bring everyone back!\nAgumon! We have to defeat Devimon!",
      "_offset": 7359,
      "_length": 62,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 97,
      "english": "It's weird...I ate so much, but I\ndon't have any power.",
      "_offset": 7422,
      "_length": 55,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 98,
      "english": "Of course. The food and the bath\nwere all illusions.",
      "_offset": 7478,
      "_length": 52,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 99,
      "english": "Why are you doing this to us?",
      "_offset": 7531,
      "_length": 29,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 100,
      "english": "Because you're the Chosen\nChildren.",
      "_offset": 7561,
      "_length": 35,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 101,
      "english": "Chosen Children?!",
      "_offset": 7597,
      "_length": 17,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 102,
      "english": "I've covered the entire File\nIsland in black gears. Next will\nbe the land across the sea!",
      "_offset": 7615,
      "_length": 89,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 103,
      "english": "The other side of the sea? There's\nmore land beyond this island?!",
      "_offset": 7705,
      "_length": 65,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 104,
      "english": "You kids will never live to see\nit, because this will be your\ngrave!",
      "_offset": 7771,
      "_length": 68,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 105,
      "english": "Kill...the children!",
      "_offset": 7840,
      "_length": 20,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 106,
      "english": "Agumon! How are we gonna\nstop Leomon?",
      "_offset": 7861,
      "_length": 37,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 107,
      "english": "My Digivice is...T-the light!",
      "_offset": 7899,
      "_length": 29,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 108,
      "english": "Ghhhhhhh!",
      "_offset": 7929,
      "_length": 9,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 109,
      "english": "Ghaaaaaaaah!!",
      "_offset": 7939,
      "_length": 13,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 110,
      "english": "The evil has been purged! So you\nguys are the Chosen Children!",
      "_offset": 7953,
      "_length": 62,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 111,
      "english": "Again with the whole Chosen\nChildren thing...",
      "_offset": 8016,
      "_length": 45,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 112,
      "english": "Devimon! You'll pay for using\nthose dirty tricks on me!",
      "_offset": 8062,
      "_length": 55,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 113,
      "english": "Leave this to me, boy.",
      "_offset": 8118,
      "_length": 22,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 114,
      "english": "B-but!",
      "_offset": 8141,
      "_length": 6,
      "speaker_id": 0,
      "translation": ""
    },
