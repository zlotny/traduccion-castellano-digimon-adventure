{
  "file_id": "3595",
  "text_count": 55,
  "dialog": [
    {
      "index": 0,
      "english": "��������We should stop here and take a\nquick break.",
      "_offset": 2150,
      "_length": 51,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 1,
      "english": "Yeah.",
      "_offset": 2202,
      "_length": 5,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 2,
      "english": "Aaaaaah, we walked a lot today!",
      "_offset": 2208,
      "_length": 31,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 3,
      "english": "Hey, Yamato!",
      "_offset": 2240,
      "_length": 12,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 4,
      "english": "What is it, Gabumon?",
      "_offset": 2253,
      "_length": 20,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 5,
      "english": "I wanna hear your harmonica again!\nCan you play it for me?",
      "_offset": 2274,
      "_length": 58,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 6,
      "english": "Can you play it for me?",
      "_offset": 2333,
      "_length": 23,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 7,
      "english": "Huh? I'm not that great at it,\nthough... Okay, I'll play. Just\nfor a bit.",
      "_offset": 2357,
      "_length": 73,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 8,
      "english": "Huh? Yamato, you play the\nharmonica?",
      "_offset": 2431,
      "_length": 36,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 9,
      "english": "I wanna hear too!",
      "_offset": 2468,
      "_length": 17,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 10,
      "english": "H-Hey, don't pressure me! Ah!",
      "_offset": 2486,
      "_length": 29,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 11,
      "english": "Aaaaah!",
      "_offset": 2516,
      "_length": 7,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 12,
      "english": "It fell.",
      "_offset": 2524,
      "_length": 8,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 13,
      "english": "I dropped my harmonica...",
      "_offset": 2533,
      "_length": 25,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 14,
      "english": "I'll go and grab it for you!",
      "_offset": 2559,
      "_length": 28,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 15,
      "english": "I can't find it... This lake's so\nfull of trash, I can't see a\nthing.",
      "_offset": 2588,
      "_length": 69,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 16,
      "english": "No way...",
      "_offset": 2658,
      "_length": 9,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 17,
      "english": "Yamato...",
      "_offset": 2668,
      "_length": 9,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 18,
      "english": "So *they're* the ones throwing\ntrash into the lake!",
      "_offset": 2678,
      "_length": 51,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 19,
      "english": "Are they the ones making it dirty?",
      "_offset": 2730,
      "_length": 34,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 20,
      "english": "Even *I* throw my trash out\nproperly!",
      "_offset": 2765,
      "_length": 37,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 21,
      "english": "Let's go after them!",
      "_offset": 2803,
      "_length": 20,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 22,
      "english": "Wait! You over there!",
      "_offset": 2824,
      "_length": 21,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 23,
      "english": "What's up with you?",
      "_offset": 2846,
      "_length": 19,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 24,
      "english": "Who are you?",
      "_offset": 2866,
      "_length": 12,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 25,
      "english": "You two are causing problems by\ndumping all that trash in the\nlake. Stop it!",
      "_offset": 2879,
      "_length": 76,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 26,
      "english": "Huh? Wanna fight?",
      "_offset": 2956,
      "_length": 17,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 27,
      "english": "We'll fight you!",
      "_offset": 2974,
      "_length": 16,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 28,
      "english": "Yamato! Leave this to us!",
      "_offset": 2991,
      "_length": 25,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 29,
      "english": "We lost!",
      "_offset": 3017,
      "_length": 8,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 30,
      "english": "Please forgive us!",
      "_offset": 3026,
      "_length": 18,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 31,
      "english": "Clean up the lake and promise you\nwon't litter anymore!",
      "_offset": 3045,
      "_length": 55,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 32,
      "english": "O-Okay!",
      "_offset": 3101,
      "_length": 7,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 33,
      "english": "We'll do it right away!",
      "_offset": 3109,
      "_length": 23,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 34,
      "english": "Wait here!",
      "_offset": 3133,
      "_length": 10,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 35,
      "english": "We cleaned it up real good!",
      "_offset": 3144,
      "_length": 27,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 36,
      "english": "All right, lemme look for Yamato's\nharmonica one more time!",
      "_offset": 3172,
      "_length": 59,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 37,
      "english": "All right, lemme look for Yamato's\nharmonica one more time!",
      "_offset": 3232,
      "_length": 59,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 38,
      "english": "Hey! Here it is!",
      "_offset": 3292,
      "_length": 16,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 39,
      "english": "Ah! My harmonica! Thanks, Gomamon!",
      "_offset": 3309,
      "_length": 34,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 40,
      "english": "Isn't that great, Yamato?",
      "_offset": 3344,
      "_length": 25,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 41,
      "english": "I found this too, so you can have\nit!",
      "_offset": 3370,
      "_length": 37,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 42,
      "english": "Oh! Good job, Gomamon!",
      "_offset": 3408,
      "_length": 22,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 43,
      "english": "Play your harmonica for us,\nYamato!",
      "_offset": 3431,
      "_length": 35,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 44,
      "english": "Ah...",
      "_offset": 3467,
      "_length": 5,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 45,
      "english": "What's wrong?",
      "_offset": 3473,
      "_length": 13,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 46,
      "english": "I should wash it before I play. It\nfell into all that garbage...",
      "_offset": 3487,
      "_length": 64,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 47,
      "english": "Hey, Yamato. Is your harmonica\nreally that important to you?",
      "_offset": 3552,
      "_length": 60,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 48,
      "english": "Not really...",
      "_offset": 3613,
      "_length": 13,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 49,
      "english": "Well...",
      "_offset": 3627,
      "_length": 7,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 50,
      "english": "It's not exactly an expensive\nharmonica.",
      "_offset": 3635,
      "_length": 40,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 51,
      "english": "But you're having a really hard\ntime parting with it.",
      "_offset": 3676,
      "_length": 53,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 52,
      "english": "It's the first thing I ever bought\nfor myself.",
      "_offset": 3734,
      "_length": 46,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 53,
      "english": "Really?! Then it looks like we'll\nhave to give those two a good\npunishing!",
      "_offset": 3781,
      "_length": 74,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 54,
      "english": "Well, we don't have to go *that*\nfar...",
      "_offset": 3856,
      "_length": 39,
      "speaker_id": 0,
      "translation": ""
    }
  ]
}