{
  "file_id": "3595",
  "format": "etdf",
  "kind": "ETDF",
  "text_count": 56,
  "dialog": [
    {
      "index": 0,
      "english": "We should stop here and take a\nquick break.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 6088,
      "_bytes": 43,
      "translation": "Vamos a parar aquí a\ndescansar un poco."
    },
    {
      "index": 1,
      "english": "Yeah.",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 6132,
      "_bytes": 5,
      "translation": "Sí."
    },
    {
      "index": 2,
      "english": "Aaaaaah, we walked a lot today!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 6138,
      "_bytes": 31,
      "translation": "¡Aaaaaah, hoy caminamos mucho!"
    },
    {
      "index": 3,
      "english": "Hey, Matt!",
      "speaker_id": 2221,
      "line_type": 2,
      "_offset": 6170,
      "_bytes": 12,
      "translation": "¡Oye, Matt!"
    },
    {
      "index": 4,
      "english": "What is it, Gabumon?",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 6183,
      "_bytes": 20,
      "translation": "¿Qué pasa, Gabumon?"
    },
    {
      "index": 5,
      "english": "I wanna hear your harmonica again!\nCan you play it for me?",
      "speaker_id": 2221,
      "line_type": 2,
      "_offset": 6204,
      "_bytes": 58,
      "translation": "¡Quiero oír tu armónica\notra vez! ¿La tocas para mí?"
    },
    {
      "index": 6,
      "english": "Can you play it for me?",
      "speaker_id": 8061,
      "line_type": 2,
      "_offset": 6263,
      "_bytes": 23,
      "translation": "¿La tocas para mí?"
    },
    {
      "index": 7,
      "english": "Huh? I'm not that great at it,\nthough... Okay, I'll play. Just\nfor a bit.",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 6287,
      "_bytes": 73,
      "translation": "¿Eh? No se me da tan bien,\npero... vale, toco un\npoco."
    },
    {
      "index": 8,
      "english": "Huh? Matt, you play the\nharmonica?",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 6361,
      "_bytes": 36,
      "translation": "¿Eh? Matt, ¿tocas la\narmónica?"
    },
    {
      "index": 9,
      "english": "I wanna hear too!",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 6398,
      "_bytes": 17,
      "translation": "¡Yo también quiero oírla!"
    },
    {
      "index": 10,
      "english": "H-Hey, don't pressure me! Ah!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 6416,
      "_bytes": 29,
      "translation": "¡N-No me presionéis! ¡Ah!"
    },
    {
      "index": 11,
      "english": "Aaaaah!",
      "speaker_id": 2221,
      "line_type": 2,
      "_offset": 6446,
      "_bytes": 7,
      "translation": "¡Aaaaah!"
    },
    {
      "index": 12,
      "english": "It fell.",
      "speaker_id": 2221,
      "line_type": 2,
      "_offset": 6454,
      "_bytes": 8,
      "translation": "Se cayó."
    },
    {
      "index": 13,
      "english": "I dropped my harmonica...",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 6463,
      "_bytes": 25,
      "translation": "Se me cayó la armónica..."
    },
    {
      "index": 14,
      "english": "I'll go and grab it for you!",
      "speaker_id": 2621,
      "line_type": 2,
      "_offset": 6489,
      "_bytes": 28,
      "translation": "¡Voy a por ella!"
    },
    {
      "index": 15,
      "english": "I can't find it... This lake's so\nfull of trash, I can't see a\nthing.",
      "speaker_id": 2621,
      "line_type": 2,
      "_offset": 6518,
      "_bytes": 69,
      "translation": "No la encuentro... El lago\ntiene tanta basura que no\nveo nada."
    },
    {
      "index": 16,
      "english": "No way...",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 6588,
      "_bytes": 9,
      "translation": "Vaya..."
    },
    {
      "index": 17,
      "english": "Matt...",
      "speaker_id": 2221,
      "line_type": 2,
      "_offset": 6598,
      "_bytes": 9,
      "translation": "Matt..."
    },
    {
      "index": 18,
      "english": "So *they're* the ones throwing\ntrash into the lake!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 6608,
      "_bytes": 51,
      "translation": "¡Así que son ellos los que\ntiran basura al lago!"
    },
    {
      "index": 19,
      "english": "Are they the ones making it dirty?",
      "speaker_id": 2221,
      "line_type": 2,
      "_offset": 6660,
      "_bytes": 34,
      "translation": "¿Son ellos los que lo ensucian?"
    },
    {
      "index": 20,
      "english": "Even *I* throw my trash out\nproperly!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 6695,
      "_bytes": 37,
      "translation": "¡Hasta yo tiro mi basura\nbien!"
    },
    {
      "index": 21,
      "english": "Let's go after them!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 6733,
      "_bytes": 20,
      "translation": "¡Vamos tras ellos!"
    },
    {
      "index": 22,
      "english": "Wait! You over there!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 6754,
      "_bytes": 21,
      "translation": "¡Esperad! ¡Vosotros!"
    },
    {
      "index": 23,
      "english": "What's up with you?",
      "speaker_id": 4101,
      "line_type": 2,
      "_offset": 6776,
      "_bytes": 19,
      "translation": "¿Qué te pasa a ti?"
    },
    {
      "index": 24,
      "english": "Who are you?",
      "speaker_id": 4341,
      "line_type": 2,
      "_offset": 6796,
      "_bytes": 12,
      "translation": "¿Quién eres?"
    },
    {
      "index": 25,
      "english": "You two are causing problems by\ndumping all that trash in the\nlake. Stop it!",
      "speaker_id": 2221,
      "line_type": 2,
      "_offset": 6809,
      "_bytes": 76,
      "translation": "Vosotros dos causáis\nproblemas tirando basura\nal lago. ¡Parad ya!"
    },
    {
      "index": 26,
      "english": "Huh? Wanna fight?",
      "speaker_id": 4101,
      "line_type": 2,
      "_offset": 6886,
      "_bytes": 17,
      "translation": "¿Eh? ¿Quieres pelea?"
    },
    {
      "index": 27,
      "english": "We'll fight you!",
      "speaker_id": 4341,
      "line_type": 2,
      "_offset": 6904,
      "_bytes": 16,
      "translation": "¡Lucharemos!"
    },
    {
      "index": 28,
      "english": "Matt! Leave this to us!",
      "speaker_id": 2221,
      "line_type": 2,
      "_offset": 6921,
      "_bytes": 25,
      "translation": "¡Matt! ¡Déjanoslo a nosotros!"
    },
    {
      "index": 29,
      "english": "We lost!",
      "speaker_id": 4101,
      "line_type": 2,
      "_offset": 6947,
      "_bytes": 8,
      "translation": "¡Perdimos!"
    },
    {
      "index": 30,
      "english": "Please forgive us!",
      "speaker_id": 4341,
      "line_type": 2,
      "_offset": 6956,
      "_bytes": 18,
      "translation": "¡Perdonadnos!"
    },
    {
      "index": 31,
      "english": "Clean up the lake and promise you\nwon't litter anymore!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 6975,
      "_bytes": 55,
      "translation": "¡Limpiad el lago y prometed\nno tirar más basura!"
    },
    {
      "index": 32,
      "english": "O-Okay!",
      "speaker_id": 4101,
      "line_type": 2,
      "_offset": 7031,
      "_bytes": 7,
      "translation": "¡V-Vale!"
    },
    {
      "index": 33,
      "english": "We'll do it right away!",
      "speaker_id": 4341,
      "line_type": 2,
      "_offset": 7039,
      "_bytes": 23,
      "translation": "¡Lo haremos ya mismo!"
    },
    {
      "index": 34,
      "english": "Wait here!",
      "speaker_id": 4101,
      "line_type": 2,
      "_offset": 7063,
      "_bytes": 10,
      "translation": "¡Esperad!"
    },
    {
      "index": 35,
      "english": "We cleaned it up real good!",
      "speaker_id": 4341,
      "line_type": 2,
      "_offset": 7074,
      "_bytes": 27,
      "translation": "¡Lo limpiamos genial!"
    },
    {
      "index": 36,
      "english": "All right, lemme look for Matt's\nharmonica one more time!",
      "speaker_id": 2621,
      "line_type": 2,
      "_offset": 7102,
      "_bytes": 59,
      "translation": "¡Vale, voy a buscar la\narmónica de Matt otra vez!"
    },
    {
      "index": 37,
      "english": "All right, lemme look for Matt's\nharmonica one more time!",
      "speaker_id": 8061,
      "line_type": 2,
      "_offset": 7162,
      "_bytes": 59,
      "translation": "¡Vale, voy a buscar la\narmónica de Matt otra vez!"
    },
    {
      "index": 38,
      "english": "Hey! Here it is!",
      "speaker_id": 2621,
      "line_type": 2,
      "_offset": 7222,
      "_bytes": 16,
      "translation": "¡Eh! ¡Aquí está!"
    },
    {
      "index": 39,
      "english": "Ah! My harmonica! Thanks, Gomamon!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 7239,
      "_bytes": 34,
      "translation": "¡Ah! ¡Mi armónica! ¡Gracias, Gomamon!"
    },
    {
      "index": 40,
      "english": "Isn't that great, Matt?",
      "speaker_id": 2221,
      "line_type": 2,
      "_offset": 7274,
      "_bytes": 25,
      "translation": "¿No es genial, Matt?"
    },
    {
      "index": 41,
      "english": "I found this too, so you can have\nit!",
      "speaker_id": 2621,
      "line_type": 2,
      "_offset": 7300,
      "_bytes": 37,
      "translation": "¡Encontré esto también, es\npara ti!"
    },
    {
      "index": 42,
      "english": "Oh! Good job, Gomamon!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 7338,
      "_bytes": 22,
      "translation": "¡Bien hecho, Gomamon!"
    },
    {
      "index": 43,
      "english": "Play your harmonica for us,\nMatt!",
      "speaker_id": 2221,
      "line_type": 2,
      "_offset": 7361,
      "_bytes": 35,
      "translation": "¡Tócanos la armónica,\nMatt!"
    },
    {
      "index": 44,
      "english": "Ah...",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 7397,
      "_bytes": 5,
      "translation": "Ah..."
    },
    {
      "index": 45,
      "english": "What's wrong?",
      "speaker_id": 2221,
      "line_type": 2,
      "_offset": 7403,
      "_bytes": 13,
      "translation": "¿Qué pasa?"
    },
    {
      "index": 46,
      "english": "I should wash it before I play. It\nfell into all that garbage...",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 7417,
      "_bytes": 64,
      "translation": "Debería lavarla antes de\ntocar. Cayó en toda esa\nbasura..."
    },
    {
      "index": 47,
      "english": "Hey, Matt. Is your harmonica\nreally that important to you?",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 7482,
      "_bytes": 60,
      "translation": "Oye, Matt. ¿De verdad te\nimporta tanto tu armónica?"
    },
    {
      "index": 48,
      "english": "Not really...",
      "speaker_id": 4294967295,
      "line_type": 2,
      "_offset": 7543,
      "_bytes": 13,
      "translation": "No mucho..."
    },
    {
      "index": 49,
      "english": "Well...",
      "speaker_id": 4294967295,
      "line_type": 2,
      "_offset": 7557,
      "_bytes": 7,
      "translation": "Pues..."
    },
    {
      "index": 50,
      "english": "It's not exactly an expensive\nharmonica.",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 7565,
      "_bytes": 40,
      "translation": "No es una armónica muy\ncara, la verdad."
    },
    {
      "index": 51,
      "english": "But you're having a really hard\ntime parting with it.",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 7606,
      "_bytes": 53,
      "translation": "Pero te cuesta mucho\nsepararte de ella."
    },
    {
      "index": 52,
      "english": "...",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 7660,
      "_bytes": 3,
      "translation": "..."
    },
    {
      "index": 53,
      "english": "It's the first thing I ever bought\nfor myself.",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 7664,
      "_bytes": 46,
      "translation": "Es lo primero que me\ncompré yo mismo."
    },
    {
      "index": 54,
      "english": "Really?! Then it looks like we'll\nhave to give those two a good\npunishing!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 7711,
      "_bytes": 74,
      "translation": "¡¿En serio?! ¡Entonces habrá\nque darles un buen castigo\na esos dos!"
    },
    {
      "index": 55,
      "english": "Well, we don't have to go *that*\nfar...",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 7786,
      "_bytes": 39,
      "translation": "Bueno, no hace falta\nllegar tan lejos..."
    }
  ]
}