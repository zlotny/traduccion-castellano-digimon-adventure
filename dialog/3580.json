{
  "file_id": "3580",
  "format": "etdf",
  "kind": "ETDF",
  "text_count": 86,
  "dialog": [
    {
      "index": 0,
      "english": "Nf... U-Ugh...",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 9512,
      "_bytes": 14,
      "translation": "U-ugh..."
    },
    {
      "index": 1,
      "english": "Where am...?",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 9527,
      "_bytes": 12,
      "translation": "¿Dónde...?"
    },
    {
      "index": 2,
      "english": "Oh, you're awake?",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 9540,
      "_bytes": 17,
      "translation": "¿Has despertado?"
    },
    {
      "index": 3,
      "english": "Kari!",
      "speaker_id": 2831,
      "line_type": 2,
      "_offset": 9558,
      "_bytes": 7,
      "translation": "¡Kari!"
    },
    {
      "index": 4,
      "english": "T.K... Tailmon...",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 9566,
      "_bytes": 20,
      "translation": "T.K... Gatomon..."
    },
    {
      "index": 5,
      "english": "How do you feel?",
      "speaker_id": 2831,
      "line_type": 2,
      "_offset": 9587,
      "_bytes": 16,
      "translation": "¿Cómo te sientes?"
    },
    {
      "index": 6,
      "english": "My fever's coming down. And I feel\na lot better.",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 9604,
      "_bytes": 48,
      "translation": "Se me baja la fiebre. Y me\nsiento mucho mejor."
    },
    {
      "index": 7,
      "english": "Oh, Kari! You're awake.",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 9653,
      "_bytes": 25,
      "translation": "¡Kari! Ya has despertado."
    },
    {
      "index": 8,
      "english": "Sora...?",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 9679,
      "_bytes": 8,
      "translation": "¿Sora...?"
    },
    {
      "index": 9,
      "english": "Where's Tai?",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 9688,
      "_bytes": 15,
      "translation": "¿Dónde está Tai?"
    },
    {
      "index": 10,
      "english": "I couldn't find him anywhere\nnearby, but I've found this: cold\nmedicine!",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 9704,
      "_bytes": 72,
      "translation": "No lo encontré, pero hallé\nesto: ¡medicina para el\nresfriado!"
    },
    {
      "index": 11,
      "english": "Pretty sure Tai must have\ngotten it for you and dropped it.",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 9777,
      "_bytes": 62,
      "translation": "Seguro que Tai la consiguió\npara ti y se le cayó."
    },
    {
      "index": 12,
      "english": "Medicine that Tai had... so\ndoes that mean he's somewhere\naround here?",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 9840,
      "_bytes": 73,
      "translation": "La medicina de Tai... ¿o sea\nque está por aquí cerca?"
    },
    {
      "index": 13,
      "english": "Seems like this place is a maze.\nIf we look for him together, I'm\nsure we'll find him.",
      "speaker_id": 2321,
      "line_type": 2,
      "_offset": 9914,
      "_bytes": 86,
      "translation": "Parece que esto es un laberinto.\nSi lo buscamos juntos, seguro\nque lo encontramos."
    },
    {
      "index": 14,
      "english": "You see? So cheer up!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 10001,
      "_bytes": 21,
      "translation": "¿Ves? ¡Así que anímate!"
    },
    {
      "index": 15,
      "english": "I'll help you guys out! I'm his\nlittle sister, after all!",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 10023,
      "_bytes": 57,
      "translation": "¡Os ayudaré! ¡Al fin y al cabo,\nsoy su hermana pequeña!"
    },
    {
      "index": 16,
      "english": "Wait!",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 10081,
      "_bytes": 5,
      "translation": "¡Alto!"
    },
    {
      "index": 17,
      "english": "What's wrong, Sora?",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 10087,
      "_bytes": 19,
      "translation": "¿Qué pasa, Sora?"
    },
    {
      "index": 18,
      "english": "Quiet! I can hear voices coming\nfrom there!",
      "speaker_id": 2321,
      "line_type": 2,
      "_offset": 10107,
      "_bytes": 43,
      "translation": "¡Silencio! ¡Oigo voces\nque vienen de allí!"
    },
    {
      "index": 19,
      "english": "Let's get a little closer.",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 10151,
      "_bytes": 26,
      "translation": "Acerquémonos un poco."
    },
    {
      "index": 20,
      "english": "Work! Work! Work harder!",
      "speaker_id": 4461,
      "line_type": 2,
      "_offset": 10178,
      "_bytes": 24,
      "translation": "¡Trabajad! ¡Trabajad! ¡Más!"
    },
    {
      "index": 21,
      "english": "Nuuuu!",
      "speaker_id": 4031,
      "line_type": 2,
      "_offset": 10203,
      "_bytes": 6,
      "translation": "¡Nuuuu!"
    },
    {
      "index": 22,
      "english": "Listen up, Numemon. This here\nmountain's the property of\nMugendramon.",
      "speaker_id": 4461,
      "line_type": 2,
      "_offset": 10210,
      "_bytes": 69,
      "translation": "Escuchad, Numemon. Esta montaña\nes propiedad de Machinedramon."
    },
    {
      "index": 23,
      "english": "And you all are the power source\nfor the greater urban area! So\nwork, work, work until you die!",
      "speaker_id": 4461,
      "line_type": 2,
      "_offset": 10280,
      "_bytes": 95,
      "translation": "¡Sois la fuente de energía de\nla gran zona urbana! ¡Así que\na trabajar hasta morir!"
    },
    {
      "index": 24,
      "english": "Nuuuu!!",
      "speaker_id": 4031,
      "line_type": 2,
      "_offset": 10376,
      "_bytes": 7,
      "translation": "¡¡Nuuuu!!"
    },
    {
      "index": 25,
      "english": "Is that... Monzaemon?",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 10384,
      "_bytes": 21,
      "translation": "Eso es... ¿Monzaemon?"
    },
    {
      "index": 26,
      "english": "That's not Monzaemon. It's\nWaruMonzaemon!",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 10406,
      "_bytes": 41,
      "translation": "Ese no es Monzaemon. ¡Es\nWaruMonzaemon!"
    },
    {
      "index": 27,
      "english": "The poor Numemon...",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 10448,
      "_bytes": 19,
      "translation": "Pobres Numemon..."
    },
    {
      "index": 28,
      "english": "Kari...?!",
      "speaker_id": 2831,
      "line_type": 2,
      "_offset": 10468,
      "_bytes": 11,
      "translation": "¡¿Kari...?!"
    },
    {
      "index": 29,
      "english": "?!",
      "speaker_id": 9001,
      "line_type": 2,
      "_offset": 10480,
      "_bytes": 2,
      "translation": "?!"
    },
    {
      "index": 30,
      "english": "Nuuuu!?",
      "speaker_id": 4032,
      "line_type": 2,
      "_offset": 10483,
      "_bytes": 7,
      "translation": "¿¡Nuuuu!?"
    },
    {
      "index": 31,
      "english": "What's going on? Flaking off now?",
      "speaker_id": 4461,
      "line_type": 2,
      "_offset": 10491,
      "_bytes": 33,
      "translation": "¿Qué pasa? ¿Dejáis de currar?"
    },
    {
      "index": 32,
      "english": "Y...You!!",
      "speaker_id": 4461,
      "line_type": 2,
      "_offset": 10525,
      "_bytes": 9,
      "translation": "¡¡T...Tú!!"
    },
    {
      "index": 33,
      "english": "Gyaaaaah! Run!!",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 10535,
      "_bytes": 15,
      "translation": "¡Gyaaah! ¡¡Huid!!"
    },
    {
      "index": 34,
      "english": "Hey! Stop right there!",
      "speaker_id": 4461,
      "line_type": 2,
      "_offset": 10551,
      "_bytes": 22,
      "translation": "¡Eh! ¡Quietos ahí!"
    },
    {
      "index": 35,
      "english": "Tailmon, don't worry about me. We\nhave to free the Numemon.",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 10574,
      "_bytes": 59,
      "translation": "Gatomon, no te preocupes.\nHay que liberar a los Numemon."
    },
    {
      "index": 36,
      "english": "All right...",
      "speaker_id": 2831,
      "line_type": 2,
      "_offset": 10634,
      "_bytes": 12,
      "translation": "Vale..."
    },
    {
      "index": 37,
      "english": "Stop!",
      "speaker_id": 4461,
      "line_type": 2,
      "_offset": 10647,
      "_bytes": 5,
      "translation": "¡Alto!"
    },
    {
      "index": 38,
      "english": "What are we gonna do, Sora?",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 10653,
      "_bytes": 27,
      "translation": "¿Qué hacemos, Sora?"
    },
    {
      "index": 39,
      "english": "The only thing we can do is run!",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 10681,
      "_bytes": 32,
      "translation": "¡Solo podemos correr!"
    },
    {
      "index": 40,
      "english": "Lady Kari... Lady Kari...",
      "speaker_id": 4032,
      "line_type": 2,
      "_offset": 10714,
      "_bytes": 29,
      "translation": "Ama Kari... Ama Kari..."
    },
    {
      "index": 41,
      "english": "The Numemon are...",
      "speaker_id": 2831,
      "line_type": 2,
      "_offset": 10744,
      "_bytes": 18,
      "translation": "Los Numemon..."
    },
    {
      "index": 42,
      "english": "...",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 10763,
      "_bytes": 3,
      "translation": "..."
    },
    {
      "index": 43,
      "english": "Gyaaaaah!",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 10767,
      "_bytes": 9,
      "translation": "¡Gyaaaaah!"
    },
    {
      "index": 44,
      "english": "Aaaaah!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 10777,
      "_bytes": 7,
      "translation": "¡Aaaaah!"
    },
    {
      "index": 45,
      "english": "...",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 10785,
      "_bytes": 3,
      "translation": "..."
    },
    {
      "index": 46,
      "english": "Kari?",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 10789,
      "_bytes": 7,
      "translation": "¿Kari?"
    },
    {
      "index": 47,
      "english": "Nu, nuuuuuu!",
      "speaker_id": 4031,
      "line_type": 2,
      "_offset": 10797,
      "_bytes": 12,
      "translation": "¡Nu, nuuuuuu!"
    },
    {
      "index": 48,
      "english": "Hey, you Numemon over there!\nWhaddya think you're doing?",
      "speaker_id": 4461,
      "line_type": 2,
      "_offset": 10810,
      "_bytes": 56,
      "translation": "¡Eh, vosotros, Numemon!\n¿Qué creéis que hacéis?"
    },
    {
      "index": 49,
      "english": "Nu!",
      "speaker_id": 4032,
      "line_type": 2,
      "_offset": 10867,
      "_bytes": 3,
      "translation": "¡Nu!"
    },
    {
      "index": 50,
      "english": "...Gh! Who released the Numemon?",
      "speaker_id": 4461,
      "line_type": 2,
      "_offset": 10871,
      "_bytes": 32,
      "translation": "...¡Argh! ¿Quién los soltó?"
    },
    {
      "index": 51,
      "english": "That would be me.",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 10904,
      "_bytes": 17,
      "translation": "He sido yo."
    },
    {
      "index": 52,
      "english": "Kari!",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 10922,
      "_bytes": 7,
      "translation": "¡Kari!"
    },
    {
      "index": 53,
      "english": "Kari!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 10930,
      "_bytes": 7,
      "translation": "¡Kari!"
    },
    {
      "index": 54,
      "english": "Why, you!",
      "speaker_id": 4461,
      "line_type": 2,
      "_offset": 10938,
      "_bytes": 9,
      "translation": "¡Serás...!"
    },
    {
      "index": 55,
      "english": "Nuuuu!",
      "speaker_id": 4031,
      "line_type": 2,
      "_offset": 10948,
      "_bytes": 6,
      "translation": "¡Nuuuu!"
    },
    {
      "index": 56,
      "english": "You think you can defeat *me*, the\ngreat WaruMonzaemon?",
      "speaker_id": 4461,
      "line_type": 2,
      "_offset": 10955,
      "_bytes": 55,
      "translation": "¿Creéis que podéis derrotar\nal gran WaruMonzaemon?"
    },
    {
      "index": 57,
      "english": "Nu, nu!",
      "speaker_id": 4031,
      "line_type": 2,
      "_offset": 11011,
      "_bytes": 7,
      "translation": "¡Nu, nu!"
    },
    {
      "index": 58,
      "english": "Hah hah ha! It's the end for you!",
      "speaker_id": 4461,
      "line_type": 2,
      "_offset": 11019,
      "_bytes": 33,
      "translation": "¡Ja ja ja! ¡Se acabó para vosotros!"
    },
    {
      "index": 59,
      "english": "W-What's with this light...",
      "speaker_id": 4461,
      "line_type": 2,
      "_offset": 11053,
      "_bytes": 27,
      "translation": "¿Q-qué es esta luz...?"
    },
    {
      "index": 60,
      "english": "Kari...",
      "speaker_id": 2831,
      "line_type": 2,
      "_offset": 11081,
      "_bytes": 9,
      "translation": "Kari..."
    },
    {
      "index": 61,
      "english": "I feel power coming from inside\nher...",
      "speaker_id": 2321,
      "line_type": 2,
      "_offset": 11091,
      "_bytes": 38,
      "translation": "Noto un poder saliendo\nde ella..."
    },
    {
      "index": 62,
      "english": "Yeah, there's power overflowing\nfrom inside her body!",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 11130,
      "_bytes": 53,
      "translation": "¡Sí, hay un poder que desborda\nde todo su cuerpo!"
    },
    {
      "index": 63,
      "english": "Wanna try going at it?",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 11184,
      "_bytes": 22,
      "translation": "¿Vamos a por él?"
    },
    {
      "index": 64,
      "english": "Yeah! Leave it to us!",
      "speaker_id": 2321,
      "line_type": 2,
      "_offset": 11207,
      "_bytes": 21,
      "translation": "¡Sí! ¡Dejádnoslo!"
    },
    {
      "index": 65,
      "english": "I'm ready whenever you are!",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 11229,
      "_bytes": 27,
      "translation": "¡Listo cuando queráis!"
    },
    {
      "index": 66,
      "english": "Gaaahh!!",
      "speaker_id": 4461,
      "line_type": 2,
      "_offset": 11257,
      "_bytes": 8,
      "translation": "¡¡Gaaahh!!"
    },
    {
      "index": 67,
      "english": "Are you okay, Numemon?",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 11266,
      "_bytes": 22,
      "translation": "¿Estáis bien, Numemon?"
    },
    {
      "index": 68,
      "english": "Nu... nu...",
      "speaker_id": 4031,
      "line_type": 2,
      "_offset": 11289,
      "_bytes": 11,
      "translation": "Nu... nu..."
    },
    {
      "index": 69,
      "english": "They'll be okay in no time flat!",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 11301,
      "_bytes": 32,
      "translation": "¡Se pondrán bien enseguida!"
    },
    {
      "index": 70,
      "english": "Thank goodness...",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 11334,
      "_bytes": 17,
      "translation": "Menos mal..."
    },
    {
      "index": 71,
      "english": "Kari's light...",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 11352,
      "_bytes": 17,
      "translation": "La luz de Kari..."
    },
    {
      "index": 72,
      "english": "The light is showing us the way...",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 11370,
      "_bytes": 34,
      "translation": "La luz nos muestra el camino..."
    },
    {
      "index": 73,
      "english": "If we keep following the light,\nmaybe we'll find Tai and the\nothers!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 11405,
      "_bytes": 71,
      "translation": "¡Si seguimos la luz, seguro que\nencontramos a Tai y a los demás!"
    },
    {
      "index": 74,
      "english": "Okay! We'll put our faith in your\nlight, Kari.",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 11477,
      "_bytes": 48,
      "translation": "¡Vale! Confiaremos en tu luz,\nKari."
    },
    {
      "index": 75,
      "english": "Sora... I wonder how Matt is\ndoing?",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 11526,
      "_bytes": 37,
      "translation": "Sora... ¿cómo estará\nMatt?"
    },
    {
      "index": 76,
      "english": "Matt has Gabumon with him.",
      "speaker_id": 4294967295,
      "line_type": 2,
      "_offset": 11564,
      "_bytes": 28,
      "translation": "Matt tiene a Gabumon con él."
    },
    {
      "index": 77,
      "english": "He wouldn't want you sad, T.K.",
      "speaker_id": 4294967295,
      "line_type": 2,
      "_offset": 11593,
      "_bytes": 33,
      "translation": "No querría verte triste, T.K."
    },
    {
      "index": 78,
      "english": "Those two won't be taken down so\neasily.",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 11627,
      "_bytes": 40,
      "translation": "Esos dos no caerán tan\nfácilmente."
    },
    {
      "index": 79,
      "english": "I'm sure he'll come back when he\nfeels better.",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 11668,
      "_bytes": 46,
      "translation": "Seguro que vuelve en cuanto\nse encuentre mejor."
    },
    {
      "index": 80,
      "english": "Yeah...",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 11715,
      "_bytes": 7,
      "translation": "Sí..."
    },
    {
      "index": 81,
      "english": "I'm sure he's thinking of you,\nT.K.",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 11723,
      "_bytes": 38,
      "translation": "Seguro que está pensando\nen ti, T.K."
    },
    {
      "index": 82,
      "english": "So have faith in him, okay?",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 11762,
      "_bytes": 27,
      "translation": "Confía en él, ¿vale?"
    },
    {
      "index": 83,
      "english": "You're right... Matt's always\nthinking of me.",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 11790,
      "_bytes": 47,
      "translation": "Tienes razón... Matt siempre\npiensa en mí."
    },
    {
      "index": 84,
      "english": "But this time, I'll be the one to\nlook after him!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 11838,
      "_bytes": 49,
      "translation": "¡Pero esta vez, yo cuidaré\nde él!"
    },
    {
      "index": 85,
      "english": "Yeah!",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 11888,
      "_bytes": 5,
      "translation": "¡Sí!"
    }
  ]
}