{
  "file_id": "3541",
  "format": "etdf",
  "kind": "ETDF",
  "text_count": 177,
  "dialog": [
    {
      "index": 0,
      "english": "This is the base of Infinity\nMountain.",
      "speaker_id": 4071,
      "line_type": 2,
      "_offset": 15784,
      "_bytes": 38,
      "translation": "Esta es la base del Monte Mugen."
    },
    {
      "index": 1,
      "english": "That's where Devimon's waiting for\nus.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15823,
      "_bytes": 38,
      "translation": "Aquí es donde nos espera Devimon."
    },
    {
      "index": 2,
      "english": "Heeeeeeeey!",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 15862,
      "_bytes": 11,
      "translation": "¡Eeeeeh!"
    },
    {
      "index": 3,
      "english": "Tai! Guys!",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 15874,
      "_bytes": 13,
      "translation": "¡Tai! ¡Chicos!"
    },
    {
      "index": 4,
      "english": "!!",
      "speaker_id": 9001,
      "line_type": 2,
      "_offset": 15888,
      "_bytes": 2,
      "translation": "!!"
    },
    {
      "index": 5,
      "english": "Joe, Sora! You're safe!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15891,
      "_bytes": 23,
      "translation": "¡Joe, Sora! ¡Estáis bien!"
    },
    {
      "index": 6,
      "english": "Glad we could catch up to you...",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 15915,
      "_bytes": 32,
      "translation": "Menos mal que os pillamos..."
    },
    {
      "index": 7,
      "english": "I was worried about what we'd do\nif you'd left us behind.",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 15948,
      "_bytes": 57,
      "translation": "Me preocupaba qué hacer si nos\ndejabais atrás."
    },
    {
      "index": 8,
      "english": "I'm really glad you two are safe!",
      "speaker_id": 4294967295,
      "line_type": 2,
      "_offset": 16006,
      "_bytes": 33,
      "translation": "¡Me alegra que estéis bien!"
    },
    {
      "index": 9,
      "english": "I thought you two were gonna run.",
      "speaker_id": 4294967295,
      "line_type": 2,
      "_offset": 16040,
      "_bytes": 33,
      "translation": "Pensaba que os largaríais."
    },
    {
      "index": 10,
      "english": "Tai...",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 16074,
      "_bytes": 9,
      "translation": "Tai..."
    },
    {
      "index": 11,
      "english": "What's wrong, Tai? You're not\nacting like yourself.",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 16084,
      "_bytes": 54,
      "translation": "¿Qué pasa, Tai? No pareces tú\nmismo."
    },
    {
      "index": 12,
      "english": "This is a great day, because we\ngot to meet up with you guys\nagain!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16139,
      "_bytes": 67,
      "translation": "¡Es un día genial, porque nos\nhemos podido reunir de nuevo!"
    },
    {
      "index": 13,
      "english": "Taiiiiii!",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 16207,
      "_bytes": 12,
      "translation": "¡Taiiiii!"
    },
    {
      "index": 14,
      "english": "How rude, Tai!",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 16220,
      "_bytes": 17,
      "translation": "¡Qué borde!"
    },
    {
      "index": 15,
      "english": "Sorry, sorry!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16238,
      "_bytes": 13,
      "translation": "¡Perdón!"
    },
    {
      "index": 16,
      "english": "Okay, we're all here!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16252,
      "_bytes": 21,
      "translation": "¡Vale, estamos todos!"
    },
    {
      "index": 17,
      "english": "And we've got Leomon helping us\nout as well.",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 16274,
      "_bytes": 44,
      "translation": "Y tenemos a Leomon de ayuda\ntambién."
    },
    {
      "index": 18,
      "english": "Whoa! Seems like a lot's happened\nwhile we were gone.",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 16319,
      "_bytes": 53,
      "translation": "¡Uah! Ocurrieron muchas\ncosas desde la última vez."
    },
    {
      "index": 19,
      "english": "I'm surprised.",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 16373,
      "_bytes": 14,
      "translation": "Me sorprende."
    },
    {
      "index": 20,
      "english": "It's the least I can do to atone.\nPlease allow me to assist you.",
      "speaker_id": 4071,
      "line_type": 2,
      "_offset": 16388,
      "_bytes": 64,
      "translation": "Quiero redimirme. Dejad que os\nayude."
    },
    {
      "index": 21,
      "english": "It's fine, I was just surprised.",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 16453,
      "_bytes": 32,
      "translation": "Está bien, sólo me sorprende."
    },
    {
      "index": 22,
      "english": "Looking forward to working with\nyou!",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 16486,
      "_bytes": 36,
      "translation": "¡Encantada de trabajar contigo!"
    },
    {
      "index": 23,
      "english": "Okay, let's go find Devimon!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16523,
      "_bytes": 28,
      "translation": "¡Vale, encontremos a Devimon!"
    },
    {
      "index": 24,
      "english": "I think we've got a fighting\nchance against Devimon, since Sora\nand Joe arrived just in time.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16552,
      "_bytes": 93,
      "translation": "Creo que tenemos alguna\noportunidad contra Devimon, ya\nque Sora y Joe están aquí."
    },
    {
      "index": 25,
      "english": "But Devimon's much stronger than\nthe enemies we've fought so far.",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 16646,
      "_bytes": 65,
      "translation": "Pero Devimon es más fuerte\nque los enemigos que hemos\ntenido hasta ahora."
    },
    {
      "index": 26,
      "english": "True, but we can use the Digivices\nnow!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16712,
      "_bytes": 39,
      "translation": "¡Cierto, pero tenemos los\ndispositivos!"
    },
    {
      "index": 27,
      "english": "Yeah! We'll defeat Devimon and get\nback to our world, for sure!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 16752,
      "_bytes": 63,
      "translation": "¡Sí! ¡Derrotaremos a Devimon y\nvolveremos a nuestro mundo!"
    },
    {
      "index": 28,
      "english": "If we defeat Devimon, we'll\nfinally get to go home.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16816,
      "_bytes": 51,
      "translation": "Si le derrotamos, podremos\nvolver."
    },
    {
      "index": 29,
      "english": "Finally, at last. I've missed so\nmany days of cram school.",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 16868,
      "_bytes": 58,
      "translation": "Por fin. He perdido muchos días\nde academia."
    },
    {
      "index": 30,
      "english": "Is cram school the only thing you\nworry about?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16927,
      "_bytes": 46,
      "translation": "¿Es la academia lo único que te\npreocupa?"
    },
    {
      "index": 31,
      "english": "I can't help it! I'm a student,\nyou know!",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 16974,
      "_bytes": 41,
      "translation": "¡No lo puedo evitar! Soy\nestudiante, ¿sabes?"
    },
    {
      "index": 32,
      "english": "In that case, we'll have to do our\nbest for the sake of your grades!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17016,
      "_bytes": 68,
      "translation": "¡En ese caso, esfuérzate al máximo\npor el bien de tus notas!"
    },
    {
      "index": 33,
      "english": "You saved us when you figured out\nthe Digivice's secret, Izzy.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17085,
      "_bytes": 67,
      "translation": "Nos salvaste con el secreto de\nlos dispositivos, Izzy."
    },
    {
      "index": 34,
      "english": "It was a coincidence; we just\nhappened to be in the old ruins.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 17153,
      "_bytes": 62,
      "translation": "Fue coincidencia; resulta que\nacabamos en unas viejas ruinas."
    },
    {
      "index": 35,
      "english": "But aren't you're the one who\ninspected the ruins? Take credit \nfor your accomplishments!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17216,
      "_bytes": 89,
      "translation": "¿Pero no fuiste tú el que estudió\nesas ruinas? ¡No te quites el\nmérito!"
    },
    {
      "index": 36,
      "english": "Tai...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 17306,
      "_bytes": 9,
      "translation": "Tai..."
    },
    {
      "index": 37,
      "english": "We'll be at the top soon. Let's\ntake a short break.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17316,
      "_bytes": 51,
      "translation": "Estaremos arriba pronto.\nDescansemos un poco."
    },
    {
      "index": 38,
      "english": "Head up",
      "speaker_id": 4294967295,
      "line_type": 2,
      "_offset": 17368,
      "_bytes": 7,
      "translation": "Seguir"
    },
    {
      "index": 39,
      "english": "Talk with the others a little longer",
      "speaker_id": 4294967295,
      "line_type": 2,
      "_offset": 17376,
      "_bytes": 36,
      "translation": "Hablar con el resto un poco más."
    },
    {
      "index": 40,
      "english": "All right, let's head up!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17413,
      "_bytes": 25,
      "translation": "¡De acuerdo, sigamos!"
    },
    {
      "index": 41,
      "english": "We weren't away that long, but it\nfeels like we haven't seen each\nother in a long time.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17439,
      "_bytes": 87,
      "translation": "No estuvimos separados tanto,\npero parece que no nos hayamos\nvisto en meses."
    },
    {
      "index": 42,
      "english": "Yeah. Well, a lot happened while\nwe were separated.",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 17527,
      "_bytes": 51,
      "translation": "Sí. Bueno, pasaron muchas cosas."
    },
    {
      "index": 43,
      "english": "Agumon and I wound up drifting to\na place with a ton of ice and\nsnow...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17579,
      "_bytes": 71,
      "translation": "Agumon y yo acabamos en un lugar\nlleno de hielo y nieve..."
    },
    {
      "index": 44,
      "english": "We got captured by some ghosts.",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 17651,
      "_bytes": 31,
      "translation": "Nos capturaron unos fantasmas."
    },
    {
      "index": 45,
      "english": "Really? Tell me all about it when\nwe get home.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17683,
      "_bytes": 46,
      "translation": "¿De veras? Cuéntame todo cuando\nvolvamos a casa."
    },
    {
      "index": 46,
      "english": "Sure.",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 17730,
      "_bytes": 5,
      "translation": "Vale."
    },
    {
      "index": 47,
      "english": "We're going to *another* dark and\ndamp place...",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 17736,
      "_bytes": 47,
      "translation": "Vamos a otro lugar oscuro y\nhúmedo..."
    },
    {
      "index": 48,
      "english": "What on earth happened?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17784,
      "_bytes": 23,
      "translation": "¿Qué ha ocurrido?"
    },
    {
      "index": 49,
      "english": "So we're still not done climbing\nInfinity Mountain...",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 17808,
      "_bytes": 53,
      "translation": "Así que aún no hemos acabado\nde subir el Monte Mugen..."
    },
    {
      "index": 50,
      "english": "Mimi, are you tired?",
      "speaker_id": 4294967295,
      "line_type": 2,
      "_offset": 17862,
      "_bytes": 20,
      "translation": "Mimi, ¿estás cansada?"
    },
    {
      "index": 51,
      "english": "If you're tired, you can wait here.",
      "speaker_id": 4294967295,
      "line_type": 2,
      "_offset": 17883,
      "_bytes": 35,
      "translation": "Si estás cansada, espera aquí."
    },
    {
      "index": 52,
      "english": "I'm fine. Just a bit more and I\ncan go home.",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 17919,
      "_bytes": 44,
      "translation": "Estoy bien. Un poco más y nos\nvamos a casa."
    },
    {
      "index": 53,
      "english": "Yeah, that's the spirit!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17964,
      "_bytes": 24,
      "translation": "¡Ese es el espíritu!"
    },
    {
      "index": 54,
      "english": "You've grown up a little, Mimi.",
      "speaker_id": 2521,
      "line_type": 2,
      "_offset": 17989,
      "_bytes": 31,
      "translation": "Te has hecho mayor, Mimi."
    },
    {
      "index": 55,
      "english": "You're so mean, Palmon!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 18021,
      "_bytes": 23,
      "translation": "¡Qué mala, Palmon!"
    },
    {
      "index": 56,
      "english": "What're you saying? This mountain\nis nothing to me if it means I can\ngo home soon!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 18045,
      "_bytes": 82,
      "translation": "¿Qué dices? ¡Esta montaña no es\nnada si significa irse a casa\npronto!"
    },
    {
      "index": 57,
      "english": "Mimi, you've gotten a lot\nstronger.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 18128,
      "_bytes": 35,
      "translation": "Mimi, eres mucho más fuerte\nahora."
    },
    {
      "index": 58,
      "english": "The first thing I'll do when I get\nhome is take a shower!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 18164,
      "_bytes": 57,
      "translation": "¡Lo primero que haré al volver es\ndarme una ducha!"
    },
    {
      "index": 59,
      "english": "...Or maybe just a little\nstronger.",
      "speaker_id": 2521,
      "line_type": 2,
      "_offset": 18222,
      "_bytes": 35,
      "translation": "...Quizás sólo algo más\nfuerte."
    },
    {
      "index": 60,
      "english": "Okay, I'll have to work hard now,\nso I can take a nice shower, too!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 18258,
      "_bytes": 67,
      "translation": "¡Vale, tengo que trabajar duro\npara poder darme una ducha,\ntambién!"
    },
    {
      "index": 61,
      "english": "Patamon and I were looking after a\nbunch of Digimon babies!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 18326,
      "_bytes": 59,
      "translation": "¡Patamon y yo cuidamos de muchos\nDigimon bebés!"
    },
    {
      "index": 62,
      "english": "That's great, T.K!",
      "speaker_id": 4294967295,
      "line_type": 2,
      "_offset": 18386,
      "_bytes": 21,
      "translation": "¡Genial, T.K.!"
    },
    {
      "index": 63,
      "english": "So Digimon hatch from eggs?",
      "speaker_id": 4294967295,
      "line_type": 2,
      "_offset": 18408,
      "_bytes": 27,
      "translation": "¿Salen de huevos?"
    },
    {
      "index": 64,
      "english": "Haha! Tai, did you know that\nDigimon hatch from eggs?",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 18436,
      "_bytes": 56,
      "translation": "¡Vaya, Tai! ¿No sabías de dónde\nnacen los Digimon?"
    },
    {
      "index": 65,
      "english": "Really?!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 18493,
      "_bytes": 8,
      "translation": "¡¿Sí?!"
    },
    {
      "index": 66,
      "english": "Really! I bet Agumon and the\nothers did, too!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 18502,
      "_bytes": 45,
      "translation": "¡Seguro que Agumon y los\ndemás nacieron así!"
    },
    {
      "index": 67,
      "english": "(Now that I think about it, why\nwere Agumon and the others the \nonly ones to not be born there?)",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 18548,
      "_bytes": 96,
      "translation": "(Ahora que lo pienso, ¿por qué\nAgumon y los otros fueron los\núnicos en no nacer allí?)"
    },
    {
      "index": 68,
      "english": "Really! I bet Agumon and the\nothers did, too!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 18645,
      "_bytes": 45,
      "translation": "¡Seguro que Agumon y los demás\nnacieron así!"
    },
    {
      "index": 69,
      "english": "(Now that I think about it, why\nwere Agumon and the others the \nonly ones to not be born there?)",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 18691,
      "_bytes": 96,
      "translation": "(Ahora que lo pienso, ¿por qué\nAgumon y los otros fueron los\núnicos en no nacer allí?)"
    },
    {
      "index": 70,
      "english": "Did you hatch from an egg too,\nPatamon?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 18788,
      "_bytes": 39,
      "translation": "¿Saliste de un huevo, Patamon?"
    },
    {
      "index": 71,
      "english": "Maybe. I don't really remember it\nmuch.",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 18828,
      "_bytes": 39,
      "translation": "Supongo. No lo recuerdo."
    },
    {
      "index": 72,
      "english": "I've been waiting, ya brats...",
      "speaker_id": 4061,
      "line_type": 2,
      "_offset": 18868,
      "_bytes": 30,
      "translation": "Os esperaba, idiotas..."
    },
    {
      "index": 73,
      "english": "You don't have a chance, so why\ndon't you just run for it?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 18899,
      "_bytes": 58,
      "translation": "No puedes con nosotros, ¿por qué\nno te largas sin más?"
    },
    {
      "index": 74,
      "english": "I don't think so!",
      "speaker_id": 4061,
      "line_type": 2,
      "_offset": 18958,
      "_bytes": 17,
      "translation": "¡Ni de broma!"
    },
    {
      "index": 75,
      "english": "Huh? What's with the sudden\nconfidence?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 18976,
      "_bytes": 39,
      "translation": "¿Eh? ¿De dónde sale esa confianza?"
    },
    {
      "index": 76,
      "english": "I've become one with Devimon and\nbeen granted power!",
      "speaker_id": 4061,
      "line_type": 2,
      "_offset": 19016,
      "_bytes": 52,
      "translation": "¡Ahora soy uno con el poder de\nDevimon!"
    },
    {
      "index": 77,
      "english": "What...?!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 19069,
      "_bytes": 9,
      "translation": "¡¿Qué...?!"
    },
    {
      "index": 78,
      "english": "I won't lose to you again! I'll\nchoke the life out of all of you!",
      "speaker_id": 4061,
      "line_type": 2,
      "_offset": 19079,
      "_bytes": 65,
      "translation": "No perderé otra vez. ¡Os arrancaré\nla vida de cuajo!"
    },
    {
      "index": 79,
      "english": "Ghhhh...",
      "speaker_id": 4061,
      "line_type": 2,
      "_offset": 19145,
      "_bytes": 8,
      "translation": "Ghh..."
    },
    {
      "index": 80,
      "english": "Did we kill Ogremon?",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 19154,
      "_bytes": 20,
      "translation": "¿Matamos a Ogremon?"
    },
    {
      "index": 81,
      "english": "No, he just said he'd become one\nwith Devimon, so he's not dead...",
      "speaker_id": 4071,
      "line_type": 2,
      "_offset": 19175,
      "_bytes": 66,
      "translation": "No, dijo que se hizo uno con\nDevimon, no creo que esté\nmuerto..."
    },
    {
      "index": 82,
      "english": "That's not enough to stop us from\ngetting to Devimon. Let's hurry!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 19242,
      "_bytes": 66,
      "translation": "Con eso no basta para frenarnos.\n¡Vamos a por Devimon!"
    },
    {
      "index": 83,
      "english": "Chosen Children...I can't believe\nthat you've managed to meet up and\nappear in front of me once again.",
      "speaker_id": 3011,
      "line_type": 2,
      "_offset": 19309,
      "_bytes": 102,
      "translation": "Niños Elegidos... No puedo creer\nque os juntaseis y aparecieseis\naquí, frente a mí."
    },
    {
      "index": 84,
      "english": "Devimon!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 19412,
      "_bytes": 8,
      "translation": "¡Devimon!"
    },
    {
      "index": 85,
      "english": "Come to me, powers of darkness!",
      "speaker_id": 3011,
      "line_type": 2,
      "_offset": 19421,
      "_bytes": 31,
      "translation": "¡Ven a mí, oscuridad!"
    },
    {
      "index": 86,
      "english": "Gyaaaaah! What's this?!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 19453,
      "_bytes": 23,
      "translation": "¡Huaaa! ¡¿Qué es esto?!"
    },
    {
      "index": 87,
      "english": "The powers of darkness made him\ninto a giant!",
      "speaker_id": 4071,
      "line_type": 2,
      "_offset": 19477,
      "_bytes": 45,
      "translation": "¡El poder de la oscuridad lo ha\nhecho gigante!"
    },
    {
      "index": 88,
      "english": "I'll make File Island into your\ngraveyard!",
      "speaker_id": 3011,
      "line_type": 2,
      "_offset": 19523,
      "_bytes": 42,
      "translation": "¡La isla File será vuestro\ncementerio!"
    },
    {
      "index": 89,
      "english": "He's coming at us!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 19566,
      "_bytes": 18,
      "translation": "¡Ahí viene!"
    },
    {
      "index": 90,
      "english": "So the so-called \"Chosen Children\"\ncan only do this much to me?",
      "speaker_id": 3011,
      "line_type": 2,
      "_offset": 19585,
      "_bytes": 63,
      "translation": "¿Estos tales \"Niños Elegidos\"\nno pueden hacerme nada más?"
    },
    {
      "index": 91,
      "english": "!!",
      "speaker_id": 9001,
      "line_type": 2,
      "_offset": 19649,
      "_bytes": 2,
      "translation": "!!"
    },
    {
      "index": 92,
      "english": "What...? He was only toying with\nus?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 19652,
      "_bytes": 36,
      "translation": "¿Qué...? ¿Estaba jugando con\nnosotros?"
    },
    {
      "index": 93,
      "english": "It is your fate to be destroyed\nhere!",
      "speaker_id": 3011,
      "line_type": 2,
      "_offset": 19689,
      "_bytes": 37,
      "translation": "¡Morir es vuestro destino!"
    },
    {
      "index": 94,
      "english": "The powers of darkness are\nexpanding...!",
      "speaker_id": 4071,
      "line_type": 2,
      "_offset": 19727,
      "_bytes": 40,
      "translation": "¡El poder de la oscuridad\nse expande...!"
    },
    {
      "index": 95,
      "english": "Now...for a trial of strength...",
      "speaker_id": 3011,
      "line_type": 2,
      "_offset": 19768,
      "_bytes": 32,
      "translation": "Ahora...una prueba de fuerza..."
    },
    {
      "index": 96,
      "english": "Uwaaaaaaaaah!",
      "speaker_id": 9003,
      "line_type": 2,
      "_offset": 19801,
      "_bytes": 13,
      "translation": "¡Uuuaahhhh!"
    },
    {
      "index": 97,
      "english": "Guys!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 19815,
      "_bytes": 5,
      "translation": "¡Chicos!"
    },
    {
      "index": 98,
      "english": "First, I shall start with the\nsmallest Chosen Child...",
      "speaker_id": 3011,
      "line_type": 2,
      "_offset": 19821,
      "_bytes": 54,
      "translation": "Primero, el niño más pequeño..."
    },
    {
      "index": 99,
      "english": "!!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 19876,
      "_bytes": 2,
      "translation": "!!"
    },
    {
      "index": 100,
      "english": "Does he mean T.K?!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 19879,
      "_bytes": 21,
      "translation": "¡¿Se refiere a T.K.?!"
    },
    {
      "index": 101,
      "english": "If you disappear, I have nothing\nleft to be afraid of.",
      "speaker_id": 3011,
      "line_type": 2,
      "_offset": 19901,
      "_bytes": 54,
      "translation": "Si desapareces, no tengo nada\nque temer."
    },
    {
      "index": 102,
      "english": "T.Kuuuuu!",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 19956,
      "_bytes": 12,
      "translation": "¡¡¡T.K.!!!"
    },
    {
      "index": 103,
      "english": "Gh...",
      "speaker_id": 4071,
      "line_type": 2,
      "_offset": 19969,
      "_bytes": 5,
      "translation": "Gh..."
    },
    {
      "index": 104,
      "english": "Leomon! Are you okay?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 19975,
      "_bytes": 21,
      "translation": "¡Leomon! ¿Estás bien?"
    },
    {
      "index": 105,
      "english": "Yes, but I don't think I have any\nmore power.",
      "speaker_id": 4071,
      "line_type": 2,
      "_offset": 19997,
      "_bytes": 45,
      "translation": "Sí, pero no tengo más energía."
    },
    {
      "index": 106,
      "english": "Leomon...",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 20043,
      "_bytes": 9,
      "translation": "Leomon..."
    },
    {
      "index": 107,
      "english": "(Why am I...why am I the only one\nwho can't evolve?)",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 20053,
      "_bytes": 52,
      "translation": "(¿Por qué soy yo el único que no\ndigievoluciona?)"
    },
    {
      "index": 108,
      "english": "All of you, watch and observe the\nsmallest Chosen Child's greatest\nand final moment!",
      "speaker_id": 3011,
      "line_type": 2,
      "_offset": 20106,
      "_bytes": 84,
      "translation": "¡Observad todos el momento final\ndel más pequeño de los Niños\nElegidos!"
    },
    {
      "index": 109,
      "english": "No...I'll protect T.K!",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 20191,
      "_bytes": 25,
      "translation": "No...¡Te protegeré, T.K.!"
    },
    {
      "index": 110,
      "english": "!! Patamon...",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 20217,
      "_bytes": 13,
      "translation": "!! Patamon..."
    },
    {
      "index": 111,
      "english": "I've decided, I'm going to stay\nwith T.K!",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 20231,
      "_bytes": 44,
      "translation": "¡Decidido, me quedo con T.K.!"
    },
    {
      "index": 112,
      "english": "The words of a powerless Digimon\nare only in vain.",
      "speaker_id": 3011,
      "line_type": 2,
      "_offset": 20276,
      "_bytes": 50,
      "translation": "Las palabras de un Digimon débil\nson en vano."
    },
    {
      "index": 113,
      "english": "Patamoooooooooooon!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 20327,
      "_bytes": 19,
      "translation": "¡Patamooooooooooon!"
    },
    {
      "index": 114,
      "english": "Patamon evolved...",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 20347,
      "_bytes": 18,
      "translation": "Digievolucionó..."
    },
    {
      "index": 115,
      "english": "That's T.K's Digimon...?",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 20366,
      "_bytes": 27,
      "translation": "¿Ese es el Digimon de T.K.?"
    },
    {
      "index": 116,
      "english": "He's like an angel...",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 20394,
      "_bytes": 21,
      "translation": "Es como un ángel..."
    },
    {
      "index": 117,
      "english": "Patamon?",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 20416,
      "_bytes": 8,
      "translation": "¿Patamon?"
    },
    {
      "index": 118,
      "english": "T.K, I'm Angemon...your\nfriend...",
      "speaker_id": 2731,
      "line_type": 2,
      "_offset": 20425,
      "_bytes": 36,
      "translation": "T.K., soy Angemon... tu\namigo..."
    },
    {
      "index": 119,
      "english": "Angemon...",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 20462,
      "_bytes": 10,
      "translation": "Angemon..."
    },
    {
      "index": 120,
      "english": "Why, you...and I was so close!",
      "speaker_id": 3011,
      "line_type": 2,
      "_offset": 20473,
      "_bytes": 30,
      "translation": "¡Maldito...! ¡Y estaba tan cerca!"
    },
    {
      "index": 121,
      "english": "Agumon! Everyone! Lend me your\npower one more time!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 20504,
      "_bytes": 51,
      "translation": "¡Agumon! ¡Todos! ¡Dadme vuestro\npoder una vez más!"
    },
    {
      "index": 122,
      "english": "We're going to defeat Devimon!\nLet's go!",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 20556,
      "_bytes": 40,
      "translation": "¡Derrotaremos a Devimon!\n¡Vamos!"
    },
    {
      "index": 123,
      "english": "Yeah!",
      "speaker_id": 9003,
      "line_type": 2,
      "_offset": 20597,
      "_bytes": 5,
      "translation": "¡Sí!"
    },
    {
      "index": 124,
      "english": "I will erase your powers of\ndarkness!",
      "speaker_id": 2731,
      "line_type": 2,
      "_offset": 20603,
      "_bytes": 37,
      "translation": "¡Eliminaré tus poderes oscuros!"
    },
    {
      "index": 125,
      "english": "Fool. You're going to lose all\nyour power this way, Angemon...",
      "speaker_id": 3011,
      "line_type": 2,
      "_offset": 20641,
      "_bytes": 62,
      "translation": "Idiota. Perderás tus poderes si\nhaces eso, Angemon..."
    },
    {
      "index": 126,
      "english": "The powers of darkness exist\nacross the ocean as well, as do\nDigimon stronger than me!",
      "speaker_id": 3011,
      "line_type": 2,
      "_offset": 20704,
      "_bytes": 86,
      "translation": "¡El poder de la oscuridad existe\nmás allá del océano, y\nDigimon más fuertes que yo!"
    },
    {
      "index": 127,
      "english": "W-what...?!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 20791,
      "_bytes": 11,
      "translation": "¡¿Q-Qué...?!"
    },
    {
      "index": 128,
      "english": "You guys are doomed!\nHahahahahahaha...!",
      "speaker_id": 3011,
      "line_type": 2,
      "_offset": 20803,
      "_bytes": 39,
      "translation": "¡Estáis perdidos!\n¡Jajajajajaja...!"
    },
    {
      "index": 129,
      "english": "Angemon...",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 20843,
      "_bytes": 10,
      "translation": "Angemon..."
    },
    {
      "index": 130,
      "english": "T.K...I'm sure we'll meet\nagain, if you wish for it.",
      "speaker_id": 2731,
      "line_type": 2,
      "_offset": 20854,
      "_bytes": 55,
      "translation": "T.K... Nos volveremos a\nencontrar, si así lo deseas."
    },
    {
      "index": 131,
      "english": "Angemoooooooooon!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 20910,
      "_bytes": 17,
      "translation": "¡Angemooooooooon!"
    },
    {
      "index": 132,
      "english": "It's a DigiEgg.",
      "speaker_id": 2421,
      "line_type": 2,
      "_offset": 20928,
      "_bytes": 15,
      "translation": "Es un DigiHuevo."
    },
    {
      "index": 133,
      "english": "It's Angemon's, right?",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 20944,
      "_bytes": 22,
      "translation": "Es de Angemon, ¿verdad?"
    },
    {
      "index": 134,
      "english": "Angemon turned into an egg and is\nstarting over.",
      "speaker_id": 2221,
      "line_type": 2,
      "_offset": 20967,
      "_bytes": 48,
      "translation": "Angemon se ha convertido en huevo\nde nuevo."
    },
    {
      "index": 135,
      "english": "If he evolves properly, you'll\nmeet him again.",
      "speaker_id": 2521,
      "line_type": 2,
      "_offset": 21016,
      "_bytes": 46,
      "translation": "Si evoluciona, volveremos a\nverle."
    },
    {
      "index": 136,
      "english": "Then I'll make sure to raise him\ncarefully.",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 21063,
      "_bytes": 43,
      "translation": "Me encargaré de cuidarle mucho."
    },
    {
      "index": 137,
      "english": "Guys! The island is coming back\ntogether!",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 21107,
      "_bytes": 41,
      "translation": "¡Chicos! La isla se está juntando."
    },
    {
      "index": 138,
      "english": "Devimon? Did they kill him?",
      "speaker_id": 4061,
      "line_type": 2,
      "_offset": 21149,
      "_bytes": 27,
      "translation": "¿Devimon? ¿Lo han matado?"
    },
    {
      "index": 139,
      "english": "Ogremon. Do you want to fight\nagain?",
      "speaker_id": 4071,
      "line_type": 2,
      "_offset": 21177,
      "_bytes": 36,
      "translation": "Ogremon. ¿Quieres luchar de nuevo?"
    },
    {
      "index": 140,
      "english": "H-haaah! I'm done with all of\nthis!",
      "speaker_id": 4061,
      "line_type": 2,
      "_offset": 21214,
      "_bytes": 35,
      "translation": "¡Eh-eeh! ¡Estoy harto de esto!"
    },
    {
      "index": 141,
      "english": "But...I'm worried about what\nDevimon said about Digimon with\nstrong, dark powers...",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 21250,
      "_bytes": 83,
      "translation": "Pero... me preocupa lo que dijo\nDevimon de Digimon con poderes\noscuros más fuertes..."
    },
    {
      "index": 142,
      "english": "Are we gonna have to fight again?",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 21334,
      "_bytes": 33,
      "translation": "¿Tendremos que luchar de nuevo?"
    },
    {
      "index": 143,
      "english": "There's not much else we can do.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 21368,
      "_bytes": 32,
      "translation": "No podemos hacer mucho más."
    },
    {
      "index": 144,
      "english": "W-what's this?",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 21401,
      "_bytes": 14,
      "translation": "¿Qué es esto?"
    },
    {
      "index": 145,
      "english": "?!",
      "speaker_id": 9001,
      "line_type": 2,
      "_offset": 21416,
      "_bytes": 2,
      "translation": "?!"
    },
    {
      "index": 146,
      "english": "Huh...So you're the Chosen\nChildren, right?",
      "speaker_id": 5011,
      "line_type": 2,
      "_offset": 21419,
      "_bytes": 43,
      "translation": "Eh...sois los Niños Elegidos,\n¿verdad?"
    },
    {
      "index": 147,
      "english": "Who's there?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 21463,
      "_bytes": 12,
      "translation": "¿Quién va?"
    },
    {
      "index": 148,
      "english": "I'm on your side.",
      "speaker_id": 5011,
      "line_type": 2,
      "_offset": 21476,
      "_bytes": 17,
      "translation": "Estoy de vuestra parte."
    },
    {
      "index": 149,
      "english": "There's a human here, besides us?",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 21494,
      "_bytes": 33,
      "translation": "¿Un humano aparte de nosotros?"
    },
    {
      "index": 150,
      "english": "No, I'm human and yet not human.",
      "speaker_id": 5011,
      "line_type": 2,
      "_offset": 21528,
      "_bytes": 32,
      "translation": "No, soy humano y no lo soy."
    },
    {
      "index": 151,
      "english": "Are you a ghost?",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 21561,
      "_bytes": 16,
      "translation": "¿Un fantasma?"
    },
    {
      "index": 152,
      "english": "My name is Gennai. Devimon's \ninterference...",
      "speaker_id": 5011,
      "line_type": 2,
      "_offset": 21578,
      "_bytes": 45,
      "translation": "Me llamo Gennai, la influencia\nde Devimon..."
    },
    {
      "index": 153,
      "english": "...kept us from getting in touch,\nbut now we finally meet.",
      "speaker_id": 5011,
      "line_type": 2,
      "_offset": 21624,
      "_bytes": 58,
      "translation": "...me mantuvo apartado,\npero por fin nos conocemos."
    },
    {
      "index": 154,
      "english": "Hey, old man, were you the one who\nchose us?",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 21683,
      "_bytes": 44,
      "translation": "Eh, anciano, ¿nos has elegido tú?"
    },
    {
      "index": 155,
      "english": "It wasn't me.",
      "speaker_id": 5011,
      "line_type": 2,
      "_offset": 21728,
      "_bytes": 13,
      "translation": "No fui yo."
    },
    {
      "index": 156,
      "english": "Then, who?",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 21742,
      "_bytes": 10,
      "translation": "¿Y quién?"
    },
    {
      "index": 157,
      "english": "Well...I don't know.",
      "speaker_id": 5011,
      "line_type": 2,
      "_offset": 21753,
      "_bytes": 20,
      "translation": "Eh...No lo sé."
    },
    {
      "index": 158,
      "english": "Whaaaaaat?!",
      "speaker_id": 9001,
      "line_type": 2,
      "_offset": 21774,
      "_bytes": 11,
      "translation": "¡¿Queeeé?!"
    },
    {
      "index": 159,
      "english": "I'm sending this from the other\nside of the ocean. You must defeat\nthe enemy on Server Continent...",
      "speaker_id": 5011,
      "line_type": 2,
      "_offset": 21786,
      "_bytes": 99,
      "translation": "Os envío esto desde el otro lado\ndel océano. Debéis derrotar al\nenemigo del Continente Server."
    },
    {
      "index": 160,
      "english": "But we don't know where that is,\nor whether we can win...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 21886,
      "_bytes": 57,
      "translation": "Pero no sabemos dónde, ni si\npodemos ganar..."
    },
    {
      "index": 161,
      "english": "I'll send a map to your computer.\nFind the Tags and Crests.",
      "speaker_id": 5011,
      "line_type": 2,
      "_offset": 21944,
      "_bytes": 59,
      "translation": "Os enviaré un mapa.\nEncontrad los Circuitos y\nEmblemas."
    },
    {
      "index": 162,
      "english": "Tags? Crests?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 22004,
      "_bytes": 13,
      "translation": "¿Circuitos? ¿Emblemas?"
    },
    {
      "index": 163,
      "english": "You'll need them to make your\nDigimon evolve further.",
      "speaker_id": 5011,
      "line_type": 2,
      "_offset": 22018,
      "_bytes": 53,
      "translation": "Los necesitaréis para\ndigievolucionar más."
    },
    {
      "index": 164,
      "english": "There's even *further* levels of\nevolution?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 22072,
      "_bytes": 43,
      "translation": "¿Hay más niveles de digievolución?"
    },
    {
      "index": 165,
      "english": "So where do we find the Tags and\nCrests?",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 22116,
      "_bytes": 40,
      "translation": "¿Dónde encontramos Circuitos y\nEmblemas?"
    },
    {
      "index": 166,
      "english": "Well, Devimon sealed the Tags\nsomewhere together...",
      "speaker_id": 5011,
      "line_type": 2,
      "_offset": 22157,
      "_bytes": 51,
      "translation": "Bueno, Devimon selló los\nCircuitos todos juntos..."
    },
    {
      "index": 167,
      "english": "What's wrong? The picture's\nfuzzy?!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 22209,
      "_bytes": 35,
      "translation": "¿Qué ocurre? ¡Está borroso!"
    },
    {
      "index": 168,
      "english": "The Crests are...\nscattered...Server\nContinent...hurry...",
      "speaker_id": 5011,
      "line_type": 2,
      "_offset": 22245,
      "_bytes": 57,
      "translation": "Emblemas están...\nrepartidos por...\nContinente Server..."
    },
    {
      "index": 169,
      "english": "He disappeared.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 22303,
      "_bytes": 15,
      "translation": "Desapareció."
    },
    {
      "index": 170,
      "english": "What the heck was that?",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 22319,
      "_bytes": 23,
      "translation": "¿Qué ha sido eso?"
    },
    {
      "index": 171,
      "english": "So what do we do now?",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 22343,
      "_bytes": 21,
      "translation": "¿Qué hacemos ahora?"
    },
    {
      "index": 172,
      "english": "Hm...well, let's get down from\nthis mountain first, and then\nwe'll decide!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 22365,
      "_bytes": 74,
      "translation": "¡Hm...bueno, bajemos esta montaña\nprimero, luego decidiremos!"
    },
    {
      "index": 173,
      "english": "Head up",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 22440,
      "_bytes": 7,
      "translation": "Seguir"
    },
    {
      "index": 174,
      "english": "Talk with the others a little longer",
      "speaker_id": 4294967295,
      "line_type": 2,
      "_offset": 22448,
      "_bytes": 36,
      "translation": "Hablar con los demás un rato más."
    },
    {
      "index": 175,
      "english": "It's the final battle, guys! Are\nyou ready?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 22485,
      "_bytes": 43,
      "translation": "¡Es la batalla final, chicos!\n¿Estáis listos?"
    },
    {
      "index": 176,
      "english": "Guys! We have to combine our power\nand defeat Devimon!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 22529,
      "_bytes": 54,
      "translation": "¡Chicos! ¡Debemos juntar nuestro\npoder contra Devimon!"
    }
  ]
