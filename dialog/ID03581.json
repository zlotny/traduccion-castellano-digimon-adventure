{
  "file_id": "ID03581",
  "text_count": 82,
  "dialog": [
    {
      "index": 0,
      "english": "��������Hikari... Hikari...",
      "_offset": 3675,
      "_length": 27,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 1,
      "english": "*pant, pant*",
      "_offset": 3703,
      "_length": 12,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 2,
      "english": "Come on, Agumon! We're gonna leave\nyou behind if you keep this up!",
      "_offset": 3716,
      "_length": 66,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 3,
      "english": "Sorry, Taichi...",
      "_offset": 3783,
      "_length": 16,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 4,
      "english": "I can't take it anymore...",
      "_offset": 3800,
      "_length": 26,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 5,
      "english": "I can't do any more walkin'...",
      "_offset": 3827,
      "_length": 30,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 6,
      "english": "Hikari! Where are you...?",
      "_offset": 3858,
      "_length": 25,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 7,
      "english": "Taichi, Agumon and Tentomon are\ntired. Why don't we rest for a\nlittle while?",
      "_offset": 3884,
      "_length": 76,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 8,
      "english": "Hikari...",
      "_offset": 3961,
      "_length": 9,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 9,
      "english": "The truth is, I'm tired, as well.",
      "_offset": 3971,
      "_length": 33,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 10,
      "english": "Hikari! Where are you?",
      "_offset": 4005,
      "_length": 22,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 11,
      "english": "Taichi! Please calm down! I'm sure\nyou're tired, too...",
      "_offset": 4028,
      "_length": 55,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 12,
      "english": "K-Koushirou...",
      "_offset": 4084,
      "_length": 14,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 13,
      "english": "Hikari is sick right now!",
      "_offset": 4099,
      "_length": 25,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 14,
      "english": "How obstinate...",
      "_offset": 4125,
      "_length": 16,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 15,
      "english": "How obstinate...",
      "_offset": 4142,
      "_length": 16,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 16,
      "english": "What did you just say?!",
      "_offset": 4159,
      "_length": 23,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 17,
      "english": "Guys, this really isn't the time\nto be fighting...",
      "_offset": 4183,
      "_length": 50,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 18,
      "english": "Hey, you both need to calm down!",
      "_offset": 4234,
      "_length": 32,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 19,
      "english": "Koushirou...",
      "_offset": 4267,
      "_length": 12,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 20,
      "english": "We're being followed.",
      "_offset": 4280,
      "_length": 21,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 21,
      "english": "What...?",
      "_offset": 4302,
      "_length": 8,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 22,
      "english": "Keep pretending we're fighting, \nand once we get to that corner, \nAgumon and Tentomon can attack.",
      "_offset": 4311,
      "_length": 97,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 23,
      "english": "Got a problem? Then spit it out!",
      "_offset": 4409,
      "_length": 32,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 24,
      "english": "You can't keep doing things the\nway *you* want to do them!",
      "_offset": 4442,
      "_length": 58,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 25,
      "english": "Think it's one of Mugendramon's\nsubordinates?",
      "_offset": 4501,
      "_length": 45,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 26,
      "english": "Maybe.",
      "_offset": 4547,
      "_length": 6,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 27,
      "english": "Taichi!",
      "_offset": 4554,
      "_length": 7,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 28,
      "english": "Here they come!",
      "_offset": 4562,
      "_length": 15,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 29,
      "english": "Andromon!?",
      "_offset": 4581,
      "_length": 10,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 30,
      "english": "I did not expect to find you here.",
      "_offset": 4592,
      "_length": 34,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 31,
      "english": "We could say the same for you!",
      "_offset": 4627,
      "_length": 30,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 32,
      "english": "Indeed. What are you doing here,\nAndromon?",
      "_offset": 4658,
      "_length": 42,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 33,
      "english": "I'm here to liberate the towns\nfrom Mugendramon's tyranny.",
      "_offset": 4701,
      "_length": 58,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 34,
      "english": "The resistance has commanded me to\ninflitrate the underground.",
      "_offset": 4760,
      "_length": 62,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 35,
      "english": "We're looking for a girl named\nHikari.",
      "_offset": 4823,
      "_length": 38,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 36,
      "english": "We think she's with Sora and\nTakeru, but...",
      "_offset": 4862,
      "_length": 43,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 37,
      "english": "I see. We shall look for them\ntogether, then.",
      "_offset": 4906,
      "_length": 45,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 38,
      "english": "What's wrong, Andromon?",
      "_offset": 4955,
      "_length": 23,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 39,
      "english": "Someone's coming!",
      "_offset": 4979,
      "_length": 17,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 40,
      "english": "Is it Hikari?!",
      "_offset": 4997,
      "_length": 14,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 41,
      "english": "Are they really coming?",
      "_offset": 5012,
      "_length": 23,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 42,
      "english": "So you were here, Chosen Children!",
      "_offset": 5036,
      "_length": 34,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 43,
      "english": "Mugendramon!",
      "_offset": 5071,
      "_length": 12,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 44,
      "english": "And Andromon, as well... good, I\ncan kill two birds with one stone.",
      "_offset": 5084,
      "_length": 67,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 45,
      "english": "Hide yourselves!",
      "_offset": 5152,
      "_length": 16,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 46,
      "english": "Andromon!",
      "_offset": 5169,
      "_length": 9,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 47,
      "english": "Taichi, we have to use this chance\nto look for Hikari!",
      "_offset": 5179,
      "_length": 54,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 48,
      "english": "R-Right...",
      "_offset": 5234,
      "_length": 10,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 49,
      "english": "Taichi!",
      "_offset": 5245,
      "_length": 7,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 50,
      "english": "Hikari!",
      "_offset": 5253,
      "_length": 7,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 51,
      "english": "Sora! Takeru!",
      "_offset": 5261,
      "_length": 13,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 52,
      "english": "Glad you're doing okay, guys!\nWhat's going on?",
      "_offset": 5275,
      "_length": 46,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 53,
      "english": "Andromon protected us, and now\nhe's fighting Mugendramon!",
      "_offset": 5322,
      "_length": 57,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 54,
      "english": "What?!",
      "_offset": 5380,
      "_length": 6,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 55,
      "english": "Really?!",
      "_offset": 5387,
      "_length": 8,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 56,
      "english": "We wouldn't have been able to meet\nup like this if it weren't for\nhim! So we need to help him, now!",
      "_offset": 5396,
      "_length": 99,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 57,
      "english": "Yeah!",
      "_offset": 5496,
      "_length": 5,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 58,
      "english": "Andromon!",
      "_offset": 5502,
      "_length": 9,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 59,
      "english": "You're persistent... but now, it's\nyour turn.",
      "_offset": 5512,
      "_length": 45,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 60,
      "english": "Hikari?",
      "_offset": 5558,
      "_length": 7,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 61,
      "english": "Hikari?",
      "_offset": 5566,
      "_length": 7,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 62,
      "english": "Nuuuuu!",
      "_offset": 5574,
      "_length": 7,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 63,
      "english": "It's the Numemon...",
      "_offset": 5582,
      "_length": 19,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 64,
      "english": "Do you really think that's enough\nto take me down?",
      "_offset": 5602,
      "_length": 50,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 65,
      "english": "Nu!",
      "_offset": 5653,
      "_length": 3,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 66,
      "english": "Numemon!",
      "_offset": 5657,
      "_length": 8,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 67,
      "english": "Hikari!",
      "_offset": 5666,
      "_length": 7,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 68,
      "english": "Huh? There's power... coming from\nmy body...",
      "_offset": 5674,
      "_length": 44,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 69,
      "english": "Gaaaaaaah!",
      "_offset": 5719,
      "_length": 10,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 70,
      "english": "Guhhhhhh!",
      "_offset": 5730,
      "_length": 9,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 71,
      "english": "Mugendramon, the ruler of the \ncity, has been defeated. With his \ndefeat, this place will crumble.",
      "_offset": 5740,
      "_length": 98,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 72,
      "english": "It's dangerous to remain here.\nLet's return to the surface!",
      "_offset": 5839,
      "_length": 59,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 73,
      "english": "Okay! Let's go!",
      "_offset": 5899,
      "_length": 15,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 74,
      "english": "The fight has finally ended...",
      "_offset": 5915,
      "_length": 30,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 75,
      "english": "Taichi... can I make some graves\nfor the Numemon?",
      "_offset": 5946,
      "_length": 49,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 76,
      "english": "Of course.",
      "_offset": 5996,
      "_length": 10,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 77,
      "english": "I'll help, too!",
      "_offset": 6007,
      "_length": 15,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 78,
      "english": "All right, you just wait, Piemon!",
      "_offset": 6023,
      "_length": 33,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 79,
      "english": "We have to find Hikari...",
      "_offset": 6057,
      "_length": 25,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 80,
      "english": "Taichi! We have to find Hikari,\nwhile we still can!",
      "_offset": 6083,
      "_length": 51,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 81,
      "english": "Let's go back and save Andromon!",
      "_offset": 6135,
      "_length": 32,
      "speaker_id": 0,
      "translation": ""
    }
  ]
}