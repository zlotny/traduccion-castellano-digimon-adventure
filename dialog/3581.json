{
  "file_id": "3581",
  "text_count": 82,
  "dialog": [
    {
      "index": 0,
      "english": "��������Kari... Kari...",
      "_offset": 3675,
      "_length": 27,
      "speaker_id": 0,
      "translation": "Kari... Kari..."
    },
    {
      "index": 1,
      "english": "*pant, pant*",
      "_offset": 3703,
      "_length": 12,
      "speaker_id": 0,
      "translation": "(jadeando)"
    },
    {
      "index": 2,
      "english": "Come on, Agumon! We're gonna leave\nyou behind if you keep this up!",
      "_offset": 3716,
      "_length": 66,
      "speaker_id": 0,
      "translation": "Vamos, Agumon! Como sigas así,\nte vamos a dejar atrás!"
    },
    {
      "index": 3,
      "english": "Sorry, Tai...",
      "_offset": 3783,
      "_length": 16,
      "speaker_id": 0,
      "translation": "Perdona, Tai..."
    },
    {
      "index": 4,
      "english": "I can't take it anymore...",
      "_offset": 3800,
      "_length": 26,
      "speaker_id": 0,
      "translation": "Ya no puedo más..."
    },
    {
      "index": 5,
      "english": "I can't do any more walkin'...",
      "_offset": 3827,
      "_length": 30,
      "speaker_id": 0,
      "translation": "No puedo andar más..."
    },
    {
      "index": 6,
      "english": "Kari! Where are you...?",
      "_offset": 3858,
      "_length": 25,
      "speaker_id": 0,
      "translation": "Kari! Dónde estás...?"
    },
    {
      "index": 7,
      "english": "Tai, Agumon and Tentomon are\ntired. Why don't we rest for a\nlittle while?",
      "_offset": 3884,
      "_length": 76,
      "speaker_id": 0,
      "translation": "Tai, Agumon y Tentomon están\ncansados. Por qué no descansamos\nun rato?"
    },
    {
      "index": 8,
      "english": "Kari...",
      "_offset": 3961,
      "_length": 9,
      "speaker_id": 0,
      "translation": "Kari..."
    },
    {
      "index": 9,
      "english": "The truth is, I'm tired, as well.",
      "_offset": 3971,
      "_length": 33,
      "speaker_id": 0,
      "translation": "Yo también estoy cansado."
    },
    {
      "index": 10,
      "english": "Kari! Where are you?",
      "_offset": 4005,
      "_length": 22,
      "speaker_id": 0,
      "translation": "Kari! Dónde estás?"
    },
    {
      "index": 11,
      "english": "Tai! Please calm down! I'm sure\nyou're tired, too...",
      "_offset": 4028,
      "_length": 55,
      "speaker_id": 0,
      "translation": "Tai! Cálmate! Seguro que tú\ntambién estás cansado..."
    },
    {
      "index": 12,
      "english": "K-Izzy...",
      "_offset": 4084,
      "_length": 14,
      "speaker_id": 0,
      "translation": "I-Izzy..."
    },
    {
      "index": 13,
      "english": "Kari is sick right now!",
      "_offset": 4099,
      "_length": 25,
      "speaker_id": 0,
      "translation": "Kari está enferma ahora!"
    },
    {
      "index": 14,
      "english": "How obstinate...",
      "_offset": 4125,
      "_length": 16,
      "speaker_id": 0,
      "translation": "Qué terco..."
    },
    {
      "index": 15,
      "english": "How obstinate...",
      "_offset": 4142,
      "_length": 16,
      "speaker_id": 0,
      "translation": "Qué terco..."
    },
    {
      "index": 16,
      "english": "What did you just say?!",
      "_offset": 4159,
      "_length": 23,
      "speaker_id": 0,
      "translation": "Qué acabas de decir?!"
    },
    {
      "index": 17,
      "english": "Guys, this really isn't the time\nto be fighting...",
      "_offset": 4183,
      "_length": 50,
      "speaker_id": 0,
      "translation": "Chicos, no es momento de\npeleas..."
    },
    {
      "index": 18,
      "english": "Hey, you both need to calm down!",
      "_offset": 4234,
      "_length": 32,
      "speaker_id": 0,
      "translation": "Eh, los dos calmaos ya!"
    },
    {
      "index": 19,
      "english": "Izzy...",
      "_offset": 4267,
      "_length": 12,
      "speaker_id": 0,
      "translation": "Izzy..."
    },
    {
      "index": 20,
      "english": "We're being followed.",
      "_offset": 4280,
      "_length": 21,
      "speaker_id": 0,
      "translation": "Nos están siguiendo."
    },
    {
      "index": 21,
      "english": "What...?",
      "_offset": 4302,
      "_length": 8,
      "speaker_id": 0,
      "translation": "Qué...?"
    },
    {
      "index": 22,
      "english": "Keep pretending we're fighting, \nand once we get to that corner, \nAgumon and Tentomon can attack.",
      "_offset": 4311,
      "_length": 97,
      "speaker_id": 0,
      "translation": "Seguid fingiendo pelea, y en\ncuanto lleguemos a la esquina,\nAgumon y Tentomon atacarán."
    },
    {
      "index": 23,
      "english": "Got a problem? Then spit it out!",
      "_offset": 4409,
      "_length": 32,
      "speaker_id": 0,
      "translation": "Problema? Pues suéltalo!"
    },
    {
      "index": 24,
      "english": "You can't keep doing things the\nway *you* want to do them!",
      "_offset": 4442,
      "_length": 58,
      "speaker_id": 0,
      "translation": "No puedes hacer las cosas\nsiempre a TU manera!"
    },
    {
      "index": 25,
      "english": "Think it's one of Mugendramon's\nsubordinates?",
      "_offset": 4501,
      "_length": 45,
      "speaker_id": 0,
      "translation": "Será uno de los subordinados\nde Mugendramon?"
    },
    {
      "index": 26,
      "english": "Maybe.",
      "_offset": 4547,
      "_length": 6,
      "speaker_id": 0,
      "translation": "Quizá."
    },
    {
      "index": 27,
      "english": "Tai!",
      "_offset": 4554,
      "_length": 7,
      "speaker_id": 0,
      "translation": "Tai!"
    },
    {
      "index": 28,
      "english": "Here they come!",
      "_offset": 4562,
      "_length": 15,
      "speaker_id": 0,
      "translation": "Ya vienen!"
    },
    {
      "index": 29,
      "english": "Andromon!?",
      "_offset": 4581,
      "_length": 10,
      "speaker_id": 0,
      "translation": "Andromon!?"
    },
    {
      "index": 30,
      "english": "I did not expect to find you here.",
      "_offset": 4592,
      "_length": 34,
      "speaker_id": 0,
      "translation": "No esperaba encontraros aquí."
    },
    {
      "index": 31,
      "english": "We could say the same for you!",
      "_offset": 4627,
      "_length": 30,
      "speaker_id": 0,
      "translation": "Lo mismo digo de ti!"
    },
    {
      "index": 32,
      "english": "Indeed. What are you doing here,\nAndromon?",
      "_offset": 4658,
      "_length": 42,
      "speaker_id": 0,
      "translation": "Cierto. Qué haces aquí,\nAndromon?"
    },
    {
      "index": 33,
      "english": "I'm here to liberate the towns\nfrom Mugendramon's tyranny.",
      "_offset": 4701,
      "_length": 58,
      "speaker_id": 0,
      "translation": "Vengo a liberar los pueblos\nde la tiranía de Mugendramon."
    },
    {
      "index": 34,
      "english": "The resistance has commanded me to\ninflitrate the underground.",
      "_offset": 4760,
      "_length": 62,
      "speaker_id": 0,
      "translation": "La resistencia me ha ordenado\ninfiltrarme en el subsuelo."
    },
    {
      "index": 35,
      "english": "We're looking for a girl named\nKari.",
      "_offset": 4823,
      "_length": 38,
      "speaker_id": 0,
      "translation": "Buscamos a una chica llamada\nKari."
    },
    {
      "index": 36,
      "english": "We think she's with Sora and\nT.K, but...",
      "_offset": 4862,
      "_length": 43,
      "speaker_id": 0,
      "translation": "Creemos que está con Sora\ny T.K., pero..."
    },
    {
      "index": 37,
      "english": "I see. We shall look for them\ntogether, then.",
      "_offset": 4906,
      "_length": 45,
      "speaker_id": 0,
      "translation": "Ya veo. Los buscaremos\njuntos, entonces."
    },
    {
      "index": 38,
      "english": "What's wrong, Andromon?",
      "_offset": 4955,
      "_length": 23,
      "speaker_id": 0,
      "translation": "Qué pasa, Andromon?"
    },
    {
      "index": 39,
      "english": "Someone's coming!",
      "_offset": 4979,
      "_length": 17,
      "speaker_id": 0,
      "translation": "Viene alguien!"
    },
    {
      "index": 40,
      "english": "Is it Kari?!",
      "_offset": 4997,
      "_length": 14,
      "speaker_id": 0,
      "translation": "Es Kari?!"
    },
    {
      "index": 41,
      "english": "Are they really coming?",
      "_offset": 5012,
      "_length": 23,
      "speaker_id": 0,
      "translation": "De verdad vienen?"
    },
    {
      "index": 42,
      "english": "So you were here, Chosen Children!",
      "_offset": 5036,
      "_length": 34,
      "speaker_id": 0,
      "translation": "Así que estáis aquí\nNiños Elegidos!"
    },
    {
      "index": 43,
      "english": "Mugendramon!",
      "_offset": 5071,
      "_length": 12,
      "speaker_id": 0,
      "translation": "Mugendramon!"
    },
    {
      "index": 44,
      "english": "And Andromon, as well... good, I\ncan kill two birds with one stone.",
      "_offset": 5084,
      "_length": 67,
      "speaker_id": 0,
      "translation": "Y Andromon también... bien, mato\ndos pájaros de un tiro."
    },
    {
      "index": 45,
      "english": "Hide yourselves!",
      "_offset": 5152,
      "_length": 16,
      "speaker_id": 0,
      "translation": "Escondeos!"
    },
    {
      "index": 46,
      "english": "Andromon!",
      "_offset": 5169,
      "_length": 9,
      "speaker_id": 0,
      "translation": "Andromon!"
    },
    {
      "index": 47,
      "english": "Tai, we have to use this chance\nto look for Kari!",
      "_offset": 5179,
      "_length": 54,
      "speaker_id": 0,
      "translation": "Tai, hay que aprovechar\npara buscar a Kari!"
    },
    {
      "index": 48,
      "english": "R-Right...",
      "_offset": 5234,
      "_length": 10,
      "speaker_id": 0,
      "translation": "V-Vale..."
    },
    {
      "index": 49,
      "english": "Tai!",
      "_offset": 5245,
      "_length": 7,
      "speaker_id": 0,
      "translation": "Tai!"
    },
    {
      "index": 50,
      "english": "Kari!",
      "_offset": 5253,
      "_length": 7,
      "speaker_id": 0,
      "translation": "Kari!"
    },
    {
      "index": 51,
      "english": "Sora! T.K!",
      "_offset": 5261,
      "_length": 13,
      "speaker_id": 0,
      "translation": "Sora! T.K!"
    },
    {
      "index": 52,
      "english": "Glad you're doing okay, guys!\nWhat's going on?",
      "_offset": 5275,
      "_length": 46,
      "speaker_id": 0,
      "translation": "Me alegro de que estéis bien!\nQué ha pasado?"
    },
    {
      "index": 53,
      "english": "Andromon protected us, and now\nhe's fighting Mugendramon!",
      "_offset": 5322,
      "_length": 57,
      "speaker_id": 0,
      "translation": "Andromon nos protegió y ahora\nlucha contra Mugendramon!"
    },
    {
      "index": 54,
      "english": "What?!",
      "_offset": 5380,
      "_length": 6,
      "speaker_id": 0,
      "translation": "Qué?!"
    },
    {
      "index": 55,
      "english": "Really?!",
      "_offset": 5387,
      "_length": 8,
      "speaker_id": 0,
      "translation": "Verdad?!"
    },
    {
      "index": 56,
      "english": "We wouldn't have been able to meet\nup like this if it weren't for\nhim! So we need to help him, now!",
      "_offset": 5396,
      "_length": 99,
      "speaker_id": 0,
      "translation": "Si no fuera por él, no nos\nhabríamos podido reunir así!\nHay que ayudarlo ya!"
    },
    {
      "index": 57,
      "english": "Yeah!",
      "_offset": 5496,
      "_length": 5,
      "speaker_id": 0,
      "translation": "Sí!"
    },
    {
      "index": 58,
      "english": "Andromon!",
      "_offset": 5502,
      "_length": 9,
      "speaker_id": 0,
      "translation": "Andromon!"
    },
    {
      "index": 59,
      "english": "You're persistent... but now, it's\nyour turn.",
      "_offset": 5512,
      "_length": 45,
      "speaker_id": 0,
      "translation": "Eres persistente... pero ahora\nte toca a ti."
    },
    {
      "index": 60,
      "english": "Kari?",
      "_offset": 5558,
      "_length": 7,
      "speaker_id": 0,
      "translation": "Kari?"
    },
    {
      "index": 61,
      "english": "Kari?",
      "_offset": 5566,
      "_length": 7,
      "speaker_id": 0,
      "translation": "Kari?"
    },
    {
      "index": 62,
      "english": "Nuuuuu!",
      "_offset": 5574,
      "_length": 7,
      "speaker_id": 0,
      "translation": "Nuuuuu!"
    },
    {
      "index": 63,
      "english": "It's the Numemon...",
      "_offset": 5582,
      "_length": 19,
      "speaker_id": 0,
      "translation": "Son los Numemon..."
    },
    {
      "index": 64,
      "english": "Do you really think that's enough\nto take me down?",
      "_offset": 5602,
      "_length": 50,
      "speaker_id": 0,
      "translation": "De verdad creéis que con eso\nme derrotáis?"
    },
    {
      "index": 65,
      "english": "Nu!",
      "_offset": 5653,
      "_length": 3,
      "speaker_id": 0,
      "translation": "Nu!"
    },
    {
      "index": 66,
      "english": "Numemon!",
      "_offset": 5657,
      "_length": 8,
      "speaker_id": 0,
      "translation": "Numemon!"
    },
    {
      "index": 67,
      "english": "Kari!",
      "_offset": 5666,
      "_length": 7,
      "speaker_id": 0,
      "translation": "Kari!"
    },
    {
      "index": 68,
      "english": "Huh? There's power... coming from\nmy body...",
      "_offset": 5674,
      "_length": 44,
      "speaker_id": 0,
      "translation": "Eh? Hay un poder... saliendo\nde mi cuerpo..."
    },
    {
      "index": 69,
      "english": "Gaaaaaaah!",
      "_offset": 5719,
      "_length": 10,
      "speaker_id": 0,
      "translation": "Gaaaaaaah!"
    },
    {
      "index": 70,
      "english": "Guhhhhhh!",
      "_offset": 5730,
      "_length": 9,
      "speaker_id": 0,
      "translation": "Guhhhhhh!"
    },
    {
      "index": 71,
      "english": "Mugendramon, the ruler of the \ncity, has been defeated. With his \ndefeat, this place will crumble.",
      "_offset": 5740,
      "_length": 98,
      "speaker_id": 0,
      "translation": "Mugendramon, el gobernante\nde la ciudad, ha sido derrotado.\nCon esto, el lugar caerá."
    },
    {
      "index": 72,
      "english": "It's dangerous to remain here.\nLet's return to the surface!",
      "_offset": 5839,
      "_length": 59,
      "speaker_id": 0,
      "translation": "Es peligroso quedarse aquí.\nVolvamos a la superficie!"
    },
    {
      "index": 73,
      "english": "Okay! Let's go!",
      "_offset": 5899,
      "_length": 15,
      "speaker_id": 0,
      "translation": "Vale! Vamos!"
    },
    {
      "index": 74,
      "english": "The fight has finally ended...",
      "_offset": 5915,
      "_length": 30,
      "speaker_id": 0,
      "translation": "Por fin acabó la pelea..."
    },
    {
      "index": 75,
      "english": "Tai... can I make some graves\nfor the Numemon?",
      "_offset": 5946,
      "_length": 49,
      "speaker_id": 0,
      "translation": "Tai... puedo hacerles tumbas\na los Numemon?"
    },
    {
      "index": 76,
      "english": "Of course.",
      "_offset": 5996,
      "_length": 10,
      "speaker_id": 0,
      "translation": "Claro."
    },
    {
      "index": 77,
      "english": "I'll help, too!",
      "_offset": 6007,
      "_length": 15,
      "speaker_id": 0,
      "translation": "También ayudo!"
    },
    {
      "index": 78,
      "english": "All right, you just wait, Piemon!",
      "_offset": 6023,
      "_length": 33,
      "speaker_id": 0,
      "translation": "Muy bien, espera y verás, Piemon!"
    },
    {
      "index": 79,
      "english": "We have to find Kari...",
      "_offset": 6057,
      "_length": 25,
      "speaker_id": 0,
      "translation": "Hay que hallar a Kari..."
    },
    {
      "index": 80,
      "english": "Tai! We have to find Kari,\nwhile we still can!",
      "_offset": 6083,
      "_length": 51,
      "speaker_id": 0,
      "translation": "Tai! Hay que encontrar a Kari\nmientras podamos!"
    },
    {
      "index": 81,
      "english": "Let's go back and save Andromon!",
      "_offset": 6135,
      "_length": 32,
      "speaker_id": 0,
      "translation": "Volvamos a salvar a Andromon!"
    }
  ]
}