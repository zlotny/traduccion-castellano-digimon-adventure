      "_offset": 31090,
      "_bytes": 7,
      "translation": "¡Puuuf!"
    },
    {
      "index": 170,
      "english": "Poof!",
      "speaker_id": 2711,
      "line_type": 2,
      "_offset": 31098,
      "_bytes": 5,
      "translation": "¡Puf!"
    },
    {
      "index": 171,
      "english": "Gryaaaah?! Kryaaaaaaaaah!",
      "speaker_id": 4902,
      "line_type": 2,
      "_offset": 31104,
      "_bytes": 25,
      "translation": "¡¿Gryaah?! ¡Kryaaah!"
    },
    {
      "index": 172,
      "english": "Gryaaaah?! Kryaaaaaaaaah!",
      "speaker_id": 2111,
      "line_type": 4,
      "_offset": 31130,
      "_bytes": 25,
      "translation": "¡¿Gryaah?! ¡Kryaaah!"
    },
    {
      "index": 173,
      "english": "Gryaaaah?! Kryaaaaaaaaah!",
      "speaker_id": 2211,
      "line_type": 4,
      "_offset": 31156,
      "_bytes": 25,
      "translation": "¡¿Gryaah?! ¡Kryaaah!"
    },
    {
      "index": 174,
      "english": "Aaaaaaaagh!",
      "speaker_id": 6061,
      "line_type": 2,
      "_offset": 31182,
      "_bytes": 11,
      "translation": "¡Aaaaah!"
    },
    {
      "index": 175,
      "english": "Koromon! No! If you keep this\nup...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 31194,
      "_bytes": 35,
      "translation": "¡Koromon! ¡No! Si sigues así..."
    },
    {
      "index": 176,
      "english": "Let me go...we have to! We have to\nfight...!",
      "speaker_id": 2111,
      "line_type": 2,
      "_offset": 31230,
      "_bytes": 44,
      "translation": "Déjame ir... tengo que hacerlo.\n¡Debo luchar!"
    },
    {
      "index": 177,
      "english": "Yeah! We've been waiting for so\nlong, just for this moment!",
      "speaker_id": 2411,
      "line_type": 2,
      "_offset": 31275,
      "_bytes": 59,
      "translation": "¡Sí! ¡Hemos esperado mucho\neste momento!"
    },
    {
      "index": 178,
      "english": "Let's go!",
      "speaker_id": 2111,
      "line_type": 2,
      "_offset": 31335,
      "_bytes": 9,
      "translation": "¡Vamos!"
    },
    {
      "index": 179,
      "english": "Koromon!!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 31345,
      "_bytes": 9,
      "translation": "¡¡Koromon!!"
    },
    {
      "index": 180,
      "english": "Huh?!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 31355,
      "_bytes": 5,
      "translation": "¡¿Eh?!"
    },
    {
      "index": 181,
      "english": "They all transformed...!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 31361,
      "_bytes": 24,
      "translation": "¡Se han transformado...!"
    },
    {
      "index": 182,
      "english": "Such sudden growth...it's\nunbelievable!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 31386,
      "_bytes": 39,
      "translation": "¿Así de repente? Increíble..."
    },
    {
      "index": 183,
      "english": "Tokomon! Are you okay?!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 31426,
      "_bytes": 23,
      "translation": "¡Tokomon! ¿Estás bien?"
    },
    {
      "index": 184,
      "english": "Watch me, T.K!",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 31450,
      "_bytes": 17,
      "translation": "¡Mira, T.K.!"
    },
    {
      "index": 185,
      "english": "You won't get away with this!",
      "speaker_id": 2521,
      "line_type": 2,
      "_offset": 31468,
      "_bytes": 29,
      "translation": "¡No te saldrás con la tuya!"
    },
    {
      "index": 186,
      "english": "Prepare yourself!",
      "speaker_id": 2421,
      "line_type": 2,
      "_offset": 31498,
      "_bytes": 17,
      "translation": "¡Prepárate!"
    },
    {
      "index": 187,
      "english": "It's our turn now!",
      "speaker_id": 2221,
      "line_type": 2,
      "_offset": 31516,
      "_bytes": 18,
      "translation": "¡Ahora nos toca!"
    },
    {
      "index": 188,
      "english": "I can fight, too!",
      "speaker_id": 2621,
      "line_type": 2,
      "_offset": 31535,
      "_bytes": 17,
      "translation": "¡Puedo luchar!"
    },
    {
      "index": 189,
      "english": "We'll show you!",
      "speaker_id": 2321,
      "line_type": 2,
      "_offset": 31553,
      "_bytes": 15,
      "translation": "¡Ya verás!"
    },
    {
      "index": 190,
      "english": "Everyone, let's go!",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 31569,
      "_bytes": 19,
      "translation": "Todos, ¡vamos allá!"
    },
    {
      "index": 191,
      "english": "They did it...!!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 31589,
      "_bytes": 16,
      "translation": "Lo han hecho..."
    },
    {
      "index": 192,
      "english": "Tai!",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 31606,
      "_bytes": 7,
      "translation": "¡Tai!"
    },
    {
      "index": 193,
      "english": "That was amazing! Great job!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 31614,
      "_bytes": 28,
      "translation": "¡Increíble! ¡Buen trabajo!"
    },
    {
      "index": 194,
      "english": "Were you watching me, Sora?\nI did it!",
      "speaker_id": 2321,
      "line_type": 2,
      "_offset": 31643,
      "_bytes": 37,
      "translation": "¿Lo has visto, Sora?\n¡Lo hice!"
    },
    {
      "index": 195,
      "english": "You all did so well!",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 31681,
      "_bytes": 20,
      "translation": "¡Lo hicisteis genial!"
    },
    {
      "index": 196,
      "english": "You were so strong out there,\nTokomon!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 31702,
      "_bytes": 38,
      "translation": "¡Has sido muy fuerte, Tokomon!"
    },
    {
      "index": 197,
      "english": "My palms got all sweaty from\nwatching!",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 31741,
      "_bytes": 38,
      "translation": "¡Me sudan las manos sólo de\nmirar!"
    },
    {
      "index": 198,
      "english": "But if you guys could just\ninstantly get bigger, why didn't \nyou do that to begin with?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 31780,
      "_bytes": 87,
      "translation": "Pero si podíais crecer así...\n¿Por qué no lo habéis hecho antes?"
    },
    {
      "index": 199,
      "english": "We can't! We can't do \"that\" on\nour own!",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 31868,
      "_bytes": 40,
      "translation": "¡No podemos! No podemos hacerlo...\nsolos."
    },
    {
      "index": 200,
      "english": "Huh? You can't what on your own?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 31909,
      "_bytes": 32,
      "translation": "¿Eh? ¿Hacer el qué?"
    },
    {
      "index": 201,
      "english": "Kuwagamon's still alive!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 31942,
      "_bytes": 24,
      "translation": "¡Kuwagamon sigue vivo!"
    },
    {
      "index": 202,
      "english": "Look out!",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 31967,
      "_bytes": 9,
      "translation": "¡Cuidado!"
    },
    {
      "index": 203,
      "english": "Kryaaaaaaahh!",
      "speaker_id": 4902,
      "line_type": 2,
      "_offset": 31977,
      "_bytes": 13,
      "translation": "¡Kryaaahh!"
    },
    {
      "index": 204,
      "english": "Tai! Where are you going?",
      "speaker_id": 2111,
      "line_type": 2,
      "_offset": 31991,
      "_bytes": 28,
      "translation": "¡Tai! ¿A dónde vas?"
    },
    {
      "index": 205,
      "english": "Oops. I ought to check on the\nothers first.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 32020,
      "_bytes": 43,
      "translation": "Ups. Tengo que hablar con\nel resto primero."
    },
    {
      "index": 206,
      "english": "Tai! We have to go help Mimi!",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 32064,
      "_bytes": 32,
      "translation": "¡Tai! ¡Debemos ayudar a Mimi!"
    },
    {
      "index": 207,
      "english": "Yes...At this point in time, the\nchildren had no idea...",
      "speaker_id": 9003,
      "line_type": 2,
      "_offset": 32097,
      "_bytes": 56,
      "translation": "En este preciso momento, \nlos niños no tenían ni idea..."
    },
    {
      "index": 208,
      "english": "...that it was the beginning of\ntheir longest, and yet shortest,\nsummer vacation ever...",
      "speaker_id": 9003,
      "line_type": 2,
      "_offset": 32154,
      "_bytes": 88,
      "translation": "...de que empezaban sus más\nlargas, y a la vez más cortas,\nvacaciones de verano..."
    }
  ]
}