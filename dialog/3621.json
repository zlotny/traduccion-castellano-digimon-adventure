{
  "file_id": "3621",
  "format": "etdf",
  "kind": "ETDF",
  "text_count": 102,
  "dialog": [
    {
      "index": 0,
      "english": "!!",
      "speaker_id": 9001,
      "line_type": 2,
      "_offset": 9048,
      "_bytes": 2,
      "translation": "!!"
    },
    {
      "index": 1,
      "english": "That's Gankuumon!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 9051,
      "_bytes": 17,
      "translation": "¡Es Gankoomon!"
    },
    {
      "index": 2,
      "english": "Someone else is there, too!",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 9069,
      "_bytes": 27,
      "translation": "¡Hay alguien más ahí!"
    },
    {
      "index": 3,
      "english": "Yo, man, that's the biggest one\nI've seen so far! Go get him,\nArresterdramon!",
      "speaker_id": 7061,
      "line_type": 2,
      "_offset": 9097,
      "_bytes": 77,
      "translation": "Tío, ¡es el más grande que\nhe visto! ¡A por él,\nArresterdramon!"
    },
    {
      "index": 4,
      "english": "Grooooooooh!",
      "speaker_id": 7171,
      "line_type": 2,
      "_offset": 9175,
      "_bytes": 12,
      "translation": "¡Groooooooh!"
    },
    {
      "index": 5,
      "english": "...Too inexperienced!",
      "speaker_id": 7191,
      "line_type": 2,
      "_offset": 9188,
      "_bytes": 21,
      "translation": "...¡Aún eres novato!"
    },
    {
      "index": 6,
      "english": "Aaaaaaagh!",
      "speaker_id": 7171,
      "line_type": 2,
      "_offset": 9210,
      "_bytes": 10,
      "translation": "¡Aaaaaagh!"
    },
    {
      "index": 7,
      "english": "Arresterdramon!",
      "speaker_id": 7061,
      "line_type": 2,
      "_offset": 9221,
      "_bytes": 15,
      "translation": "¡Arresterdramon!"
    },
    {
      "index": 8,
      "english": "There you are, Gankuumon!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 9237,
      "_bytes": 25,
      "translation": "¡Ahí estás, Gankoomon!"
    },
    {
      "index": 9,
      "english": "...",
      "speaker_id": 7191,
      "line_type": 2,
      "_offset": 9263,
      "_bytes": 3,
      "translation": "..."
    },
    {
      "index": 10,
      "english": "Not again!",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 9267,
      "_bytes": 10,
      "translation": "¡Ay, no!"
    },
    {
      "index": 11,
      "english": "He's gone...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 9278,
      "_bytes": 12,
      "translation": "Se ha ido..."
    },
    {
      "index": 12,
      "english": "Man, he got away...",
      "speaker_id": 7061,
      "line_type": 2,
      "_offset": 9291,
      "_bytes": 19,
      "translation": "Vaya, se escapó..."
    },
    {
      "index": 13,
      "english": "Sorry, Tagiru!",
      "speaker_id": 7171,
      "line_type": 2,
      "_offset": 9311,
      "_bytes": 14,
      "translation": "¡Perdón, Tagiru!"
    },
    {
      "index": 14,
      "english": "No sweat, no sweat. We'll just\nhave to look for him again.",
      "speaker_id": 7061,
      "line_type": 2,
      "_offset": 9326,
      "_bytes": 58,
      "translation": "Tranquilo, tranquilo. Solo\ntenemos que buscarlo otra vez."
    },
    {
      "index": 15,
      "english": "By the way, would you happen to be\nTaiki's friend?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 9385,
      "_bytes": 50,
      "translation": "Por cierto, ¿serás amigo\nde Taiki?"
    },
    {
      "index": 16,
      "english": "Taiki? Aaaaah! Aaaaaaaaaaaaaaaah!",
      "speaker_id": 7061,
      "line_type": 2,
      "_offset": 9436,
      "_bytes": 33,
      "translation": "¿Taiki? ¡Aaaah! ¡Aaaaaaaaaah!"
    },
    {
      "index": 17,
      "english": "Ack!",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 9470,
      "_bytes": 4,
      "translation": "¡Ay!"
    },
    {
      "index": 18,
      "english": "Whoopsie-daisy! I *totally* forgot\nabout Taiki!",
      "speaker_id": 7061,
      "line_type": 2,
      "_offset": 9475,
      "_bytes": 47,
      "translation": "¡Uy, uy! ¡Me olvidé\ntotalmente de Taiki!"
    },
    {
      "index": 19,
      "english": "We gotta go back, Arresterdramon!",
      "speaker_id": 7061,
      "line_type": 2,
      "_offset": 9523,
      "_bytes": 33,
      "translation": "¡Hay que volver, Arresterdramon!"
    },
    {
      "index": 20,
      "english": "But, Tagiru... what about these\nguys...",
      "speaker_id": 7171,
      "line_type": 2,
      "_offset": 9557,
      "_bytes": 39,
      "translation": "Pero, Tagiru... y estos\nde aquí..."
    },
    {
      "index": 21,
      "english": "Oops, forgot about them! Hey, why\ndon't you come with us?",
      "speaker_id": 7061,
      "line_type": 2,
      "_offset": 9597,
      "_bytes": 57,
      "translation": "¡Uy, me olvidé de vosotros!\n¡Venid con nosotros!"
    },
    {
      "index": 22,
      "english": "O-Okay!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 9655,
      "_bytes": 7,
      "translation": "¡V-Vale!"
    },
    {
      "index": 23,
      "english": "I'm Tagiru Akashi, and this is\nArresterdramon.",
      "speaker_id": 7061,
      "line_type": 2,
      "_offset": 9663,
      "_bytes": 46,
      "translation": "Soy Tagiru Akashi, y este\nes Arresterdramon."
    },
    {
      "index": 24,
      "english": "Nice to meet you, Tai and\nAgumon!",
      "speaker_id": 7171,
      "line_type": 2,
      "_offset": 9710,
      "_bytes": 36,
      "translation": "¡Encantado, Tai y Agumon!"
    },
    {
      "index": 25,
      "english": "Nice to meet you!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 9747,
      "_bytes": 17,
      "translation": "¡Encantado!"
    },
    {
      "index": 26,
      "english": "Nice to meet you!",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 9765,
      "_bytes": 17,
      "translation": "¡Encantado!"
    },
    {
      "index": 27,
      "english": "I'm Taiki's junior, and a Digimon\nHunter!",
      "speaker_id": 7061,
      "line_type": 2,
      "_offset": 9783,
      "_bytes": 41,
      "translation": "¡Soy el sucesor de Taiki\ny Cazador de Digimon!"
    },
    {
      "index": 28,
      "english": "What?!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 9825,
      "_bytes": 6,
      "translation": "¡¿Qué?!"
    },
    {
      "index": 29,
      "english": "A Digimon... Hunter?!",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 9832,
      "_bytes": 21,
      "translation": "¡¿Cazador de Digimon?!"
    },
    {
      "index": 30,
      "english": "Oh! No worries, no worries! We\ndon't take other people's Digimon!",
      "speaker_id": 7061,
      "line_type": 2,
      "_offset": 9854,
      "_bytes": 65,
      "translation": "¡Tranquilo, tranquilo! ¡No nos\nquedamos con Digimon ajenos!"
    },
    {
      "index": 31,
      "english": "...R-Right! Thank goodness!",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 9920,
      "_bytes": 27,
      "translation": "...¡C-Claro! ¡Menos mal!"
    },
    {
      "index": 32,
      "english": "...",
      "speaker_id": 9002,
      "line_type": 2,
      "_offset": 9948,
      "_bytes": 3,
      "translation": "..."
    },
    {
      "index": 33,
      "english": "There's a fake, right there!",
      "speaker_id": 7171,
      "line_type": 2,
      "_offset": 9952,
      "_bytes": 28,
      "translation": "¡Ahí hay un falso!"
    },
    {
      "index": 34,
      "english": "Right on... just like they said.\nLooks just like Arresterdramon!",
      "speaker_id": 7061,
      "line_type": 2,
      "_offset": 9981,
      "_bytes": 64,
      "translation": "Justo... como dijeron.\n¡Es igual a Arresterdramon!"
    },
    {
      "index": 35,
      "english": "Let's go, guys!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 10046,
      "_bytes": 15,
      "translation": "¡Vamos, chicos!"
    },
    {
      "index": 36,
      "english": "We did it, Tagiru!",
      "speaker_id": 7171,
      "line_type": 2,
      "_offset": 10062,
      "_bytes": 18,
      "translation": "¡Ganamos, Tagiru!"
    },
    {
      "index": 37,
      "english": "Great job as always,\nArresterdramon!",
      "speaker_id": 7061,
      "line_type": 2,
      "_offset": 10081,
      "_bytes": 36,
      "translation": "¡Buen trabajo,\nArresterdramon!"
    },
    {
      "index": 38,
      "english": "You did great, Agumon!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 10118,
      "_bytes": 22,
      "translation": "¡Bien hecho, Agumon!"
    },
    {
      "index": 39,
      "english": "Well, it wasn't easy...",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 10141,
      "_bytes": 23,
      "translation": "Bueno, no fue fácil..."
    },
    {
      "index": 40,
      "english": "So Tai can go home, right?",
      "speaker_id": 7061,
      "line_type": 2,
      "_offset": 10165,
      "_bytes": 29,
      "translation": "Así Tai puede volver, ¿no?"
    },
    {
      "index": 41,
      "english": "!!",
      "speaker_id": 7171,
      "line_type": 2,
      "_offset": 10195,
      "_bytes": 2,
      "translation": "!!"
    },
    {
      "index": 42,
      "english": "!!",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 10198,
      "_bytes": 2,
      "translation": "!!"
    },
    {
      "index": 43,
      "english": "You've finally arrived, chosen\nones...",
      "speaker_id": 7191,
      "line_type": 2,
      "_offset": 10201,
      "_bytes": 38,
      "translation": "Por fin llegasteis,\nelegidos..."
    },
    {
      "index": 44,
      "english": "Gankuumon!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 10240,
      "_bytes": 10,
      "translation": "¡Gankoomon!"
    },
    {
      "index": 45,
      "english": "I'm gonna get revenge for Hackmon!",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 10251,
      "_bytes": 34,
      "translation": "¡Voy a vengar a Hackmon!"
    },
    {
      "index": 46,
      "english": "And we're gonna getcha this time!",
      "speaker_id": 7061,
      "line_type": 2,
      "_offset": 10286,
      "_bytes": 33,
      "translation": "¡Y esta vez te atrapamos!"
    },
    {
      "index": 47,
      "english": "Get ready!",
      "speaker_id": 7171,
      "line_type": 2,
      "_offset": 10320,
      "_bytes": 10,
      "translation": "¡Prepárate!"
    },
    {
      "index": 48,
      "english": "...",
      "speaker_id": 7191,
      "line_type": 2,
      "_offset": 10331,
      "_bytes": 3,
      "translation": "..."
    },
    {
      "index": 49,
      "english": "Ngh... ghhhh...",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 10335,
      "_bytes": 15,
      "translation": "Ngh... ghhhh..."
    },
    {
      "index": 50,
      "english": "Hackmon!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 10351,
      "_bytes": 8,
      "translation": "¡Hackmon!"
    },
    {
      "index": 51,
      "english": "Tai... Agumon...",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 10360,
      "_bytes": 19,
      "translation": "Tai... Agumon..."
    },
    {
      "index": 52,
      "english": "So you've finally recovered...\nHave you finally trained properly?",
      "speaker_id": 7191,
      "line_type": 2,
      "_offset": 10380,
      "_bytes": 65,
      "translation": "Así que por fin te recuperaste...\n¿Ya has entrenado como\nes debido?"
    },
    {
      "index": 53,
      "english": "And you didn't let a silly little\npunch get you down either, did\nyou?",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 10446,
      "_bytes": 69,
      "translation": "Y no dejaste que un simple\npuñetazo te derrotara,\n¿verdad?"
    },
    {
      "index": 54,
      "english": "Hahahahaha!",
      "speaker_id": 7191,
      "line_type": 2,
      "_offset": 10516,
      "_bytes": 11,
      "translation": "¡Jajajaja!"
    },
    {
      "index": 55,
      "english": "Hahahahaha!",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 10528,
      "_bytes": 11,
      "translation": "¡Jajajaja!"
    },
    {
      "index": 56,
      "english": "??",
      "speaker_id": 9001,
      "line_type": 2,
      "_offset": 10540,
      "_bytes": 2,
      "translation": "??"
    },
    {
      "index": 57,
      "english": "...Why are you two so friendly all\nof a sudden?",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 10543,
      "_bytes": 47,
      "translation": "...¿Por qué de repente sois\ntan amigos?"
    },
    {
      "index": 58,
      "english": "Oh, Gankuumon's like my guardian\nof sorts.",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 10591,
      "_bytes": 42,
      "translation": "Ah, Gankoomon es mi\nguardián, más o menos."
    },
    {
      "index": 59,
      "english": "What?!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 10634,
      "_bytes": 6,
      "translation": "¡¿Qué?!"
    },
    {
      "index": 60,
      "english": "So then why were you attacking\nGankuumon earlier?",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 10641,
      "_bytes": 49,
      "translation": "¿Entonces por qué atacabas\na Gankoomon antes?"
    },
    {
      "index": 61,
      "english": "Oh, I always do that. It's like\nour daily ritual.",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 10691,
      "_bytes": 49,
      "translation": "Ah, siempre hago eso. Es\nnuestro ritual diario."
    },
    {
      "index": 62,
      "english": "'Cause if I don't, he's gonna get\n*me* instead.",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 10741,
      "_bytes": 47,
      "translation": "Porque si no, me atrapa\na mí en su lugar."
    },
    {
      "index": 63,
      "english": "Exactly.",
      "speaker_id": 7191,
      "line_type": 2,
      "_offset": 10789,
      "_bytes": 8,
      "translation": "Exacto."
    },
    {
      "index": 64,
      "english": "What? You really seemed like you\nhated each other, I thought you\nwere mortal enemies!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 10798,
      "_bytes": 85,
      "translation": "¿Qué? ¡Parecía que os\nodiabais! ¡Pensé que erais\nenemigos mortales!"
    },
    {
      "index": 65,
      "english": "Hey, hey, but then what are you?\nYou're clearly not normal.",
      "speaker_id": 7061,
      "line_type": 2,
      "_offset": 10884,
      "_bytes": 59,
      "translation": "Oye, oye, ¿entonces qué\neres? Está claro que no\neres normal."
    },
    {
      "index": 66,
      "english": "Gankuumon is one of the Royal\nKnights who protects the order of\nthe Digital World!",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 10944,
      "_bytes": 82,
      "translation": "¡Gankoomon es uno de los\nCaballeros Reales que protegen\nel orden del Digimundo!"
    },
    {
      "index": 67,
      "english": "The Royal Knights?!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 11027,
      "_bytes": 19,
      "translation": "¡¿Caballeros Reales?!"
    },
    {
      "index": 68,
      "english": "And someday I'll be as strong as\nhim, you just wait!",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 11047,
      "_bytes": 52,
      "translation": "¡Y algún día seré tan\nfuerte como él, ya verás!"
    },
    {
      "index": 69,
      "english": "So then why are *we* trapped in\nhere?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 11100,
      "_bytes": 37,
      "translation": "¿Y por qué estamos\natrapados aquí?"
    },
    {
      "index": 70,
      "english": "We need you to correct the\ndistortions in the digital fields.",
      "speaker_id": 7191,
      "line_type": 2,
      "_offset": 11138,
      "_bytes": 61,
      "translation": "Debéis corregir las\ndistorsiones de los campos\ndigitales."
    },
    {
      "index": 71,
      "english": "Something with great power has\nforced itself into this space and\nhastened its collapse.",
      "speaker_id": 7191,
      "line_type": 2,
      "_offset": 11200,
      "_bytes": 87,
      "translation": "Algo con mucho poder se\ncoló en este espacio y\naceleró su colapso."
    },
    {
      "index": 72,
      "english": "You have defeated numerous\nenemies, and you have finally\nreached this place.",
      "speaker_id": 7191,
      "line_type": 2,
      "_offset": 11288,
      "_bytes": 76,
      "translation": "Habéis derrotado a muchos\nenemigos, y por fin habéis\nllegado hasta aquí."
    },
    {
      "index": 73,
      "english": "So then what are the distortions?",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 11365,
      "_bytes": 33,
      "translation": "¿Y qué son las distorsiones?"
    },
    {
      "index": 74,
      "english": "In this place, distorted fragments\nin the Digital World are\ngathering...",
      "speaker_id": 7191,
      "line_type": 2,
      "_offset": 11399,
      "_bytes": 72,
      "translation": "Aquí se están juntando\nfragmentos distorsionados\ndel Digimundo..."
    },
    {
      "index": 75,
      "english": "It has copied the appearance of\nyour Digimon and, without any\nconscience, continued to grow.",
      "speaker_id": 7191,
      "line_type": 2,
      "_offset": 11472,
      "_bytes": 92,
      "translation": "Ha copiado la apariencia\nde vuestros Digimon y sigue\ncreciendo sin consciencia."
    },
    {
      "index": 76,
      "english": "So if we don't do anything about\nall the fake Digimon...",
      "speaker_id": 7061,
      "line_type": 2,
      "_offset": 11565,
      "_bytes": 56,
      "translation": "Así que si no hacemos nada\ncon los Digimon falsos..."
    },
    {
      "index": 77,
      "english": "The copies will continue to\npermeate through things and gain\npower.",
      "speaker_id": 7191,
      "line_type": 2,
      "_offset": 11622,
      "_bytes": 67,
      "translation": "Las copias seguirán\nextendiéndose y ganando\npoder."
    },
    {
      "index": 78,
      "english": "If they were to overflow from this\nspace, they would completely cover\nthe Digital Field.",
      "speaker_id": 7191,
      "line_type": 2,
      "_offset": 11690,
      "_bytes": 88,
      "translation": "Si desbordaran este\nespacio, cubrirían por\ncompleto el campo digital."
    },
    {
      "index": 79,
      "english": "No way...",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 11779,
      "_bytes": 9,
      "translation": "No puede ser..."
    },
    {
      "index": 80,
      "english": "And if that happens, it'll have\nbad effects on our world, too.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 11789,
      "_bytes": 62,
      "translation": "Y si eso pasa, también\nafectará mal a nuestro\nmundo."
    },
    {
      "index": 81,
      "english": "There is not much time left before\nthis space collapses.",
      "speaker_id": 7191,
      "line_type": 2,
      "_offset": 11852,
      "_bytes": 56,
      "translation": "Queda poco tiempo antes de\nque este espacio colapse."
    },
    {
      "index": 82,
      "english": "I have opened the door to the\nspatial core that controls this\nspace. Now go, chosen ones.",
      "speaker_id": 7191,
      "line_type": 2,
      "_offset": 11909,
      "_bytes": 89,
      "translation": "He abierto la puerta al\nnúcleo espacial que controla\neste lugar. Id ya, elegidos."
    },
    {
      "index": 83,
      "english": "I shall stave off the collapse of\nthis space in the meantime.",
      "speaker_id": 7191,
      "line_type": 2,
      "_offset": 11999,
      "_bytes": 61,
      "translation": "Yo contendré el colapso\nde este espacio mientras\ntanto."
    },
    {
      "index": 84,
      "english": "Hackmon, come here!",
      "speaker_id": 7191,
      "line_type": 2,
      "_offset": 12061,
      "_bytes": 19,
      "translation": "¡Hackmon, ven aquí!"
    },
    {
      "index": 85,
      "english": "Gankuumon...",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 12081,
      "_bytes": 12,
      "translation": "Gankoomon..."
    },
    {
      "index": 86,
      "english": "You are still immature, but your\npotential exceeds even mine.",
      "speaker_id": 7191,
      "line_type": 2,
      "_offset": 12094,
      "_bytes": 61,
      "translation": "Aún eres inmaduro, pero tu\npotencial supera incluso\nal mío."
    },
    {
      "index": 87,
      "english": "I-It does?!",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 12156,
      "_bytes": 11,
      "translation": "¡¿En serio?!"
    },
    {
      "index": 88,
      "english": "You'll lead the chosen ones to the \nspatial core, where you will fix \nthe source that has gone haywire.",
      "speaker_id": 7191,
      "line_type": 2,
      "_offset": 12168,
      "_bytes": 103,
      "translation": "Guiarás a los elegidos hasta\nel núcleo espacial, donde\narreglarás la fuente dañada."
    },
    {
      "index": 89,
      "english": "I will!",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 12272,
      "_bytes": 7,
      "translation": "¡Lo haré!"
    },
    {
      "index": 90,
      "english": "Tai!",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 12280,
      "_bytes": 7,
      "translation": "¡Tai!"
    },
    {
      "index": 91,
      "english": "Yeah, there's no way we're gonna\nrun away from this!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 12288,
      "_bytes": 52,
      "translation": "¡Sí, no vamos a huir\nde esto!"
    },
    {
      "index": 92,
      "english": "We'll go with you, too!",
      "speaker_id": 7061,
      "line_type": 2,
      "_offset": 12341,
      "_bytes": 23,
      "translation": "¡Nosotros también vamos!"
    },
    {
      "index": 93,
      "english": "Yeah, let us join in!",
      "speaker_id": 7171,
      "line_type": 2,
      "_offset": 12365,
      "_bytes": 21,
      "translation": "¡Sí, dejadnos unirnos!"
    },
    {
      "index": 94,
      "english": "Let's go, guys!",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 12387,
      "_bytes": 15,
      "translation": "¡Vamos, chicos!"
    },
    {
      "index": 95,
      "english": "I've reached my limits in my\ntraining as a Digimon Hunter. I'll\nshow you a real Hunt next time!",
      "speaker_id": 7061,
      "line_type": 2,
      "_offset": 12403,
      "_bytes": 95,
      "translation": "He llegado al límite como\nCazador de Digimon. ¡La próxima\nos mostraré una caza real!"
    },
    {
      "index": 96,
      "english": "And in order to make that happen,\nwe'll save the digital field!\nLet's go!",
      "speaker_id": 7191,
      "line_type": 2,
      "_offset": 12499,
      "_bytes": 73,
      "translation": "¡Y para lograrlo, vamos a\nsalvar el campo digital!\n¡Vamos!"
    },
    {
      "index": 97,
      "english": "It'll be fine, Tai!",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 12573,
      "_bytes": 22,
      "translation": "¡Todo saldrá bien, Tai!"
    },
    {
      "index": 98,
      "english": "Of course! We'll always find a\nway!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 12596,
      "_bytes": 35,
      "translation": "¡Claro! ¡Siempre encontramos\nla forma!"
    },
