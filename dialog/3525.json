{
  "file_id": "3525",
  "format": "etdf",
  "kind": "ETDF",
  "text_count": 23,
  "dialog": [
    {
      "index": 0,
      "english": "This place is all damp and\ndisgusting.",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 2520,
      "_bytes": 38,
      "translation": "Este lugar está húmedo y\nasqueroso."
    },
    {
      "index": 1,
      "english": "Yeah.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 2559,
      "_bytes": 5,
      "translation": "Sí."
    },
    {
      "index": 2,
      "english": "Kyaah!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 2565,
      "_bytes": 6,
      "translation": "¡Ahh!"
    },
    {
      "index": 3,
      "english": "!!",
      "speaker_id": 9001,
      "line_type": 2,
      "_offset": 2572,
      "_bytes": 2,
      "translation": "!!"
    },
    {
      "index": 4,
      "english": "What's wrong, Mimi?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 2575,
      "_bytes": 19,
      "translation": "¿Qué pasa, Mimi?"
    },
    {
      "index": 5,
      "english": "Look, this place is full of those\nNumemon!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 2595,
      "_bytes": 42,
      "translation": "¡Mira, está hasta arriba de\nNumemon!"
    },
    {
      "index": 6,
      "english": "You're right. Should we try to go\nthrough them?",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 2638,
      "_bytes": 47,
      "translation": "Es verdad. ¿Deberíamos ir a través\nde ellos?"
    },
    {
      "index": 7,
      "english": "All we can do is try to avoid\nthem. Let's hurry up and get\nthrough here.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 2686,
      "_bytes": 72,
      "translation": "Todo lo que podemos hacer es\ntratar de esquivarlos. Démonos\nprisa."
    },
    {
      "index": 8,
      "english": "Hey, I can see light!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 2759,
      "_bytes": 21,
      "translation": "¡Eh, veo luz!"
    },
    {
      "index": 9,
      "english": "All right! We found the exit!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 2781,
      "_bytes": 29,
      "translation": "¡Sí! ¡Encontramos la salida!"
    },
    {
      "index": 10,
      "english": "Ugh, we're finally free of those\nslimy Numemon.",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 2811,
      "_bytes": 47,
      "translation": "Ugh, por fin nos libramos de\nlos Numemon."
    },
    {
      "index": 11,
      "english": "Nunu! Looks like I've caught a\nsuspicious bunch sneaking around!",
      "speaker_id": 4031,
      "line_type": 2,
      "_offset": 2859,
      "_bytes": 64,
      "translation": "¡Nunu! ¡Parece que encontramos\ngente sospechosa merodeando!"
    },
    {
      "index": 12,
      "english": "Aaaah!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 2924,
      "_bytes": 6,
      "translation": "¡Ahh!"
    },
    {
      "index": 13,
      "english": "Are you okay, T.K?!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 2931,
      "_bytes": 22,
      "translation": "¡¿Estás bien, T.K.?!"
    },
    {
      "index": 14,
      "english": "Yeah...but my face feels all\nyucky.",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 2954,
      "_bytes": 35,
      "translation": "Sí, pero tengo la cara sucia."
    },
    {
      "index": 15,
      "english": "You can use my handkerchief.",
      "speaker_id": 4294967295,
      "line_type": 2,
      "_offset": 2990,
      "_bytes": 28,
      "translation": "Puedes usar mi pañuelo."
    },
    {
      "index": 16,
      "english": "Let's look for some water later.",
      "speaker_id": 4294967295,
      "line_type": 2,
      "_offset": 3019,
      "_bytes": 32,
      "translation": "Busquemos agua más tarde."
    },
    {
      "index": 17,
      "english": "What? But I'll get your\nhandkerchief all dirty!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 3052,
      "_bytes": 47,
      "translation": "¿Qué? ¡Pero te ensuciaré todo el\npañuelo!"
    },
    {
      "index": 18,
      "english": "The point of a handkerchief is for\nit to get dirty, right?",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 3100,
      "_bytes": 58,
      "translation": "Para eso sirve un pañuelo, ¿no es\ncierto?"
    },
    {
      "index": 19,
      "english": "Thank you, Mimi!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 3159,
      "_bytes": 16,
      "translation": "¡Gracias, Mimi!"
    },
    {
      "index": 20,
      "english": "Okay. But it feels really bad.",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 3176,
      "_bytes": 30,
      "translation": "Vale. Pero es desagradable."
    },
    {
      "index": 21,
      "english": "Here, use my towel to wipe your\nface.",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 3207,
      "_bytes": 37,
      "translation": "Toma, usa mi toalla para\nlimpiarte."
    },
    {
      "index": 22,
      "english": "Thanks, Matt.",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 3245,
      "_bytes": 15,
      "translation": "Gracias, Matt."
    }
  ]
}