  "dialog": [
    {
      "index": 0,
      "english": "��������This place is all damp and\ndisgusting.",
      "_offset": 843,
      "_length": 46,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 1,
      "english": "Yeah.",
      "_offset": 890,
      "_length": 5,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 2,
      "english": "Kyaah!",
      "_offset": 896,
      "_length": 6,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 3,
      "english": "What's wrong, Mimi?",
      "_offset": 906,
      "_length": 19,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 4,
      "english": "Look, this place is full of those\nNumemon!",
      "_offset": 926,
      "_length": 42,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 5,
      "english": "You're right. Should we try to go\nthrough them?",
      "_offset": 969,
      "_length": 47,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 6,
      "english": "All we can do is try to avoid\nthem. Let's hurry up and get\nthrough here.",
      "_offset": 1017,
      "_length": 72,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 7,
      "english": "Hey, I can see light!",
      "_offset": 1090,
      "_length": 21,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 8,
      "english": "All right! We found the exit!",
      "_offset": 1112,
      "_length": 29,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 9,
      "english": "Ugh, we're finally free of those\nslimy Numemon.",
      "_offset": 1142,
      "_length": 47,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 10,
      "english": "Nunu! Looks like I've caught a\nsuspicious bunch sneaking around!",
      "_offset": 1190,
      "_length": 64,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 11,
      "english": "Aaaah!",
      "_offset": 1255,
      "_length": 6,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 12,
      "english": "Are you okay, Takeru?!",
      "_offset": 1262,
      "_length": 22,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 13,
      "english": "Yeah...but my face feels all\nyucky.",
      "_offset": 1285,
      "_length": 35,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 14,
      "english": "You can use my handkerchief.",
      "_offset": 1321,
      "_length": 28,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 15,
      "english": "Let's look for some water later.",
      "_offset": 1350,
      "_length": 32,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 16,
      "english": "What? But I'll get your\nhandkerchief all dirty!",
      "_offset": 1383,
      "_length": 47,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 17,
      "english": "The point of a handkerchief is for\nit to get dirty, right?",
      "_offset": 1431,
      "_length": 58,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 18,
      "english": "Thank you, Mimi!",
      "_offset": 1490,
      "_length": 16,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 19,
      "english": "Okay. But it feels really bad.",
      "_offset": 1507,
      "_length": 30,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 20,
      "english": "Here, use my towel to wipe your\nface.",
      "_offset": 1538,
      "_length": 37,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 21,
      "english": "Thanks, Yamato.",
      "_offset": 1576,
      "_length": 15,
      "speaker_id": 0,
      "translation": ""
    }
  ]
}