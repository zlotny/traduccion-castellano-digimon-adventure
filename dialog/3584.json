  "kind": "ETDF",
  "text_count": 187,
  "dialog": [
    {
      "index": 0,
      "english": "Aaaaaaaah!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 19800,
      "_bytes": 10,
      "translation": "¡Aaaaaaaah!"
    },
    {
      "index": 1,
      "english": "Gaaaaaaah!",
      "speaker_id": 2151,
      "line_type": 2,
      "_offset": 19811,
      "_bytes": 10,
      "translation": "¡Gaaaaaaah!"
    },
    {
      "index": 2,
      "english": "Tai!",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 19822,
      "_bytes": 7,
      "translation": "¡Tai!"
    },
    {
      "index": 3,
      "english": "Tai!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 19830,
      "_bytes": 7,
      "translation": "¡Tai!"
    },
    {
      "index": 4,
      "english": "Izzy, stay back! Take care of\nKari!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 19838,
      "_bytes": 42,
      "translation": "Izzy, ¡quédate atrás! ¡Cuida\nde Kari!"
    },
    {
      "index": 5,
      "english": "Tai! At this rate, you'll...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 19881,
      "_bytes": 31,
      "translation": "¡Tai! A este paso vas a..."
    },
    {
      "index": 6,
      "english": "You're bein' real stubborn!",
      "speaker_id": 2421,
      "line_type": 2,
      "_offset": 19913,
      "_bytes": 27,
      "translation": "¡Eres un cabezota!"
    },
    {
      "index": 7,
      "english": "Fine! Call me stubborn if you\nlike! Just leave it to me, I'll\nfind a way to manage!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 19941,
      "_bytes": 83,
      "translation": "¡Vale! ¡Llamadme cabezota si\nqueréis! ¡Dejádmelo a mí,\nya me las apañaré!"
    },
    {
      "index": 8,
      "english": "!!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 20025,
      "_bytes": 2,
      "translation": "!!"
    },
    {
      "index": 9,
      "english": "!!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 20028,
      "_bytes": 2,
      "translation": "!!"
    },
    {
      "index": 10,
      "english": "WarGreymon!",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 20031,
      "_bytes": 11,
      "translation": "¡WarGreymon!"
    },
    {
      "index": 11,
      "english": "War...Greymon...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 20043,
      "_bytes": 16,
      "translation": "War...Greymon..."
    },
    {
      "index": 12,
      "english": "Tai!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 20060,
      "_bytes": 7,
      "translation": "¡Tai!"
    },
    {
      "index": 13,
      "english": "So. Who's next?",
      "speaker_id": 3081,
      "line_type": 2,
      "_offset": 20068,
      "_bytes": 15,
      "translation": "¿Quién sigue?"
    },
    {
      "index": 14,
      "english": "Tai!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 20084,
      "_bytes": 7,
      "translation": "¡Tai!"
    },
    {
      "index": 15,
      "english": "Ugh... Matt...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 20092,
      "_bytes": 16,
      "translation": "Argh... Matt..."
    },
    {
      "index": 16,
      "english": "Tai!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 20109,
      "_bytes": 7,
      "translation": "¡Tai!"
    },
    {
      "index": 17,
      "english": "Tai!",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 20117,
      "_bytes": 7,
      "translation": "¡Tai!"
    },
    {
      "index": 18,
      "english": "Tai, are you okay?",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 20125,
      "_bytes": 21,
      "translation": "Tai, ¿estás bien?"
    },
    {
      "index": 19,
      "english": "Joe... Mimi...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 20147,
      "_bytes": 14,
      "translation": "Joe... Mimi..."
    },
    {
      "index": 20,
      "english": "Ogremon and the others are here\ntoo!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 20162,
      "_bytes": 36,
      "translation": "¡Ogremon y los demás\nestán aquí!"
    },
    {
      "index": 21,
      "english": "I see... we've got a lot of\nfriends on our side...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 20199,
      "_bytes": 50,
      "translation": "Ya veo... tenemos muchos\namigos de nuestro lado..."
    },
    {
      "index": 22,
      "english": "My, someone's late. But it doesn't \nmatter whether you're early or \nlate. The result will be the same.",
      "speaker_id": 3081,
      "line_type": 2,
      "_offset": 20250,
      "_bytes": 102,
      "translation": "Vaya, llegas tarde. Pero da\nigual que sea pronto o tarde,\nel resultado será el mismo."
    },
    {
      "index": 23,
      "english": "You're finally here... I've been\nwaiting for you all this time, you\nknow.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 20353,
      "_bytes": 73,
      "translation": "Por fin llegas... Llevo\nesperándote todo este\ntiempo, ¿sabes?"
    },
    {
      "index": 24,
      "english": "Tai...",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 20427,
      "_bytes": 9,
      "translation": "Tai..."
    },
    {
      "index": 25,
      "english": "I believed you'd come... no, I\nknew you'd come...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 20437,
      "_bytes": 49,
      "translation": "Creía que vendrías... no,\nsabía que vendrías..."
    },
    {
      "index": 26,
      "english": "...Thank you. Thank you for\nbelieving in me. But I'm sorry,\nI'm late...",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 20487,
      "_bytes": 71,
      "translation": "...Gracias. Gracias por\ncreer en mí. Pero lo\nsiento, llego tarde..."
    },
    {
      "index": 27,
      "english": "Tai... you're my true friend!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 20559,
      "_bytes": 32,
      "translation": "Tai... ¡eres mi verdadero amigo!"
    },
    {
      "index": 28,
      "english": "And I won't throw your friendship\naway!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 20592,
      "_bytes": 39,
      "translation": "¡Y no tiraré tu amistad\npor la borda!"
    },
    {
      "index": 29,
      "english": "Huh? That's...",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 20632,
      "_bytes": 14,
      "translation": "¿Eh? Eso es..."
    },
    {
      "index": 30,
      "english": "What?!",
      "speaker_id": 3081,
      "line_type": 2,
      "_offset": 20647,
      "_bytes": 6,
      "translation": "¡¿Qué?!"
    },
    {
      "index": 31,
      "english": "Matt's Crest of Friendship is\nbringing WarGreymon back to life!",
      "speaker_id": 2231,
      "line_type": 2,
      "_offset": 20654,
      "_bytes": 65,
      "translation": "¡El Emblema de la Amistad\nde Matt le devuelve la\nvida a WarGreymon!"
    },
    {
      "index": 32,
      "english": "Thanks! Now I can fight again!",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 20720,
      "_bytes": 30,
      "translation": "¡Gracias! ¡Puedo luchar de nuevo!"
    },
    {
      "index": 33,
      "english": "Hmph! I wanted to defeat you, one\nby one...",
      "speaker_id": 3081,
      "line_type": 2,
      "_offset": 20751,
      "_bytes": 43,
      "translation": "¡Hmph! Quería derrotaros\nde uno en uno..."
    },
    {
      "index": 34,
      "english": "But you're free to die in whatever\nway you please. After all, the end\nresult will be the same.",
      "speaker_id": 3081,
      "line_type": 2,
      "_offset": 20795,
      "_bytes": 94,
      "translation": "Pero sois libres de morir\ncomo queráis. Al fin y al\ncabo, el resultado será igual."
    },
    {
      "index": 35,
      "english": "And if you want to suffer that\nbadly, I won't stop you.",
      "speaker_id": 3081,
      "line_type": 2,
      "_offset": 20890,
      "_bytes": 55,
      "translation": "Y si tantas ganas tenéis\nde sufrir, no os lo\nimpediré."
    },
    {
      "index": 36,
      "english": "Oh, shut your mouth!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 20946,
      "_bytes": 20,
      "translation": "¡Cállate de una vez!"
    },
    {
      "index": 37,
      "english": "Guys, let's take him out together!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 20967,
      "_bytes": 34,
      "translation": "Chicos, ¡acabemos con él juntos!"
    },
    {
      "index": 38,
      "english": "Yeah!",
      "speaker_id": 9001,
      "line_type": 2,
      "_offset": 21002,
      "_bytes": 5,
      "translation": "¡Sí!"
    },
    {
      "index": 39,
      "english": "Hahaha...",
      "speaker_id": 3081,
      "line_type": 2,
      "_offset": 21008,
      "_bytes": 9,
      "translation": "Jajaja..."
    },
    {
      "index": 40,
      "english": "All right, let's go!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 21018,
      "_bytes": 20,
      "translation": "¡Muy bien, vamos!"
    },
    {
      "index": 41,
      "english": "Wait!",
      "speaker_id": 4021,
      "line_type": 2,
      "_offset": 21039,
      "_bytes": 5,
      "translation": "¡Alto!"
    },
    {
      "index": 42,
      "english": "Tai!",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 21045,
      "_bytes": 7,
      "translation": "¡Tai!"
    },
    {
      "index": 43,
      "english": "What's going on?",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 21053,
      "_bytes": 16,
      "translation": "¿Qué pasa?"
    },
    {
      "index": 44,
      "english": "He's taken Tai and Matt\nsomewhere!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 21070,
      "_bytes": 39,
      "translation": "¡Se llevó a Tai y a Matt\na algún sitio!"
    },
    {
      "index": 45,
      "english": "He's taken Tai and Matt\nsomewhere!",
      "speaker_id": 8041,
      "line_type": 2,
      "_offset": 21110,
      "_bytes": 39,
      "translation": "¡Se llevó a Tai y a Matt\na algún sitio!"
    },
    {
      "index": 46,
      "english": "Look, they're right here!",
      "speaker_id": 3081,
      "line_type": 2,
      "_offset": 21150,
      "_bytes": 25,
      "translation": "¡Mirad, están aquí mismo!"
    },
    {
      "index": 47,
      "english": "He... he turned them into dolls...",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 21176,
      "_bytes": 34,
      "translation": "Los... los convirtió en muñecos..."
    },
    {
      "index": 48,
      "english": "That's right. They've become my\nprizes for my personal collection.",
      "speaker_id": 3081,
      "line_type": 2,
      "_offset": 21211,
      "_bytes": 66,
      "translation": "Así es. Se han convertido\nen trofeos para mi\ncolección personal."
    },
    {
      "index": 49,
      "english": "Hahaha! I wonder who's next...?",
      "speaker_id": 3081,
      "line_type": 2,
      "_offset": 21278,
      "_bytes": 31,
      "translation": "¡Jajaja! ¿Quién sigue...?"
    },
    {
      "index": 50,
      "english": "Run! Get to that cave!",
      "speaker_id": 4021,
      "line_type": 2,
      "_offset": 21310,
      "_bytes": 22,
      "translation": "¡Corred! ¡A la cueva!"
    },
    {
      "index": 51,
      "english": "Andromon!",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 21333,
      "_bytes": 9,
      "translation": "¡Andromon!"
    },
    {
      "index": 52,
      "english": "I'll take care of him!",
      "speaker_id": 4021,
      "line_type": 2,
      "_offset": 21343,
      "_bytes": 22,
      "translation": "¡Yo me encargo de él!"
    },
    {
      "index": 53,
      "english": "But...",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 21366,
      "_bytes": 6,
      "translation": "Pero..."
    },
    {
      "index": 54,
      "english": "Come on, Sora! We can't let his\nefforts be in vain!",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 21373,
      "_bytes": 51,
      "translation": "¡Vamos, Sora! ¡No dejemos\nque su esfuerzo sea en\nvano!"
    },
    {
      "index": 55,
      "english": "Hurry!",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 21425,
      "_bytes": 6,
      "translation": "¡Vamos!"
    },
    {
      "index": 56,
      "english": "But what about Tai and Matt?",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 21432,
      "_bytes": 33,
      "translation": "¿Y qué hay de Tai y Matt?"
    },
    {
      "index": 57,
      "english": "I'm sure there's a way to save\nthem. We'll figure it out while we\nescape!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 21466,
      "_bytes": 73,
      "translation": "Seguro que hay forma de\nsalvarlos. ¡Lo pensaremos\nmientras escapamos!"
    },
    {
      "index": 58,
      "english": "Now Andromon is a doll, too. Who's\nnext?",
      "speaker_id": 3081,
      "line_type": 2,
      "_offset": 21540,
      "_bytes": 40,
      "translation": "Andromon ya es un\nmuñeco. ¿Quién sigue?"
    },
    {
      "index": 59,
      "english": "Not Andromon, too!",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 21581,
      "_bytes": 18,
      "translation": "¡Andromon no!"
    },
    {
      "index": 60,
      "english": "Go, Sora!",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 21600,
      "_bytes": 9,
      "translation": "¡Ve, Sora!"
    },
    {
      "index": 61,
      "english": "We'll figure something out!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 21610,
      "_bytes": 27,
      "translation": "¡Ya se nos ocurrirá algo!"
    },
    {
      "index": 62,
      "english": "Joe! Izzy!",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 21638,
      "_bytes": 15,
      "translation": "¡Joe! ¡Izzy!"
    },
    {
      "index": 63,
      "english": "Gyaaaaaah!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 21654,
      "_bytes": 10,
      "translation": "¡Gyaaaaaah!"
    },
    {
      "index": 64,
      "english": "Aaaaaaaaaah!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 21665,
      "_bytes": 12,
      "translation": "¡Aaaaaaaaah!"
    },
    {
      "index": 65,
      "english": "What'dya do to Izzy?!",
      "speaker_id": 2421,
      "line_type": 2,
      "_offset": 21678,
      "_bytes": 26,
      "translation": "¡¿Qué le hiciste a Izzy?!"
    },
    {
      "index": 66,
      "english": "I'll get you back for what you did\nto Joe!",
      "speaker_id": 2621,
      "line_type": 2,
      "_offset": 21705,
      "_bytes": 42,
      "translation": "¡Me las pagarás por lo\nque le hiciste a Joe!"
    },
    {
      "index": 67,
      "english": "Kari! T.K! Run!",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 21748,
      "_bytes": 20,
      "translation": "¡Kari! ¡T.K.! ¡Corred!"
    },
    {
      "index": 68,
      "english": "Oh, it's pointless to run. I've\ngot you. You cannot escape...",
      "speaker_id": 3081,
      "line_type": 2,
      "_offset": 21769,
      "_bytes": 61,
      "translation": "Es inútil correr. Os\ntengo. No podéis escapar..."
    },
    {
      "index": 69,
      "english": "Izzy... Mimi...",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 21831,
      "_bytes": 20,
      "translation": "Izzy... Mimi..."
    },
    {
      "index": 70,
      "english": "Is Joe gonna be okay...?",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 21852,
      "_bytes": 24,
      "translation": "¿Joe estará bien...?"
    },
    {
      "index": 71,
      "english": "I'll save the others! Just get out\nof here!",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 21877,
      "_bytes": 43,
      "translation": "¡Yo salvaré a los demás!\n¡Salid de aquí!"
    },
    {
      "index": 72,
      "english": "It's over...",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 21921,
      "_bytes": 12,
      "translation": "Se acabó..."
    },
    {
      "index": 73,
      "english": "No, it's not!",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 21934,
      "_bytes": 13,
      "translation": "¡No, no acabó!"
    },
    {
      "index": 74,
      "english": "Perhaps it is.",
      "speaker_id": 3081,
      "line_type": 2,
      "_offset": 21948,
      "_bytes": 14,
      "translation": "Quizás sí."
    },
    {
      "index": 75,
      "english": "Sora...!",
      "speaker_id": 2321,
      "line_type": 2,
      "_offset": 21963,
      "_bytes": 8,
      "translation": "¡Sora...!"
    },
    {
      "index": 76,
      "english": "Sora!",
      "speaker_id": 8041,
      "line_type": 2,
      "_offset": 21972,
      "_bytes": 5,
      "translation": "¡Sora!"
    },
    {
      "index": 77,
      "english": "See, look!",
      "speaker_id": 3081,
      "line_type": 2,
      "_offset": 21978,
      "_bytes": 10,
      "translation": "¡Mirad!"
    },
    {
      "index": 78,
      "english": "See, look!",
      "speaker_id": 9901,
      "line_type": 2,
      "_offset": 21989,
      "_bytes": 10,
      "translation": "¡Mirad!"
    },
    {
      "index": 79,
      "english": "T.K...",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 22000,
      "_bytes": 9,
      "translation": "T.K..."
    },
    {
      "index": 80,
      "english": "What...?",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 22010,
      "_bytes": 8,
      "translation": "¿Qué...?"
    },
    {
      "index": 81,
      "english": "Take Kari with you and run.",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 22019,
      "_bytes": 29,
      "translation": "Llévate a Kari y corre."
    },
    {
      "index": 82,
      "english": "What?! But what about you?",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 22049,
      "_bytes": 26,
      "translation": "¡¿Qué?! ¿Y tú qué?"
    },
    {
      "index": 83,
      "english": "Forget about me. Got it?",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 22076,
      "_bytes": 24,
      "translation": "Olvídate de mí. ¿Vale?"
    },
    {
      "index": 84,
      "english": "O-Okay.",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 22101,
      "_bytes": 7,
      "translation": "V-Vale."
    },
    {
      "index": 85,
      "english": "No matter what happens, you need\nto get away.",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 22109,
      "_bytes": 45,
      "translation": "Pase lo que pase, tienes\nque escapar."
    },
    {
      "index": 86,
      "english": "Okay. I'll protect Kari, no\nmatter what!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 22155,
      "_bytes": 42,
      "translation": "Vale. ¡Protegeré a Kari,\npase lo que pase!"
    },
    {
      "index": 87,
      "english": "Good. Now hurry up and get out of\nhere!",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 22198,
      "_bytes": 39,
      "translation": "Bien. ¡Ahora daos prisa\ny salid de aquí!"
    },
    {
      "index": 88,
      "english": "N-No way...",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 22238,
      "_bytes": 11,
      "translation": "N-no puede ser..."
    },
    {
      "index": 89,
      "english": "It's a dead end...",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 22250,
      "_bytes": 18,
      "translation": "Sin salida..."
    },
    {
      "index": 90,
      "english": "What?!",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 22269,
      "_bytes": 6,
      "translation": "¡¿Qué?!"
    },
    {
      "index": 91,
      "english": "Leave him to me!",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 22276,
      "_bytes": 16,
      "translation": "¡Déjamelo a mí!"
    },
    {
      "index": 92,
      "english": "Aaaaaaaargh!",
      "speaker_id": 2731,
      "line_type": 2,
      "_offset": 22293,
      "_bytes": 12,
      "translation": "¡Aaaaaaaargh!"
    },
    {
      "index": 93,
      "english": "Angemon!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 22306,
      "_bytes": 8,
      "translation": "¡Angemon!"
    },
    {
      "index": 94,
      "english": "T.K...",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 22315,
      "_bytes": 9,
      "translation": "T.K..."
    },
    {
      "index": 95,
      "english": "(This is bad. I have to pull\nmyself together, or Kari will\nget scared, too.)",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 22325,
      "_bytes": 78,
      "translation": "(Esto es malo. Tengo que\nserenarme, o Kari\ntambién se asustará.)"
    },
    {
      "index": 96,
      "english": "Don't worry, Angemon can handle\nit.",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 22404,
      "_bytes": 35,
      "translation": "Tranquila, Angemon\npuede con esto."
    },
    {
      "index": 97,
      "english": "There's nowhere left for you to\nrun! Hahaha...",
      "speaker_id": 3081,
      "line_type": 2,
      "_offset": 22440,
      "_bytes": 46,
      "translation": "¡Ya no tenéis dónde huir!\nJajaja..."
    },
    {
      "index": 98,
      "english": "(This is it. This is the end...)",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 22487,
      "_bytes": 32,
      "translation": "(Esto es todo, es el final...)"
    },
    {
      "index": 99,
      "english": "Matt...",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 22520,
      "_bytes": 9,
      "translation": "Matt..."
    },
    {
      "index": 100,
      "english": "T.K, don't give up!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 22530,
      "_bytes": 22,
      "translation": "T.K., ¡no te rindas!"
    },
    {
      "index": 101,
      "english": "Big brother...",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 22553,
      "_bytes": 14,
      "translation": "Hermano..."
    },
    {
      "index": 102,
      "english": "You're my brother! You can't give\nup, no matter what!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 22568,
      "_bytes": 53,
      "translation": "¡Eres mi hermano! ¡No\npuedes rendirte, pase\nlo que pase!"
    },
    {
      "index": 103,
      "english": "You have to be strong, until it's\nall over!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 22622,
      "_bytes": 43,
      "translation": "¡Tienes que ser fuerte,\nhasta que todo acabe!"
    },
    {
      "index": 104,
      "english": "I won't give up. I won't give up\nuntil the end!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 22666,
      "_bytes": 47,
      "translation": "No me rendiré. ¡No me\nrendiré hasta el final!"
    },
    {
      "index": 105,
      "english": "If I die here, this world and our\nworld will be destroyed...",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 22714,
      "_bytes": 60,
      "translation": "Si muero aquí, este\nmundo y el nuestro\nserán destruidos..."
    },
    {
      "index": 106,
      "english": "So I won't give up!\nAngemoooooooon!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 22775,
      "_bytes": 35,
      "translation": "¡Así que no me rindo!\n¡Angemoooooooon!"
    },
    {
      "index": 107,
      "english": "T.K...",
      "speaker_id": 2731,
      "line_type": 2,
      "_offset": 22811,
      "_bytes": 9,
      "translation": "T.K..."
    },
    {
      "index": 108,
      "english": "Angemon... super-evolved...",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 22821,
      "_bytes": 27,
      "translation": "Angemon... evolucionó..."
    },
    {
      "index": 109,
      "english": "Whoaaaaaaa!",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 22849,
      "_bytes": 11,
      "translation": "¡Uaaaaaaaa!"
    },
    {
      "index": 110,
      "english": "What?!",
      "speaker_id": 3081,
      "line_type": 2,
      "_offset": 22861,
      "_bytes": 6,
      "translation": "¡¿Qué?!"
    },
    {
      "index": 111,
      "english": "Receive my Sword of Judgement!",
      "speaker_id": 2741,
      "line_type": 2,
      "_offset": 22868,
      "_bytes": 30,
      "translation": "¡Recibe mi Espada del Juicio!"
    },
    {
      "index": 112,
      "english": "Tailmon!",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 22899,
      "_bytes": 8,
      "translation": "¡Gatomon!"
    },
    {
      "index": 113,
      "english": "Yeah, I'm joining in!",
      "speaker_id": 2831,
      "line_type": 2,
      "_offset": 22908,
      "_bytes": 21,
      "translation": "¡Sí, yo también voy!"
    },
    {
      "index": 114,
      "english": "How interesting! I'll take you on!",
      "speaker_id": 3081,
      "line_type": 2,
      "_offset": 22930,
      "_bytes": 34,
      "translation": "¡Qué interesante! ¡Os haré frente!"
    },
    {
      "index": 115,
      "english": "Give everyone back!",
      "speaker_id": 2741,
      "line_type": 2,
      "_offset": 22965,
      "_bytes": 19,
      "translation": "¡Devuélvenoslos!"
    },
    {
      "index": 116,
      "english": "No...!",
      "speaker_id": 3081,
      "line_type": 2,
      "_offset": 22985,
      "_bytes": 6,
      "translation": "¡No...!"
    },
    {
      "index": 117,
      "english": "Wait!",
      "speaker_id": 2841,
      "line_type": 2,
      "_offset": 22992,
      "_bytes": 5,
      "translation": "¡Alto!"
    },
    {
      "index": 118,
      "english": "Wait!",
      "speaker_id": 8041,
      "line_type": 2,
      "_offset": 22998,
      "_bytes": 5,
      "translation": "¡Alto!"
    },
    {
      "index": 119,
      "english": "Don't you forget, I have these\ndolls with me.",
      "speaker_id": 3081,
      "line_type": 2,
      "_offset": 23004,
      "_bytes": 45,
      "translation": "No olvidéis que tengo\nestos muñecos conmigo."
    },
    {
      "index": 120,
      "english": "Don't you forget, I have these\ndolls with me.",
      "speaker_id": 9901,
      "line_type": 2,
      "_offset": 23050,
      "_bytes": 45,
      "translation": "No olvidéis que tengo\nestos muñecos conmigo."
    },
    {
      "index": 121,
      "english": "You coward!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 23096,
      "_bytes": 11,
      "translation": "¡Cobarde!"
    },
    {
      "index": 122,
      "english": "There's no need to worry!\nHoly Disinfection!",
      "speaker_id": 2741,
      "line_type": 2,
      "_offset": 23108,
      "_bytes": 44,
      "translation": "¡No hay que preocuparse!\n¡Purificación Sagrada!"
    },
    {
      "index": 123,
      "english": "Guys, we're back to normal...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 23153,
      "_bytes": 29,
      "translation": "Ya somos normales de nuevo..."
    },
    {
      "index": 124,
      "english": "Tai...",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 23183,
      "_bytes": 9,
      "translation": "Tai..."
    },
    {
      "index": 125,
      "english": "Matt...",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 23193,
      "_bytes": 9,
      "translation": "Matt..."
    },
    {
      "index": 126,
      "english": "Kari!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 23203,
      "_bytes": 7,
      "translation": "¡Kari!"
    },
    {
      "index": 127,
      "english": "T.K! You did great!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 23211,
      "_bytes": 22,
      "translation": "¡T.K.! ¡Lo hiciste bien!"
    },
    {
      "index": 128,
      "english": "It was thanks to you, Matt! You\nwere the one who cheered me on!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 23234,
      "_bytes": 65,
      "translation": "¡Fue gracias a ti, Matt!\n¡Tú fuiste quien me animó!"
    },
    {
      "index": 129,
      "english": "??",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 23300,
      "_bytes": 2,
      "translation": "??"
    },
    {
      "index": 130,
      "english": "I thought I could let you live by\nturning you into dolls...",
      "speaker_id": 3081,
      "line_type": 2,
      "_offset": 23303,
      "_bytes": 59,
      "translation": "Pensé que podría\ndejaros vivir\nconvirtiéndoos en muñecos..."
    },
    {
      "index": 131,
      "english": "If you want to die that badly,\nthen I shall grant your wish!",
      "speaker_id": 3081,
      "line_type": 2,
      "_offset": 23363,
      "_bytes": 60,
      "translation": "¡Si tantas ganas tenéis\nde morir, os concederé\nvuestro deseo!"
    },
    {
      "index": 132,
      "english": "Argh! What are these fellas doin'\nhere?!",
      "speaker_id": 2421,
      "line_type": 2,
      "_offset": 23424,
      "_bytes": 40,
      "translation": "¡Argh! ¡¿Qué hacen estos\ntipos aquí?!"
    },
    {
      "index": 133,
      "english": "We're surrounded...",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 23465,
      "_bytes": 19,
      "translation": "Estamos rodeados..."
    },
    {
      "index": 134,
      "english": "But there's no way we'll lose to\nthem!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 23485,
      "_bytes": 38,
      "translation": "¡No vamos a perder\nante ellos!"
    },
    {
      "index": 135,
      "english": "No way at all!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 23524,
      "_bytes": 14,
      "translation": "¡Ni de broma!"
    },
    {
      "index": 136,
      "english": "Fist of the Tyrant!",
      "speaker_id": 9002,
      "line_type": 2,
      "_offset": 23539,
      "_bytes": 19,
      "translation": "¡Puño Imperial!"
    },
    {
      "index": 137,
      "english": "Ogremon!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 23559,
      "_bytes": 8,
      "translation": "¡Ogremon!"
    },
    {
      "index": 138,
      "english": "Heyo! Looks like we got a whole\ncrowd of enemies here. Want me to\nlend a hand? Heh heh heh.",
      "speaker_id": 4061,
      "line_type": 2,
      "_offset": 23568,
      "_bytes": 91,
      "translation": "¡Eh! Menudo montón de\nenemigos hay aquí. ¿Os\necho una mano? Je je je."
    },
    {
      "index": 139,
      "english": "Tch! Insects...",
      "speaker_id": 3081,
      "line_type": 2,
      "_offset": 23660,
      "_bytes": 15,
      "translation": "¡Tch! Insectos..."
    },
    {
      "index": 140,
      "english": "Thanks for the help, guys!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 23676,
      "_bytes": 26,
      "translation": "¡Gracias por ayudar, chicos!"
    },
    {
      "index": 141,
      "english": "Leave them to us! Go after Piemon!",
      "speaker_id": 4061,
      "line_type": 2,
      "_offset": 23703,
      "_bytes": 34,
      "translation": "¡Dejádnoslos! ¡Id a por Piedmon!"
    },
    {
      "index": 142,
      "english": "Okay! We're counting on you!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 23738,
      "_bytes": 28,
      "translation": "¡Vale! ¡Contamos con vosotros!"
    },
    {
      "index": 143,
      "english": "Get ready, Piemon!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 23767,
      "_bytes": 18,
      "translation": "¡Prepárate, Piedmon!"
    },
    {
      "index": 144,
      "english": "Don't get carried away, my dear\nChosen Children! I'll show you my\ntrue power!",
      "speaker_id": 3081,
      "line_type": 2,
      "_offset": 23786,
      "_bytes": 77,
      "translation": "¡No os paséis, mis queridos\nNiños Elegidos! ¡Os mostraré\nmi verdadero poder!"
    },
    {
      "index": 145,
      "english": "All right, guys, this is the last\nbattle!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 23864,
      "_bytes": 41,
      "translation": "¡Muy bien, chicos, es la\nbatalla final!"
    },
    {
      "index": 146,
      "english": "Heaven's Gate!",
      "speaker_id": 2741,
      "line_type": 2,
      "_offset": 23906,
      "_bytes": 14,
      "translation": "¡Puerta del Cielo!"
    },
    {
      "index": 147,
      "english": "That's...!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 23921,
      "_bytes": 10,
      "translation": "¡Eso es...!"
    },
    {
      "index": 148,
      "english": "I shall bury your evil spirit in\nthe subspace that lies beyond this\ngate.",
      "speaker_id": 2741,
      "line_type": 2,
      "_offset": 23932,
      "_bytes": 73,
      "translation": "Enterraré tu espíritu\nmaligno en el subespacio\nmás allá de esta puerta."
    },
    {
      "index": 149,
      "english": "W-What!?",
      "speaker_id": 3081,
      "line_type": 2,
      "_offset": 24006,
      "_bytes": 8,
      "translation": "¿¡Q-Qué!?"
    },
    {
      "index": 150,
      "english": "Ngaaaaaaaaaah!",
      "speaker_id": 3081,
      "line_type": 2,
      "_offset": 24015,
      "_bytes": 14,
      "translation": "¡Ngaaaaaaaaaah!"
    },
    {
      "index": 151,
      "english": "Let's finish this!",
      "speaker_id": 2151,
      "line_type": 2,
      "_offset": 24030,
      "_bytes": 18,
      "translation": "¡Acabemos con esto!"
    },
    {
      "index": 152,
      "english": "Yeah!",
      "speaker_id": 2251,
      "line_type": 2,
      "_offset": 24049,
      "_bytes": 5,
      "translation": "¡Sí!"
    },
    {
      "index": 153,
      "english": "Gaia Force!",
      "speaker_id": 2151,
      "line_type": 2,
      "_offset": 24055,
      "_bytes": 11,
      "translation": "¡Fuerza Gaia!"
    },
    {
      "index": 154,
      "english": "Garuru Tomahawk!",
      "speaker_id": 2251,
      "line_type": 2,
      "_offset": 24067,
      "_bytes": 16,
      "translation": "¡Hacha Garuru!"
    },
    {
      "index": 155,
      "english": "Gaaaaaaaaah!",
      "speaker_id": 3081,
      "line_type": 2,
      "_offset": 24084,
      "_bytes": 12,
      "translation": "¡Gaaaaaaaaah!"
    },
    {
      "index": 156,
      "english": "...It's over.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 24097,
      "_bytes": 13,
      "translation": "...Se acabó."
    },
    {
      "index": 157,
      "english": "Yeah...",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 24111,
      "_bytes": 7,
      "translation": "Sí..."
    },
    {
      "index": 158,
      "english": "We won!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 24119,
      "_bytes": 7,
      "translation": "¡Ganamos!"
    },
    {
      "index": 159,
      "english": "Now we can go home!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 24127,
      "_bytes": 19,
      "translation": "¡Ya podemos volver a casa!"
    },
    {
      "index": 160,
      "english": "Something's wrong...",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 24147,
      "_bytes": 20,
      "translation": "Algo va mal..."
    },
    {
      "index": 161,
      "english": "Yeah...",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 24168,
      "_bytes": 7,
      "translation": "Sí..."
    },
    {
      "index": 162,
      "english": "The Digimon world hasn't gone back\nto normal...",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 24176,
      "_bytes": 47,
      "translation": "El Digimundo no ha\nvuelto a la normalidad..."
    },
    {
      "index": 163,
      "english": "Huh? There's a message from\nGennai!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 24224,
      "_bytes": 35,
      "translation": "¿Eh? ¡Hay un mensaje de\nGennai!"
    },
    {
      "index": 164,
      "english": "Impossible!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 24260,
      "_bytes": 11,
      "translation": "¡Imposible!"
    },
    {
      "index": 165,
      "english": "What'd he say?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 24272,
      "_bytes": 14,
      "translation": "¿Qué dice?"
    },
    {
      "index": 166,
      "english": "It seems that our true enemy isn't\nthe Dark Masters...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 24287,
      "_bytes": 54,
      "translation": "Nuestro enemigo real no\nson los Amos Oscuros..."
    },
    {
      "index": 167,
      "english": "What?!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 24342,
      "_bytes": 6,
      "translation": "¡¿Qué?!"
    },
    {
      "index": 168,
      "english": "Our true enemy is... an existence\nthat was neglected by this world.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 24349,
      "_bytes": 67,
      "translation": "Nuestro verdadero enemigo\nes una existencia\nolvidada por este mundo."
    },
    {
      "index": 169,
      "english": "The Dark Masters were able to\ngather all the power they did\nbecause of this enemy...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 24417,
      "_bytes": 84,
      "translation": "Los Amos Oscuros\nreunieron todo su poder\ngracias a este enemigo..."
    },
    {
      "index": 170,
      "english": "So then who's this \"true enemy\"?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 24502,
      "_bytes": 32,
      "translation": "¿Y quién es ese \"enemigo real\"?"
    },
    {
      "index": 171,
      "english": "Aaaaaaaaagh!",
      "speaker_id": 9001,
      "line_type": 2,
      "_offset": 24535,
      "_bytes": 12,
      "translation": "¡Aaaaaaaagh!"
    },
    {
      "index": 172,
      "english": "Okay, first things first! Let's go\ninside.",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 24548,
      "_bytes": 42,
      "translation": "¡Vale, lo primero es lo\nprimero! Entremos."
    },
    {
      "index": 173,
      "english": "We have to escape!",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 24591,
      "_bytes": 18,
      "translation": "¡Hay que escapar!"
    },
    {
      "index": 174,
      "english": "Right now, we have to get out of\nhere!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 24610,
      "_bytes": 38,
      "translation": "¡Ahora mismo, hay que\nsalir de aquí!"
    },
    {
      "index": 175,
      "english": "Leave these guys to us! Go after\nPiemon!",
      "speaker_id": 4061,
      "line_type": 2,
      "_offset": 24649,
      "_bytes": 40,
      "translation": "¡Dejádnoslos a nosotros!\n¡Id a por Piedmon!"
    },
    {
      "index": 176,
      "english": "We can't do anything by\nourselves...",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 24690,
      "_bytes": 36,
      "translation": "No podemos hacer nada\nsolos..."
    },
    {
      "index": 177,
      "english": "Get a hold of yourself, Kari.",
      "speaker_id": 4294967295,
      "line_type": 2,
      "_offset": 24727,
      "_bytes": 31,
      "translation": "Contrólate, Kari."
    },
    {
      "index": 178,
      "english": "Don't give up, Kari.",
      "speaker_id": 4294967295,
      "line_type": 2,
      "_offset": 24759,
      "_bytes": 22,
      "translation": "No te rindas, Kari."
    },
    {
      "index": 179,
      "english": "Let's go as far as we can!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 24782,
      "_bytes": 26,
      "translation": "¡Vayamos cuanto podamos!"
    },
    {
      "index": 180,
      "english": "But Tai...",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 24809,
      "_bytes": 13,
      "translation": "Pero Tai..."
    },
    {
      "index": 181,
      "english": "We have to keep going!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 24823,
      "_bytes": 22,
      "translation": "¡Debemos seguir!"
    },
    {
      "index": 182,
      "english": "Tai... Everyone...",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 24846,
      "_bytes": 21,
      "translation": "Tai... Chicos..."
    },
    {
      "index": 183,
      "english": "If we give up, there'll be nobody\nto help Tai and Matt and the\nothers!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 24868,
      "_bytes": 75,
      "translation": "¡Si nos rendimos, nadie\nayudará a Tai, Matt y\nlos demás!"
    },
    {
      "index": 184,
      "english": "T.K...",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 24944,
      "_bytes": 9,
      "translation": "T.K..."
    },
    {
      "index": 185,
      "english": "Don't give up until the very end!\nKeep believing!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 24954,
      "_bytes": 49,
      "translation": "¡No te rindas hasta el\nfinal! ¡Sigue creyendo!"
    },
    {
      "index": 186,
      "english": "You're right... we have to keep\nfighting!",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 25004,
      "_bytes": 41,
      "translation": "¡Tienes razón... hay que\nseguir luchando!"
    }
  ]
}