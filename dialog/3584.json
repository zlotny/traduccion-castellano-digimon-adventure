{
  "file_id": "3584",
  "text_count": 180,
  "dialog": [
    {
      "index": 0,
      "english": "Izzy, stay back! Take care of\nKari!",
      "_offset": 7424,
      "_length": 42,
      "speaker_id": 0,
      "translation": "Izzy, quédate atrás! Cuida\nde Kari!"
    },
    {
      "index": 1,
      "english": "Tai! At this rate, you'll...",
      "_offset": 7467,
      "_length": 31,
      "speaker_id": 0,
      "translation": "Tai! A este paso vas a..."
    },
    {
      "index": 2,
      "english": "You're bein' real stubborn!",
      "_offset": 7499,
      "_length": 27,
      "speaker_id": 0,
      "translation": "Eres un cabezota!"
    },
    {
      "index": 3,
      "english": "Fine! Call me stubborn if you\nlike! Just leave it to me, I'll\nfind a way to manage!",
      "_offset": 7527,
      "_length": 83,
      "speaker_id": 0,
      "translation": "Vale! Llamadme cabezota si\nqueréis! Dejádmelo a mí,\nya me las apañaré!"
    },
    {
      "index": 4,
      "english": "WarGreymon!",
      "_offset": 7617,
      "_length": 11,
      "speaker_id": 0,
      "translation": "WarGreymon!"
    },
    {
      "index": 5,
      "english": "War...Greymon...",
      "_offset": 7629,
      "_length": 16,
      "speaker_id": 0,
      "translation": "War...Greymon..."
    },
    {
      "index": 6,
      "english": "Tai!",
      "_offset": 7646,
      "_length": 7,
      "speaker_id": 0,
      "translation": "Tai!"
    },
    {
      "index": 7,
      "english": "So. Who's next?",
      "_offset": 7654,
      "_length": 15,
      "speaker_id": 0,
      "translation": "Quién sigue?"
    },
    {
      "index": 8,
      "english": "Tai!",
      "_offset": 7670,
      "_length": 7,
      "speaker_id": 0,
      "translation": "Tai!"
    },
    {
      "index": 9,
      "english": "Ugh... Matt...",
      "_offset": 7678,
      "_length": 16,
      "speaker_id": 0,
      "translation": "Argh... Matt..."
    },
    {
      "index": 10,
      "english": "Tai!",
      "_offset": 7695,
      "_length": 7,
      "speaker_id": 0,
      "translation": "Tai!"
    },
    {
      "index": 11,
      "english": "Tai!",
      "_offset": 7703,
      "_length": 7,
      "speaker_id": 0,
      "translation": "Tai!"
    },
    {
      "index": 12,
      "english": "Tai, are you okay?",
      "_offset": 7711,
      "_length": 21,
      "speaker_id": 0,
      "translation": "Tai, estás bien?"
    },
    {
      "index": 13,
      "english": "Joe... Mimi...",
      "_offset": 7733,
      "_length": 14,
      "speaker_id": 0,
      "translation": "Joe... Mimi..."
    },
    {
      "index": 14,
      "english": "Ogremon and the others are here\ntoo!",
      "_offset": 7748,
      "_length": 36,
      "speaker_id": 0,
      "translation": "Ogremon y otros\ntambién están aquí!"
    },
    {
      "index": 15,
      "english": "I see... we've got a lot of\nfriends on our side...",
      "_offset": 7785,
      "_length": 50,
      "speaker_id": 0,
      "translation": "Ya veo... tenemos muchos\namigos de nuestro lado..."
    },
    {
      "index": 16,
      "english": "My, someone's late. But it doesn't \nmatter whether you're early or \nlate. The result will be the same.",
      "_offset": 7836,
      "_length": 102,
      "speaker_id": 0,
      "translation": "Vaya, llegas tarde. Pero da\nigual que sea pronto o tarde,\nel resultado será el mismo."
    },
    {
      "index": 17,
      "english": "You're finally here... I've been\nwaiting for you all this time, you\nknow.",
      "_offset": 7939,
      "_length": 73,
      "speaker_id": 0,
      "translation": "Por fin llegas... Llevo\nesperándote todo este\ntiempo, sabes?"
    },
    {
      "index": 18,
      "english": "Tai...",
      "_offset": 8013,
      "_length": 9,
      "speaker_id": 0,
      "translation": "Tai..."
    },
    {
      "index": 19,
      "english": "I believed you'd come... no, I\nknew you'd come...",
      "_offset": 8023,
      "_length": 49,
      "speaker_id": 0,
      "translation": "Creía que vendrías... no,\nsabía que vendrías..."
    },
    {
      "index": 20,
      "english": "...Thank you. Thank you for\nbelieving in me. But I'm sorry,\nI'm late...",
      "_offset": 8073,
      "_length": 71,
      "speaker_id": 0,
      "translation": "...Gracias. Gracias por\ncreer en mí. Pero lo\nsiento, llego tarde..."
    },
    {
      "index": 21,
      "english": "Tai... you're my true friend!",
      "_offset": 8145,
      "_length": 32,
      "speaker_id": 0,
      "translation": "Tai... eres mi verdadero\namigo!"
    },
    {
      "index": 22,
      "english": "And I won't throw your friendship\naway!",
      "_offset": 8178,
      "_length": 39,
      "speaker_id": 0,
      "translation": "Y no tiraré tu amistad\npor la borda!"
    },
    {
      "index": 23,
      "english": "Huh? That's...",
      "_offset": 8218,
      "_length": 14,
      "speaker_id": 0,
      "translation": "Eh? Eso es..."
    },
    {
      "index": 24,
      "english": "What?!",
      "_offset": 8233,
      "_length": 6,
      "speaker_id": 0,
      "translation": "Qué?!"
    },
    {
      "index": 25,
      "english": "Matt's Crest of Friendship is\nbringing WarGreymon back to life!",
      "_offset": 8240,
      "_length": 65,
      "speaker_id": 0,
      "translation": "El Emblema de la Amistad\nde Matt le devuelve la\nvida a WarGreymon!"
    },
    {
      "index": 26,
      "english": "Thanks! Now I can fight again!",
      "_offset": 8306,
      "_length": 30,
      "speaker_id": 0,
      "translation": "Gracias! Puedo luchar\nde nuevo!"
    },
    {
      "index": 27,
      "english": "Hmph! I wanted to defeat you, one\nby one...",
      "_offset": 8337,
      "_length": 43,
      "speaker_id": 0,
      "translation": "Hmph! Quería derrotaros\nde uno en uno..."
    },
    {
      "index": 28,
      "english": "But you're free to die in whatever\nway you please. After all, the end\nresult will be the same.",
      "_offset": 8381,
      "_length": 94,
      "speaker_id": 0,
      "translation": "Pero sois libres de morir\ncomo queráis. Al fin y al\ncabo, el resultado será igual."
    },
    {
      "index": 29,
      "english": "And if you want to suffer that\nbadly, I won't stop you.",
      "_offset": 8476,
      "_length": 55,
      "speaker_id": 0,
      "translation": "Y si tantas ganas tenéis\nde sufrir, no os lo\nimpediré."
    },
    {
      "index": 30,
      "english": "Oh, shut your mouth!",
      "_offset": 8532,
      "_length": 20,
      "speaker_id": 0,
      "translation": "Cállate de una vez!"
    },
    {
      "index": 31,
      "english": "Guys, let's take him out together!",
      "_offset": 8553,
      "_length": 34,
      "speaker_id": 0,
      "translation": "Chicos, acabemos con él\njuntos!"
    },
    {
      "index": 32,
      "english": "Yeah!",
      "_offset": 8588,
      "_length": 5,
      "speaker_id": 0,
      "translation": "Sí!"
    },
    {
      "index": 33,
      "english": "Hahaha...",
      "_offset": 8594,
      "_length": 9,
      "speaker_id": 0,
      "translation": "Jajaja..."
    },
    {
      "index": 34,
      "english": "All right, let's go!",
      "_offset": 8604,
      "_length": 20,
      "speaker_id": 255,
      "translation": "Muy bien, vamos!"
    },
    {
      "index": 35,
      "english": "Wait!",
      "_offset": 8625,
      "_length": 5,
      "speaker_id": 255,
      "translation": "Alto!"
    },
    {
      "index": 36,
      "english": "Tai!",
      "_offset": 8631,
      "_length": 7,
      "speaker_id": 255,
      "translation": "Tai!"
    },
    {
      "index": 37,
      "english": "What's going on?",
      "_offset": 8639,
      "_length": 16,
      "speaker_id": 255,
      "translation": "Qué pasa?"
    },
    {
      "index": 38,
      "english": "He's taken Tai and Matt\nsomewhere!",
      "_offset": 8656,
      "_length": 39,
      "speaker_id": 255,
      "translation": "Se llevó a Tai y a Matt\na algún sitio!"
    },
    {
      "index": 39,
      "english": "He's taken Tai and Matt\nsomewhere!",
      "_offset": 8696,
      "_length": 39,
      "speaker_id": 255,
      "translation": "Se llevó a Tai y a Matt\na algún sitio!"
    },
    {
      "index": 40,
      "english": "Look, they're right here!",
      "_offset": 8736,
      "_length": 25,
      "speaker_id": 255,
      "translation": "Mirad, están aquí mismo!"
    },
    {
      "index": 41,
      "english": "He... he turned them into dolls...",
      "_offset": 8762,
      "_length": 34,
      "speaker_id": 255,
      "translation": "Los... los convirtió en\nmuñecos..."
    },
    {
      "index": 42,
      "english": "That's right. They've become my\nprizes for my personal collection.",
      "_offset": 8797,
      "_length": 66,
      "speaker_id": 255,
      "translation": "Así es. Se han convertido\nen trofeos para mi\ncolección personal."
    },
    {
      "index": 43,
      "english": "Hahaha! I wonder who's next...?",
      "_offset": 8864,
      "_length": 31,
      "speaker_id": 255,
      "translation": "Jajaja! Quién sigue...?"
    },
    {
      "index": 44,
      "english": "Run! Get to that cave!",
      "_offset": 8896,
      "_length": 22,
      "speaker_id": 255,
      "translation": "Corred! A la cueva!"
    },
    {
      "index": 45,
      "english": "Andromon!",
      "_offset": 8919,
      "_length": 9,
      "speaker_id": 255,
      "translation": "Andromon!"
    },
    {
      "index": 46,
      "english": "I'll take care of him!",
      "_offset": 8929,
      "_length": 22,
      "speaker_id": 255,
      "translation": "Yo me encargo de él!"
    },
    {
      "index": 47,
      "english": "But...",
      "_offset": 8952,
      "_length": 6,
      "speaker_id": 255,
      "translation": "Pero.."
    },
    {
      "index": 48,
      "english": "Come on, Sora! We can't let his\nefforts be in vain!",
      "_offset": 8959,
      "_length": 51,
      "speaker_id": 255,
      "translation": "Vamos, Sora! No dejemos\nque su esfuerzo sea en\nvano!"
    },
    {
      "index": 49,
      "english": "Hurry!",
      "_offset": 9011,
      "_length": 6,
      "speaker_id": 255,
      "translation": "Vamos!"
    },
    {
      "index": 50,
      "english": "But what about Tai and Matt?",
      "_offset": 9018,
      "_length": 33,
      "speaker_id": 255,
      "translation": "Y qué hay de Tai y Matt?"
    },
    {
      "index": 51,
      "english": "I'm sure there's a way to save\nthem. We'll figure it out while we\nescape!",
      "_offset": 9052,
      "_length": 73,
      "speaker_id": 255,
      "translation": "Seguro que hay forma de\nsalvarlos. Lo pensaremos\nmientras escapamos!"
    },
    {
      "index": 52,
      "english": "Now Andromon is a doll, too. Who's\nnext?",
      "_offset": 9126,
      "_length": 40,
      "speaker_id": 255,
      "translation": "Andromon ya es un\nmuñeco. Quién sigue?"
    },
    {
      "index": 53,
      "english": "Not Andromon, too!",
      "_offset": 9167,
      "_length": 18,
      "speaker_id": 255,
      "translation": "Andromon no!"
    },
    {
      "index": 54,
      "english": "Go, Sora!",
      "_offset": 9186,
      "_length": 9,
      "speaker_id": 255,
      "translation": "Ve, Sora!"
    },
    {
      "index": 55,
      "english": "We'll figure something out!",
      "_offset": 9196,
      "_length": 27,
      "speaker_id": 255,
      "translation": "Ya se nos ocurrirá algo!"
    },
    {
      "index": 56,
      "english": "Joe! Izzy!",
      "_offset": 9224,
      "_length": 15,
      "speaker_id": 255,
      "translation": "Joe! Izzy!"
    },
    {
      "index": 57,
      "english": "Gyaaaaaah!",
      "_offset": 9240,
      "_length": 10,
      "speaker_id": 255,
      "translation": "Gyaaaaaah!"
    },
    {
      "index": 58,
      "english": "Aaaaaaaaaah!",
      "_offset": 9251,
      "_length": 12,
      "speaker_id": 255,
      "translation": "Aaaaaaaaah!"
    },
    {
      "index": 59,
      "english": "What'dya do to Izzy?!",
      "_offset": 9264,
      "_length": 26,
      "speaker_id": 255,
      "translation": "Qué le hiciste a Izzy?!"
    },
    {
      "index": 60,
      "english": "I'll get you back for what you did\nto Joe!",
      "_offset": 9291,
      "_length": 42,
      "speaker_id": 255,
      "translation": "Me las pagarás por lo\nque le hiciste a Joe!"
    },
    {
      "index": 61,
      "english": "Kari! T.K! Run!",
      "_offset": 9334,
      "_length": 20,
      "speaker_id": 255,
      "translation": "Kari! T.K! Corred!"
    },
    {
      "index": 62,
      "english": "Oh, it's pointless to run. I've\ngot you. You cannot escape...",
      "_offset": 9355,
      "_length": 61,
      "speaker_id": 255,
      "translation": "Es inútil correr. Os\ntengo. No podéis escapar..."
    },
    {
      "index": 63,
      "english": "Izzy... Mimi...",
      "_offset": 9417,
      "_length": 20,
      "speaker_id": 255,
      "translation": "Izzy... Mimi..."
    },
    {
      "index": 64,
      "english": "Is Joe gonna be okay...?",
      "_offset": 9438,
      "_length": 24,
      "speaker_id": 255,
      "translation": "Joe estará bien...?"
    },
    {
      "index": 65,
      "english": "I'll save the others! Just get out\nof here!",
      "_offset": 9463,
      "_length": 43,
      "speaker_id": 255,
      "translation": "Yo salvaré a los demás!\nSalid de aquí!"
    },
    {
      "index": 66,
      "english": "It's over...",
      "_offset": 9507,
      "_length": 12,
      "speaker_id": 255,
      "translation": "Se acabó..."
    },
    {
      "index": 67,
      "english": "No, it's not!",
      "_offset": 9520,
      "_length": 13,
      "speaker_id": 255,
      "translation": "No, no acabó!"
    },
    {
      "index": 68,
      "english": "Perhaps it is.",
      "_offset": 9534,
      "_length": 14,
      "speaker_id": 255,
      "translation": "Quizás sí."
    },
    {
      "index": 69,
      "english": "Sora...!",
      "_offset": 9549,
      "_length": 8,
      "speaker_id": 255,
      "translation": "Sora...!"
    },
    {
      "index": 70,
      "english": "Sora!",
      "_offset": 9558,
      "_length": 5,
      "speaker_id": 255,
      "translation": "Sora!"
    },
    {
      "index": 71,
      "english": "See, look!",
      "_offset": 9564,
      "_length": 10,
      "speaker_id": 255,
      "translation": "Mirad!"
    },
    {
      "index": 72,
      "english": "See, look!",
      "_offset": 9575,
      "_length": 10,
      "speaker_id": 255,
      "translation": "Mirad!"
    },
    {
      "index": 73,
      "english": "T.K...",
      "_offset": 9586,
      "_length": 9,
      "speaker_id": 255,
      "translation": "T.K..."
    },
    {
      "index": 74,
      "english": "What...?",
      "_offset": 9596,
      "_length": 8,
      "speaker_id": 255,
      "translation": "Qué...?"
    },
    {
      "index": 75,
      "english": "Take Kari with you and run.",
      "_offset": 9605,
      "_length": 29,
      "speaker_id": 255,
      "translation": "Llévate a Kari y corre."
    },
    {
      "index": 76,
      "english": "What?! But what about you?",
      "_offset": 9635,
      "_length": 26,
      "speaker_id": 255,
      "translation": "Qué?! Y tú qué?"
    },
    {
      "index": 77,
      "english": "Forget about me. Got it?",
      "_offset": 9662,
      "_length": 24,
      "speaker_id": 255,
      "translation": "Olvídate de mí. Vale?"
    },
    {
      "index": 78,
      "english": "O-Okay.",
      "_offset": 9687,
      "_length": 7,
      "speaker_id": 255,
      "translation": "V-Vale."
    },
    {
      "index": 79,
      "english": "No matter what happens, you need\nto get away.",
      "_offset": 9695,
      "_length": 45,
      "speaker_id": 0,
      "translation": "Pase lo que pase, tienes\nque escapar."
    },
    {
      "index": 80,
      "english": "Okay. I'll protect Kari, no\nmatter what!",
      "_offset": 9741,
      "_length": 42,
      "speaker_id": 255,
      "translation": "Vale. Protegeré a Kari,\npase lo que pase!"
    },
    {
      "index": 81,
      "english": "Good. Now hurry up and get out of\nhere!",
      "_offset": 9784,
      "_length": 39,
      "speaker_id": 255,
      "translation": "Bien. Ahora daos prisa\ny salid de aquí!"
    },
    {
      "index": 82,
      "english": "N-No way...",
      "_offset": 9824,
      "_length": 11,
      "speaker_id": 255,
      "translation": "Qué va..."
    },
    {
      "index": 83,
      "english": "It's a dead end...",
      "_offset": 9836,
      "_length": 18,
      "speaker_id": 255,
      "translation": "Sin salida..."
    },
    {
      "index": 84,
      "english": "What?!",
      "_offset": 9855,
      "_length": 6,
      "speaker_id": 255,
      "translation": "Qué?!"
    },
    {
      "index": 85,
      "english": "Leave him to me!",
      "_offset": 9862,
      "_length": 16,
      "speaker_id": 255,
      "translation": "Déjamelo a mí!"
    },
    {
      "index": 86,
      "english": "Aaaaaaaargh!",
      "_offset": 9879,
      "_length": 12,
      "speaker_id": 255,
      "translation": "Aaaaaaaargh!"
    },
    {
      "index": 87,
      "english": "Angemon!",
      "_offset": 9892,
      "_length": 8,
      "speaker_id": 255,
      "translation": "Angemon!"
    },
    {
      "index": 88,
      "english": "T.K...",
      "_offset": 9901,
      "_length": 9,
      "speaker_id": 255,
      "translation": "T.K..."
    },
    {
      "index": 89,
      "english": "(This is bad. I have to pull\nmyself together, or Kari will\nget scared, too.)",
      "_offset": 9911,
      "_length": 78,
      "speaker_id": 255,
      "translation": "(Esto es malo. Tengo que\nserenarme, o Kari\ntambién se asustará.)"
    },
    {
      "index": 90,
      "english": "Don't worry, Angemon can handle\nit.",
      "_offset": 9990,
      "_length": 35,
      "speaker_id": 255,
      "translation": "Tranquila, Angemon\npuede con esto."
    },
    {
      "index": 91,
      "english": "There's nowhere left for you to\nrun! Hahaha...",
      "_offset": 10026,
      "_length": 46,
      "speaker_id": 255,
      "translation": "Ya no tenéis dónde huir!\nJajaja..."
    },
    {
      "index": 92,
      "english": "(This is it. This is the end...)",
      "_offset": 10073,
      "_length": 32,
      "speaker_id": 255,
      "translation": "(Esto es todo, es el\nfinal...)"
    },
    {
      "index": 93,
      "english": "Matt...",
      "_offset": 10106,
      "_length": 9,
      "speaker_id": 255,
      "translation": "Matt..."
    },
    {
      "index": 94,
      "english": "T.K, don't give up!",
      "_offset": 10116,
      "_length": 22,
      "speaker_id": 255,
      "translation": "T.K, no te rindas!"
    },
    {
      "index": 95,
      "english": "Big brother...",
      "_offset": 10139,
      "_length": 14,
      "speaker_id": 255,
      "translation": "Hermano..."
    },
    {
      "index": 96,
      "english": "You're my brother! You can't give\nup, no matter what!",
      "_offset": 10154,
      "_length": 53,
      "speaker_id": 255,
      "translation": "Eres mi hermano! No\npuedes rendirte, pase\nlo que pase!"
    },
    {
      "index": 97,
      "english": "You have to be strong, until it's\nall over!",
      "_offset": 10208,
      "_length": 43,
      "speaker_id": 255,
      "translation": "Tienes que ser fuerte,\nhasta que todo acabe!"
    },
    {
      "index": 98,
      "english": "I won't give up. I won't give up\nuntil the end!",
      "_offset": 10252,
      "_length": 47,
      "speaker_id": 255,
      "translation": "No me rendiré. No me\nrendiré hasta el final!"
    },
    {
      "index": 99,
      "english": "If I die here, this world and our\nworld will be destroyed...",
      "_offset": 10300,
      "_length": 60,
      "speaker_id": 255,
      "translation": "Si muero aquí, este\nmundo y el nuestro\nserán destruidos..."
    },
    {
      "index": 100,
      "english": "So I won't give up!\nAngemoooooooon!",
      "_offset": 10361,
      "_length": 35,
      "speaker_id": 255,
      "translation": "Así que no me rindo!\nAngemoooooooon!"
    },
    {
      "index": 101,
      "english": "T.K...",
      "_offset": 10397,
      "_length": 9,
      "speaker_id": 255,
      "translation": "T.K..."
    },
    {
      "index": 102,
      "english": "Angemon... super-evolved...",
      "_offset": 10407,
