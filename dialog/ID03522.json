{
  "file_id": "ID03522",
  "text_count": 193,
  "dialog": [
    {
      "index": 0,
      "english": "��������I'm so tired. If I walk any more,\nmy legs will get thick.",
      "_offset": 2859,
      "_length": 65,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 1,
      "english": "Mimi! This is why you should have\nroots for legs!",
      "_offset": 2925,
      "_length": 49,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 2,
      "english": "I don't want roots...",
      "_offset": 2975,
      "_length": 21,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 3,
      "english": "Looks like it's getting dark.",
      "_offset": 2997,
      "_length": 29,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 4,
      "english": "What should we do? It'll be\ndangerous if we keep going after\ndark.",
      "_offset": 3027,
      "_length": 66,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 5,
      "english": "I smell...I smell it! Fresh water!\nThere's a lake around here!",
      "_offset": 3094,
      "_length": 62,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 6,
      "english": "We're all tired and hungry...",
      "_offset": 3157,
      "_length": 29,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 7,
      "english": "Should we make camp at the lake\nfor the night?",
      "_offset": 3187,
      "_length": 46,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 8,
      "english": "Whoa! It's a big lake!",
      "_offset": 3234,
      "_length": 22,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 9,
      "english": "It's the perfect place to camp!",
      "_offset": 3257,
      "_length": 31,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 10,
      "english": "Hey, if we camp out here, does\nthat mean we'll have to sleep\noutdoors?",
      "_offset": 3289,
      "_length": 70,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 11,
      "english": "Yeah, looks like it.",
      "_offset": 3360,
      "_length": 20,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 12,
      "english": "No way...",
      "_offset": 3381,
      "_length": 9,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 13,
      "english": "Hey! There's a trolley over there!",
      "_offset": 3391,
      "_length": 34,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 14,
      "english": "T-there is!",
      "_offset": 3426,
      "_length": 11,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 15,
      "english": "Why would there be a trolley car\nin a place like this?",
      "_offset": 3438,
      "_length": 54,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 16,
      "english": "Huh? The lights went on!",
      "_offset": 3493,
      "_length": 24,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 17,
      "english": "Someone must be in this car! There\nare people besides us here!",
      "_offset": 3518,
      "_length": 62,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 18,
      "english": "Let's check it out!",
      "_offset": 3581,
      "_length": 19,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 19,
      "english": "There's no one here.",
      "_offset": 3601,
      "_length": 20,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 20,
      "english": "Seems like it.",
      "_offset": 3622,
      "_length": 14,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 21,
      "english": "And after all those phones...\nWhat's going on?",
      "_offset": 3637,
      "_length": 46,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 22,
      "english": "We should sleep here. Let's figure\nthis out tomorrow.",
      "_offset": 3684,
      "_length": 53,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 23,
      "english": "Taichi! We still don't have enough\nfood!",
      "_offset": 3738,
      "_length": 40,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 24,
      "english": "Yeah... Let's search a bit more!",
      "_offset": 3779,
      "_length": 32,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 25,
      "english": "We gathered a lot!",
      "_offset": 3812,
      "_length": 18,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 26,
      "english": "We all worked together and got all\nthis food!",
      "_offset": 3831,
      "_length": 45,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 27,
      "english": "I'm really, really hungry.",
      "_offset": 3877,
      "_length": 26,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 28,
      "english": "All right! Time to head back for\ndinner!",
      "_offset": 3904,
      "_length": 40,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 29,
      "english": "Palmon says she can tell the\ndifference between edible and\npoisonous mushrooms!",
      "_offset": 3945,
      "_length": 79,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 30,
      "english": "Yep!",
      "_offset": 4025,
      "_length": 4,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 31,
      "english": "Digimon really are amazing!",
      "_offset": 4030,
      "_length": 27,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 32,
      "english": "Can you teach me how?",
      "_offset": 4058,
      "_length": 21,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 33,
      "english": "It's not just any Digimon who can\ndo this, it's Palmon!",
      "_offset": 4080,
      "_length": 55,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 34,
      "english": "Oh, sorry.",
      "_offset": 4136,
      "_length": 10,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 35,
      "english": "Of course! It'll be fun!",
      "_offset": 4147,
      "_length": 24,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 36,
      "english": "Let's go mushroom hunting!",
      "_offset": 4172,
      "_length": 26,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 37,
      "english": "Gabumon, do you have any special\ntalents, too?",
      "_offset": 4199,
      "_length": 46,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 38,
      "english": "I'll bet he doesn't.",
      "_offset": 4246,
      "_length": 20,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 39,
      "english": "Hmmmmm.",
      "_offset": 4267,
      "_length": 7,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 40,
      "english": "What's wrong? Does your stomach\nhurt?",
      "_offset": 4275,
      "_length": 37,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 41,
      "english": "No! I'm trying to stargaze to find\nour location, but I can't find the\nNorth Star.",
      "_offset": 4313,
      "_length": 81,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 42,
      "english": "I can't see the Southern Cross\neither. Weird.",
      "_offset": 4395,
      "_length": 45,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 43,
      "english": "So we're not in the Northern or\nSouthern Hemisphere. Hmm.",
      "_offset": 4441,
      "_length": 57,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 44,
      "english": "Try not to think about it too\nmuch.",
      "_offset": 4499,
      "_length": 35,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 45,
      "english": "You seem to know a lot about\ncooking fish, Yamato.",
      "_offset": 4535,
      "_length": 50,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 46,
      "english": "Did you learn how at home?",
      "_offset": 4586,
      "_length": 26,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 47,
      "english": "Ah, well...",
      "_offset": 4613,
      "_length": 11,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 48,
      "english": "I cook in place of my mom.",
      "_offset": 4625,
      "_length": 26,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 49,
      "english": "Is that so...",
      "_offset": 4657,
      "_length": 13,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 50,
      "english": "I wonder if I should try cooking,\ntoo.",
      "_offset": 4671,
      "_length": 38,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 51,
      "english": "Was it hard, fishing with Takeru?",
      "_offset": 4710,
      "_length": 33,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 52,
      "english": "Not at all! He's very skillful! It\nwas enjoyable for me as well.",
      "_offset": 4744,
      "_length": 64,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 53,
      "english": "Invite me next time.",
      "_offset": 4809,
      "_length": 20,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 54,
      "english": "He wasn't too much trouble?",
      "_offset": 4830,
      "_length": 27,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 55,
      "english": "All right, next time the three of\nus will go fishing together!",
      "_offset": 4858,
      "_length": 62,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 56,
      "english": "I never thought of him as being a\nburden to me...",
      "_offset": 4921,
      "_length": 49,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 57,
      "english": "There seem to be normal fish here\nand not just Digimon.",
      "_offset": 4971,
      "_length": 55,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 58,
      "english": "Catching fish was fun, but I don't\nlike fish bones.",
      "_offset": 5027,
      "_length": 51,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 59,
      "english": "I would've taken them out if you'd\nasked.",
      "_offset": 5079,
      "_length": 41,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 60,
      "english": "But Taichi said it's tastier if\nyou eat the head whole.",
      "_offset": 5121,
      "_length": 55,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 61,
      "english": "Is it really?",
      "_offset": 5177,
      "_length": 13,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 62,
      "english": "Looks like we're safe for tonight,\nbut... What'll we do tomorrow?",
      "_offset": 5191,
      "_length": 65,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 63,
      "english": "We should rest for now and think\nabout it tomorrow.",
      "_offset": 5257,
      "_length": 51,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 64,
      "english": "I'm tired, too.",
      "_offset": 5309,
      "_length": 15,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 65,
      "english": "*yawn*",
      "_offset": 5325,
      "_length": 6,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 66,
      "english": "Are you tired, Patamon?",
      "_offset": 5332,
      "_length": 23,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 67,
      "english": "Yeah.",
      "_offset": 5356,
      "_length": 5,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 68,
      "english": "*yawn* I'm full. I should sleep\nsoon.",
      "_offset": 5362,
      "_length": 37,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 69,
      "english": "Should we keep watch in shifts?",
      "_offset": 5400,
      "_length": 31,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 70,
      "english": "Okay. Let's pick an order.",
      "_offset": 5432,
      "_length": 26,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 71,
      "english": "I don't think the girls should\nhave to do it. Or Takeru.",
      "_offset": 5459,
      "_length": 56,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 72,
      "english": "I'll be fine!",
      "_offset": 5516,
      "_length": 13,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 73,
      "english": "Don't worry about it. Get some\nrest.",
      "_offset": 5530,
      "_length": 36,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 74,
      "english": "Hey, Gabumon. Let me use your pelt\nas a blanket!",
      "_offset": 5567,
      "_length": 48,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 75,
      "english": "I've always wondered what's under\nyour fur, Gabumon!",
      "_offset": 5622,
      "_length": 52,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 76,
      "english": "A-a-about that...",
      "_offset": 5675,
      "_length": 17,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 77,
      "english": "Stop it! Can't you see he doesn't\nlike it?",
      "_offset": 5693,
      "_length": 42,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 78,
      "english": "It was just a joke, don't get mad!",
      "_offset": 5736,
      "_length": 34,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 79,
      "english": "S-stop it! Both of you!",
      "_offset": 5771,
      "_length": 23,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 80,
      "english": "So, who'll take the first shift on\nguard duty?",
      "_offset": 5795,
      "_length": 46,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 81,
      "english": "I'll go first.",
      "_offset": 5842,
      "_length": 14,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 82,
      "english": "I'll go next.",
      "_offset": 5857,
      "_length": 13,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 83,
      "english": "Yamato...",
      "_offset": 5879,
      "_length": 9,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 84,
      "english": "Yamato's harmonica has such a nice\ntone.",
      "_offset": 5889,
      "_length": 40,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 85,
      "english": "(Why did I have to get so angry\nover such a little thing?)",
      "_offset": 5930,
      "_length": 58,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 86,
      "english": "(I should go check on Taichi...)",
      "_offset": 5989,
      "_length": 32,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 87,
      "english": "Apologize to Taichi",
      "_offset": 6022,
      "_length": 19,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 88,
      "english": "Don't apologize to Taichi",
      "_offset": 6042,
      "_length": 25,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 89,
      "english": "I couldn't sleep. Sorry about\nearlier.",
      "_offset": 6068,
      "_length": 38,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 90,
      "english": "It was my fault too. I keep\ngetting irritated over stupid\nthings.",
      "_offset": 6107,
      "_length": 65,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 91,
      "english": "I know the feeling. When we can't\nhold ourselves together, we just\nend up fighting.",
      "_offset": 6173,
      "_length": 83,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 92,
      "english": "I just came here to make sure that\nyou're not falling asleep.",
      "_offset": 6257,
      "_length": 61,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 93,
      "english": "Right. I'm awake and watching,\ndon't worry.",
      "_offset": 6319,
      "_length": 43,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 94,
      "english": "By the way, I've been wondering.\nWhat's your relationship to\nTakeru?",
      "_offset": 6367,
      "_length": 68,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 95,
      "english": "We're brothers. We've been living\nseparately ever since our parents\ndivorced.",
      "_offset": 6436,
      "_length": 77,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 96,
      "english": "I live with our father, and Takeru\nlives with our mother.",
      "_offset": 6517,
      "_length": 57,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 97,
      "english": "So that's why you have different\nsurnames.",
      "_offset": 6575,
      "_length": 42,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 98,
      "english": "Yeah.",
      "_offset": 6618,
      "_length": 5,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 99,
      "english": "I've been waiting to use the\nbathroom... I wonder where Yamato\nwent.",
      "_offset": 6624,
      "_length": 68,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 100,
      "english": "Hm? What's this?",
      "_offset": 6693,
      "_length": 16,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 101,
      "english": "An earthquake?",
      "_offset": 6710,
      "_length": 14,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 102,
      "english": "Look over there, it's a monster!",
      "_offset": 6725,
      "_length": 32,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 103,
      "english": "What is that thing?!",
      "_offset": 6758,
      "_length": 20,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 104,
      "english": "That's Seadramon!",
      "_offset": 6779,
      "_length": 17,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 105,
      "english": "Takeru!",
      "_offset": 6797,
      "_length": 7,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 106,
      "english": "Uwaaah!",
      "_offset": 6805,
      "_length": 7,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 107,
      "english": "Uwaaaaah!",
      "_offset": 6813,
      "_length": 9,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 108,
      "english": "Yamato! Gabumon, do something to\nhelp my brother!",
      "_offset": 6823,
      "_length": 49,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 109,
      "english": "B-but I can't. I'm not strong\nenough.",
      "_offset": 6873,
      "_length": 37,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 110,
      "english": "This way! Come get me!",
      "_offset": 6911,
      "_length": 22,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 111,
      "english": "Y-Yamato! I can't do it. I'm too\nscared...",
      "_offset": 6934,
      "_length": 42,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 112,
      "english": "Gabumon...",
      "_offset": 6977,
      "_length": 10,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 113,
      "english": "I'm scared, but!",
      "_offset": 6988,
      "_length": 16,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 114,
      "english": "If I don't do something, I won't\nbe able to listen to the gentle\ntone of Yamato's harmonica again.",
      "_offset": 7005,
      "_length": 98,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 115,
      "english": "Garurumon? Gabumon evolved!",
      "_offset": 7104,
      "_length": 27,
