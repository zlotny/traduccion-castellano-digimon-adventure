      "index": 81,
      "english": "Okay!",
      "_offset": 4270,
      "_length": 5,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 82,
      "english": "That's great, Takeru!",
      "_offset": 4276,
      "_length": 21,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 83,
      "english": "Hey, Chosen Children!",
      "_offset": 4298,
      "_length": 21,
      "speaker_id": 0,
      "translation": ""
    },
