      "_length": 18,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 26,
      "english": "Wah?!",
      "_offset": 2892,
      "_length": 5,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 27,
      "english": "Aaaaah! Chosen Children!",
