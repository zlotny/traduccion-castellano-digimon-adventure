      "_length": 24,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 28,
      "english": "Did you come here to look for the\neighth Chosen Child?!",
      "_offset": 2923,
      "_length": 55,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 29,
      "english": "Yeah, but hanging out in Shibuya\nwound up being a lot more fun.",
      "_offset": 2979,
      "_length": 63,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 30,
      "english": "Hanging out in Shibuya wound up\nbeing a lot more fun?",
      "_offset": 3043,
      "_length": 53,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 31,
      "english": "We've totally become Shibuya-type\nDigimon!",
      "_offset": 3097,
      "_length": 42,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 32,
      "english": "Shibuya-type Digimon?",
      "_offset": 3140,
      "_length": 21,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 33,
      "english": "What kind of little scheme are you\ntwo coming up with?",
      "_offset": 3162,
      "_length": 54,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 34,
      "english": "Nothing at all!",
      "_offset": 3217,
      "_length": 15,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 35,
      "english": "Nothing at all!",
      "_offset": 3233,
      "_length": 15,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 36,
      "english": "Aaaaah, they...!",
      "_offset": 3249,
      "_length": 16,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 37,
      "english": "Let's follow them!",
      "_offset": 3266,
      "_length": 18,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 38,
      "english": "Ten minutes later...",
