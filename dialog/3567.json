  "dialog": [
    {
      "index": 0,
      "english": "��������30 minutes ago...",
      "_offset": 2058,
      "_length": 25,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 1,
      "english": "Stupid Patamon!",
      "_offset": 2084,
      "_length": 15,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 2,
      "english": "Do whatever you want, Takeru! I\ndon't care!",
      "_offset": 2100,
      "_length": 43,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 3,
      "english": "Right now...",
      "_offset": 2144,
      "_length": 12,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 4,
      "english": "I wonder where Patamon went...",
      "_offset": 2157,
      "_length": 30,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 5,
      "english": "He flew away after you told him\noff.",
      "_offset": 2188,
      "_length": 36,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 6,
      "english": "I *had* to say something! It's his\nown fault for asking me all those\npersonal questions...",
      "_offset": 2225,
      "_length": 90,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 7,
      "english": "Stuff like \"Was it hard to have to\nlive separately from your brother\nand dad?\"",
      "_offset": 2316,
      "_length": 78,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 8,
      "english": "I understand, but I still think\nyou were too harsh.",
      "_offset": 2395,
      "_length": 51,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 9,
      "english": "I was just being honest...",
      "_offset": 2447,
      "_length": 26,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 10,
      "english": "C'mon, let's go make up with\nPatamon.",
      "_offset": 2474,
      "_length": 37,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 11,
      "english": "Okay...",
      "_offset": 2512,
      "_length": 7,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 12,
      "english": "I think he's that way! Let's go\nlook!",
      "_offset": 2520,
      "_length": 37,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 13,
      "english": "Where did Patamon go?",
      "_offset": 2558,
      "_length": 21,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 14,
      "english": "Takeru...",
      "_offset": 2580,
      "_length": 9,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 15,
      "english": "Cheer up, Takeru.",
      "_offset": 2590,
      "_length": 17,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 16,
      "english": "Hey, missy!",
      "_offset": 2608,
      "_length": 11,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 17,
      "english": "What time is it?",
      "_offset": 2620,
      "_length": 16,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 18,
      "english": "Tch! What's wrong, are you scared\nof our faces?",
      "_offset": 2637,
      "_length": 47,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 19,
      "english": "Y'know, Shibuya is the best! It's\nso much more fun than the Digimon\nworld!",
      "_offset": 2685,
      "_length": 74,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 20,
      "english": "It's Pumpmon and Gotsumon!",
      "_offset": 2763,
      "_length": 26,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 21,
      "english": "Do you know those Digimon?",
      "_offset": 2790,
      "_length": 26,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 22,
      "english": "They must be Vamdemon's minions!",
      "_offset": 2817,
      "_length": 32,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 23,
      "english": "What?! Let's go!",
      "_offset": 2850,
      "_length": 16,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 24,
      "english": "Yeah!",
      "_offset": 2867,
      "_length": 5,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 25,
