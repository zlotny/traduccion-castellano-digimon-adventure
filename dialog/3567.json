{
  "file_id": "3567",
  "format": "etdf",
  "kind": "ETDF",
  "text_count": 160,
  "dialog": [
    {
      "index": 0,
      "english": "30 minutes ago...",
      "speaker_id": 9003,
      "line_type": 2,
      "_offset": 12424,
      "_bytes": 17,
      "translation": "Hace 30 minutos..."
    },
    {
      "index": 1,
      "english": "Stupid Patamon!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 12442,
      "_bytes": 15,
      "translation": "¡Patamon tonto!"
    },
    {
      "index": 2,
      "english": "Do whatever you want, T.K! I\ndon't care!",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 12458,
      "_bytes": 43,
      "translation": "¡Haz lo que quieras, T.K.! ¡Me\nda igual!"
    },
    {
      "index": 3,
      "english": "Right now...",
      "speaker_id": 9003,
      "line_type": 2,
      "_offset": 12502,
      "_bytes": 12,
      "translation": "Ahora..."
    },
    {
      "index": 4,
      "english": "I wonder where Patamon went...",
      "speaker_id": 2211,
      "line_type": 2,
      "_offset": 12515,
      "_bytes": 30,
      "translation": "¿Dónde estará Patamon?"
    },
    {
      "index": 5,
      "english": "He flew away after you told him\noff.",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 12546,
      "_bytes": 36,
      "translation": "Se fue volando cuando le\nregañaste."
    },
    {
      "index": 6,
      "english": "I *had* to say something! It's his\nown fault for asking me all those\npersonal questions...",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 12583,
      "_bytes": 90,
      "translation": "¡Tenía que decir algo! Es culpa\nsuya por hacerme todas esas\npreguntas personales..."
    },
    {
      "index": 7,
      "english": "Stuff like \"Was it hard to have to\nlive separately from your brother\nand dad?\"",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 12674,
      "_bytes": 78,
      "translation": "Cosas como: \"¿Te costó vivir\nseparado de tu hermano y tu\npadre?\""
    },
    {
      "index": 8,
      "english": "I understand, but I still think\nyou were too harsh.",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 12753,
      "_bytes": 51,
      "translation": "Lo entiendo, pero creo que\nfuiste demasiado duro."
    },
    {
      "index": 9,
      "english": "I was just being honest...",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 12805,
      "_bytes": 26,
      "translation": "Solo era sincero..."
    },
    {
      "index": 10,
      "english": "C'mon, let's go make up with\nPatamon.",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 12832,
      "_bytes": 37,
      "translation": "Vamos a hacer las paces\ncon Patamon."
    },
    {
      "index": 11,
      "english": "Okay...",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 12870,
      "_bytes": 7,
      "translation": "Vale..."
    },
    {
      "index": 12,
      "english": "I think he's that way! Let's go\nlook!",
      "speaker_id": 2211,
      "line_type": 2,
      "_offset": 12878,
      "_bytes": 37,
      "translation": "¡Creo que se fue por ahí!\n¡Vamos a ver!"
    },
    {
      "index": 13,
      "english": "Where did Patamon go?",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 12916,
      "_bytes": 21,
      "translation": "¿Adónde fue Patamon?"
    },
    {
      "index": 14,
      "english": "T.K...",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 12938,
      "_bytes": 9,
      "translation": "T.K..."
    },
    {
      "index": 15,
      "english": "Cheer up, T.K.",
      "speaker_id": 2211,
      "line_type": 2,
      "_offset": 12948,
      "_bytes": 17,
      "translation": "Anímate, T.K."
    },
    {
      "index": 16,
      "english": "Hey, missy!",
      "speaker_id": 4301,
      "line_type": 2,
      "_offset": 12966,
      "_bytes": 11,
      "translation": "¡Oye, guapa!"
    },
    {
      "index": 17,
      "english": "What time is it?",
      "speaker_id": 4311,
      "line_type": 2,
      "_offset": 12978,
      "_bytes": 16,
      "translation": "¿Qué hora es?"
    },
    {
      "index": 18,
      "english": "Tch! What's wrong, are you scared\nof our faces?",
      "speaker_id": 4301,
      "line_type": 2,
      "_offset": 12995,
      "_bytes": 47,
      "translation": "¡Tch! ¿Qué pasa, te dan miedo\nnuestras caras?"
    },
    {
      "index": 19,
      "english": "Y'know, Shibuya is the best! It's\nso much more fun than the Digimon\nworld!",
      "speaker_id": 4311,
      "line_type": 2,
      "_offset": 13043,
      "_bytes": 74,
      "translation": "¡Shibuya es lo mejor! ¡Es mucho\nmás divertido que el Digimundo!"
    },
    {
      "index": 20,
      "english": "!!",
      "speaker_id": 2211,
      "line_type": 2,
      "_offset": 13118,
      "_bytes": 2,
      "translation": "!!"
    },
    {
      "index": 21,
      "english": "It's Pumpmon and Gotsumon!",
      "speaker_id": 2221,
      "line_type": 2,
      "_offset": 13121,
      "_bytes": 26,
      "translation": "¡Son Pumpmon y Gotsumon!"
    },
    {
      "index": 22,
      "english": "Do you know those Digimon?",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 13148,
      "_bytes": 26,
      "translation": "¿Conocéis a esos Digimon?"
    },
    {
      "index": 23,
      "english": "They must be Myotismon's minions!",
      "speaker_id": 2221,
      "line_type": 2,
      "_offset": 13175,
      "_bytes": 32,
      "translation": "¡Serán secuaces de\nMyotismon!"
    },
    {
      "index": 24,
      "english": "What?! Let's go!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 13208,
      "_bytes": 16,
      "translation": "¡¿Qué?! ¡Vamos!"
    },
    {
      "index": 25,
      "english": "Yeah!",
      "speaker_id": 2221,
      "line_type": 2,
      "_offset": 13225,
      "_bytes": 5,
      "translation": "¡Sí!"
    },
    {
      "index": 26,
      "english": "Pumpmon! Gotsumon!",
      "speaker_id": 2221,
      "line_type": 2,
      "_offset": 13231,
      "_bytes": 18,
      "translation": "¡Pumpmon! ¡Gotsumon!"
    },
    {
      "index": 27,
      "english": "Wah?!",
      "speaker_id": 4301,
      "line_type": 2,
      "_offset": 13250,
      "_bytes": 5,
      "translation": "¡¿Ah?!"
    },
    {
      "index": 28,
      "english": "Aaaaah! Chosen Children!",
      "speaker_id": 4311,
      "line_type": 2,
      "_offset": 13256,
      "_bytes": 24,
      "translation": "¡Aaaaah! ¡Niños Elegidos!"
    },
    {
      "index": 29,
      "english": "Did you come here to look for the\neighth Chosen Child?!",
      "speaker_id": 2221,
      "line_type": 2,
      "_offset": 13281,
      "_bytes": 55,
      "translation": "¡¿Habéis venido a buscar al\noctavo Niño Elegido?!"
    },
    {
      "index": 30,
      "english": "Yeah, but hanging out in Shibuya\nwound up being a lot more fun.",
      "speaker_id": 4301,
      "line_type": 2,
      "_offset": 13337,
      "_bytes": 63,
      "translation": "Sí, pero salir en Shibuya\nfue mucho más divertido."
    },
    {
      "index": 31,
      "english": "Hanging out in Shibuya wound up\nbeing a lot more fun?",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 13401,
      "_bytes": 53,
      "translation": "¿Salir en Shibuya fue mucho\nmás divertido?"
    },
    {
      "index": 32,
      "english": "We've totally become Shibuya-type\nDigimon!",
      "speaker_id": 4311,
      "line_type": 2,
      "_offset": 13455,
      "_bytes": 42,
      "translation": "¡Nos hemos vuelto Digimon al\nestilo Shibuya!"
    },
    {
      "index": 33,
      "english": "Shibuya-type Digimon?",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 13498,
      "_bytes": 21,
      "translation": "¿Digimon de Shibuya?"
    },
    {
      "index": 34,
      "english": "What kind of little scheme are you\ntwo coming up with?",
      "speaker_id": 2221,
      "line_type": 2,
      "_offset": 13520,
      "_bytes": 54,
      "translation": "¿Qué tramáis vosotros dos ahora?"
    },
    {
      "index": 35,
      "english": "Nothing at all!",
      "speaker_id": 4301,
      "line_type": 2,
      "_offset": 13575,
      "_bytes": 15,
      "translation": "¡Nada de nada!"
    },
    {
      "index": 36,
      "english": "Nothing at all!",
      "speaker_id": 4311,
      "line_type": 2,
      "_offset": 13591,
      "_bytes": 15,
      "translation": "¡Nada de nada!"
    },
    {
      "index": 37,
      "english": "Aaaaah, they...!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 13607,
      "_bytes": 16,
      "translation": "¡Aaaah, ellos...!"
    },
    {
      "index": 38,
      "english": "Let's follow them!",
      "speaker_id": 2221,
      "line_type": 2,
      "_offset": 13624,
      "_bytes": 18,
      "translation": "¡Vamos a seguirlos!"
    },
    {
      "index": 39,
      "english": "Ten minutes later...",
      "speaker_id": 9003,
      "line_type": 2,
      "_offset": 13643,
      "_bytes": 20,
      "translation": "Pasan 10 minutos..."
    },
    {
      "index": 40,
      "english": "*pant* *pant*...",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 13664,
      "_bytes": 16,
      "translation": "(jadeos)..."
    },
    {
      "index": 41,
      "english": "Where'd they go?",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 13681,
      "_bytes": 16,
      "translation": "¿Adónde han ido?"
    },
    {
      "index": 42,
      "english": "Over there, Matt!",
      "speaker_id": 2221,
      "line_type": 2,
      "_offset": 13698,
      "_bytes": 19,
      "translation": "¡Por ahí, Matt!"
    },
    {
      "index": 43,
      "english": "This is delicious!",
      "speaker_id": 4301,
      "line_type": 2,
      "_offset": 13718,
      "_bytes": 18,
      "translation": "¡Qué rico está!"
    },
    {
      "index": 44,
      "english": "You can't get ice cream\nin the Digimon world!",
      "speaker_id": 4311,
      "line_type": 2,
      "_offset": 13737,
      "_bytes": 45,
      "translation": "¡No hay helados en el\nDigimundo!"
    },
    {
      "index": 45,
      "english": "Pumpmon! Gotsumon!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 13783,
      "_bytes": 18,
      "translation": "¡Pumpmon! ¡Gotsumon!"
    },
    {
      "index": 46,
      "english": "Uh-oh! We've been spotted!",
      "speaker_id": 4301,
      "line_type": 2,
      "_offset": 13802,
      "_bytes": 26,
      "translation": "¡Uy! ¡Nos han visto!"
    },
    {
      "index": 47,
      "english": "Run!!",
      "speaker_id": 4311,
      "line_type": 2,
      "_offset": 13829,
      "_bytes": 5,
      "translation": "¡Corre!"
    },
    {
      "index": 48,
      "english": "Wait!",
      "speaker_id": 2221,
      "line_type": 2,
      "_offset": 13835,
      "_bytes": 5,
      "translation": "¡Alto!"
    },
    {
      "index": 49,
      "english": "Ten minutes later...",
      "speaker_id": 9003,
      "line_type": 2,
      "_offset": 13841,
      "_bytes": 20,
      "translation": "Pasan 10 minutos..."
    },
    {
      "index": 50,
      "english": "*pant* *pant*...",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 13862,
      "_bytes": 16,
      "translation": "(jadeos)..."
    },
    {
      "index": 51,
      "english": "*pant* Where are they this time?",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 13879,
      "_bytes": 32,
      "translation": "(jadeos) ¿Dónde están ahora?"
    },
    {
      "index": 52,
      "english": "Matt, over there!",
      "speaker_id": 2221,
      "line_type": 2,
      "_offset": 13912,
      "_bytes": 19,
      "translation": "Matt, ¡por ahí!"
    },
    {
      "index": 53,
      "english": "Wouldn't you look better in this\none?",
      "speaker_id": 4301,
      "line_type": 2,
      "_offset": 13932,
      "_bytes": 37,
      "translation": "¿No te quedaría mejor este?"
    },
    {
      "index": 54,
      "english": "I think so, too!",
      "speaker_id": 4311,
      "line_type": 2,
      "_offset": 13970,
      "_bytes": 16,
      "translation": "¡Yo también!"
    },
    {
      "index": 55,
      "english": "Found you!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 13987,
      "_bytes": 10,
      "translation": "¡Os pillé!"
    },
    {
      "index": 56,
      "english": "They found us again!",
      "speaker_id": 4301,
      "line_type": 2,
      "_offset": 13998,
      "_bytes": 20,
      "translation": "¡Otra vez nos pillan!"
    },
    {
      "index": 57,
      "english": "Ruuuuuuun!!",
      "speaker_id": 4311,
      "line_type": 2,
      "_offset": 14019,
      "_bytes": 11,
      "translation": "¡¡Correeee!!"
    },
    {
      "index": 58,
      "english": "D-darn it!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 14031,
      "_bytes": 10,
      "translation": "¡P-porras!"
    },
    {
      "index": 59,
      "english": "I'm so tired, I can't run\nanymore...",
      "speaker_id": 2221,
      "line_type": 2,
      "_offset": 14042,
      "_bytes": 36,
      "translation": "Estoy muy cansado, no\npuedo más..."
    },
    {
      "index": 60,
      "english": "They're...",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 14079,
      "_bytes": 10,
      "translation": "Son..."
    },
    {
      "index": 61,
      "english": "Aaaah! Patamon!",
      "speaker_id": 2221,
      "line_type": 2,
      "_offset": 14090,
      "_bytes": 15,
      "translation": "¡Aaaah! ¡Patamon!"
    },
    {
      "index": 62,
      "english": "T.K, let's go after him!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 14106,
      "_bytes": 27,
      "translation": "T.K., ¡vamos tras él!"
    },
    {
      "index": 63,
      "english": "Wait! Patamooooooooon!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 14134,
      "_bytes": 22,
      "translation": "¡Espera! ¡Patamooooooon!"
    },
    {
      "index": 64,
      "english": "They didn't follow us...",
      "speaker_id": 4301,
      "line_type": 2,
      "_offset": 14157,
      "_bytes": 24,
      "translation": "No nos han seguido..."
    },
    {
      "index": 65,
      "english": "Should we wait and see what\nhappens?",
      "speaker_id": 4311,
      "line_type": 2,
      "_offset": 14182,
      "_bytes": 36,
      "translation": "¿Deberíamos esperar y ver qué\npasa?"
    },
    {
      "index": 66,
      "english": "Hmm... Yeah, we should.",
      "speaker_id": 4301,
      "line_type": 2,
      "_offset": 14219,
      "_bytes": 23,
      "translation": "Hmm... Sí, deberíamos."
    },
    {
      "index": 67,
      "english": "Lord Myotismon!",
      "speaker_id": 4301,
      "line_type": 2,
      "_offset": 14243,
      "_bytes": 14,
      "translation": "¡Amo Myotismon!"
    },
    {
      "index": 68,
      "english": "Lord Myotismon!",
      "speaker_id": 4311,
      "line_type": 2,
      "_offset": 14258,
      "_bytes": 14,
      "translation": "¡Amo Myotismon!"
    },
    {
      "index": 69,
      "english": "Pumpmon. Gotsumon.",
      "speaker_id": 3031,
      "line_type": 2,
      "_offset": 14273,
      "_bytes": 18,
      "translation": "Pumpmon. Gotsumon."
    },
    {
      "index": 70,
      "english": "Yes, sir!",
      "speaker_id": 4301,
      "line_type": 2,
      "_offset": 14292,
      "_bytes": 9,
      "translation": "¡Sí, señor!"
    },
    {
      "index": 71,
      "english": "Yes, sir!",
      "speaker_id": 4311,
      "line_type": 2,
      "_offset": 14302,
      "_bytes": 9,
      "translation": "¡Sí, señor!"
    },
    {
      "index": 72,
      "english": "Have you found the eighth Chosen\nChild yet?",
      "speaker_id": 3031,
      "line_type": 2,
      "_offset": 14312,
      "_bytes": 43,
      "translation": "¿Habéis encontrado al octavo\nNiño Elegido?"
    },
    {
      "index": 73,
      "english": "We still haven't found them.",
      "speaker_id": 4311,
      "line_type": 2,
      "_offset": 14356,
      "_bytes": 28,
      "translation": "Aún no lo hemos encontrado."
    },
    {
      "index": 74,
      "english": "Then why haven't you seized the\nCrests from the Chosen Children?",
      "speaker_id": 3031,
      "line_type": 2,
      "_offset": 14385,
      "_bytes": 64,
      "translation": "¿Entonces por qué no les\nquitasteis los Emblemas?"
    },
    {
      "index": 75,
      "english": "We were thinking about doing that\njust now!",
      "speaker_id": 4301,
      "line_type": 2,
      "_offset": 14450,
      "_bytes": 43,
      "translation": "¡Estábamos pensando hacerlo\nahora mismo!"
    },
    {
      "index": 76,
      "english": "What he said!",
      "speaker_id": 4311,
      "line_type": 2,
      "_offset": 14494,
      "_bytes": 13,
      "translation": "¡Eso digo yo!"
    },
    {
      "index": 77,
      "english": "Patamooooooooooon!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 14508,
      "_bytes": 18,
      "translation": "¡Patamooooooooooon!"
    },
    {
      "index": 78,
      "english": "T.K! Why'd you come here?",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 14527,
      "_bytes": 28,
      "translation": "¡T.K.! ¿Por qué has venido?"
    },
    {
      "index": 79,
      "english": "Sorry, Patamon, I was too harsh on\nyou.",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 14556,
      "_bytes": 39,
      "translation": "Perdona, Patamon, fui muy\nduro contigo."
    },
    {
      "index": 80,
      "english": "...",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 14596,
      "_bytes": 3,
      "translation": "..."
    },
    {
      "index": 81,
      "english": "Patamon!",
      "speaker_id": 2221,
      "line_type": 2,
      "_offset": 14600,
      "_bytes": 8,
      "translation": "¡Patamon!"
    },
    {
      "index": 82,
      "english": "...I'm sorry, too.",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 14609,
      "_bytes": 18,
      "translation": "...Y yo lo siento."
    },
    {
      "index": 83,
      "english": "Okay!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 14628,
      "_bytes": 5,
      "translation": "¡Vale!"
    },
    {
      "index": 84,
      "english": "That's great, T.K!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 14634,
      "_bytes": 21,
      "translation": "¡Qué bien, T.K.!"
    },
    {
      "index": 85,
      "english": "Hey, Chosen Children!",
      "speaker_id": 4301,
      "line_type": 2,
      "_offset": 14656,
      "_bytes": 21,
      "translation": "¡Eh, Niños Elegidos!"
    },
    {
      "index": 86,
      "english": "Hand over your Tags and Crests!",
      "speaker_id": 4311,
      "line_type": 2,
      "_offset": 14678,
      "_bytes": 31,
      "translation": "¡Dadme los Circuitos y\nEmblemas!"
    },
    {
      "index": 87,
      "english": "Huh?!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 14710,
      "_bytes": 5,
      "translation": "¡¿Eh?!"
    },
    {
      "index": 88,
      "english": "What happened now? What's with the\none-eighty?",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 14716,
      "_bytes": 46,
      "translation": "¿Y ahora qué? ¿A qué viene ese\ncambio?"
    },
    {
      "index": 89,
      "english": "I guess we should have expected\nthis. They were Myotismon's minions\nall along.",
      "speaker_id": 2221,
      "line_type": 2,
      "_offset": 14763,
      "_bytes": 77,
      "translation": "Supongo que debíamos\nesperarlo. Eran secuaces de\nMyotismon desde el principio."
    },
    {
      "index": 90,
      "english": "Guess we'll have to fight them...",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 14841,
      "_bytes": 33,
      "translation": "Habrá que luchar contra ellos..."
    },
    {
      "index": 91,
      "english": "Roaaaaaar!",
      "speaker_id": 4301,
      "line_type": 2,
      "_offset": 14875,
      "_bytes": 10,
      "translation": "¡Roaaaaaar!"
    },
    {
      "index": 92,
      "english": "We'll mess you up!",
      "speaker_id": 4311,
      "line_type": 2,
      "_offset": 14886,
      "_bytes": 18,
      "translation": "¡Os machacaremos!"
    },
    {
      "index": 93,
      "english": "They're coming for us!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 14905,
      "_bytes": 22,
      "translation": "¡Vienen a por nosotros!"
    },
    {
      "index": 94,
      "english": "All right then, come at us!",
      "speaker_id": 2221,
      "line_type": 2,
      "_offset": 14928,
      "_bytes": 27,
      "translation": "¡Pues venid a por nosotros!"
    },
    {
      "index": 95,
      "english": "...I give up.",
      "speaker_id": 4301,
      "line_type": 2,
      "_offset": 14956,
      "_bytes": 13,
      "translation": "...Me rindo."
    },
    {
      "index": 96,
      "english": "Me, too.",
      "speaker_id": 4311,
      "line_type": 2,
      "_offset": 14970,
      "_bytes": 8,
      "translation": "Y yo."
    },
    {
      "index": 97,
      "english": "Huh?",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 14979,
      "_bytes": 4,
      "translation": "¿Eh?"
    },
    {
      "index": 98,
      "english": "I'd have a lot more fun hanging\nout in Shibuya than fighting the\nChosen Children.",
      "speaker_id": 4301,
      "line_type": 2,
      "_offset": 14984,
      "_bytes": 81,
      "translation": "Me lo pasaría mejor en\nShibuya que luchando contra\nlos Niños Elegidos."
    },
    {
      "index": 99,
      "english": "Yeah, yeah. Wanna hang with us?",
      "speaker_id": 4311,
      "line_type": 2,
      "_offset": 15066,
      "_bytes": 31,
      "translation": "Sí, sí. ¿Os venís con nosotros?"
    },
    {
      "index": 100,
      "english": "Whaaaaaaaaat?",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 15098,
      "_bytes": 13,
      "translation": "¡¿Queeeeeeé?!"
    },
    {
      "index": 101,
      "english": "I don't get them at all.",
      "speaker_id": 2221,
      "line_type": 2,
      "_offset": 15112,
      "_bytes": 24,
      "translation": "No los entiendo nada."
    },
    {
      "index": 102,
      "english": "!!",
      "speaker_id": 4301,
      "line_type": 2,
      "_offset": 15137,
      "_bytes": 2,
      "translation": "!!"
    },
    {
      "index": 103,
      "english": "W-what's wrong?",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 15140,
      "_bytes": 15,
      "translation": "¿Q-qué pasa?"
    },
    {
      "index": 104,
      "english": "Myotismon's coming!",
      "speaker_id": 4311,
      "line_type": 2,
      "_offset": 15156,
      "_bytes": 18,
      "translation": "¡Viene Myotismon!"
    },
    {
      "index": 105,
      "english": "Why haven't you defeated the\nChosen Children?",
      "speaker_id": 3031,
      "line_type": 2,
      "_offset": 15175,
      "_bytes": 45,
      "translation": "¿Por qué no vencisteis a los\nNiños Elegidos?"
    },
    {
      "index": 106,
      "english": "T-that's because...",
      "speaker_id": 4301,
      "line_type": 2,
      "_offset": 15221,
      "_bytes": 19,
      "translation": "E-es que..."
    },
    {
      "index": 107,
      "english": "You're worthless! I have no\nfurther use for you!",
      "speaker_id": 3031,
      "line_type": 2,
      "_offset": 15241,
      "_bytes": 48,
      "translation": "¡No valéis nada! ¡Ya no me\nsois útiles!"
    },
    {
      "index": 108,
      "english": "Night Raid!",
      "speaker_id": 3031,
      "line_type": 2,
      "_offset": 15290,
      "_bytes": 11,
      "translation": "¡Asalto Nocturno!"
    },
    {
      "index": 109,
      "english": "Gyaaaaaaaaaaaaaaah!",
      "speaker_id": 4301,
      "line_type": 2,
      "_offset": 15302,
      "_bytes": 19,
      "translation": "¡Gyaaaaaaaaaaaaaaah!"
    },
    {
      "index": 110,
      "english": "Gyaaaaaaaaaaaaaaah!",
      "speaker_id": 4311,
      "line_type": 2,
      "_offset": 15322,
      "_bytes": 19,
      "translation": "¡Gyaaaaaaaaaaaaaaah!"
    },
    {
      "index": 111,
      "english": "Pumpmon!",
      "speaker_id": 2221,
      "line_type": 2,
      "_offset": 15342,
      "_bytes": 8,
      "translation": "¡Pumpmon!"
    },
    {
      "index": 112,
      "english": "Gotsumon!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 15351,
      "_bytes": 9,
      "translation": "¡Gotsumon!"
    },
    {
      "index": 113,
      "english": "You're next.",
      "speaker_id": 3031,
      "line_type": 2,
      "_offset": 15361,
      "_bytes": 12,
      "translation": "Ahora vas tú."
    },
    {
      "index": 114,
      "english": "They were good guys... You didn't\nhave to kill them!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 15374,
      "_bytes": 52,
      "translation": "Eran buena gente... ¡No hacía\nfalta matarlos!"
    },
    {
      "index": 115,
      "english": "*sob* What are we gonna do now?",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 15427,
      "_bytes": 31,
      "translation": "(llora) ¿Qué hacemos ahora?"
    },
    {
      "index": 116,
      "english": "T.K... I'll protect T.K!",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 15459,
      "_bytes": 30,
      "translation": "T.K... ¡Protegeré a T.K.!"
    },
    {
      "index": 117,
      "english": "Patamoooooooooooooooooooon!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 15490,
      "_bytes": 27,
      "translation": "¡Patamoooooooooooooooooooon!"
    },
    {
      "index": 118,
      "english": "Myotismon! I won't let you do as\nyou please!",
      "speaker_id": 2731,
      "line_type": 2,
      "_offset": 15518,
      "_bytes": 43,
      "translation": "¡Myotismon! ¡No harás lo que\nquieras!"
    },
    {
      "index": 119,
      "english": "Ngh... You're...",
      "speaker_id": 3031,
      "line_type": 2,
      "_offset": 15562,
      "_bytes": 16,
      "translation": "Ngh... Eres..."
    },
    {
      "index": 120,
      "english": "Angemon! You evolved!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 15579,
      "_bytes": 21,
      "translation": "¡Angemon! ¡Has evolucionado!"
    },
    {
      "index": 121,
      "english": "The one who holds holy power...\nWe'll put this fight on hold for\nnow! Mwahahahaha!",
      "speaker_id": 3031,
      "line_type": 2,
      "_offset": 15601,
      "_bytes": 82,
      "translation": "El portador del poder\nsagrado... ¡Dejaremos esto para\nmás tarde! ¡Mwahahahaha!"
    },
    {
      "index": 122,
      "english": "Pumpmon... Gotsumon...",
      "speaker_id": 2221,
      "line_type": 2,
      "_offset": 15684,
      "_bytes": 22,
      "translation": "Pumpmon... Gotsumon..."
    },
    {
      "index": 123,
      "english": "We knew them for such a short\ntime, but they were our friends.",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 15707,
      "_bytes": 62,
      "translation": "Los conocimos poco tiempo,\npero eran nuestros amigos."
    },
    {
      "index": 124,
      "english": "Yeah...",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 15770,
      "_bytes": 7,
      "translation": "Sí..."
    },
    {
      "index": 125,
      "english": "Let's go home.",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 15778,
      "_bytes": 14,
      "translation": "Vamos a casa."
    },
    {
      "index": 126,
      "english": "Wait, Matt! We have to look for\nPatamon!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 15793,
      "_bytes": 42,
      "translation": "¡Espera, Matt! ¡Hay que buscar\na Patamon!"
    },
    {
      "index": 127,
      "english": "A-ah. Sorry, sorry...",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 15836,
      "_bytes": 21,
      "translation": "A-ah. Perdón, perdón."
    },
    {
      "index": 128,
      "english": "Miss, have you seen Patamon?",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 15858,
      "_bytes": 28,
      "translation": "Señorita, ¿ha visto a Patamon?"
    },
    {
      "index": 129,
      "english": "Patamon? Uh, what's that?",
      "speaker_id": 6401,
      "line_type": 2,
      "_offset": 15887,
      "_bytes": 25,
      "translation": "¿Patamon? ¿Eso qué es?"
    },
    {
      "index": 130,
      "english": "T-T.K!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 15913,
      "_bytes": 9,
      "translation": "¡T-T.K.!"
    },
    {
      "index": 131,
      "english": "Nothing, nothing, Ahaha.",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 15923,
      "_bytes": 24,
      "translation": "Nada, nada, jaja."
    },
    {
      "index": 132,
      "english": "Mister, have you seen Patamon?",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 15948,
      "_bytes": 30,
      "translation": "Señor, ¿ha visto a Patamon?"
    },
    {
      "index": 133,
      "english": "Hm? Patamon?",
      "speaker_id": 6381,
      "line_type": 2,
      "_offset": 15979,
      "_bytes": 12,
      "translation": "¿Hm? ¿Patamon?"
    },
    {
      "index": 134,
      "english": "T-T.K!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 15992,
      "_bytes": 9,
      "translation": "¡T-T.K.!"
    },
    {
      "index": 135,
      "english": "But we're keeping the Digimon secret",
      "speaker_id": 4294967295,
      "line_type": 2,
      "_offset": 16002,
      "_bytes": 36,
      "translation": "Pero lo del Digimon es secreto"
    },
    {
      "index": 136,
      "english": "He may have devolved to Tokomon",
      "speaker_id": 4294967295,
      "line_type": 2,
      "_offset": 16039,
      "_bytes": 31,
      "translation": "Puede que haya vuelto a Tokomon"
    },
    {
      "index": 137,
      "english": "Right, it's a secret.",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 16071,
      "_bytes": 21,
      "translation": "Cierto, es secreto."
    },
    {
      "index": 138,
      "english": "I'll do everything I can to help\nyou find Patamon, so relax.",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 16093,
      "_bytes": 60,
      "translation": "Haré lo posible para ayudarte\na buscar a Patamon, tranquilo."
    },
    {
      "index": 139,
      "english": "Thanks, Matt!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 16154,
      "_bytes": 15,
      "translation": "¡Gracias, Matt!"
    },
    {
      "index": 140,
      "english": "Anyway, mister! Forget what you\njust heard!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 16170,
      "_bytes": 43,
      "translation": "¡Bueno, señor! ¡Olvide lo que\nacaba de oír!"
    },
    {
      "index": 141,
      "english": "*sigh*",
      "speaker_id": 6381,
      "line_type": 2,
      "_offset": 16214,
      "_bytes": 6,
      "translation": "Uf..."
    },
    {
      "index": 142,
      "english": "Looks like he's sleeping... he\nmust be drunk.",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 16221,
      "_bytes": 45,
      "translation": "Parece que duerme... debe de\nestar borracho."
    },
    {
      "index": 143,
      "english": "What!? That means he's in danger!\nIf he gets attacked by a\nDigimon...",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 16267,
      "_bytes": 69,
      "translation": "¡¿Qué?! ¡Entonces está en\npeligro! Si le ataca un\nDigimon..."
    },
    {
      "index": 144,
      "english": "S-sorry, I was joking. Let's look\nfor Patamon!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 16337,
      "_bytes": 46,
      "translation": "P-perdón, era broma. ¡Vamos a\nbuscar a Patamon!"
    },
    {
      "index": 145,
      "english": "Yeah.",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 16384,
      "_bytes": 5,
      "translation": "Sí."
    },
    {
      "index": 146,
      "english": "Patter, patter... now that I think\nabout it, I messed up in that golf\ngame.",
      "speaker_id": 6381,
      "line_type": 2,
      "_offset": 16390,
      "_bytes": 75,
      "translation": "Pata, pata... pensándolo bien,\nla lié en esa partida de golf."
    },
    {
      "index": 147,
      "english": "I'll ask this old lady. Have you\nseen Patamon?",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 16466,
      "_bytes": 46,
      "translation": "Le preguntaré a esa vieja.\n¿Ha visto a Patamon?"
    },
    {
      "index": 148,
      "english": "...",
      "speaker_id": 6401,
      "line_type": 2,
      "_offset": 16513,
      "_bytes": 3,
      "translation": "..."
    },
    {
      "index": 149,
      "english": "Hello?",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 16517,
      "_bytes": 6,
      "translation": "¿Hola?"
    },
    {
      "index": 150,
      "english": "Did you just call me an old lady?",
      "speaker_id": 6401,
      "line_type": 2,
      "_offset": 16524,
      "_bytes": 33,
      "translation": "¿Me acabas de llamar vieja?"
    },
    {
      "index": 151,
      "english": "T-T.K! Don't call her that!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 16558,
      "_bytes": 30,
      "translation": "¡T-T.K.! ¡No la llames así!"
    },
    {
      "index": 152,
      "english": "It's nothing... Ahaha.",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 16589,
      "_bytes": 22,
      "translation": "Nada, nada... Jaja."
    },
    {
      "index": 153,
      "english": "Mister, have you seen Patamon?",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 16612,
      "_bytes": 30,
      "translation": "Señor, ¿ha visto a Patamon?"
    },
    {
      "index": 154,
      "english": "I have.",
      "speaker_id": 6381,
      "line_type": 2,
      "_offset": 16643,
      "_bytes": 7,
      "translation": "Sí."
    },
    {
      "index": 155,
      "english": "Really!? Where?",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 16651,
      "_bytes": 15,
      "translation": "¡¿En serio?! ¿Dónde?"
    },
    {
      "index": 156,
      "english": "*burp*",
      "speaker_id": 6381,
      "line_type": 2,
      "_offset": 16667,
      "_bytes": 6,
      "translation": "Hip..."
    },
    {
      "index": 157,
      "english": "Looks like he's drunk... let's go,\nT.K.",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 16674,
      "_bytes": 42,
      "translation": "Parece que está borracho...\nvamos, T.K."
    },
    {
      "index": 158,
      "english": "Okay...",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 16717,
      "_bytes": 7,
      "translation": "Vale..."
    },
    {
      "index": 159,
      "english": "10 more minutes later...",
      "speaker_id": 9003,
      "line_type": 2,
      "_offset": 16725,
      "_bytes": 24,
      "translation": "10 minutos más tarde..."
    }
  ]
}