      "index": 47,
      "english": "Wait!",
      "_offset": 3477,
      "_length": 5,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 48,
      "english": "Ten minutes later...",
      "_offset": 3483,
      "_length": 20,
      "speaker_id": 0,
