{
  "file_id": "3579",
  "format": "etdf",
  "kind": "ETDF",
  "text_count": 128,
  "dialog": [
    {
      "index": 0,
      "english": "*cough, cough*",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 11560,
      "_bytes": 14,
      "translation": "Cof, cof..."
    },
    {
      "index": 1,
      "english": "Kari!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 11575,
      "_bytes": 7,
      "translation": "¡Kari!"
    },
    {
      "index": 2,
      "english": "Looks like her cold's returned...",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 11583,
      "_bytes": 33,
      "translation": "Vuelve a tener el resfriado..."
    },
    {
      "index": 3,
      "english": "Kari... Are you okay?",
      "speaker_id": 2831,
      "line_type": 2,
      "_offset": 11617,
      "_bytes": 23,
      "translation": "Kari... ¿Estás bien?"
    },
    {
      "index": 4,
      "english": "...",
      "speaker_id": 1081,
      "line_type": 4,
      "_offset": 11641,
      "_bytes": 3,
      "translation": "..."
    },
    {
      "index": 5,
      "english": "Why didn't you tell us? You've\nbeen sick for a while, haven't\nyou?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 11645,
      "_bytes": 66,
      "translation": "¿Por qué no dijiste nada?\nLlevas tiempo enferma, ¿no?"
    },
    {
      "index": 6,
      "english": "I know, but... if we don't\nhurry... the Earth will...",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 11712,
      "_bytes": 53,
      "translation": "Ya lo sé, pero si no nos\ndamos prisa... la Tierra..."
    },
    {
      "index": 7,
      "english": "Kari...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 11766,
      "_bytes": 9,
      "translation": "Kari..."
    },
    {
      "index": 8,
      "english": "I *knew* we shouldn't have brought\nher with us!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 11776,
      "_bytes": 47,
      "translation": "¡Lo sabía! ¡No deberíamos\nhaberla traído!"
    },
    {
      "index": 9,
      "english": "Huh? But unless Kari is here, we\nwon't be able to save the Digimon\nworld, or the Earth!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 11824,
      "_bytes": 89,
      "translation": "¿Eh? ¡Pero si Kari no está aquí,\nno podremos salvar ni el\nDigimundo ni la Tierra!"
    },
    {
      "index": 10,
      "english": "But she's the kind of person who\nnever says anything and keeps it\nto herself...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 11914,
      "_bytes": 79,
      "translation": "Pero ella es de las que nunca\ndice nada y se lo guarda\ntodo..."
    },
    {
      "index": 11,
      "english": "Tai...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 11994,
      "_bytes": 9,
      "translation": "Tai..."
    },
    {
      "index": 12,
      "english": "There's a town here!",
      "speaker_id": 2421,
      "line_type": 2,
      "_offset": 12004,
      "_bytes": 20,
      "translation": "¡Hay un pueblo aquí!"
    },
    {
      "index": 13,
      "english": "Thank goodness there happened to\nbe a town nearby.",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 12025,
      "_bytes": 50,
      "translation": "Menos mal que había un\npueblo cerca."
    },
    {
      "index": 14,
      "english": "Isn't it weird, though? There\naren't any Digimon in this town at\nall.",
      "speaker_id": 2321,
      "line_type": 2,
      "_offset": 12076,
      "_bytes": 69,
      "translation": "¿No os parece raro? No hay\nni un solo Digimon en este\npueblo."
    },
    {
      "index": 15,
      "english": "We're just lucky to be able to\nfind a bed for Kari.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 12146,
      "_bytes": 53,
      "translation": "Menos mal que hemos\nencontrado una cama para Kari."
    },
    {
      "index": 16,
      "english": "Kari... are you okay?",
      "speaker_id": 2831,
      "line_type": 2,
      "_offset": 12200,
      "_bytes": 23,
      "translation": "Kari... ¿estás bien?"
    },
    {
      "index": 17,
      "english": "I'll go out and find some medicine\nfor Kari. Sorry, but... can you\ntake care of her?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 12224,
      "_bytes": 86,
      "translation": "Voy a buscar medicinas para\nKari. Lo siento, pero...\n¿puedes cuidarla?"
    },
    {
      "index": 18,
      "english": "Of course. Be careful, Tai.",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 12311,
      "_bytes": 30,
      "translation": "Claro. Ten cuidado, Tai."
    },
    {
      "index": 19,
      "english": "I'll go with you!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 12342,
      "_bytes": 17,
      "translation": "¡Voy contigo!"
    },
    {
      "index": 20,
      "english": "No, I need you to stay here.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 12360,
      "_bytes": 28,
      "translation": "No, quédate aquí."
    },
    {
      "index": 21,
      "english": "We don't know when the Dark\nMasters might attack us again.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 12389,
      "_bytes": 58,
      "translation": "No sabemos cuándo volverán a\natacar los Amos Oscuros."
    },
    {
      "index": 22,
      "english": "Okay! I'll protect everyone here,\nthen!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 12448,
      "_bytes": 39,
      "translation": "¡Vale! ¡Entonces protegeré a\ntodos aquí!"
    },
    {
      "index": 23,
      "english": "Just leave it to us!",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 12488,
      "_bytes": 20,
      "translation": "¡Cuenta con nosotros!"
    },
    {
      "index": 24,
      "english": "Good man!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 12509,
      "_bytes": 9,
      "translation": "¡Muy bien!"
    },
    {
      "index": 25,
      "english": "Tai, there's a hospital! I'm\nsure we'll be able to find some\nmedicine there!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 12519,
      "_bytes": 79,
      "translation": "Tai, ¡hay un hospital! ¡Seguro\nque allí encontramos\nmedicinas!"
    },
    {
      "index": 26,
      "english": "Okay, let's hurry!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 12599,
      "_bytes": 18,
      "translation": "¡Vale, deprisa!"
    },
    {
      "index": 27,
      "english": "Agumon! Did you find anything...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 12618,
      "_bytes": 32,
      "translation": "¡Agumon! ¿Has encontrado algo...?"
    },
    {
      "index": 28,
      "english": "Bandages... adhesive plaster...\nnope, I can't find anything...",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 12651,
      "_bytes": 62,
      "translation": "Vendas... tiritas...\nnada, no encuentro nada..."
    },
    {
      "index": 29,
      "english": "Tai, I've found medicine!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 12714,
      "_bytes": 28,
      "translation": "Tai, ¡he encontrado medicina!"
    },
    {
      "index": 30,
      "english": "Really?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 12743,
      "_bytes": 7,
      "translation": "¿Seguro?"
    },
    {
      "index": 31,
      "english": "Ugh, there's way too many\ndifferent kinds. Which one's cold\nmedicine?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 12751,
      "_bytes": 69,
      "translation": "Uf, hay demasiados tipos\ndistintos. ¿Cuál es la del\nresfriado?"
    },
    {
      "index": 32,
      "english": "If only Joe were here... His\nfather is a doctor, isn't he?",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 12821,
      "_bytes": 58,
      "translation": "Ojalá estuviera Joe aquí...\nSu padre es médico, ¿no?"
    },
    {
      "index": 33,
      "english": "It wouldn't be Joe if he were\naround whenever you needed him...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 12880,
      "_bytes": 63,
      "translation": "No sería Joe si apareciera\njusto cuando se le\nnecesita..."
    },
    {
      "index": 34,
      "english": "I know! We can use the Internet to\nlook up which one is cold\nmedicine!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 12944,
      "_bytes": 70,
      "translation": "¡Ya sé! ¡Podemos buscar en\nInternet cuál es la del\nresfriado!"
    },
    {
      "index": 35,
      "english": "That's it! Go for it!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 13015,
      "_bytes": 21,
      "translation": "¡Eso es! ¡Adelante!"
    },
    {
      "index": 36,
      "english": "All right!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 13037,
      "_bytes": 10,
      "translation": "¡Vale!"
    },
    {
      "index": 37,
      "english": "Lord Mugendramon, our connection\nhas been accessed from within the\nhospital.",
      "speaker_id": 4492,
      "line_type": 2,
      "_offset": 13048,
      "_bytes": 76,
      "translation": "Señor Machinedramon, han\naccedido a nuestra red desde\ndentro del hospital."
    },
    {
      "index": 38,
      "english": "Hmph... set the hospital as the\ntarget, and prepare to attack!",
      "speaker_id": 3071,
      "line_type": 2,
      "_offset": 13125,
      "_bytes": 62,
      "translation": "¡Hmph... marcad el hospital\ncomo objetivo, atacad!"
    },
    {
      "index": 39,
      "english": "Roger! Metal Empire forces! March!",
      "speaker_id": 4492,
      "line_type": 2,
      "_offset": 13188,
      "_bytes": 34,
      "translation": "¡Recibido! ¡Tropas, en marcha!"
    },
    {
      "index": 40,
      "english": "Metal Empire forces! March!",
      "speaker_id": 4493,
      "line_type": 2,
      "_offset": 13223,
      "_bytes": 27,
      "translation": "¡Tropas, en marcha!"
    },
    {
      "index": 41,
      "english": "Here it is!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 13251,
      "_bytes": 11,
      "translation": "¡Aquí está!"
    },
    {
      "index": 42,
      "english": "No doubt about it!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 13263,
      "_bytes": 18,
      "translation": "¡Sin duda alguna!"
    },
    {
      "index": 43,
      "english": "Great. Let's go back.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 13282,
      "_bytes": 21,
      "translation": "Genial. Volvamos."
    },
    {
      "index": 44,
      "english": "Aaaaaah!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 13304,
      "_bytes": 8,
      "translation": "¡Aaaaah!"
    },
    {
      "index": 45,
      "english": "What?!",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 13313,
      "_bytes": 6,
      "translation": "¡¿Qué?!"
    },
    {
      "index": 46,
      "english": "At this rate, the building will\ncollapse! Tai, we need to get\nout!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 13320,
      "_bytes": 69,
      "translation": "¡Como sigamos así, el edificio\nse derrumbará! Tai, ¡tenemos\nque salir!"
    },
    {
      "index": 47,
      "english": "Right!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 13390,
      "_bytes": 6,
      "translation": "¡Vale!"
    },
    {
      "index": 48,
      "english": "Aaaaagh! The heck are those?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 13397,
      "_bytes": 28,
      "translation": "¡Aaaagh! ¿Qué diablos es eso?"
    },
    {
      "index": 49,
      "english": "Ugh, now isn't the time for this!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 13426,
      "_bytes": 33,
      "translation": "¡Uf, no es momento para esto!"
    },
    {
      "index": 50,
      "english": "Get out of the way!",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 13460,
      "_bytes": 19,
      "translation": "¡Fuera de en medio!"
    },
    {
      "index": 51,
      "english": "Now the town's full of Digimon!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 13480,
      "_bytes": 31,
      "translation": "¡Hay Digimon por todo el pueblo!"
    },
    {
      "index": 52,
      "english": "You think they know we're here?",
      "speaker_id": 2421,
      "line_type": 2,
      "_offset": 13512,
      "_bytes": 31,
      "translation": "¿Crees que nos han visto?"
    },
    {
      "index": 53,
      "english": "It's possible that they saw us\nwhile we were entering the\nhospital.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 13544,
      "_bytes": 67,
      "translation": "Es posible que nos vieran\nmientras entrábamos en el\nhospital."
    },
    {
      "index": 54,
      "english": "Gh! Right when we'd found the\nmedicine...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 13612,
      "_bytes": 41,
      "translation": "Justo cuando encontramos\nla medicina..."
    },
    {
      "index": 55,
      "english": "Why don't we hide for a bit and\nwait it out?",
      "speaker_id": 2421,
      "line_type": 2,
      "_offset": 13654,
      "_bytes": 44,
      "translation": "¿Por qué no esperamos\nescondidos un rato?"
    },
    {
      "index": 56,
      "english": "Okay. Let's find a place to hide,\nthen.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 13699,
      "_bytes": 39,
      "translation": "Vale, busquemos dónde\nescondernos."
    },
    {
      "index": 57,
      "english": "Tai, let's rest here for a\nbit...",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 13739,
      "_bytes": 36,
      "translation": "Tai, descansemos aquí un\npoco..."
    },
    {
      "index": 58,
      "english": "This a good place?",
      "speaker_id": 2421,
      "line_type": 2,
      "_offset": 13776,
      "_bytes": 18,
      "translation": "¿Este sitio vale?"
    },
    {
      "index": 59,
      "english": "A church? Well... it'll have to do\nfor now.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 13795,
      "_bytes": 43,
      "translation": "¿Una iglesia? Bueno, tendrá\nque valer."
    },
    {
      "index": 60,
      "english": "That's it!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 13839,
      "_bytes": 10,
      "translation": "¡Eso es!"
    },
    {
      "index": 61,
      "english": "What's up, Izzy?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 13850,
      "_bytes": 21,
      "translation": "¿Qué pasa, Izzy?"
    },
    {
      "index": 62,
      "english": "I was careless...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 13872,
      "_bytes": 17,
      "translation": "Fui descuidado..."
    },
    {
      "index": 63,
      "english": "Our enemies located our position \nfrom the signal I transmitted when \nI accessed their network...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 13890,
      "_bytes": 97,
      "translation": "Nuestros enemigos localizaron\nnuestra posición por la señal\nque emití al acceder a su red..."
    },
    {
      "index": 64,
      "english": "What a great time to be careless!\nNow we're here, while Kari is...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 13988,
      "_bytes": 68,
      "translation": "¡Vaya momento para\ndescuidarse! Ahora estamos\naquí, mientras Kari..."
    },
    {
      "index": 65,
      "english": "Hey there, Tai...",
      "speaker_id": 2421,
      "line_type": 2,
      "_offset": 14057,
      "_bytes": 20,
      "translation": "Oye, Tai..."
    },
    {
      "index": 66,
      "english": "What's wrong, Tai? You're not\nacting like yourself. Is it\nbecause of Kari?",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 14078,
      "_bytes": 79,
      "translation": "¿Qué te pasa, Tai? No pareces\ntú mismo. ¿Es por Kari?"
    },
    {
      "index": 67,
      "english": "Ah... I... I'm sorry...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 14158,
      "_bytes": 23,
      "translation": "Ah... lo siento..."
    },
    {
      "index": 68,
      "english": "Did something in particular\nhappen, Tai?",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 14182,
      "_bytes": 43,
      "translation": "¿Ha pasado algo en especial,\nTai?"
    },
    {
      "index": 69,
      "english": "Kari... almost died, once,\nbecause of me.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 14226,
      "_bytes": 43,
      "translation": "Kari... casi murió una vez\npor mi culpa."
    },
    {
      "index": 70,
      "english": "?!",
      "speaker_id": 9001,
      "line_type": 2,
      "_offset": 14270,
      "_bytes": 2,
      "translation": "?!"
    },
    {
      "index": 71,
      "english": "I was in second grade, and she was\nin kindergarten. She had a cold,\nso she couldn't go to school.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 14273,
      "_bytes": 97,
      "translation": "Yo estaba en segundo curso y\nella en preescolar. Tenía un\nresfriado y no podía ir al cole."
    },
    {
      "index": 72,
      "english": "She looked like she was doing\nbetter, so I took her outside to\nplay.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 14371,
      "_bytes": 68,
      "translation": "Parecía que estaba mejor, así\nque la saqué a jugar fuera."
    },
    {
      "index": 73,
      "english": "...",
      "speaker_id": 1041,
      "line_type": 4,
      "_offset": 14440,
      "_bytes": 3,
      "translation": "..."
    },
    {
      "index": 74,
      "english": "But instead, she was on the verge\nof death for 3 days 'til she was\ndischarged from the hospital.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 14444,
      "_bytes": 96,
      "translation": "Pero en vez de eso, estuvo al\nborde de la muerte 3 días\nhasta que le dieron el alta."
    },
    {
      "index": 75,
      "english": "And on that day, she said...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 14541,
      "_bytes": 28,
      "translation": "Y ese día, ella dijo..."
    },
    {
      "index": 76,
      "english": "\"Tai... I'm sorry I couldn't\nkick the ball very well.\"",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 14570,
      "_bytes": 57,
      "translation": "\"Tai... siento no haber sabido\nchutar bien el balón.\""
    },
    {
      "index": 77,
      "english": "Tai...",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 14628,
      "_bytes": 9,
      "translation": "Tai..."
    },
    {
      "index": 78,
      "english": "That's the kind of person she is!\nShe always puts others before\nherself!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 14638,
      "_bytes": 72,
      "translation": "¡Así es ella! ¡Siempre antepone\na los demás a sí\nmisma!"
    },
    {
      "index": 79,
      "english": "And if something's bothering her,\nshe won't say a thing until the \nend, no matter how much it hurts!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 14711,
      "_bytes": 100,
      "translation": "¡Y si algo le preocupa, no dice\nni una palabra hasta el final,\npor mucho que le duela!"
    },
    {
      "index": 80,
      "english": "And that's why she didn't tell us\nabout her illness until it was too\nlate...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 14812,
      "_bytes": 76,
      "translation": "Por eso no nos contó lo de su\nenfermedad hasta que fue\ndemasiado tarde..."
    },
    {
      "index": 81,
      "english": "Yeah... and I'm supposed to be\nkeeping a close eye on her, and\nyet...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 14889,
      "_bytes": 69,
      "translation": "Sí... y se supone que debo\ncuidar de ella de cerca, y\naun así..."
    },
    {
      "index": 82,
      "english": "Tai, you shouldn't blame\nyourself.",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 14959,
      "_bytes": 37,
      "translation": "Tai, no deberías culparte."
    },
    {
      "index": 83,
      "english": "That's right! So let's get the\nmedicine to her, as quickly as we\ncan!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 14997,
      "_bytes": 69,
      "translation": "¡Eso es! ¡Así que llevémosle\nla medicina cuanto antes!"
    },
    {
      "index": 84,
      "english": "Yeah... but how? We're completely\nsurrounded.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15067,
      "_bytes": 45,
      "translation": "Sí... ¿pero cómo? Estamos\ntotalmente rodeados."
    },
    {
      "index": 85,
      "english": "We won't be able to attack them\nhead-on, but we can use their own\ntactics against them.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 15113,
      "_bytes": 87,
      "translation": "No podremos atacarlos de\nfrente, pero podemos usar sus\npropias tácticas contra ellos."
    },
    {
      "index": 86,
      "english": "Whaddya mean by that, Izzy?",
      "speaker_id": 2421,
      "line_type": 2,
      "_offset": 15201,
      "_bytes": 32,
      "translation": "¿Qué quieres decir, Izzy?"
    },
    {
      "index": 87,
      "english": "We'll use a program that masks our\naccess point.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 15234,
      "_bytes": 48,
      "translation": "Un programa ocultará\nnuestro punto de acceso."
    },
    {
      "index": 88,
      "english": "With this, we will be able to pull\nthe wool over their eyes.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 15283,
      "_bytes": 60,
      "translation": "Así podremos engañarlos y\ntomarles el pelo."
    },
    {
      "index": 89,
      "english": "We've caught their point of\naddress! They're...",
      "speaker_id": 4492,
      "line_type": 2,
      "_offset": 15344,
      "_bytes": 47,
      "translation": "¡Hemos localizado su punto\nde acceso! Están..."
    },
    {
      "index": 90,
      "english": "Get to it! Tell me where they are,\nnow!",
      "speaker_id": 3071,
      "line_type": 2,
      "_offset": 15392,
      "_bytes": 39,
      "translation": "¡Vamos! ¡Dime dónde están,\nahora!"
    },
    {
      "index": 91,
      "english": "...I can't read this! The\nreactions are coming from all over\nthe map!",
      "speaker_id": 4492,
      "line_type": 2,
      "_offset": 15432,
      "_bytes": 69,
      "translation": "¡No puedo leer esto! ¡Las\nreacciones vienen de todo\nel mapa!"
    },
    {
      "index": 92,
      "english": "...",
      "speaker_id": 3071,
      "line_type": 2,
      "_offset": 15502,
      "_bytes": 3,
      "translation": "..."
    },
    {
      "index": 93,
      "english": "There's the house! We're here,\nKari!",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 15506,
      "_bytes": 38,
      "translation": "¡Ahí está la casa! ¡Ya\nllegamos, Kari!"
    },
    {
      "index": 94,
      "english": "Kari!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15545,
      "_bytes": 7,
      "translation": "¡Kari!"
    },
    {
      "index": 95,
      "english": "Aaaaaaaah!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15553,
      "_bytes": 10,
      "translation": "¡Aaaaaah!"
    },
    {
      "index": 96,
      "english": "No...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 15564,
      "_bytes": 5,
      "translation": "No..."
    },
    {
      "index": 97,
      "english": "N-No way... Kari...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15570,
      "_bytes": 21,
      "translation": "Imposible... Kari..."
    },
    {
      "index": 98,
      "english": "Was that a missile?!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 15592,
      "_bytes": 20,
      "translation": "¡¿Ha sido un misil?!"
    },
    {
      "index": 99,
      "english": "Huh?!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15613,
      "_bytes": 5,
      "translation": "¡¿Eh?!"
    },
    {
      "index": 100,
      "english": "!!",
      "speaker_id": 9001,
      "line_type": 2,
      "_offset": 15619,
      "_bytes": 2,
      "translation": "!!"
    },
    {
      "index": 101,
      "english": "Angemon!",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 15622,
      "_bytes": 8,
      "translation": "¡Angemon!"
    },
    {
      "index": 102,
      "english": "Angemon!",
      "speaker_id": 2421,
      "line_type": 2,
      "_offset": 15631,
      "_bytes": 8,
      "translation": "¡Angemon!"
    },
    {
      "index": 103,
      "english": "Tai! Are you okay?",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 15640,
      "_bytes": 21,
      "translation": "¡Tai! ¿Estás bien?"
    },
    {
      "index": 104,
      "english": "T.K!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15662,
      "_bytes": 7,
      "translation": "¡T.K.!"
    },
    {
      "index": 105,
      "english": "Kari!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15670,
      "_bytes": 7,
      "translation": "¡Kari!"
    },
    {
      "index": 106,
      "english": "So you were safe after all!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 15678,
      "_bytes": 27,
      "translation": "¡Así que estabas a salvo!"
    },
    {
      "index": 107,
      "english": "See? I protected everyone like I\nsaid I would, Tai!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 15706,
      "_bytes": 54,
      "translation": "¿Ves? ¡Protegí a todos como\ndije que haría, Tai!"
    },
    {
      "index": 108,
      "english": "Great job, T.K!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15761,
      "_bytes": 18,
      "translation": "¡Bien hecho, T.K.!"
    },
    {
      "index": 109,
      "english": "!!",
      "speaker_id": 9001,
      "line_type": 2,
      "_offset": 15780,
      "_bytes": 2,
      "translation": "!!"
    },
    {
      "index": 110,
      "english": "It's Mugendramon!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 15783,
      "_bytes": 17,
      "translation": "¡Es Machinedramon!"
    },
    {
      "index": 111,
      "english": "Guys, run for it!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15801,
      "_bytes": 17,
      "translation": "¡Corred, chicos!"
    },
    {
      "index": 112,
      "english": "This is where you will meet your\nend, Chosen Children! Infinity\nCannon!",
      "speaker_id": 3071,
      "line_type": 2,
      "_offset": 15819,
      "_bytes": 71,
      "translation": "¡Aquí es donde encontraréis\nvuestro fin, Niños Elegidos!\n¡Cañón Infinito!"
    },
    {
      "index": 113,
      "english": "Gyaaaaah!",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 15891,
      "_bytes": 9,
      "translation": "¡Gyaaaah!"
    },
    {
      "index": 114,
      "english": "Aaaaaaaah!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 15901,
      "_bytes": 10,
      "translation": "¡Aaaaaaah!"
    },
    {
      "index": 115,
      "english": "Tai!",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 15912,
      "_bytes": 7,
      "translation": "¡Tai!"
    },
    {
      "index": 116,
      "english": "Kariiiiiiii!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15920,
      "_bytes": 14,
      "translation": "¡Kariiiiiiii!"
    },
    {
      "index": 117,
      "english": "Tai, let's look for somewhere\nwe can find medicine.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 15935,
      "_bytes": 54,
      "translation": "Tai, busquemos algún sitio\ndonde encontrar medicinas."
    },
    {
      "index": 118,
      "english": "Okay!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15990,
      "_bytes": 5,
      "translation": "¡Vale!"
    },
    {
      "index": 119,
      "english": "It's a church... I don't think\nwe'll find any medicine here.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 15996,
      "_bytes": 60,
      "translation": "Es una iglesia... no creo que\nencontremos medicinas aquí."
    },
    {
      "index": 120,
      "english": "Let's look elsewhere!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16057,
      "_bytes": 21,
      "translation": "¡Vayamos a otro sitio!"
    },
    {
      "index": 121,
      "english": "It's dangerous to go back to the\nhospital! We need to find a place\nto hide!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 16079,
      "_bytes": 75,
      "translation": "¡Es peligroso volver al\nhospital! ¡Necesitamos un\nsitio donde escondernos!"
    },
    {
      "index": 122,
      "english": "Ugh! Right when we'd gotten the\nmedicine...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16155,
      "_bytes": 43,
      "translation": "Justo cuando conseguimos\nla medicina..."
    },
    {
      "index": 123,
      "english": "The enemy is confused! Now's our\nchance!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 16199,
      "_bytes": 40,
      "translation": "¡Están confusos! ¡Es\nnuestra oportunidad!"
    },
    {
      "index": 124,
      "english": "We need to hurry over to the\nhouse!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16240,
      "_bytes": 35,
      "translation": "¡Hay que llegar rápido a\nla casa!"
    },
    {
      "index": 125,
      "english": "An ambush... they're trying to\nblock our escape routes!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 16276,
      "_bytes": 55,
      "translation": "¡Una emboscada... intentan\nbloquear nuestra huida!"
    },
    {
      "index": 126,
      "english": "We won't be able to get to the\nhouse at this rate.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16332,
      "_bytes": 50,
      "translation": "Así no llegaremos nunca a\nla casa."
    },
    {
      "index": 127,
      "english": "Tai, we need to find a place to\nhide for now!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 16383,
      "_bytes": 48,
      "translation": "Tai, ¡busquemos un sitio\ndonde escondernos!"
    }
  ]
}