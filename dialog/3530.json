      "_length": 43,
      "speaker_id": 146,
      "translation": ""
    },
    {
      "index": 39,
      "english": "I wonder if there's land across\nthe sea?",
      "_offset": 6177,
      "_length": 40,
      "speaker_id": 194,
      "translation": ""
    },
    {
      "index": 40,
      "english": "We can't go there anyway.",
