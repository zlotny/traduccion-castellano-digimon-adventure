      "_length": 29,
      "speaker_id": 215,
      "translation": ""
    },
    {
      "index": 25,
      "english": "It's taking a while to defeat\nthem.",
      "_offset": 5687,
      "_length": 35,
      "speaker_id": 251,
      "translation": ""
    },
    {
      "index": 26,
      "english": "Then *you're* the one who needs\ndefeating!",
      "_offset": 5723,
      "_length": 42,
      "speaker_id": 40,
      "translation": ""
    },
    {
      "index": 27,
      "english": "Fist of the Beast King!",
