{
  "file_id": "3530",
  "format": "etdf",
  "kind": "ETDF",
  "text_count": 92,
  "dialog": [
    {
      "index": 0,
      "english": "Just a bit more and we'll be at\nthe top!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 11528,
      "_bytes": 40,
      "translation": "¡Sólo un poco más y estaremos en\nla cima!"
    },
    {
      "index": 1,
      "english": "I can't walk any further! I'll\njust wait here.",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 11569,
      "_bytes": 46,
      "translation": "¡No puedo caminar más! Esperaré\naquí."
    },
    {
      "index": 2,
      "english": "I can't walk any further! I'll\njust wait here.",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 11616,
      "_bytes": 46,
      "translation": "¡No puedo caminar más! Esperaré\naquí."
    },
    {
      "index": 3,
      "english": "Don't give up, Mimi! You can do\nit!",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 11663,
      "_bytes": 35,
      "translation": "¡No te rindas, Mimi! ¡Puedes\nhacerlo!"
    },
    {
      "index": 4,
      "english": "Yeah, just hang in there a bit\nlonger, okay?",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 11699,
      "_bytes": 44,
      "translation": "Sí, aguanta un poco más, ¿vale?"
    },
    {
      "index": 5,
      "english": "Okay, just a little more...",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 11744,
      "_bytes": 27,
      "translation": "Venga, un poco más..."
    },
    {
      "index": 6,
      "english": "(Nice going, Joe!)",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 11772,
      "_bytes": 18,
      "translation": "(¡Bien, Joe!)"
    },
    {
      "index": 7,
      "english": "(Nice going, Joe!)",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 11791,
      "_bytes": 18,
      "translation": "(¡Bien, Joe!)"
    },
    {
      "index": 8,
      "english": "(Nice going, Joe!)",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 11810,
      "_bytes": 18,
      "translation": "(¡Bien, Joe!)"
    },
    {
      "index": 9,
      "english": "We did it!",
      "speaker_id": 9001,
      "line_type": 2,
      "_offset": 11829,
      "_bytes": 10,
      "translation": "¡Hecho!"
    },
    {
      "index": 10,
      "english": "We're at the top!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 11840,
      "_bytes": 17,
      "translation": "¡La cima!"
    },
    {
      "index": 11,
      "english": "This is...!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 11858,
      "_bytes": 11,
      "translation": "¡Esto es...!"
    },
    {
      "index": 12,
      "english": "Tai? Do you see anything?",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 11870,
      "_bytes": 28,
      "translation": "¿Tai? ¿Ves algo?"
    },
    {
      "index": 13,
      "english": "I can't believe it...we're on an\nisland in the middle of the sea.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 11899,
      "_bytes": 65,
      "translation": "No me lo creo... Estamos en una\nisla en el medio del mar."
    },
    {
      "index": 14,
      "english": "Another black gear. If I don't do\nsomething now...",
      "speaker_id": 4071,
      "line_type": 2,
      "_offset": 11965,
      "_bytes": 50,
      "translation": "Otra rueda negra. Si no hacemos\nalgo..."
    },
    {
      "index": 15,
      "english": "Good kids shouldn't hang around\nhere! Scram!",
      "speaker_id": 4061,
      "line_type": 2,
      "_offset": 12016,
      "_bytes": 44,
      "translation": "¡Los niños buenos no deben\nestar aquí! ¡Fuera!"
    },
    {
      "index": 16,
      "english": "Good kids shouldn't hang around\nhere! Scram!",
      "speaker_id": 4061,
      "line_type": 2,
      "_offset": 12061,
      "_bytes": 44,
      "translation": "¡Los niños buenos no deben\nestar aquí! ¡Fuera!"
    },
    {
      "index": 17,
      "english": "Ogremon, now's not the time to\nsettle our feud.",
      "speaker_id": 4071,
      "line_type": 2,
      "_offset": 12106,
      "_bytes": 47,
      "translation": "Ogremon, no es el momento\nde nuestro duelo."
    },
    {
      "index": 18,
      "english": "The black gears raining down from\nthat mountain are making Digimon\ngo crazy!",
      "speaker_id": 4071,
      "line_type": 2,
      "_offset": 12154,
      "_bytes": 76,
      "translation": "¡Esas ruedas negras que salen de\nla montaña hacen que los Digimon\nenloquezcan!"
    },
    {
      "index": 19,
      "english": "Oh, just drop dead!\nFist of the Tyrant!",
      "speaker_id": 4061,
      "line_type": 2,
      "_offset": 12231,
      "_bytes": 39,
      "translation": "¡Bah, muérete!\n¡Puño Imperial!"
    },
    {
      "index": 20,
      "english": "Oh, just drop dead!\nFist of the Tyrant!",
      "speaker_id": 4061,
      "line_type": 2,
      "_offset": 12271,
      "_bytes": 39,
      "translation": "¡Bah, muérete!\n¡Puño Imperial!"
    },
    {
      "index": 21,
      "english": "Fist of the Beast King!",
      "speaker_id": 4071,
      "line_type": 2,
      "_offset": 12311,
      "_bytes": 23,
      "translation": "¡Puño Real!"
    },
    {
      "index": 22,
      "english": "Stop your fighting.",
      "speaker_id": 9002,
      "line_type": 2,
      "_offset": 12335,
      "_bytes": 19,
      "translation": "Dejad de luchar."
    },
    {
      "index": 23,
      "english": "!!",
      "speaker_id": 4061,
      "line_type": 2,
      "_offset": 12355,
      "_bytes": 2,
      "translation": "!!"
    },
    {
      "index": 24,
      "english": "The Chosen Children have arrived.",
      "speaker_id": 3011,
      "line_type": 2,
      "_offset": 12358,
      "_bytes": 33,
      "translation": "Los Niños Elegidos han llegado."
    },
    {
      "index": 25,
      "english": "The Children?! It can't be...",
      "speaker_id": 4071,
      "line_type": 2,
      "_offset": 12392,
      "_bytes": 29,
      "translation": "¡¿Los Niños?! No puede ser..."
    },
    {
      "index": 26,
      "english": "It's taking a while to defeat\nthem.",
      "speaker_id": 3011,
      "line_type": 2,
      "_offset": 12422,
      "_bytes": 35,
      "translation": "Está tardando en\neliminarlos."
    },
    {
      "index": 27,
      "english": "Then *you're* the one who needs\ndefeating!",
      "speaker_id": 4071,
      "line_type": 2,
      "_offset": 12458,
      "_bytes": 42,
      "translation": "¡Tú eres el que necesita ser\neliminado!"
    },
    {
      "index": 28,
      "english": "Fist of the Beast King!",
      "speaker_id": 4071,
      "line_type": 2,
      "_offset": 12501,
      "_bytes": 23,
      "translation": "¡Puño Real!"
    },
    {
      "index": 29,
      "english": "What?!",
      "speaker_id": 4071,
      "line_type": 2,
      "_offset": 12525,
      "_bytes": 6,
      "translation": "¡¿Qué?!"
    },
    {
      "index": 30,
      "english": "Do you really think that will\ndefeat me?",
      "speaker_id": 3011,
      "line_type": 2,
      "_offset": 12532,
      "_bytes": 40,
      "translation": "¿Pensabas que eso me iba a\nderrotar?"
    },
    {
      "index": 31,
      "english": "Death Claw!",
      "speaker_id": 3011,
      "line_type": 2,
      "_offset": 12573,
      "_bytes": 11,
      "translation": "¡Garra Mortal!"
    },
    {
      "index": 32,
      "english": "Nghaaaaaaah!",
      "speaker_id": 4071,
      "line_type": 2,
      "_offset": 12585,
      "_bytes": 12,
      "translation": "¡Nghaaaaaaah!"
    },
    {
      "index": 33,
      "english": "Receive my baptism of evil!",
      "speaker_id": 3011,
      "line_type": 2,
      "_offset": 12598,
      "_bytes": 27,
      "translation": "¡Te bautizo en la maldad!"
    },
    {
      "index": 34,
      "english": "Kill...the Chosen Children!",
      "speaker_id": 4071,
      "line_type": 2,
      "_offset": 12626,
      "_bytes": 27,
      "translation": "Matar... ¡Niños Elegidos!"
    },
    {
      "index": 35,
      "english": "But hey, we can't give up. Should\nI make a map?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 12654,
      "_bytes": 47,
      "translation": "Eh, no podemos rendirnos. ¿Hago\nun mapa?"
    },
    {
      "index": 36,
      "english": "Are you good at drawing, Tai?\nMaybe you should ask the others\nfor help.",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 12702,
      "_bytes": 74,
      "translation": "¿Sabes dibujar, Tai? Quizás\npodrías preguntar a los demás."
    },
    {
      "index": 37,
      "english": "It doesn't have to be that good!\nBut yeah, maybe I'll do that\nfirst.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 12777,
      "_bytes": 68,
      "translation": "¡No tiene que ser tan bueno! Pero\nsí, creo que haré eso primero."
    },
    {
      "index": 38,
      "english": "So what do we do now?",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 12846,
      "_bytes": 21,
      "translation": "¿Y qué hacemos ahora?"
    },
    {
      "index": 39,
      "english": "Even with Birdramon, it'll be\nimpossible...",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 12868,
      "_bytes": 43,
      "translation": "Incluso con Birdramon, será\nimposible..."
    },
    {
      "index": 40,
      "english": "I wonder if there's land across\nthe sea?",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 12912,
      "_bytes": 40,
      "translation": "Me pregunto si habrá tierra al\notro lado del mar."
    },
    {
      "index": 41,
      "english": "We can't go there anyway.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 12953,
      "_bytes": 25,
      "translation": "No podemos ir igualmente."
    },
    {
      "index": 42,
      "english": "We should just wait for help...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 12979,
      "_bytes": 31,
      "translation": "Deberíamos esperar ayuda..."
    },
    {
      "index": 43,
      "english": "Even if there is, we can't travel\nacross the sea.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 13011,
      "_bytes": 49,
      "translation": "Incluso si hay, no podemos viajar\npor el mar."
    },
    {
      "index": 44,
      "english": "You're right. We can't be troubled\nby things we have no clue about.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 13061,
      "_bytes": 67,
      "translation": "Tienes razón. No deberíamos\npreocuparnos por lo que no\nsabemos."
    },
    {
      "index": 45,
      "english": "Maybe we should just wait on this\nisland for help...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 13129,
      "_bytes": 52,
      "translation": "Quizás deberíamos esperar ayuda\nen la isla..."
    },
    {
      "index": 46,
      "english": "But can we really live in this\nworld?",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 13182,
      "_bytes": 37,
      "translation": "¿Pero podríamos vivir en este\nmundo?"
    },
    {
      "index": 47,
      "english": "Izzy, I was just...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 13220,
      "_bytes": 24,
      "translation": "Izzy, yo solo..."
    },
    {
      "index": 48,
      "english": "I'm sorry, Tai. I know you were\njust trying to encourage me.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 13245,
      "_bytes": 63,
      "translation": "Disculpa, Tai. Ya sé que sólo\nquerías animarme."
    },
    {
      "index": 49,
      "english": "Why'd it have to turn out like\nthis?",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 13309,
      "_bytes": 36,
      "translation": "¿Por qué tiene que ser todo así?"
    },
    {
      "index": 50,
      "english": "Haaah, I'm tired.",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 13346,
      "_bytes": 17,
      "translation": "Haaa... Estoy cansado."
    },
    {
      "index": 51,
      "english": "So it really is an island\nsurrounded by the sea...",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 13364,
      "_bytes": 50,
      "translation": "Así que una isla rodeada de\nmar..."
    },
    {
      "index": 52,
      "english": "Tai, are you done consulting\neveryone?",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 13415,
      "_bytes": 41,
      "translation": "Tai, ¿ya pediste opinión a todos?"
    },
    {
      "index": 53,
      "english": "(What should I do...?)",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 13457,
      "_bytes": 22,
      "translation": "(¿Qué debería...?)"
    },
    {
      "index": 54,
      "english": "Let's go down the mountain.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 13480,
      "_bytes": 27,
      "translation": "Bajemos la montaña."
    },
    {
      "index": 55,
      "english": "Let me talk to everyone else.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 13508,
      "_bytes": 29,
      "translation": "Déjame hablar con el resto."
    },
    {
      "index": 56,
      "english": "Guys, let's go down the mountain!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 13538,
      "_bytes": 33,
      "translation": "Chicos, ¡bajemos la montaña!"
    },
    {
      "index": 57,
      "english": "Yeah, we'll just have to go down\nfor now.",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 13572,
      "_bytes": 41,
      "translation": "Sí, deberíamos bajar por ahora."
    },
    {
      "index": 58,
      "english": "...",
      "speaker_id": 4071,
      "line_type": 2,
      "_offset": 13614,
      "_bytes": 3,
      "translation": "..."
    },
    {
      "index": 59,
      "english": "It's Leomon!",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 13618,
      "_bytes": 12,
      "translation": "¡Es Leomon!"
    },
    {
      "index": 60,
      "english": "Who's Leomon?",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 13631,
      "_bytes": 13,
      "translation": "¿Leomon?"
    },
    {
      "index": 61,
      "english": "He's a really strong,\njustice-minded Digimon!",
      "speaker_id": 2221,
      "line_type": 2,
      "_offset": 13645,
      "_bytes": 45,
      "translation": "¡Un Digimon justiciero!\n¡Y fuerte!"
    },
    {
      "index": 62,
      "english": "Kill...the children!",
      "speaker_id": 4071,
      "line_type": 2,
      "_offset": 13691,
      "_bytes": 20,
      "translation": "¡Matar... a los niños!"
    },
    {
      "index": 63,
      "english": "Then why's he attacking us all of\na sudden? Run!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 13712,
      "_bytes": 48,
      "translation": "¿Y por qué nos ataca así de\nrepente? ¡Corred!"
    },
    {
      "index": 64,
      "english": "Hahaha! Welcome!",
      "speaker_id": 4061,
      "line_type": 2,
      "_offset": 13761,
      "_bytes": 16,
      "translation": "¡Bienvenidos!"
    },
    {
      "index": 65,
      "english": "Hahaha! Welcome!",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 13778,
      "_bytes": 16,
      "translation": "¡Bienvenidos!"
    },
    {
      "index": 66,
      "english": "Hahaha! Welcome!",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 13795,
      "_bytes": 16,
      "translation": "¡Bienvenidos!"
    },
    {
      "index": 67,
      "english": "!!",
      "speaker_id": 9001,
      "line_type": 2,
      "_offset": 13812,
      "_bytes": 2,
      "translation": "!!"
    },
    {
      "index": 68,
      "english": "This one's Ogremon!",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 13815,
      "_bytes": 19,
      "translation": "¡Ese es Ogremon!"
    },
    {
      "index": 69,
      "english": "He's a legitimately bad Digimon!",
      "speaker_id": 2621,
      "line_type": 2,
      "_offset": 13835,
      "_bytes": 32,
      "translation": "¡Es un Digimon malo de verdad!"
    },
    {
      "index": 70,
      "english": "Uh-oh! We're trapped!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 13868,
      "_bytes": 21,
      "translation": "¡Estamos atrapados!"
    },
    {
      "index": 71,
      "english": "Looks like we've got no other\nchoice, then!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 13890,
      "_bytes": 43,
      "translation": "¡No nos queda otra, entonces!"
    },
    {
      "index": 72,
      "english": "Gh...The children...",
      "speaker_id": 4071,
      "line_type": 2,
      "_offset": 13934,
      "_bytes": 20,
      "translation": "Gh... Los niños..."
    },
    {
      "index": 73,
      "english": "Looks like you took a beating,\nLeomon! Get out of the way, I'll\nbe their opponent!",
      "speaker_id": 4061,
      "line_type": 2,
      "_offset": 13955,
      "_bytes": 82,
      "translation": "¡Menuda paliza te han dado,\nLeomon! ¡Quítate de en medio, yo\nseré su oponente!"
    },
    {
      "index": 74,
      "english": "He's coming this way!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 14038,
      "_bytes": 21,
      "translation": "¡Viene por aquí!"
    },
    {
      "index": 75,
      "english": "It really is a pain fighting six\nof them at once.",
      "speaker_id": 3011,
      "line_type": 2,
      "_offset": 14060,
      "_bytes": 49,
      "translation": "Es una molestia luchar contra\nseis a la vez."
    },
    {
      "index": 76,
      "english": "It really is a pain fighting six\nof them at once.",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 14110,
      "_bytes": 49,
      "translation": "Es una molestia luchar contra\nseis a la vez."
    },
    {
      "index": 77,
      "english": "It really is a pain fighting six\nof them at once.",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 14160,
      "_bytes": 49,
      "translation": "Es una molestia luchar contra\nseis a la vez."
    },
    {
      "index": 78,
      "english": "!!",
      "speaker_id": 9001,
      "line_type": 2,
      "_offset": 14210,
      "_bytes": 2,
      "translation": "!!"
    },
    {
      "index": 79,
      "english": "W-what's this?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 14213,
      "_bytes": 14,
      "translation": "¿Qué es esto?"
    },
    {
      "index": 80,
      "english": "It's a landslide!",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 14228,
      "_bytes": 17,
      "translation": "¡Un derrumbe!"
    },
    {
      "index": 81,
      "english": "It's a landslide!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 14246,
      "_bytes": 17,
      "translation": "¡Un derrumbe!"
    },
    {
      "index": 82,
      "english": "It's a landslide!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 14264,
      "_bytes": 17,
      "translation": "¡Un derrumbe!"
    },
    {
      "index": 83,
      "english": "Whoaaaaaaaaa!",
      "speaker_id": 9001,
      "line_type": 2,
      "_offset": 14282,
      "_bytes": 13,
      "translation": "¡Uaaaah!"
    },
    {
      "index": 84,
      "english": "Everyone! Are you guys okay?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 14296,
      "_bytes": 28,
      "translation": "¿¡Estáis todos bien!?"
    },
    {
      "index": 85,
      "english": "We're okay!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 14325,
      "_bytes": 11,
      "translation": "¡Sí!"
    },
    {
      "index": 86,
      "english": "What about Leomon and Ogremon?",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 14337,
      "_bytes": 30,
      "translation": "¿Y Leomon y Ogremon?"
    },
    {
      "index": 87,
      "english": "They must have gotten caught in\nthe cliff collapsing!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 14368,
      "_bytes": 53,
      "translation": "¡Los habrá pillado el derrumbe!"
    },
    {
      "index": 88,
      "english": "Doesn't look like they could fly\nfrom here.",
      "speaker_id": 1031,
      "line_type": 2,
