      "_length": 23,
      "speaker_id": 68,
      "translation": ""
    },
    {
      "index": 28,
      "english": "What?!",
      "_offset": 5790,
      "_length": 6,
      "speaker_id": 87,
      "translation": ""
    },
    {
      "index": 29,
      "english": "Do you really think that will\ndefeat me?",
      "_offset": 5797,
      "_length": 40,
      "speaker_id": 106,
      "translation": ""
    },
    {
      "index": 30,
      "english": "Death Claw!",
