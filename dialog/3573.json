      "index": 127,
      "english": "Yeah!",
      "_offset": 9248,
      "_length": 5,
      "speaker_id": 0,
      "translation": "Sí!"
    },
    {
      "index": 128,
      "english": "You've been rambling on and on\nabout this for way too long! Hurry\nup and get in the beach hut!",
      "_offset": 9254,
      "_length": 94,
      "speaker_id": 0,
      "translation": "Llevas dándole vueltas\ndemasiado tiempo! Entra\nde una vez en la cabaña!"
