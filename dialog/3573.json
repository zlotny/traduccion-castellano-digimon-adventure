      "index": 119,
      "english": "Heehee...",
      "_offset": 8908,
      "_length": 9,
      "speaker_id": 0,
      "translation": "Jiji..."
    },
    {
      "index": 120,
      "english": "Whaaaaat?! You're not gonna eat\nthe curry rice?",
      "_offset": 8918,
      "_length": 47,
      "speaker_id": 0,
      "translation": "Quéeee?! No vas a comer\nel curry?"
    },
    {
      "index": 121,
      "english": "We're just gonna pop in for a bit,\nright, Joe? You're worrying way\ntoo much.",
      "_offset": 8966,
      "_length": 76,
      "speaker_id": 0,
      "translation": "Solo vamos a entrar un momento,\nverdad, Joe? Te preocupas\ndemasiado."
    },
    {
      "index": 122,
      "english": "I have, up until now, and it's\nbeen for the better! But now's not\nthe time to be arguing about that!",
      "_offset": 9043,
      "_length": 100,
      "speaker_id": 0,
      "translation": "Y hasta ahora nos ha ido\nbien! Pero no es momento\nde discutir sobre eso!"
