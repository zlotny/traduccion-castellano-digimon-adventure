      "_offset": 10672,
      "_length": 36,
      "speaker_id": 0,
      "translation": "Quizá deberíamos descansar\nmás..."
    },
    {
      "index": 166,
      "english": "This isn't the time to be resting!",
      "_offset": 10709,
      "_length": 34,
      "speaker_id": 0,
      "translation": "No es momento de descansar!"
    }
  ]
