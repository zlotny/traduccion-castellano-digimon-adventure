      "index": 111,
      "english": "Looks like we knocked him out!",
      "_offset": 8555,
      "_length": 30,
      "speaker_id": 0,
      "translation": "Parece que lo noqueamos!"
    },
    {
      "index": 112,
      "english": "All right, let's save everyone\nwhile we have the chance!",
      "_offset": 8586,
      "_length": 56,
      "speaker_id": 0,
      "translation": "Bien, salvemos a todos\nmientras podamos!"
    },
    {
      "index": 113,
      "english": "Tai! Guys!",
      "_offset": 8643,
      "_length": 13,
      "speaker_id": 0,
      "translation": "Tai! Chicos!"
    },
    {
      "index": 114,
      "english": "Y-You saved us, Joe...",
      "_offset": 8657,
      "_length": 22,
      "speaker_id": 0,
      "translation": "N-nos salvaste, Joe..."
    },
    {
      "index": 115,
      "english": "When he started taking away our\nenergy, we were gonna be done\nfor...",
      "_offset": 8680,
      "_length": 68,
      "speaker_id": 0,
      "translation": "Cuando empezó a quitarnos\nla energía, estábamos\nacabados..."
    },
    {
      "index": 116,
      "english": "Sorry, Joe, this wouldn't have\nhappened if we'd listened to\nyou...",
      "_offset": 8749,
      "_length": 66,
      "speaker_id": 0,
      "translation": "Perdón, Joe, esto no habría\npasado si te hubiéramos\nhecho caso..."
    },
    {
      "index": 117,
      "english": "It's my fault, really. I should\nhave been more emphatic about\nholding you guys back.",
      "_offset": 8816,
      "_length": 84,
      "speaker_id": 0,
      "translation": "Es culpa mía, en serio.\nDebí insistir más en\nque no fuerais."
