      "english": "Huh? Yeah, but if we do, the Dark\nMasters might...",
      "_offset": 10389,
      "_length": 50,
      "speaker_id": 0,
      "translation": "Eh? Sí, pero si lo hacemos,\nlos Amos Oscuros..."
    },
    {
      "index": 157,
      "english": "Sora's right, Tai. It should be\nfine if we rest a bit.",
      "_offset": 10440,
      "_length": 57,
      "speaker_id": 0,
      "translation": "Sora tiene razón, Tai.\nPodemos descansar un poco."
    },
    {
      "index": 158,
      "english": "Yeah, you're right.",
      "_offset": 10498,
      "_length": 19,
      "speaker_id": 0,
      "translation": "Sí, tienes razón."
    },
