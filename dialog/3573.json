    {
      "index": 130,
      "english": "He must be one of the Dark\nMasters' minions!",
      "_offset": 9363,
      "_length": 44,
      "speaker_id": 0,
      "translation": "Debe de ser un esbirro\nde los Amos Oscuros!"
    },
    {
      "index": 131,
      "english": "So the beach hut was a trap after\nall?!",
      "_offset": 9408,
      "_length": 39,
      "speaker_id": 0,
      "translation": "Así que la cabaña era\nuna trampa?!"
    },
    {
      "index": 132,
      "english": "Now that it's come to this, I'll\nhave to take your energy after I\ndefeat you!",
      "_offset": 9448,
      "_length": 77,
      "speaker_id": 0,
      "translation": "Ya que hemos llegado a esto,\nos quitaré la energía\ndespués de venceros!"
