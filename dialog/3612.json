{
  "file_id": "3612",
  "format": "etdf",
  "kind": "ETDF",
  "text_count": 35,
  "dialog": [
    {
      "index": 0,
      "english": "We defeated MetalSeadramon, but...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 5784,
      "_bytes": 34,
      "translation": "Vencimos a MetalSeadramon, pero..."
    },
    {
      "index": 1,
      "english": "...at a horrible cost.",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 5819,
      "_bytes": 22,
      "translation": "...a un alto precio."
    },
    {
      "index": 2,
      "english": "He was always doing things for us,\nbut we couldn't do anything...",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 5842,
      "_bytes": 65,
      "translation": "Siempre hacía cosas por\nnosotros, pero no pudimos\nhacer nada..."
    },
    {
      "index": 3,
      "english": "Mimi...",
      "speaker_id": 2521,
      "line_type": 2,
      "_offset": 5908,
      "_bytes": 7,
      "translation": "Mimi..."
    },
    {
      "index": 4,
      "english": "Guys, I think we should make a\ngrave for Whamon.",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 5916,
      "_bytes": 48,
      "translation": "Deberíamos hacerle una\ntumba a Whamon, chicos."
    },
    {
      "index": 5,
      "english": "I agree.",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 5965,
      "_bytes": 8,
      "translation": "Vale."
    },
    {
      "index": 6,
      "english": "Me, too.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 5974,
      "_bytes": 8,
      "translation": "Yo también."
    },
    {
      "index": 7,
      "english": "Yeah, let me help, too!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 5983,
      "_bytes": 23,
      "translation": "¡Sí, yo también ayudo!"
    },
    {
      "index": 8,
      "english": "Thanks, guys!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 6007,
      "_bytes": 13,
      "translation": "¡Gracias!"
    },
    {
      "index": 9,
      "english": "All right, Mimi! Let's gather\nflowers for Whamon.",
      "speaker_id": 2521,
      "line_type": 2,
      "_offset": 6021,
      "_bytes": 49,
      "translation": "¡Vale, Mimi! Vamos a\nrecoger flores para Whamon."
    },
    {
      "index": 10,
      "english": "We met Whamon on our way to Server\nContinent...",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 6071,
      "_bytes": 47,
      "translation": "Conocimos a Whamon camino\nal Continente Server..."
    },
    {
      "index": 11,
      "english": "Mimi...",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 6119,
      "_bytes": 7,
      "translation": "Mimi..."
    },
    {
      "index": 12,
      "english": "If we hadn't met Whamon, we\nprobably wouldn't have made it to\nServer Continent...",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 6127,
      "_bytes": 81,
      "translation": "Si no hubiéramos conocido a\nWhamon, no habríamos llegado\nal Continente Server..."
    },
    {
      "index": 13,
      "english": "We could have been lost at sea...",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 6209,
      "_bytes": 33,
      "translation": "Podríamos habernos perdido..."
    },
    {
      "index": 14,
      "english": "He was also the one who told us\nwhere to find the tags that\nDevimon hid...",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 6243,
      "_bytes": 74,
      "translation": "También nos dijo dónde\nencontrar los Circuitos que\nescondió Devimon..."
    },
    {
      "index": 15,
      "english": "You're right...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 6318,
      "_bytes": 15,
      "translation": "Tienes razón..."
    },
    {
      "index": 16,
      "english": "And he protected us from\nMetalSeadramon...",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 6334,
      "_bytes": 42,
      "translation": "Y nos protegió de\nMetalSeadramon..."
    },
    {
      "index": 17,
      "english": "Whamon...",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 6377,
      "_bytes": 9,
      "translation": "Whamon..."
    },
    {
      "index": 18,
      "english": "Please watch over us from the sea,\nWhamon...",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 6387,
      "_bytes": 44,
      "translation": "Cuídanos desde el mar,\nWhamon..."
    },
    {
      "index": 19,
      "english": "Let's do our best for Whamon's\nsake, Mimi!",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 6432,
      "_bytes": 42,
      "translation": "¡Démoslo todo por Whamon,\nMimi!"
    },
    {
      "index": 20,
      "english": "I'll always remember Whamon...",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 6475,
      "_bytes": 30,
      "translation": "Siempre recordaré a Whamon..."
    },
    {
      "index": 21,
      "english": "...",
      "speaker_id": 9001,
      "line_type": 4,
      "_offset": 6506,
      "_bytes": 3,
      "translation": "..."
    },
    {
      "index": 22,
      "english": "Whamon!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 6510,
      "_bytes": 7,
      "translation": "¡Whamon!"
    },
    {
      "index": 23,
      "english": "Mimi...",
      "speaker_id": 2521,
      "line_type": 2,
      "_offset": 6518,
      "_bytes": 7,
      "translation": "Mimi..."
    },
    {
      "index": 24,
      "english": "This is...",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 6526,
      "_bytes": 10,
      "translation": "Esto es..."
    },
    {
      "index": 25,
      "english": "Palmon... I feel like I can hear\nWhamon's voice...",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 6537,
      "_bytes": 50,
      "translation": "Palmon... creo que oigo la\nvoz de Whamon..."
    },
    {
      "index": 26,
      "english": "Yeah, he's probably watching over\nus right now.",
      "speaker_id": 2521,
      "line_type": 2,
      "_offset": 6588,
      "_bytes": 47,
      "translation": "Sí, seguro que nos está\ncuidando ahora mismo."
    },
    {
      "index": 27,
      "english": "This must be Whamon's gift to us.",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 6636,
      "_bytes": 33,
      "translation": "Debe de ser el regalo de Whamon."
    },
    {
      "index": 28,
      "english": "Yeah...",
      "speaker_id": 2521,
      "line_type": 2,
      "_offset": 6670,
      "_bytes": 7,
      "translation": "Sí..."
    },
    {
      "index": 29,
      "english": "Mimi, let's go.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 6678,
      "_bytes": 15,
      "translation": "Mimi, vamos."
    },
    {
      "index": 30,
      "english": "We'll meet again, Whamon! We'll\nput an end to this fight for sure.",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 6694,
      "_bytes": 66,
      "translation": "¡Nos volveremos a ver, Whamon!\nAcabaremos con esto, seguro."
    },
    {
      "index": 31,
      "english": "All right, Mimi! Let's gather\nflowers for Whamon.",
      "speaker_id": 2521,
      "line_type": 2,
      "_offset": 6761,
      "_bytes": 49,
      "translation": "¡Vale, Mimi! Vamos a\nrecoger flores para Whamon."
    },
    {
      "index": 32,
      "english": "Obtained flowers!",
      "speaker_id": 9003,
      "line_type": 2,
      "_offset": 6811,
      "_bytes": 17,
      "translation": "¡Flores obtenidas!"
    },
    {
      "index": 33,
      "english": "If we collect more flowers, I'm\nsure Whamon would like that.",
      "speaker_id": 2521,
      "line_type": 2,
      "_offset": 6829,
      "_bytes": 60,
      "translation": "Si recogemos más flores,\nseguro que a Whamon le\ngustaría."
    },
    {
      "index": 34,
      "english": "Hey, Mimi! Let's look elsewhere.",
      "speaker_id": 2521,
      "line_type": 2,
      "_offset": 6890,
      "_bytes": 32,
      "translation": "¡Oye, Mimi! Miremos en otro sitio."
    }
  ]
}