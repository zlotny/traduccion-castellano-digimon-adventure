{
  "file_id": "3612",
  "text_count": 34,
  "dialog": [
    {
      "index": 0,
      "english": "��������We defeated MetalSeadramon, but...",
      "_offset": 3229,
      "_length": 42,
      "speaker_id": 0,
      "translation": "Derrotamos a MetalSeadramon,\npero..."
    },
    {
      "index": 1,
      "english": "...at a horrible cost.",
      "_offset": 3272,
      "_length": 22,
      "speaker_id": 0,
      "translation": "...a un alto precio."
    },
    {
      "index": 2,
      "english": "He was always doing things for us,\nbut we couldn't do anything...",
      "_offset": 3295,
      "_length": 65,
      "speaker_id": 0,
      "translation": "Siempre hacía cosas por\nnosotros, pero no pudimos\nhacer nada..."
    },
    {
      "index": 3,
      "english": "Mimi...",
      "_offset": 3361,
      "_length": 7,
      "speaker_id": 0,
      "translation": "Mimi..."
    },
    {
      "index": 4,
      "english": "Guys, I think we should make a\ngrave for Whamon.",
      "_offset": 3369,
      "_length": 48,
      "speaker_id": 0,
      "translation": "Deberíamos hacerle una\ntumba a Whamon, chicos."
    },
    {
      "index": 5,
      "english": "I agree.",
      "_offset": 3418,
      "_length": 8,
      "speaker_id": 0,
      "translation": "Vale."
    },
    {
      "index": 6,
      "english": "Me, too.",
      "_offset": 3427,
      "_length": 8,
      "speaker_id": 0,
      "translation": "También."
    },
    {
      "index": 7,
      "english": "Yeah, let me help, too!",
      "_offset": 3436,
      "_length": 23,
      "speaker_id": 0,
      "translation": "Sí, yo también ayudo!"
    },
    {
      "index": 8,
      "english": "Thanks, guys!",
      "_offset": 3460,
      "_length": 13,
      "speaker_id": 0,
      "translation": "Gracias!"
    },
    {
      "index": 9,
      "english": "All right, Mimi! Let's gather\nflowers for Whamon.",
      "_offset": 3474,
      "_length": 49,
      "speaker_id": 0,
      "translation": "Vale, Mimi! Vamos a\nrecoger flores para Whamon."
    },
    {
      "index": 10,
      "english": "We met Whamon on our way to Server\nContinent...",
      "_offset": 3524,
      "_length": 47,
      "speaker_id": 0,
      "translation": "Conocimos a Whamon camino\nal Continente Server"
    },
    {
      "index": 11,
      "english": "Mimi...",
      "_offset": 3572,
      "_length": 7,
      "speaker_id": 0,
      "translation": "Mimi..."
    },
    {
      "index": 12,
      "english": "If we hadn't met Whamon, we\nprobably wouldn't have made it to\nServer Continent...",
      "_offset": 3580,
      "_length": 81,
      "speaker_id": 0,
      "translation": "Si no hubiéramos conocido a\nWhamon, no habríamos llegado\nal Continente Server..."
    },
    {
      "index": 13,
      "english": "We could have been lost at sea...",
      "_offset": 3662,
      "_length": 33,
      "speaker_id": 0,
      "translation": "Podríamos perdernos en\nel mar..."
    },
    {
      "index": 14,
      "english": "He was also the one who told us\nwhere to find the tags that\nDevimon hid...",
      "_offset": 3696,
      "_length": 74,
      "speaker_id": 0,
      "translation": "También nos dijo dónde\nencontrar los Circuitos que\nescondió Devimon..."
    },
    {
      "index": 15,
      "english": "You're right...",
      "_offset": 3771,
      "_length": 15,
      "speaker_id": 0,
      "translation": "Tienes razón..."
    },
    {
      "index": 16,
      "english": "And he protected us from\nMetalSeadramon...",
      "_offset": 3787,
      "_length": 42,
      "speaker_id": 0,
      "translation": "Y nos protegió de\nMetalSeadramon..."
    },
    {
      "index": 17,
      "english": "Whamon...",
      "_offset": 3830,
      "_length": 9,
      "speaker_id": 0,
      "translation": "Whamon..."
    },
    {
      "index": 18,
      "english": "Please watch over us from the sea,\nWhamon...",
      "_offset": 3840,
      "_length": 44,
      "speaker_id": 0,
      "translation": "Cuídanos desde el mar,\nWhamon..."
    },
    {
      "index": 19,
      "english": "Let's do our best for Whamon's\nsake, Mimi!",
      "_offset": 3885,
      "_length": 42,
      "speaker_id": 0,
      "translation": "Démoslo todo por Whamon,\nMimi!"
    },
    {
      "index": 20,
      "english": "I'll always remember Whamon...",
      "_offset": 3928,
      "_length": 30,
      "speaker_id": 0,
      "translation": "Siempre recordaré a Whamon..."
    },
    {
      "index": 21,
      "english": "Whamon!",
      "_offset": 3963,
      "_length": 7,
      "speaker_id": 0,
      "translation": "Whamon!"
    },
    {
      "index": 22,
      "english": "Mimi...",
      "_offset": 3971,
      "_length": 7,
      "speaker_id": 0,
      "translation": "Mimi..."
    },
    {
      "index": 23,
      "english": "This is...",
      "_offset": 3979,
      "_length": 10,
      "speaker_id": 0,
      "translation": "Esto es..."
    },
    {
      "index": 24,
      "english": "Palmon... I feel like I can hear\nWhamon's voice...",
      "_offset": 3990,
      "_length": 50,
      "speaker_id": 0,
      "translation": "Palmon... creo que oigo la\nvoz de Whamon..."
    },
    {
      "index": 25,
      "english": "Yeah, he's probably watching over\nus right now.",
      "_offset": 4041,
      "_length": 47,
      "speaker_id": 0,
      "translation": "Sí, seguro que nos está\ncuidando ahora mismo."
    },
    {
      "index": 26,
      "english": "This must be Whamon's gift to us.",
      "_offset": 4089,
      "_length": 33,
      "speaker_id": 0,
      "translation": "Debe ser el regalo de\nWhamon."
    },
    {
      "index": 27,
      "english": "Yeah...",
      "_offset": 4123,
      "_length": 7,
      "speaker_id": 0,
      "translation": "Sí..."
    },
    {
      "index": 28,
      "english": "Mimi, let's go.",
      "_offset": 4131,
      "_length": 15,
      "speaker_id": 0,
      "translation": "Mimi, vamos."
    },
    {
      "index": 29,
      "english": "We'll meet again, Whamon! We'll\nput an end to this fight for sure.",
      "_offset": 4147,
      "_length": 66,
      "speaker_id": 0,
      "translation": "Nos volveremos a ver, Whamon!\nAcabaremos con esto, seguro."
    },
    {
      "index": 30,
      "english": "All right, Mimi! Let's gather\nflowers for Whamon.",
      "_offset": 4214,
      "_length": 49,
      "speaker_id": 0,
      "translation": "Vale, Mimi! Vamos a\nrecoger flores para Whamon."
    },
    {
      "index": 31,
      "english": "Obtained flowers!",
      "_offset": 4264,
      "_length": 17,
      "speaker_id": 0,
      "translation": "Flores obtenidas!"
    },
    {
      "index": 32,
      "english": "If we collect more flowers, I'm\nsure Whamon would like that.",
      "_offset": 4282,
      "_length": 60,
      "speaker_id": 0,
      "translation": "Si recogemos más flores,\nseguro que a Whamon le\ngustaría."
    },
    {
      "index": 33,
      "english": "Hey, Mimi! Let's look elsewhere.",
      "_offset": 4343,
      "_length": 32,
      "speaker_id": 0,
      "translation": "Oye, Mimi! Miremos en\notro sitio"
    }
  ]
}