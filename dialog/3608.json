{
  "file_id": "3608",
  "text_count": 74,
  "dialog": [
    {
      "index": 0,
      "english": "��������Takeru! It's the amusement park!",
      "_offset": 1206,
      "_length": 40,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 1,
      "english": "Which one should we ride?",
      "_offset": 1247,
      "_length": 25,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 2,
      "english": "I wonder if they sell cola at the\nshop?",
      "_offset": 1273,
      "_length": 39,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 3,
      "english": "Yamato, is there anything you want\nto ride?",
      "_offset": 1313,
      "_length": 43,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 4,
      "english": "Yamato?",
      "_offset": 1361,
      "_length": 7,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 5,
      "english": "Yamato, let's go ride that Ferris\nwheel!",
      "_offset": 1369,
      "_length": 40,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 6,
      "english": "I... I can't!",
      "_offset": 1410,
      "_length": 13,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 7,
      "english": "Yamato!",
      "_offset": 1424,
      "_length": 7,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 8,
      "english": "What's wrong with him?",
      "_offset": 1432,
      "_length": 22,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 9,
      "english": "Takeru, let's go after him!",
      "_offset": 1455,
      "_length": 27,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 10,
      "english": "Yeah!",
      "_offset": 1483,
      "_length": 5,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 11,
      "english": "There he is! It's Yamato!",
      "_offset": 1489,
      "_length": 25,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 12,
      "english": "Yamato, wait!",
      "_offset": 1515,
      "_length": 13,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 13,
      "english": "Yamato...",
      "_offset": 1533,
      "_length": 9,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 14,
      "english": "Takeru...I'm sure Yamato had a\nreason.",
      "_offset": 1543,
      "_length": 38,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 15,
      "english": "Yeah, there's gotta be something\ngoing on.",
      "_offset": 1582,
      "_length": 42,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 16,
      "english": "It must be because of me...",
      "_offset": 1625,
      "_length": 27,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 17,
      "english": "I always say selfish things and\nhe's always been patient with\nme...",
      "_offset": 1653,
      "_length": 67,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 18,
      "english": "He must have started to hate me.",
      "_offset": 1721,
      "_length": 32,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 19,
      "english": "Takeru! Believe in Yamato!",
      "_offset": 1754,
      "_length": 26,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 20,
      "english": "...Okay.",
      "_offset": 1781,
      "_length": 8,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 21,
      "english": "Yamato!",
      "_offset": 1790,
      "_length": 7,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 22,
      "english": "...S-stop it. Stay away...",
      "_offset": 1798,
      "_length": 26,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 23,
      "english": "I've never seen Yamato like this\nbefore!",
      "_offset": 1825,
      "_length": 40,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 24,
      "english": "I've taken this child's strong\nheart.",
      "_offset": 1866,
      "_length": 37,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 25,
      "english": "It's Vadermon!",
      "_offset": 1907,
      "_length": 14,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 26,
      "english": "You said you took Yamato's heart?!",
      "_offset": 1922,
      "_length": 34,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 27,
      "english": "Without a strong heart, he is\ndoomed to succumb to fear. He will\nbe like that for eternity.",
      "_offset": 1957,
      "_length": 91,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 28,
      "english": "No! My brother is kind and calm\nand very strong!",
      "_offset": 2049,
      "_length": 48,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 29,
      "english": "Takeru...!",
      "_offset": 2098,
      "_length": 10,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 30,
      "english": "Give back Yamato's heart!",
      "_offset": 2109,
      "_length": 25,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 31,
      "english": "Yamato, are you okay?",
      "_offset": 2135,
      "_length": 21,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 32,
      "english": "...Yeah, I'm fine. I'm not afraid\nof you and Gabumon anymore.",
      "_offset": 2157,
      "_length": 61,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 33,
      "english": "Thank goodness...",
      "_offset": 2219,
      "_length": 17,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 34,
      "english": "Thank you, Takeru. Oh, right...\ntake this.",
      "_offset": 2237,
      "_length": 42,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 35,
      "english": "What's this?",
      "_offset": 2280,
      "_length": 12,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 36,
      "english": "Vadermon dropped it, so I picked\nit up. Let's take it with us.",
      "_offset": 2293,
      "_length": 62,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 37,
      "english": "Now that you've gotten your strong\nheart back, let's ride the roller\ncoasters.",
      "_offset": 2356,
      "_length": 78,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 38,
      "english": "Whaaaat? The Ferris wheel's good\nenough!",
      "_offset": 2435,
      "_length": 40,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 39,
      "english": "Yamato, which do you prefer?",
      "_offset": 2476,
      "_length": 28,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 40,
      "english": "Uh...I'll... excuse myself from\nboth.",
      "_offset": 2505,
      "_length": 37,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 41,
      "english": "Come on, Yamato, are you *sure*\nyou're not scared?",
      "_offset": 2543,
      "_length": 50,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 42,
      "english": "D-don't be stupid!",
      "_offset": 2594,
      "_length": 18,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 43,
      "english": "Really? What a shocking twist!",
      "_offset": 2613,
      "_length": 30,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 44,
      "english": "Hey, stop it...!",
      "_offset": 2644,
      "_length": 16,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 45,
      "english": "Are you okay, Takeru?",
      "_offset": 2661,
      "_length": 21,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 46,
      "english": "I wonder what happened to\nYamato...",
      "_offset": 2683,
      "_length": 35,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 47,
      "english": "Let's find Yamato first!",
      "_offset": 2719,
      "_length": 24,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 48,
      "english": "Yamato...",
      "_offset": 2744,
      "_length": 9,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 49,
      "english": "He's started to hate me.",
      "_offset": 2754,
      "_length": 24,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 50,
      "english": "He was acting kind of strange...",
      "_offset": 2779,
      "_length": 32,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 51,
      "english": "Takeru, please calm down!",
      "_offset": 2812,
      "_length": 25,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 52,
      "english": "What should we do...",
      "_offset": 2838,
      "_length": 20,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 53,
      "english": "Takeru...",
      "_offset": 2859,
      "_length": 9,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 54,
      "english": "Yamato certainly wasn't acting\nlike his usual self, was he?",
      "_offset": 2869,
      "_length": 59,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 55,
      "english": "Help him, Koushirou!",
      "_offset": 2929,
      "_length": 20,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 56,
      "english": "Of course!",
      "_offset": 2950,
      "_length": 10,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 57,
      "english": "Please feel better, Takeru.",
      "_offset": 2961,
      "_length": 27,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 58,
      "english": "Thank you, Sora.",
      "_offset": 2989,
      "_length": 16,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 59,
      "english": "Yamato must have had a reason.\nBelieve in him, Takeru.",
      "_offset": 3006,
      "_length": 54,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 60,
      "english": "I'll believe in Yamato.",
      "_offset": 3061,
      "_length": 23,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 61,
      "english": "I'm scared to see Yamato.",
      "_offset": 3085,
      "_length": 25,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 62,
      "english": "Come on, let's find Yamato as\nquickly as we can.",
      "_offset": 3111,
      "_length": 48,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 63,
      "english": "Okay!",
      "_offset": 3160,
      "_length": 5,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 64,
      "english": "He was almost like a completely\ndifferent person.",
      "_offset": 3166,
      "_length": 49,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 65,
      "english": "Takeru...",
      "_offset": 3216,
      "_length": 9,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 66,
      "english": "Hey, Takeru... got any idea how\nYamato got like that?",
      "_offset": 3226,
      "_length": 53,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 67,
      "english": "No idea...",
      "_offset": 3280,
      "_length": 10,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 68,
      "english": "Maybe because I used his harmonica?",
      "_offset": 3291,
      "_length": 35,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 69,
      "english": "Okay... what happened?",
      "_offset": 3327,
      "_length": 22,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 70,
      "english": "I was trying to keep it quiet,\nbut...",
      "_offset": 3350,
      "_length": 37,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 71,
      "english": "Yamato wouldn't get mad about\nsomething like that.",
      "_offset": 3388,
      "_length": 50,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 72,
      "english": "In any case, we have to find him.",
      "_offset": 3439,
      "_length": 33,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 73,
      "english": "Right!",
      "_offset": 3473,
      "_length": 6,
      "speaker_id": 0,
      "translation": ""
    }
  ]
}