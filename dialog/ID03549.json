      "_length": 70,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 118,
      "english": "Not really.",
      "_offset": 5184,
      "_length": 11,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 119,
      "english": "Hey, Takeru, by any chance, are\nyou still worried about Tokomon?",
      "_offset": 5196,
      "_length": 64,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 120,
      "english": "I don't care about him! But I\nwonder if he's okay by himself...",
      "_offset": 5261,
      "_length": 63,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 121,
      "english": "(I can't get him to forget about\nTokomon after all. I have to do\nsomething...)",
