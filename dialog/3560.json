{
  "file_id": "3560",
  "format": "etdf",
  "kind": "ETDF",
  "text_count": 70,
  "dialog": [
    {
      "index": 0,
      "english": "No one's around. Tentomon, come\nover here!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 6152,
      "_bytes": 42,
      "translation": "No hay nadie. Tentomon, ¡ven\naquí!"
    },
    {
      "index": 1,
      "english": "Right-o!",
      "speaker_id": 2421,
      "line_type": 2,
      "_offset": 6195,
      "_bytes": 8,
      "translation": "¡Vale!"
    },
    {
      "index": 2,
      "english": "*whew*",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 6204,
      "_bytes": 6,
      "translation": "Uf..."
    },
    {
      "index": 3,
      "english": "So this is your place, Izzy?",
      "speaker_id": 2421,
      "line_type": 2,
      "_offset": 6211,
      "_bytes": 33,
      "translation": "¿Así que aquí vives, Izzy?"
    },
    {
      "index": 4,
      "english": "Y-Yes?",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 6245,
      "_bytes": 6,
      "translation": "¿S-Sí?"
    },
    {
      "index": 5,
      "english": "W-What are we gonna do?!",
      "speaker_id": 2421,
      "line_type": 2,
      "_offset": 6252,
      "_bytes": 24,
      "translation": "¡¿Q-Qué hacemos?!"
    },
    {
      "index": 6,
      "english": "Please, hide!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 6277,
      "_bytes": 13,
      "translation": "¡Escóndete!"
    },
    {
      "index": 7,
      "english": "Ah? You're home.",
      "speaker_id": 6161,
      "line_type": 2,
      "_offset": 6291,
      "_bytes": 16,
      "translation": "Ah, has vuelto."
    },
    {
      "index": 8,
      "english": "I-I'm home! Camp was cancelled.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 6308,
      "_bytes": 31,
      "translation": "¡Y-Ya he vuelto! Sin campamento."
    },
    {
      "index": 9,
      "english": "Really?",
      "speaker_id": 6161,
      "line_type": 2,
      "_offset": 6340,
      "_bytes": 7,
      "translation": "Ah, ¿sí?"
    },
    {
      "index": 10,
      "english": "What's wrong?",
      "speaker_id": 6161,
      "line_type": 2,
      "_offset": 6348,
      "_bytes": 13,
      "translation": "¿Qué te pasa?"
    },
    {
      "index": 11,
      "english": "Nothing's wrong.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 6362,
      "_bytes": 16,
      "translation": "No pasa nada."
    },
    {
      "index": 12,
      "english": "I see...",
      "speaker_id": 6161,
      "line_type": 2,
      "_offset": 6379,
      "_bytes": 8,
      "translation": "Ya veo..."
    },
    {
      "index": 13,
      "english": "*whew*",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 6388,
      "_bytes": 6,
      "translation": "Uf..."
    },
    {
      "index": 14,
      "english": "Hey, it's the first time you're\nseein' her in a while. Aren't'cha\nbein' a bit blunt?",
      "speaker_id": 2421,
      "line_type": 2,
      "_offset": 6395,
      "_bytes": 84,
      "translation": "Hace tiempo que no la ves,\n¿no crees que estás siendo\nun poco brusco?"
    },
    {
      "index": 15,
      "english": "No, that's not...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 6480,
      "_bytes": 17,
      "translation": "No, no es eso..."
    },
    {
      "index": 16,
      "english": "Hey, dear. When are we going to\ntell him the truth?",
      "speaker_id": 6161,
      "line_type": 2,
      "_offset": 6498,
      "_bytes": 51,
      "translation": "Cariño, ¿cuándo le contaremos\nla verdad...?"
    },
    {
      "index": 17,
      "english": "Why don't we wait a bit longer? If\nwe tell Izzy now, it'll be a\nreally big shock.",
      "speaker_id": 6151,
      "line_type": 2,
      "_offset": 6550,
      "_bytes": 86,
      "translation": "¿Por qué no esperamos un poco\nmás? Si se lo decimos a Izzy\nahora será un golpe muy duro."
    },
    {
      "index": 18,
      "english": "But I wonder if he's already\nrealized it by now...",
      "speaker_id": 6161,
      "line_type": 2,
      "_offset": 6637,
      "_bytes": 50,
      "translation": "Pero me pregunto si ya se\nhabrá dado cuenta..."
    },
    {
      "index": 19,
      "english": "That he's not our real son. That\nhe's adopted...",
      "speaker_id": 6161,
      "line_type": 2,
      "_offset": 6688,
      "_bytes": 48,
      "translation": "Que no es nuestro hijo de\nverdad, es adoptado."
    },
    {
      "index": 20,
      "english": "Did something happen?",
      "speaker_id": 6151,
      "line_type": 2,
      "_offset": 6737,
      "_bytes": 21,
      "translation": "¿Ha pasado algo?"
    },
    {
      "index": 21,
      "english": "Nothing in particular, but...",
      "speaker_id": 6161,
      "line_type": 2,
      "_offset": 6759,
      "_bytes": 29,
      "translation": "Nada en especial, pero..."
    },
    {
      "index": 22,
      "english": "Izzy... Izzy!",
      "speaker_id": 2421,
      "line_type": 2,
      "_offset": 6789,
      "_bytes": 23,
      "translation": "Izzy... ¡Izzy!"
    },
    {
      "index": 23,
      "english": "You 'kay?",
      "speaker_id": 2421,
      "line_type": 2,
      "_offset": 6813,
      "_bytes": 9,
      "translation": "¿Tás bien?"
    },
    {
      "index": 24,
      "english": "Yeah.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 6823,
      "_bytes": 5,
      "translation": "Sí."
    },
    {
      "index": 25,
      "english": "Looks like we've received an\ne-mail... from Gennai?!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 6829,
      "_bytes": 52,
      "translation": "Parece que hemos recibido un\ncorreo... ¡¿de Gennai?!"
    },
    {
      "index": 26,
      "english": "What happened?",
      "speaker_id": 2421,
      "line_type": 2,
      "_offset": 6882,
      "_bytes": 14,
      "translation": "¿Qué ha pasado?"
    },
    {
      "index": 27,
      "english": "This is bad! An unidentified\nDigimon has landed in Shibaura!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 6897,
      "_bytes": 60,
      "translation": "¡Esto es grave! ¡Un Digimon\nsin identificar llegó a\nShibaura!"
    },
    {
      "index": 28,
      "english": "What?!",
      "speaker_id": 2421,
      "line_type": 2,
      "_offset": 6958,
      "_bytes": 6,
      "translation": "¡¿Qué?!"
    },
    {
      "index": 29,
      "english": "Is this Shibaura Wharf?",
      "speaker_id": 2421,
      "line_type": 2,
      "_offset": 6965,
      "_bytes": 23,
      "translation": "¿El muelle de Shibaura?"
    },
    {
      "index": 30,
      "english": "Yes, according to Gennai...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 6989,
      "_bytes": 27,
      "translation": "Sí, según Gennai..."
    },
    {
      "index": 31,
      "english": "...the unidentified Digimon\nshould have landed here.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 7017,
      "_bytes": 52,
      "translation": "...el Digimon sin identificar\ndebió de aterrizar aquí."
    },
    {
      "index": 32,
      "english": "I'd feel right better 'bout this\nif the others were here, but...",
      "speaker_id": 2421,
      "line_type": 2,
      "_offset": 7070,
      "_bytes": 64,
      "translation": "Me quedaría más tranquilo si\nlos demás estuvieran aquí,\npero..."
    },
    {
      "index": 33,
      "english": "Everyone should be asleep right\nnow.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 7135,
      "_bytes": 36,
      "translation": "Todos deberían estar dormidos\nahora."
    },
    {
      "index": 34,
      "english": "Can't help it. I'll just have to\nwing it on my own some way.",
      "speaker_id": 2421,
      "line_type": 2,
      "_offset": 7172,
      "_bytes": 60,
      "translation": "No hay más remedio. Tendré que\narreglármelas yo solo."
    },
    {
      "index": 35,
      "english": "Yes!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 7233,
      "_bytes": 4,
      "translation": "¡Sí!"
    },
    {
      "index": 36,
      "english": "W-what's that!?",
      "speaker_id": 2421,
      "line_type": 2,
      "_offset": 7238,
      "_bytes": 15,
      "translation": "¡¿Q-Qué es eso?!"
    },
    {
      "index": 37,
      "english": "I-it's over there!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 7254,
      "_bytes": 18,
      "translation": "¡E-Está ahí!"
    },
    {
      "index": 38,
      "english": "That's Raremon!",
      "speaker_id": 2421,
      "line_type": 2,
      "_offset": 7273,
      "_bytes": 15,
      "translation": "¡Es Raremon!"
    },
    {
      "index": 39,
      "english": "Ugh! What's that smell...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 7289,
      "_bytes": 25,
      "translation": "¡Puaj! Qué peste..."
    },
    {
      "index": 40,
      "english": "It's comin' this-a-way!",
      "speaker_id": 2421,
      "line_type": 2,
      "_offset": 7315,
      "_bytes": 23,
      "translation": "¡Viene pa'acá!"
    },
    {
      "index": 41,
      "english": "We have to do something before he\nturns around and notices us!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 7339,
      "_bytes": 62,
      "translation": "¡Tenemos que hacer algo antes de\nque se dé la vuelta y nos vea!"
    },
    {
      "index": 42,
      "english": "Let's go, Tentomon!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 7402,
      "_bytes": 19,
      "translation": "¡Vamos, Tentomon!"
    },
    {
      "index": 43,
      "english": "Got it!",
      "speaker_id": 2421,
      "line_type": 2,
      "_offset": 7422,
      "_bytes": 7,
      "translation": "¡Vale!"
    },
    {
      "index": 44,
      "english": "We did it, Tentomon!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 7430,
      "_bytes": 20,
      "translation": "¡Lo hicimos, Tentomon!"
    },
    {
      "index": 45,
      "english": "We managed to floor him by\nourselves...",
      "speaker_id": 2421,
      "line_type": 2,
      "_offset": 7451,
      "_bytes": 39,
      "translation": "Lo hemos derribado nosotros\nsolos..."
    },
    {
      "index": 46,
      "english": "Ah! The Digivice!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 7491,
      "_bytes": 17,
      "translation": "¡Ah! ¡El Digivice!"
    },
    {
      "index": 47,
      "english": "What's going on?!",
      "speaker_id": 2421,
      "line_type": 2,
      "_offset": 7509,
      "_bytes": 17,
      "translation": "¡¿Qué pasa aquí?!"
    },
    {
      "index": 48,
      "english": "The eighth child must be nearby!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 7527,
      "_bytes": 32,
      "translation": "¡El octavo niño está cerca!"
    },
    {
      "index": 49,
      "english": "Ah! You're...",
      "speaker_id": 4221,
      "line_type": 2,
      "_offset": 7560,
      "_bytes": 13,
      "translation": "¡Ah! Eres..."
    },
    {
      "index": 50,
      "english": "Ah! PicoDevimon!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 7574,
      "_bytes": 16,
      "translation": "¡Ah! ¡DemiDevimon!"
    },
    {
      "index": 51,
      "english": "You aren't chasing the eighth\nchild's signal, are you?!",
      "speaker_id": 4221,
      "line_type": 2,
      "_offset": 7591,
      "_bytes": 55,
      "translation": "No estarás siguiendo la señal\ndel octavo niño, ¡¿verdad?!"
    },
    {
      "index": 52,
      "english": "We won't letcha have the eighth\nChosen Child!",
      "speaker_id": 2421,
      "line_type": 2,
      "_offset": 7647,
      "_bytes": 45,
      "translation": "¡No te llevarás al octavo\nNiño Elegido!"
    },
    {
      "index": 53,
      "english": "Gh... I'll remember this!",
      "speaker_id": 4221,
      "line_type": 2,
      "_offset": 7693,
      "_bytes": 25,
      "translation": "Gh... ¡Recordaré esto!"
    },
    {
      "index": 54,
      "english": "He left.",
      "speaker_id": 2421,
      "line_type": 2,
      "_offset": 7719,
      "_bytes": 8,
      "translation": "Se fue."
    },
    {
      "index": 55,
      "english": "We're safe for now, Tentomon.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 7728,
      "_bytes": 29,
      "translation": "A salvo por ahora, Tentomon."
    },
    {
      "index": 56,
      "english": "So, what 'bout the eighth child's\nsignal?",
      "speaker_id": 2421,
      "line_type": 2,
      "_offset": 7758,
      "_bytes": 41,
      "translation": "¿Y qué hay de la señal del\noctavo niño?"
    },
    {
      "index": 57,
      "english": "Right! Ah, the signal's\nvanishing...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 7800,
      "_bytes": 36,
      "translation": "¡Cierto! La señal se está\nborrando..."
    },
    {
      "index": 58,
      "english": "Right shame.",
      "speaker_id": 2421,
      "line_type": 2,
      "_offset": 7837,
      "_bytes": 12,
      "translation": "Qué pena."
    },
    {
      "index": 59,
      "english": "But at least now we know the\neighth child isn't around\nKarigaoka...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 7850,
      "_bytes": 69,
      "translation": "Al menos ya sabemos que el\noctavo niño no está en\nHikarioka..."
    },
    {
      "index": 60,
      "english": "We've learned enough. It seems\nthat Tai's suspicions were\ncorrect.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 7920,
      "_bytes": 69,
      "translation": "Ya sabemos bastante.\nParece que Tai tenía razón\nen sus sospechas."
    },
    {
      "index": 61,
      "english": "Right.",
      "speaker_id": 2421,
      "line_type": 2,
      "_offset": 7990,
      "_bytes": 6,
      "translation": "Ya."
    },
    {
      "index": 62,
      "english": "T-that's...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 7997,
      "_bytes": 11,
      "translation": "E-Eso..."
    },
    {
      "index": 63,
      "english": "What's wrong, Izzy?",
      "speaker_id": 2421,
      "line_type": 2,
      "_offset": 8009,
      "_bytes": 24,
      "translation": "¿Qué pasa, Izzy?"
    },
    {
      "index": 64,
      "english": "I just saw a cat over there that\nlooks similar to Tai's cat.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 8034,
      "_bytes": 63,
      "translation": "Acabo de ver una gata por ahí\nque se parece a la de Tai."
    },
    {
      "index": 65,
      "english": "Wonder what it's doin' over\nhere...",
      "speaker_id": 2421,
      "line_type": 2,
      "_offset": 8098,
      "_bytes": 35,
      "translation": "Qué hará por aquí..."
    },
    {
      "index": 66,
      "english": "I don't know. Maybe it hid some\nfood around here?",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 8134,
      "_bytes": 49,
      "translation": "No sé. ¿A lo mejor escondió\ncomida por aquí?"
    },
    {
      "index": 67,
      "english": "I'm gettin' kinda hungry.",
      "speaker_id": 2421,
      "line_type": 2,
      "_offset": 8184,
      "_bytes": 25,
      "translation": "Me está entrando hambre."
    },
    {
      "index": 68,
      "english": "Hahaha. I'll bring you something\nwhen we get home.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 8210,
      "_bytes": 50,
      "translation": "Jaja. Te traeré algo cuando\nlleguemos a casa."
    },
    {
      "index": 69,
      "english": "Sorry 'bout that.",
      "speaker_id": 2421,
      "line_type": 2,
      "_offset": 8261,
      "_bytes": 17,
      "translation": "Perdona por eso."
    }
  ]
}