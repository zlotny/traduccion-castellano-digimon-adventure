{
  "file_id": "3617",
  "text_count": 108,
  "dialog": [
    {
      "index": 0,
      "english": "��������We're on another floor...",
      "_offset": 2388,
      "_length": 33,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 1,
      "english": "Yeah! We need to find a way out,\nsomehow.",
      "_offset": 2422,
      "_length": 41,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 2,
      "english": "*growl*",
      "_offset": 2464,
      "_length": 7,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 3,
      "english": "Huh? That wasn't me.",
      "_offset": 2476,
      "_length": 20,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 4,
      "english": "Don't worry about it! Everyone's\nstomach growls at one point or\nanother.",
      "_offset": 2497,
      "_length": 72,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 5,
      "english": "I swear, it wasn't me!",
      "_offset": 2570,
      "_length": 22,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 6,
      "english": "It came from that direction!",
      "_offset": 2593,
      "_length": 28,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 7,
      "english": "Takatooooo! I'm staaaaaarving!",
      "_offset": 2622,
      "_length": 30,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 8,
      "english": "Shhhhh, Guilmon!",
      "_offset": 2653,
      "_length": 16,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 9,
      "english": "Who are you?",
      "_offset": 2670,
      "_length": 12,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 10,
      "english": "I-I'm... Um...",
      "_offset": 2683,
      "_length": 14,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 11,
      "english": "Your name! Now!",
      "_offset": 2698,
      "_length": 15,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 12,
      "english": "I'm Guilmon!",
      "_offset": 2714,
      "_length": 12,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 13,
      "english": "Ah, I'm Takato Matsuda. Looks like\nwe both have Digimon.",
      "_offset": 2727,
      "_length": 56,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 14,
      "english": "Yeah! I'm Taichi Yagami... and\nthis is Agumon!",
      "_offset": 2784,
      "_length": 46,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 15,
      "english": "Nice to meet you!",
      "_offset": 2831,
      "_length": 17,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 16,
      "english": "Taichi Yagami?! And Agumon?",
      "_offset": 2849,
      "_length": 27,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 17,
      "english": "Huh? What's wrong?",
      "_offset": 2877,
      "_length": 18,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 18,
      "english": "I-It's nothing... You just, uh,\nhappen to have the same name as a\nreally famous person I know.",
      "_offset": 2896,
      "_length": 94,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 19,
      "english": "Whoaaaaa! It's Agumon! Takato has\na figure of you in his room!",
      "_offset": 2991,
      "_length": 62,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 20,
      "english": "...shhh, Guilmon!",
      "_offset": 3054,
      "_length": 17,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 21,
      "english": "Huh?",
      "_offset": 3072,
      "_length": 4,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 22,
      "english": "U-Uh, just an inside joke.\nAnyway...",
      "_offset": 3077,
      "_length": 36,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 23,
      "english": "Are you guys hiding something?",
      "_offset": 3114,
      "_length": 30,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 24,
      "english": "Who are you?",
      "_offset": 3145,
      "_length": 12,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 25,
      "english": "I'm Hackmon! I love fighting\nstrong guys!",
      "_offset": 3158,
      "_length": 41,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 26,
      "english": "I love eating bread at Takato's\nplace!",
      "_offset": 3200,
      "_length": 38,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 27,
      "english": "...Something's wrong with this\npicture.",
      "_offset": 3239,
      "_length": 39,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 28,
      "english": "So why are you here?",
      "_offset": 3279,
      "_length": 20,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 29,
      "english": "Well... I was taking some of our\nbread to Guilmon after school...",
      "_offset": 3300,
      "_length": 65,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 30,
      "english": "And while I was eating the bread,\na big fuzzy thing appeared!",
      "_offset": 3366,
      "_length": 61,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 31,
      "english": "And before we knew it, we were\nhere...",
      "_offset": 3428,
      "_length": 38,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 32,
      "english": "So it was that black shadow\nagain...",
      "_offset": 3467,
      "_length": 36,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 33,
      "english": "What's going on?!",
      "_offset": 3507,
      "_length": 17,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 34,
      "english": "Y-You're...",
      "_offset": 3525,
      "_length": 11,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 35,
      "english": "That's what we saw!",
      "_offset": 3537,
      "_length": 19,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 36,
      "english": "Go...",
      "_offset": 3557,
      "_length": 5,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 37,
      "english": "I-It talked!",
      "_offset": 3563,
      "_length": 12,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 38,
      "english": "What?!",
      "_offset": 3576,
      "_length": 6,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 39,
      "english": "Go... further in...",
      "_offset": 3583,
      "_length": 19,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 40,
      "english": "What do you want from us? Let us\nout!",
      "_offset": 3603,
      "_length": 37,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 41,
      "english": "Yeah, what do you want from us?",
      "_offset": 3641,
      "_length": 31,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 42,
      "english": "You must fight... defeat the\nenemies, and go further in... or\nelse...",
      "_offset": 3673,
      "_length": 69,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 43,
      "english": "Wait! Hey!",
      "_offset": 3743,
      "_length": 10,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 44,
      "english": "It disappeared...",
      "_offset": 3754,
      "_length": 17,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 45,
      "english": "Gh!",
      "_offset": 3772,
      "_length": 3,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 46,
      "english": "Heeeeey! Don't run away! Fight me!",
      "_offset": 3776,
      "_length": 34,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 47,
      "english": "It said we need to go in further.",
      "_offset": 3811,
      "_length": 33,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 48,
      "english": "We don't have to do what he says.",
      "_offset": 3845,
      "_length": 33,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 49,
      "english": "But we have to keep going if we\nwanna get out of here, right?",
      "_offset": 3879,
      "_length": 61,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 50,
      "english": "I guess our only choice is to do\nwhat it says...",
      "_offset": 3941,
      "_length": 48,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 51,
      "english": "I guess that's our only option.\nWe'll do whatever we can in order\nto escape.",
      "_offset": 3990,
      "_length": 76,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 52,
      "english": "...We'll all have to go together,\nthen!",
      "_offset": 4067,
      "_length": 39,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 53,
      "english": "Um... I'll go too!",
      "_offset": 4107,
      "_length": 18,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 54,
      "english": "Me, too!",
      "_offset": 4126,
      "_length": 8,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 55,
      "english": "Yeah, we'll feel better having you\nguys around.",
      "_offset": 4135,
      "_length": 47,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 56,
      "english": "Hey, Takato!",
      "_offset": 4183,
      "_length": 12,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 57,
      "english": "What, Guilmon?",
      "_offset": 4196,
      "_length": 14,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 58,
      "english": "You got to meet Taichi and Agumon,\nso why aren't you saying anything?",
      "_offset": 4211,
      "_length": 69,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 59,
      "english": "What, that I already know who they\nare?",
      "_offset": 4281,
      "_length": 39,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 60,
      "english": "Yeah!",
      "_offset": 4321,
      "_length": 5,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 61,
      "english": "If I say that, that's only going\nto confuse him!",
      "_offset": 4327,
      "_length": 48,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 62,
      "english": "Really?",
      "_offset": 4376,
      "_length": 7,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 63,
      "english": "It's gonna be a big shock for him\nif I tell him about Digimon being\nall the rage in our world!",
      "_offset": 4384,
      "_length": 94,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 64,
      "english": "Anyway, just being in the presence\nof people I admire so much is good\nenough for me...",
      "_offset": 4479,
      "_length": 86,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 65,
      "english": "Hey! Takato!",
      "_offset": 4566,
      "_length": 12,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 66,
      "english": "What is it, Taichi?",
      "_offset": 4579,
      "_length": 19,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 67,
      "english": "Breaktime's gonna be over soon!\nLet's go!",
      "_offset": 4599,
      "_length": 41,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 68,
      "english": "Okay! I'm coming!",
      "_offset": 4641,
      "_length": 17,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 69,
      "english": "I wonder if all my friends at\nschool will believe me if I tell\nthem about this...",
      "_offset": 4659,
      "_length": 81,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 70,
      "english": "You look really happy, Takato!",
      "_offset": 4741,
      "_length": 30,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 71,
      "english": "Remember, we're keeping this a\nsecret from him!",
      "_offset": 4772,
      "_length": 47,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 72,
      "english": "Okay!",
      "_offset": 4820,
      "_length": 5,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 73,
      "english": "Takato, look! It's the exit!",
      "_offset": 4826,
      "_length": 28,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 74,
      "english": "You're right!",
      "_offset": 4855,
      "_length": 13,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 75,
      "english": "Yaaaaaaay!",
      "_offset": 4869,
      "_length": 10,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 76,
      "english": "W-Wait! Guilmon!",
      "_offset": 4880,
      "_length": 16,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 77,
      "english": "Whaaaaa? Why is there another me?",
      "_offset": 4897,
      "_length": 33,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 78,
      "english": "Is that a fake Guilmon?",
      "_offset": 4931,
      "_length": 23,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 79,
      "english": "There's another one!",
      "_offset": 4955,
      "_length": 20,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 80,
      "english": "Taichi, that Guilmon is dangerous!",
      "_offset": 4976,
      "_length": 34,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 81,
      "english": "Yeah! Let's go!",
      "_offset": 5011,
      "_length": 15,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 82,
      "english": "We did it, but that was hard...",
      "_offset": 5027,
      "_length": 31,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 83,
      "english": "That really hurt... a lot...",
      "_offset": 5059,
      "_length": 28,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 84,
      "english": "Not bad, you two.",
      "_offset": 5088,
      "_length": 17,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 85,
      "english": "Hey! Don't treat this like some\nkind of game!",
      "_offset": 5106,
      "_length": 45,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 86,
      "english": "Don't worry about it!",
      "_offset": 5152,
      "_length": 21,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 87,
      "english": "Now's our chance to leave! I guess\nwe're going to have to split off,\nTakato.",
      "_offset": 5174,
      "_length": 76,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 88,
      "english": "What?! Really?",
      "_offset": 5251,
      "_length": 14,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 89,
      "english": "I guess we're supposed to be\nmeeting someone new on every\nlevel.",
      "_offset": 5266,
      "_length": 64,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 90,
      "english": "I see... Um, excuse me, but can I\nask you for a favor, Taichi?",
      "_offset": 5331,
      "_length": 62,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 91,
      "english": "Me? What?",
      "_offset": 5394,
      "_length": 9,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 92,
      "english": "Please... shake my hand!",
      "_offset": 5404,
      "_length": 24,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 93,
      "english": "What?!",
      "_offset": 5429,
      "_length": 6,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 94,
      "english": "Please!",
      "_offset": 5436,
      "_length": 7,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 95,
      "english": "Well... I can, but...",
      "_offset": 5444,
      "_length": 21,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 96,
      "english": "Aaaaaah! I shook Taichi's hand!\nThank you so much!",
      "_offset": 5466,
      "_length": 50,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 97,
      "english": "Isn't that great, Takato?",
      "_offset": 5517,
      "_length": 25,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 98,
      "english": "I... have no idea what's going on,\nbut hey, I'm glad you're happy.",
      "_offset": 5543,
      "_length": 66,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 99,
      "english": "All right, we're going!",
      "_offset": 5610,
      "_length": 23,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 100,
      "english": "We'll find a way out, okay?",
      "_offset": 5634,
      "_length": 27,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 101,
      "english": "Okay!",
      "_offset": 5662,
      "_length": 5,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 102,
      "english": "Good luck!",
      "_offset": 5668,
      "_length": 10,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 103,
      "english": "I wanna eat more of your family\nbread, Takato!",
      "_offset": 5679,
      "_length": 46,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 104,
      "english": "Yeah! We'll have to find a way\nhome, no matter what!",
      "_offset": 5726,
      "_length": 52,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 105,
      "english": "【Area 1】",
      "_offset": 5779,
      "_length": 22,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 106,
      "english": "【Area 2】",
      "_offset": 5802,
      "_length": 22,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 107,
      "english": "【Area 3】",
      "_offset": 5825,
      "_length": 22,
      "speaker_id": 0,
      "translation": ""
    }
  ]
}