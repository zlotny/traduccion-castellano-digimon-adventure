{
  "file_id": "3526",
  "format": "etdf",
  "kind": "ETDF",
  "text_count": 151,
  "dialog": [
    {
      "index": 0,
      "english": "We did all that running away from\nthe Numemon, I'm thirsty...",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 17592,
      "_bytes": 61,
      "translation": "Después de huir de los Numemon,\ntengo mucha sed..."
    },
    {
      "index": 1,
      "english": "But we won't be lucky enough to\nfind drinks around here.",
      "speaker_id": 2521,
      "line_type": 2,
      "_offset": 17654,
      "_bytes": 56,
      "translation": "No creo que podamos\nencontrar bebida por aquí."
    },
    {
      "index": 2,
      "english": "!!",
      "speaker_id": 9001,
      "line_type": 2,
      "_offset": 17711,
      "_bytes": 2,
      "translation": "!!"
    },
    {
      "index": 3,
      "english": "I never expected to find vending\nmachines here! There's so many!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 17714,
      "_bytes": 64,
      "translation": "¡Nunca hubiese pensado ver tantas\nmáquinas expendedoras aquí!"
    },
    {
      "index": 4,
      "english": "Mimi, you're not thinking of\ngetting a drink, are you?",
      "speaker_id": 2521,
      "line_type": 2,
      "_offset": 17779,
      "_bytes": 54,
      "translation": "Mimi, no estarás pensando en\ncomprar un refresco, ¿no?"
    },
    {
      "index": 5,
      "english": "Of course I am!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 17834,
      "_bytes": 15,
      "translation": "¡Pues claro!"
    },
    {
      "index": 6,
      "english": "We're not gonna find juice just\nlike that!",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 17850,
      "_bytes": 42,
      "translation": "¡No encontrarás zumo así tan\nfácilmente!"
    },
    {
      "index": 7,
      "english": "Really...?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17893,
      "_bytes": 10,
      "translation": "¿De veras?"
    },
    {
      "index": 8,
      "english": "Oh, well, she's still like a\nchild.",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 17904,
      "_bytes": 35,
      "translation": "Déjala, es como una niña."
    },
    {
      "index": 9,
      "english": "Hmph, this vending machine doesn't\nhave cola. I wanna drink cola!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 17940,
      "_bytes": 65,
      "translation": "Esta máquina no tiene cola.\n¡Quiero beber cola!"
    },
    {
      "index": 10,
      "english": "This is great! I want some cola,\ntoo!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 18006,
      "_bytes": 37,
      "translation": "¡Es genial!\n¡Quiero cola yo también!"
    },
    {
      "index": 11,
      "english": "How about we split it 50-50?",
      "speaker_id": 4294967295,
      "line_type": 2,
      "_offset": 18044,
      "_bytes": 28,
      "translation": "¿Qué te parece compartir?"
    },
    {
      "index": 12,
      "english": "I'll give you all of it.",
      "speaker_id": 4294967295,
      "line_type": 2,
      "_offset": 18073,
      "_bytes": 24,
      "translation": "Te daré todo a ti."
    },
    {
      "index": 13,
      "english": "Are you sure?",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 18098,
      "_bytes": 13,
      "translation": "¿Seguro?"
    },
    {
      "index": 14,
      "english": "Yeah, it tastes better when you\ndon't drink it alone.",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 18112,
      "_bytes": 53,
      "translation": "Sí, sabe mejor si no bebes\na solas."
    },
    {
      "index": 15,
      "english": "I'll let you have all of it.",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 18166,
      "_bytes": 28,
      "translation": "Te dejo beber todo."
    },
    {
      "index": 16,
      "english": "You shouldn't give me all of it.",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 18195,
      "_bytes": 32,
      "translation": "No deberías darme todo."
    },
    {
      "index": 17,
      "english": "Don't worry! You're the youngest,\nafter all.",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 18228,
      "_bytes": 44,
      "translation": "¡No pasa nada! Eres el más\npequeño."
    },
    {
      "index": 18,
      "english": "I really don't want to be treated\nlike that.",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 18273,
      "_bytes": 44,
      "translation": "De veras que no me gusta que me\ntraten así."
    },
    {
      "index": 19,
      "english": "I said you shouldn't worry...",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 18318,
      "_bytes": 29,
      "translation": "Dije que no pasaba nada..."
    },
    {
      "index": 20,
      "english": "Thanks! Mimi, you're really nice.",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 18348,
      "_bytes": 33,
      "translation": "Gracias Mimi, eres muy amable."
    },
    {
      "index": 21,
      "english": "Cola, huh...I haven't had that in\na while.",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 18382,
      "_bytes": 42,
      "translation": "Cola, eh... Hace tiempo que no la\npruebo."
    },
    {
      "index": 22,
      "english": "How about we split it 50-50?",
      "speaker_id": 4294967295,
      "line_type": 2,
      "_offset": 18425,
      "_bytes": 28,
      "translation": "¿Qué te parece compartir?"
    },
    {
      "index": 23,
      "english": "I only have 100 yen at the moment.",
      "speaker_id": 4294967295,
      "line_type": 2,
      "_offset": 18454,
      "_bytes": 34,
      "translation": "Solo tengo 100 yenes ahora."
    },
    {
      "index": 24,
      "english": "Don't worry about me. It'd be bad\nform if I leeched off others.",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 18489,
      "_bytes": 63,
      "translation": "No te preocupes. Estaría feo\naprovecharme de los demás."
    },
    {
      "index": 25,
      "english": "I'm not worried about that!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 18553,
      "_bytes": 27,
      "translation": "¡No me preocupa eso!"
    },
    {
      "index": 26,
      "english": "I'm sorry! If I had more than 100\nyen on me, I'd buy more than one.",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 18581,
      "_bytes": 67,
      "translation": "¡Disculpa! Si tuviese más de 100\nyenes, te compraría varias."
    },
    {
      "index": 27,
      "english": "It's all right. You don't need to\nspend money on me.",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 18649,
      "_bytes": 52,
      "translation": "Está bien. No tienes que gastar\ndinero en mí."
    },
    {
      "index": 28,
      "english": "Is cola really that tasty?",
      "speaker_id": 2221,
      "line_type": 2,
      "_offset": 18702,
      "_bytes": 26,
      "translation": "¿Está tan rica la cola?"
    },
    {
      "index": 29,
      "english": "It's very tasty! And it's\nrefreshing, too!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 18729,
      "_bytes": 42,
      "translation": "¡Muy rica! ¡Y refrescante,\ntambién!"
    },
    {
      "index": 30,
      "english": "Wow!",
      "speaker_id": 2221,
      "line_type": 2,
      "_offset": 18772,
      "_bytes": 4,
      "translation": "¡Uah!"
    },
    {
      "index": 31,
      "english": "So you like cola, Mimi?",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 18777,
      "_bytes": 23,
      "translation": "¿Te gusta la cola, Mimi?"
    },
    {
      "index": 32,
      "english": "You don't?",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 18801,
      "_bytes": 10,
      "translation": "¿A ti no?"
    },
    {
      "index": 33,
      "english": "I'm more of a tea person.",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 18812,
      "_bytes": 25,
      "translation": "A mí me gusta más el té."
    },
    {
      "index": 34,
      "english": "You're weird, Joe!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 18838,
      "_bytes": 18,
      "translation": "¡Qué raro eres Joe!"
    },
    {
      "index": 35,
      "english": "Is that how you think of me?",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 18857,
      "_bytes": 28,
      "translation": "¿Eso piensas sobre mí?"
    },
    {
      "index": 36,
      "english": "How could anyone like tea more\nthan cola?",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 18886,
      "_bytes": 41,
      "translation": "¿Cómo te puede gustar más el té?"
    },
    {
      "index": 37,
      "english": "...",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 18928,
      "_bytes": 3,
      "translation": "..."
    },
    {
      "index": 38,
      "english": "Doesn't look like there are any\nvending machines beyond here...",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 18932,
      "_bytes": 63,
      "translation": "No parece que haya más\nexpendedoras a partir de aquí..."
    },
    {
      "index": 39,
      "english": "Mimi, that's enough. Let's keep\ngoing!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 18996,
      "_bytes": 38,
      "translation": "Mimi, es suficiente. ¡Sigamos!"
    },
    {
      "index": 40,
      "english": "Mimi, that's enough. Let's keep\ngoing!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 19035,
      "_bytes": 38,
      "translation": "Mimi, es suficiente. ¡Sigamos!"
    },
    {
      "index": 41,
      "english": "I can't walk, I'm still too\nthirsty!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 19074,
      "_bytes": 36,
      "translation": "¡No puedo caminar, estoy\nsedienta!"
    },
    {
      "index": 42,
      "english": "Okay, but hurry up.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 19111,
      "_bytes": 19,
      "translation": "Vale, pero aprisa."
    },
    {
      "index": 43,
      "english": "I found it! There's a vending\nmachine! I'm gonna drink some\nbubbling, sparkling cola!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 19131,
      "_bytes": 85,
      "translation": "¡La encontré! Aquí está la\nmáquina expendedora. Compraré una\nburbujeante cola."
    },
    {
      "index": 44,
      "english": "Missy!!",
      "speaker_id": 4031,
      "line_type": 2,
      "_offset": 19217,
      "_bytes": 7,
      "translation": "¡Bonita!"
    },
    {
      "index": 45,
      "english": "Kyaaaah!!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 19225,
      "_bytes": 9,
      "translation": "¡¡Uaaah!!"
    },
    {
      "index": 46,
      "english": "Wanna go on a date?",
      "speaker_id": 4031,
      "line_type": 2,
      "_offset": 19235,
      "_bytes": 19,
      "translation": "¿Saldrías conmigo?"
    },
    {
      "index": 47,
      "english": "Another Numemon?",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 19255,
      "_bytes": 16,
      "translation": "¿Otro Numemon?"
    },
    {
      "index": 48,
      "english": "He's trying to hit on you, Mimi.\nWhat are you gonna do?",
      "speaker_id": 2521,
      "line_type": 2,
      "_offset": 19272,
      "_bytes": 55,
      "translation": "Te está tirando los trastos,\nMimi. ¿Qué vas a hacer?"
    },
    {
      "index": 49,
      "english": "Definitely not! Why would I go out\nwith a thing like that?!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 19328,
      "_bytes": 59,
      "translation": "¡Pues ni de broma! ¡¿Cómo iba a\nsalir con semejante bicho?!"
    },
    {
      "index": 50,
      "english": "A thing? Why are you calling me a\nthing? Now I'm angry! Hey,\neveryone, let's attack her!",
      "speaker_id": 4031,
      "line_type": 2,
      "_offset": 19388,
      "_bytes": 88,
      "translation": "¿Bicho? ¿Por qué me llamas así?\n¡Ahora me enfado! ¡Eh, todos,\nataquémosla!"
    },
    {
      "index": 51,
      "english": "W-what's this?!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 19477,
      "_bytes": 15,
      "translation": "¡¿Q-Qué es eso?!"
    },
    {
      "index": 52,
      "english": "So many Numemon...",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 19493,
      "_bytes": 18,
      "translation": "Cuántos Numemon..."
    },
    {
      "index": 53,
      "english": "They've surrounded us!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 19512,
      "_bytes": 22,
      "translation": "¡Nos han rodeado!"
    },
    {
      "index": 54,
      "english": "Matt!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 19535,
      "_bytes": 7,
      "translation": "¡Matt!"
    },
    {
      "index": 55,
      "english": "Kyaaaaah! They're throwing poop at\nus!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 19543,
      "_bytes": 38,
      "translation": "¡Aghh! ¡Nos están tirando caca!"
    },
    {
      "index": 56,
      "english": "If we stay together, we'll just be\neasy targets for them!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 19582,
      "_bytes": 57,
      "translation": "¡Si estamos juntos seremos un\nblanco fácil!"
    },
    {
      "index": 57,
      "english": "Okay, we'll split up, run, and\nmeet up later! Let's go!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 19640,
      "_bytes": 55,
      "translation": "Vale, separémonos, corramos\ny luego nos vemos. ¡Vamos!"
    },
    {
      "index": 58,
      "english": "Nu~~~~!!",
      "speaker_id": 4031,
      "line_type": 2,
      "_offset": 19696,
      "_bytes": 8,
      "translation": "¡¡Nu~~~~!!"
    },
    {
      "index": 59,
      "english": "Mimi, get behind me!",
      "speaker_id": 2521,
      "line_type": 2,
      "_offset": 19705,
      "_bytes": 20,
      "translation": "Mimi, ¡ven conmigo!"
    },
    {
      "index": 60,
      "english": "Palmon, will you be okay?",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 19726,
      "_bytes": 25,
      "translation": "Palmon, ¿estarás bien?"
    },
    {
      "index": 61,
      "english": "!!",
      "speaker_id": 4031,
      "line_type": 2,
      "_offset": 19752,
      "_bytes": 2,
      "translation": "!!"
    },
    {
      "index": 62,
      "english": "Nunu~~",
      "speaker_id": 4031,
      "line_type": 2,
      "_offset": 19755,
      "_bytes": 6,
      "translation": "Nunu~~"
    },
    {
      "index": 63,
      "english": "Huh?",
      "speaker_id": 2521,
      "line_type": 2,
      "_offset": 19762,
      "_bytes": 4,
      "translation": "¿Eh?"
    },
    {
      "index": 64,
      "english": "That was amazing, Palmon!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 19767,
      "_bytes": 25,
      "translation": "¡Increíble, Palmon!"
    },
    {
      "index": 65,
      "english": "That's weird, I didn't even do\nanything yet...",
      "speaker_id": 2521,
      "line_type": 2,
      "_offset": 19793,
      "_bytes": 46,
      "translation": "Qué raro, pero si no\nhice aún nada..."
    },
    {
      "index": 66,
      "english": "Kyah!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 19840,
      "_bytes": 5,
      "translation": "¡Kyah!"
    },
    {
      "index": 67,
      "english": "What's going on? The earth's\nshaking...",
      "speaker_id": 2521,
      "line_type": 2,
      "_offset": 19846,
      "_bytes": 39,
      "translation": "¿Qué ocurre? El suelo tiembla..."
    },
    {
      "index": 68,
      "english": "Missy! Get over here and hide!",
      "speaker_id": 4031,
      "line_type": 2,
      "_offset": 19886,
      "_bytes": 30,
      "translation": "¡Bonita! ¡Ven y escóndete!"
    },
    {
      "index": 69,
      "english": "Something's coming! We need to\nhide!",
      "speaker_id": 2521,
      "line_type": 2,
      "_offset": 19917,
      "_bytes": 36,
      "translation": "¡Algo se acerca! ¡Escondeos!"
    },
    {
      "index": 70,
      "english": "What? What? What's coming!?",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 19954,
      "_bytes": 27,
      "translation": "¿Qué? ¿Qué? ¿¡Qué se acerca!?"
    },
    {
      "index": 71,
      "english": "... ...",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 19982,
      "_bytes": 7,
      "translation": "... ..."
    },
    {
      "index": 72,
      "english": "Welcome to Toy Town.",
      "speaker_id": 4051,
      "line_type": 2,
      "_offset": 19990,
      "_bytes": 20,
      "translation": "¡Bienvenidos!"
    },
    {
      "index": 73,
      "english": "I am Toy Town's mayor. I love the\ntoys and they love me.",
      "speaker_id": 4051,
      "line_type": 2,
      "_offset": 20011,
      "_bytes": 56,
      "translation": "Soy el alcalde del País de los\nJuguetes. ¡Los amo!"
    },
    {
      "index": 74,
      "english": "That's so cool! He must be a good\nDigimon!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 20068,
      "_bytes": 42,
      "translation": "¡Qué guay! ¡Seguro que es un\nDigimon bueno!"
    },
    {
      "index": 75,
      "english": "He should be, but...",
      "speaker_id": 2521,
      "line_type": 2,
      "_offset": 20111,
      "_bytes": 20,
      "translation": "Debería, pero..."
    },
    {
      "index": 76,
      "english": "It's a trick. He's been acting\nweird lately...for some reason.",
      "speaker_id": 4031,
      "line_type": 2,
      "_offset": 20132,
      "_bytes": 62,
      "translation": "Es un truco, se comporta raro\núltimamente... por alguna razón."
    },
    {
      "index": 77,
      "english": "Let's play together, everyone.",
      "speaker_id": 4051,
      "line_type": 2,
      "_offset": 20195,
      "_bytes": 30,
      "translation": "Juguemos juntos, todos."
    },
    {
      "index": 78,
      "english": "He left...",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 20226,
      "_bytes": 10,
      "translation": "Se fue..."
    },
    {
      "index": 79,
      "english": "He said \"let's play together,\neveryone\", so maybe everyone's in\nToy Town.",
      "speaker_id": 2521,
      "line_type": 2,
      "_offset": 20237,
      "_bytes": 73,
      "translation": "Dijo \"juguemos juntos\". Quizás\ntodos estén en el País de los\nJuguetes."
    },
    {
      "index": 80,
      "english": "Let's go!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 20311,
      "_bytes": 9,
      "translation": "¡Vamos!"
    },
    {
      "index": 81,
      "english": "Are we going on a date in Toy\nTown?",
      "speaker_id": 4031,
      "line_type": 2,
      "_offset": 20321,
      "_bytes": 35,
      "translation": "¿Una cita en el País de los\nJuguetes?"
    },
    {
      "index": 82,
      "english": "It's not a date! We're going to\nlook for everyone!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 20357,
      "_bytes": 50,
      "translation": "¡No estamos saliendo! ¡Vamos a\nbuscar a los demás!"
    },
    {
      "index": 83,
      "english": "Mimi, wait!",
      "speaker_id": 2521,
      "line_type": 2,
      "_offset": 20408,
      "_bytes": 11,
      "translation": "¡Eh, espera!"
    },
    {
      "index": 84,
      "english": "Such a blunt girl.",
      "speaker_id": 4031,
      "line_type": 2,
      "_offset": 20420,
      "_bytes": 18,
      "translation": "Qué directa."
    },
    {
      "index": 85,
      "english": "Ah!!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 20439,
      "_bytes": 4,
      "translation": "¡¡Ah!!"
    },
    {
      "index": 86,
      "english": "There's Toy Town!",
      "speaker_id": 2521,
      "line_type": 2,
      "_offset": 20444,
      "_bytes": 17,
      "translation": "¡País de los\nJuguetes!"
    },
    {
      "index": 87,
      "english": "Wow! It looks just like an\namusement park!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 20462,
      "_bytes": 42,
      "translation": "¡Guau, parece un parque de\natracciones!"
    },
    {
      "index": 88,
      "english": "Mimi...You remember why we came\nhere, right?",
      "speaker_id": 2521,
      "line_type": 2,
      "_offset": 20505,
      "_bytes": 44,
      "translation": "Mimi... Recuerdas a qué hemos\nvenido, ¿no?"
    },
    {
      "index": 89,
      "english": "Right...we were trying to meet up\nwith everyone.",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 20550,
      "_bytes": 48,
      "translation": "Sí... Busquemos a los demás."
    },
    {
      "index": 90,
      "english": "Let's stay on track and look for\nthem!",
      "speaker_id": 2521,
      "line_type": 2,
      "_offset": 20599,
      "_bytes": 38,
      "translation": "Céntrate y busquémoslos."
    },
    {
      "index": 91,
      "english": "Mimi! We won't find anything by\ngoing that way!",
      "speaker_id": 2521,
      "line_type": 2,
      "_offset": 20638,
      "_bytes": 47,
      "translation": "¡Mimi! ¡Por ahí no encontraremos\nnada!"
    },
    {
      "index": 92,
      "english": "It's not this way?",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 20686,
      "_bytes": 18,
      "translation": "¿No es por aquí?"
    },
    {
      "index": 93,
      "english": "Tai! I'm so glad you're okay!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 20705,
      "_bytes": 32,
      "translation": "¡Tai! ¡Me alegra que estés bien!"
    },
    {
      "index": 94,
      "english": "This is fun, this is fun!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 20738,
      "_bytes": 25,
      "translation": "¡Qué diver, qué diver!"
    },
    {
      "index": 95,
      "english": "I don't see anything fun.",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 20764,
      "_bytes": 25,
      "translation": "No veo nada diver..."
    },
    {
      "index": 96,
      "english": "I'm super-super-super-happy!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 20790,
      "_bytes": 28,
      "translation": "¡Soy supersupersuperfeliz!"
    },
    {
      "index": 97,
      "english": "This isn't like you at all,\nMatt!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 20819,
      "_bytes": 35,
      "translation": "¡Qué raro estás, Matt!"
    },
    {
      "index": 98,
      "english": "Mimi, something's got to be behind\nthis.",
      "speaker_id": 2521,
      "line_type": 2,
      "_offset": 20855,
      "_bytes": 40,
      "translation": "Mimi, hay algo tras esto."
    },
    {
      "index": 99,
      "english": "Sora! I'm so glad to see you here!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 20896,
      "_bytes": 34,
      "translation": "¡Sora! ¡Me alegro de que estés aquí!"
    },
    {
      "index": 100,
      "english": "This is really, really fun!",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 20931,
      "_bytes": 27,
      "translation": "¡Es súper súper divertido!"
    },
    {
      "index": 101,
      "english": "What's so fun about it?",
      "speaker_id": 2521,
      "line_type": 2,
      "_offset": 20959,
      "_bytes": 23,
      "translation": "¿Qué es lo divertido?"
    },
    {
      "index": 102,
      "english": "Why is Sora acting like this?",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 20983,
      "_bytes": 29,
      "translation": "¿Por qué se comporta así Sora?"
    },
    {
      "index": 103,
      "english": "Izzy! I've been looking for\nyou!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 21013,
      "_bytes": 37,
      "translation": "¡Izzy! ¡Te he estado buscando!"
    },
    {
      "index": 104,
      "english": "I'm happy, I'm happy!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 21051,
      "_bytes": 21,
      "translation": "¡Soy feliz, feliz!"
    },
    {
      "index": 105,
      "english": "Izzy...",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 21073,
      "_bytes": 12,
      "translation": "Izzy..."
    },
    {
      "index": 106,
      "english": "Joe! Pull yourself together!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 21086,
      "_bytes": 28,
      "translation": "¡Joe! ¡Compórtate!"
    },
    {
      "index": 107,
      "english": "This is the best! This is\ndefinitely the best!",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 21115,
      "_bytes": 46,
      "translation": "¡Esto es lo mejor, es lo mejor!"
    },
    {
      "index": 108,
      "english": "Why's he clapping like a machine?",
      "speaker_id": 2521,
      "line_type": 2,
      "_offset": 21162,
      "_bytes": 33,
      "translation": "¿Por qué aplaude como un mono?"
    },
    {
      "index": 109,
      "english": "Don't do that...",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 21196,
      "_bytes": 16,
      "translation": "No hagas eso..."
    },
    {
      "index": 110,
      "english": "Yay! Yay!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 21213,
      "_bytes": 9,
      "translation": "¡Yujuuuu!"
    },
    {
      "index": 111,
      "english": "T.K! What's going on?",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 21223,
      "_bytes": 24,
      "translation": "¡T.K.! ¿Pero qué te pasa?"
    },
    {
      "index": 112,
      "english": "Seems like he can't hear you.",
      "speaker_id": 2521,
      "line_type": 2,
      "_offset": 21248,
      "_bytes": 29,
      "translation": "Parece que no te escucha..."
    },
    {
      "index": 113,
      "english": "It's like everyone's lost their\nemotions.",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 21278,
      "_bytes": 41,
      "translation": "Parece que nadie tiene emociones\npropias."
    },
    {
      "index": 114,
      "english": "Their Digimon should be with them,\nbut I haven't seen them at all...",
      "speaker_id": 2521,
      "line_type": 2,
      "_offset": 21320,
      "_bytes": 68,
      "translation": "Y los Digimon no les acompañan...\nno los he visto."
    },
    {
      "index": 115,
      "english": "Welcome to Toy Town!",
      "speaker_id": 4051,
      "line_type": 2,
      "_offset": 21389,
      "_bytes": 20,
      "translation": "¡Bienvenidos!"
    },
    {
      "index": 116,
      "english": "He's back!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 21410,
      "_bytes": 10,
      "translation": "¡Ha vuelto!"
    },
    {
      "index": 117,
      "english": "Mimi, Monzaemon's a really strong\nDigimon! We have to run!",
      "speaker_id": 2521,
      "line_type": 2,
      "_offset": 21421,
      "_bytes": 58,
      "translation": "Mimi, ¡Monzaemon es muy fuerte!\n¡Tenemos que marcharnos!"
    },
    {
      "index": 118,
      "english": "But...",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 21480,
      "_bytes": 6,
      "translation": "Pero..."
    },
    {
      "index": 119,
      "english": "Time to erase the children's\nemotions and make them into toys\nfor the toys!",
      "speaker_id": 4051,
      "line_type": 2,
      "_offset": 21487,
      "_bytes": 75,
      "translation": "¡Hora de borrar sus emociones, y\nconvertirlos en juguetes para mis\njuguetes!"
    },
    {
      "index": 120,
      "english": "We've been waiting for you, miss.",
      "speaker_id": 4051,
      "line_type": 2,
      "_offset": 21563,
      "_bytes": 33,
      "translation": "¡Te esperábamos, guapa!"
    },
    {
      "index": 121,
      "english": "What's with you!? I don't really\nget what happened, but you took\naway my friends' emotions, right?",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 21597,
      "_bytes": 98,
      "translation": "¿¡Qué tramas!? No sé exactamente\nqué pasa, pero has robado las\nemociones de mis amigos, ¿no?"
    },
    {
      "index": 122,
      "english": "Please relax and enjoy yourself.",
      "speaker_id": 4051,
      "line_type": 2,
      "_offset": 21696,
      "_bytes": 32,
      "translation": "Relájate y disfruta."
    },
    {
      "index": 123,
      "english": "Mimiiii!",
      "speaker_id": 2521,
      "line_type": 2,
      "_offset": 21729,
      "_bytes": 8,
      "translation": "¡Mimiii!"
    },
    {
      "index": 124,
      "english": "Kyaaah!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 21738,
      "_bytes": 7,
      "translation": "¡Kyaah!"
    },
    {
      "index": 125,
      "english": "We're here to save ya, missy!",
      "speaker_id": 4031,
      "line_type": 2,
      "_offset": 21746,
      "_bytes": 29,
      "translation": "¡Te salvaremos, preciosa!"
    },
    {
      "index": 126,
      "english": "Numemon!!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 21776,
      "_bytes": 9,
      "translation": "¡¡Numemon!!"
    },
    {
      "index": 127,
      "english": "The Numemon... but why?",
      "speaker_id": 2521,
      "line_type": 2,
      "_offset": 21786,
      "_bytes": 23,
      "translation": "Los Numemon... ¿por qué?"
    },
    {
      "index": 128,
      "english": "Let's go! Hi-yah!",
      "speaker_id": 4031,
      "line_type": 2,
      "_offset": 21810,
      "_bytes": 17,
      "translation": "¡Vamos! ¡Hiaa!"
    },
    {
      "index": 129,
      "english": "Even though they can't do anything\nbut throw poop...",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 21828,
      "_bytes": 52,
      "translation": "A pesar de sólo poder lanzar\ncaca..."
    },
    {
      "index": 130,
      "english": "Even those dirty and spineless\nNumemon are helping her! I have to\nprotect Mimi, too! I...",
      "speaker_id": 2521,
      "line_type": 2,
      "_offset": 21881,
      "_bytes": 89,
      "translation": "Hasta esos sucios y blandurrios\nNumemon la están ayudando. ¡Tengo\nque proteger a Mimi!"
    },
    {
      "index": 131,
      "english": "Palmon evolved too!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 21971,
      "_bytes": 19,
      "translation": "¡Digievolucionó!"
    },
    {
      "index": 132,
      "english": "Put 'em up! This is for Mimi and\nthe Numemon!",
      "speaker_id": 2531,
      "line_type": 2,
      "_offset": 21991,
      "_bytes": 45,
      "translation": "¡Alto ahí! ¡Esto es por Mimi y\nlos Numemon!"
    },
    {
      "index": 133,
      "english": "Mimi!",
      "speaker_id": 2521,
      "line_type": 2,
      "_offset": 22037,
      "_bytes": 5,
      "translation": "¡Mimi!"
    },
    {
      "index": 134,
      "english": "Wow! Palmon, that was amazing!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 22043,
      "_bytes": 30,
      "translation": "Palmon, ¡ha sido increíble!"
    },
    {
      "index": 135,
      "english": "You're hugging me too tightly.\nOww...",
      "speaker_id": 2521,
      "line_type": 2,
      "_offset": 22074,
      "_bytes": 37,
      "translation": "Me abrazas muy fuerte. Auu..."
    },
    {
      "index": 136,
      "english": "Tai!",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 22112,
      "_bytes": 7,
      "translation": "¡Tai!"
    },
    {
      "index": 137,
      "english": "You're safe and sound, Agumon!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 22120,
      "_bytes": 30,
      "translation": "¡Estás bien, Agumon!"
    },
    {
      "index": 138,
      "english": "We got captured by Monzaemon, and\nhe locked us up.",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 22151,
      "_bytes": 50,
      "translation": "Nos capturó Monzaemon y nos\nencerró."
    },
    {
      "index": 139,
      "english": "Looks like everyone's back to\nnormal.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 22202,
      "_bytes": 37,
      "translation": "Parece que recuperamos la\nnormalidad."
    },
    {
      "index": 140,
      "english": "Thank you, Mimi and Palmon!",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 22240,
      "_bytes": 27,
      "translation": "¡Gracias, Mimi y Palmon!"
    },
    {
      "index": 141,
      "english": "I'm sorry.",
      "speaker_id": 4051,
      "line_type": 2,
      "_offset": 22268,
      "_bytes": 10,
      "translation": "Lo siento."
    },
    {
      "index": 142,
      "english": "Thoughtlessly throwing away toys\nafter getting bored of them...",
      "speaker_id": 4051,
      "line_type": 2,
      "_offset": 22279,
      "_bytes": 63,
      "translation": "Que tiraran los juguetes sin más\nal aburrirse de ellos..."
    },
    {
      "index": 143,
      "english": "I couldn't allow that.",
      "speaker_id": 4051,
      "line_type": 2,
      "_offset": 22343,
      "_bytes": 22,
      "translation": "No podía permitirlo."
    },
    {
      "index": 144,
      "english": "Ah! A black gear.",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 22366,
      "_bytes": 17,
      "translation": "¡Una rueda negra!"
    },
    {
      "index": 145,
      "english": "So it was because of that gear,\nhuh?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 22384,
      "_bytes": 36,
      "translation": "Así que esa era la causa, ¿eh?"
    },
    {
      "index": 146,
      "english": "Palmon, thank you for bringing my\nconceited heart back to its\nsenses.",
      "speaker_id": 4051,
      "line_type": 2,
      "_offset": 22421,
      "_bytes": 69,
      "translation": "Palmon, gracias por devolver a\nsus cabales mi corazón vanidoso."
    },
    {
      "index": 147,
      "english": "Missy! Give me a kiss as your\nthanks!",
      "speaker_id": 4031,
      "line_type": 2,
      "_offset": 22491,
      "_bytes": 37,
      "translation": "¡Preciosa! ¡Un besito para dar\ngracias!"
    },
    {
      "index": 148,
      "english": "No!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 22529,
      "_bytes": 3,
      "translation": "¡No!"
    },
    {
      "index": 149,
      "english": "Still as blunt as ever, I see...",
      "speaker_id": 4031,
      "line_type": 2,
      "_offset": 22533,
      "_bytes": 32,
      "translation": "Sigue igual de directa..."
    },
    {
      "index": 150,
      "english": "Hahaha!",
      "speaker_id": 9001,
      "line_type": 2,
      "_offset": 22566,
      "_bytes": 7,
      "translation": "¡Jajaja!"
    }
  ]
}