{
  "file_id": "3615",
  "format": "etdf",
  "kind": "ETDF",
  "text_count": 87,
  "dialog": [
    {
      "index": 0,
      "english": "U-Ugh...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 6600,
      "_bytes": 8,
      "translation": "Ugh..."
    },
    {
      "index": 1,
      "english": "Tai! Get yourself together!\nHey, Tai...",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 6609,
      "_bytes": 45,
      "translation": "¡Tai! ¡Espabila!\nOye, Tai..."
    },
    {
      "index": 2,
      "english": "A-Agumon... Where are we?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 6655,
      "_bytes": 25,
      "translation": "Agumon... ¿dónde estamos?"
    },
    {
      "index": 3,
      "english": "I feel like we've been here\nbefore. I definitely feel like\nwe've been here before...",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 6681,
      "_bytes": 84,
      "translation": "Tengo la sensación de que ya\nhemos estado aquí. En serio,\nya hemos estado aquí..."
    },
    {
      "index": 4,
      "english": "Where are the others?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 6766,
      "_bytes": 21,
      "translation": "¿Dónde están todos?"
    },
    {
      "index": 5,
      "english": "They're not here. Looks like it's\njust us.",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 6788,
      "_bytes": 42,
      "translation": "No están. Parece que solo\nestamos nosotros."
    },
    {
      "index": 6,
      "english": "No way... We just got back to the\nDigital World from Tokyo...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 6831,
      "_bytes": 61,
      "translation": "No puede ser... si volvimos\nde Tokio al Digimundo ahora..."
    },
    {
      "index": 7,
      "english": "We'd set up camp and were sleeping\nby the bonfire like we always\ndo...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 6893,
      "_bytes": 70,
      "translation": "Acampamos y dormíamos junto\na la hoguera, como siempre..."
    },
    {
      "index": 8,
      "english": "Do you think maybe we're in a\ndream?",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 6964,
      "_bytes": 36,
      "translation": "¿Crees que esto es un sueño?"
    },
    {
      "index": 9,
      "english": "A dream? Then why are both of us\nin the same dream?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 7001,
      "_bytes": 51,
      "translation": "¿Un sueño? ¿Y por qué\nestamos los dos en el mismo?"
    },
    {
      "index": 10,
      "english": "I guess it's not a dream, then.",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 7053,
      "_bytes": 31,
      "translation": "Pues entonces no es un sueño."
    },
    {
      "index": 11,
      "english": "!!",
      "speaker_id": 9001,
      "line_type": 2,
      "_offset": 7085,
      "_bytes": 2,
      "translation": "!!"
    },
    {
      "index": 12,
      "english": "What's that?",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 7088,
      "_bytes": 12,
      "translation": "¿Qué es eso?"
    },
    {
      "index": 13,
      "english": "Someone's coming.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 7101,
      "_bytes": 17,
      "translation": "Viene alguien."
    },
    {
      "index": 14,
      "english": "Don't move!",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 7119,
      "_bytes": 11,
      "translation": "¡Quietos!"
    },
    {
      "index": 15,
      "english": "!!",
      "speaker_id": 9001,
      "line_type": 2,
      "_offset": 7131,
      "_bytes": 2,
      "translation": "!!"
    },
    {
      "index": 16,
      "english": "It's a Digimon! Who are you?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 7134,
      "_bytes": 28,
      "translation": "¡Es un Digimon! ¿Quién eres?"
    },
    {
      "index": 17,
      "english": "I should be asking *you* that!\nWhat are you doing here?",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 7163,
      "_bytes": 55,
      "translation": "¡Esa pregunta te la hago yo!\n¿Qué haces tú aquí?"
    },
    {
      "index": 18,
      "english": "There's no reason for you to\nsuspect us! We were here before we\nknew it!",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 7219,
      "_bytes": 72,
      "translation": "¡No tienes motivos para\nsospecharnos! ¡Aparecimos aquí\nsin darnos cuenta!"
    },
    {
      "index": 19,
      "english": "Really now...?",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 7292,
      "_bytes": 14,
      "translation": "¿En serio...?"
    },
    {
      "index": 20,
      "english": "Hey, but you guys look pretty\nstrong!",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 7307,
      "_bytes": 37,
      "translation": "¡Oye, pero parecéis fuertes!"
    },
    {
      "index": 21,
      "english": "Huh?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 7345,
      "_bytes": 4,
      "translation": "¿Eh?"
    },
    {
      "index": 22,
      "english": "Wanna fight and see who's\nstronger?",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 7350,
      "_bytes": 35,
      "translation": "¿Peleamos a ver quién es\nmás fuerte?"
    },
    {
      "index": 23,
      "english": "Wait, are you talking to me?",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 7386,
      "_bytes": 28,
      "translation": "¿A mí me hablas?"
    },
    {
      "index": 24,
      "english": "Yeah!",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 7415,
      "_bytes": 5,
      "translation": "¡Sí!"
    },
    {
      "index": 25,
      "english": "What?!",
      "speaker_id": 9001,
      "line_type": 2,
      "_offset": 7421,
      "_bytes": 6,
      "translation": "¡¿Qué?!"
    },
    {
      "index": 26,
      "english": "T-Tai...",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 7428,
      "_bytes": 11,
      "translation": "T-Tai..."
    },
    {
      "index": 27,
      "english": "Hey, hey, wait a second! You're\nsaying some weird stuff, you\nknow...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 7440,
      "_bytes": 68,
      "translation": "¡Espera, espera! Estás\ndiciendo cosas muy raras..."
    },
    {
      "index": 28,
      "english": "I'm not a \"you\"! I'm Hackmon!",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 7509,
      "_bytes": 29,
      "translation": "¡No me llames \"tú\"! ¡Soy Hackmon!"
    },
    {
      "index": 29,
      "english": "Uh, Hackmon... why do you want to\nfight Agumon?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 7539,
      "_bytes": 47,
      "translation": "Hackmon... ¿por qué\nquieres pelear con Agumon?"
    },
    {
      "index": 30,
      "english": "Why? Because I'm itchin' to fight\nsomeone strong!",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 7587,
      "_bytes": 49,
      "translation": "¡Porque tengo ganas de pelear\ncon alguien fuerte!"
    },
    {
      "index": 31,
      "english": "I don't know why I'm here or what\nfor, but...",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 7637,
      "_bytes": 45,
      "translation": "No sé por qué estoy aquí\nni para qué, pero..."
    },
    {
      "index": 32,
      "english": "I just feel like getting in a\nnice, long brawl!",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 7683,
      "_bytes": 47,
      "translation": "¡Solo tengo ganas de una buena\npelea larga!"
    },
    {
      "index": 33,
      "english": "Wait, you were brought here, too?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 7731,
      "_bytes": 33,
      "translation": "Espera, ¿a ti también te trajeron?"
    },
    {
      "index": 34,
      "english": "Yeah! While I was doing my\ntraining off in the mountains...",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 7765,
      "_bytes": 59,
      "translation": "¡Sí! Mientras entrenaba\nen las montañas..."
    },
    {
      "index": 35,
      "english": "Someone approached me while I was\ntaking a nap, and before I knew it\nI was here!",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 7825,
      "_bytes": 80,
      "translation": "¡Alguien se me acercó mientras\ndormía la siesta, y de repente\nya estaba aquí!"
    },
    {
      "index": 36,
      "english": "I was sleeping, so I didn't get to\nsee them, but I certainly felt\nsomeone's presence!",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 7906,
      "_bytes": 85,
      "translation": "¡Estaba dormido, así que no lo vi,\npero sentí la presencia\nde alguien, seguro!"
    },
    {
      "index": 37,
      "english": "Someone's presence?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 7992,
      "_bytes": 19,
      "translation": "¿Sentiste a alguien?"
    },
    {
      "index": 38,
      "english": "!!",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 8012,
      "_bytes": 2,
      "translation": "!!"
    },
    {
      "index": 39,
      "english": "What's wrong, Agumon?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 8015,
      "_bytes": 21,
      "translation": "¿Qué pasa, Agumon?"
    },
    {
      "index": 40,
      "english": "I forgot to say this earlier,\nbut...",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 8037,
      "_bytes": 36,
      "translation": "Se me olvidó decir esto antes,\npero..."
    },
    {
      "index": 41,
      "english": "I also felt like there was someone\nstanding behind us while we were\nsleeping.",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 8074,
      "_bytes": 77,
      "translation": "También sentí que había alguien\ndetrás de nosotros mientras\ndormíamos."
    },
    {
      "index": 42,
      "english": "What?! Why didn't you tell me that\nearlier?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 8152,
      "_bytes": 43,
      "translation": "¡¿Qué?! ¿Por qué no me lo dijiste\nantes?"
    },
    {
      "index": 43,
      "english": "I thought maybe I was just\ndreaming...",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 8196,
      "_bytes": 38,
      "translation": "Pensé que a lo mejor\nestaba soñando..."
    },
    {
      "index": 44,
      "english": "Well, that's fair...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 8235,
      "_bytes": 20,
      "translation": "Tiene lógica..."
    },
    {
      "index": 45,
      "english": "So it seems like you're in my\nboat, then.",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 8256,
      "_bytes": 41,
      "translation": "Parece que estás en mi\nmisma situación."
    },
    {
      "index": 46,
      "english": "Nice to meet you!",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 8298,
      "_bytes": 17,
      "translation": "¡Encantado!"
    },
    {
      "index": 47,
      "english": "I don't wanna hear that! Come on,\nfight me!",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 8316,
      "_bytes": 43,
      "translation": "¡No quiero oír eso! ¡Vamos,\npelea conmigo!"
    },
    {
      "index": 48,
      "english": "Hey... Hey, Tai...",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 8360,
      "_bytes": 21,
      "translation": "Oye... oye, Tai..."
    },
    {
      "index": 49,
      "english": "Hey, why don't we start looking\nfor the exit instead?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 8382,
      "_bytes": 53,
      "translation": "Oye, ¿por qué no buscamos\nla salida mejor?"
    },
    {
      "index": 50,
      "english": "Yeah, yeah, we've been here\nbefore, so we should be able to\nfind an exit!",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 8436,
      "_bytes": 73,
      "translation": "¡Sí, sí, ya hemos estado aquí,\nasí que deberíamos encontrar\nuna salida!"
    },
    {
      "index": 51,
      "english": "Hm...",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 8510,
      "_bytes": 5,
      "translation": "Hm..."
    },
    {
      "index": 52,
      "english": "Aren't there people out there who\nare gonna be worried about you?",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 8516,
      "_bytes": 65,
      "translation": "¿No hay gente ahí fuera\npreocupada por ti?"
    },
    {
      "index": 53,
      "english": "Well, I'm sure \"they\" would be\nconcerned about my absence, but...",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 8582,
      "_bytes": 65,
      "translation": "Seguro que \"ellos\" estarían\npreocupados por mi ausencia,\npero..."
    },
    {
      "index": 54,
      "english": "Are \"they\" your friends?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 8648,
      "_bytes": 24,
      "translation": "¿\"Ellos\" son tus amigos?"
    },
    {
      "index": 55,
      "english": "They're not my friends! More like\nmy caretakers.",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 8673,
      "_bytes": 48,
      "translation": "¡No son mis amigos! Más bien\nmis cuidadores."
    },
    {
      "index": 56,
      "english": "Huh... so you have caretakers?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 8722,
      "_bytes": 30,
      "translation": "Vaya... ¿tienes cuidadores?"
    },
    {
      "index": 57,
      "english": "You're weird.",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 8753,
      "_bytes": 13,
      "translation": "Eres raro."
    },
    {
      "index": 58,
      "english": "Whatever! Let's find a way out of\nhere first.",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 8767,
      "_bytes": 45,
      "translation": "¡Da igual! Busquemos primero\ncómo salir de aquí."
    },
    {
      "index": 59,
      "english": "...Are we gonna be okay?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 8813,
      "_bytes": 24,
      "translation": "...¿Vamos a estar bien?"
    },
    {
      "index": 60,
      "english": "I'm worried, too...",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 8838,
      "_bytes": 19,
      "translation": "Yo también..."
    },
    {
      "index": 61,
      "english": "Hey, Tai! You're not a Digimon,\nare you?",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 8858,
      "_bytes": 43,
      "translation": "¡Oye, Tai! No eres un Digimon,\n¿verdad?"
    },
    {
      "index": 62,
      "english": "Nope! I came to the Digimon world\nfrom another one.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 8902,
      "_bytes": 51,
      "translation": "¡No! Vine al Digimundo\ndesde otro mundo."
    },
    {
      "index": 63,
      "english": "How'd you get there from another\nworld?",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 8954,
      "_bytes": 39,
      "translation": "¿Cómo llegaste aquí desde\notro mundo?"
    },
    {
      "index": 64,
      "english": "Well, at first we couldn't get\nback to our world at all, and then\na lot of stuff happened...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 8994,
      "_bytes": 92,
      "translation": "Al principio no podíamos volver\na nuestro mundo, y luego\npasaron muchas cosas..."
    },
    {
      "index": 65,
      "english": "So, Hackmon, what kind of stuff do\nyou usually do?",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 9087,
      "_bytes": 50,
      "translation": "¿Y tú, Hackmon, qué sueles\nhacer normalmente?"
    },
    {
      "index": 66,
      "english": "I'm training to become stronger!",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 9138,
      "_bytes": 32,
      "translation": "¡Entreno para hacerme más fuerte!"
    },
    {
      "index": 67,
      "english": "Is that it?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 9171,
      "_bytes": 11,
      "translation": "¿Solo eso?"
    },
    {
      "index": 68,
      "english": "Yup! I have a dream, you see.",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 9183,
      "_bytes": 29,
      "translation": "¡Sí! Tengo un sueño, ya ves."
    },
    {
      "index": 69,
      "english": "What's your dream?",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 9213,
      "_bytes": 18,
      "translation": "¿Cuál es tu sueño?"
    },
    {
      "index": 70,
      "english": "Heh heh heh, that's a secret!",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 9232,
      "_bytes": 29,
      "translation": "¡Je je je, eso es secreto!"
    },
    {
      "index": 71,
      "english": "Aw, man.",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 9262,
      "_bytes": 8,
      "translation": "Vaya."
    },
    {
      "index": 72,
      "english": "Ah! There's the exit!",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 9271,
      "_bytes": 21,
      "translation": "¡Ahí está la salida!"
    },
    {
      "index": 73,
      "english": "You're right!",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 9293,
      "_bytes": 13,
      "translation": "¡Tienes razón!"
    },
    {
      "index": 74,
      "english": "So I guess we're parting ways,\nhuh?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 9307,
      "_bytes": 35,
      "translation": "Entonces nos separamos,\n¿no?"
    },
    {
      "index": 75,
      "english": "Hey, Agumon! Can you do me a\nfavor?",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 9343,
      "_bytes": 35,
      "translation": "¡Oye, Agumon! ¿Me haces\nun favor?"
    },
    {
      "index": 76,
      "english": "What?",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 9379,
      "_bytes": 5,
      "translation": "¿Qué?"
    },
    {
      "index": 77,
      "english": "Next time we meet, fight me!",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 9385,
      "_bytes": 28,
      "translation": "¡La próxima vez, pelea\nconmigo!"
    },
    {
      "index": 78,
      "english": "Huh?! Are you serious?",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 9414,
      "_bytes": 22,
      "translation": "¡¿Eh?! ¿En serio?"
    },
    {
      "index": 79,
      "english": "Of course! I'm gonna be really\nstrong by then!",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 9437,
      "_bytes": 46,
      "translation": "¡Claro! ¡Para entonces seré\nmuy fuerte!"
    },
    {
      "index": 80,
      "english": "Hahaha! I knew you'd say that.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 9484,
      "_bytes": 30,
      "translation": "¡Jajaja! Sabía que dirías eso."
    },
    {
      "index": 81,
      "english": "Hey, Tai, at least say\nsomething about this...",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 9515,
      "_bytes": 49,
      "translation": "Oye, Tai, di algo al menos\nsobre esto..."
    },
    {
      "index": 82,
      "english": "See you, Hackmon!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 9565,
      "_bytes": 17,
      "translation": "¡Adiós, Hackmon!"
    },
    {
      "index": 83,
      "english": "Yeah! Take care, you two!",
      "speaker_id": 7181,
      "line_type": 2,
      "_offset": 9583,
      "_bytes": 25,
      "translation": "¡Sí! ¡Cuidaos los dos!"
    },
    {
      "index": 84,
      "english": "　　　　　　【Area 1】",
      "speaker_id": 9003,
      "line_type": 4,
      "_offset": 9609,
      "_bytes": 22,
      "translation": "Zona 1"
    },
    {
      "index": 85,
      "english": "　　　　　　【Area 2】",
      "speaker_id": 9003,
      "line_type": 4,
      "_offset": 9632,
      "_bytes": 22,
      "translation": "Zona 2"
    },
    {
      "index": 86,
      "english": "　　　　　　【Area 3】",
