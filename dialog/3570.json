  "dialog": [
    {
      "index": 0,
      "english": "Not this one, not this one...",
      "_offset": 5190,
      "_length": 29,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 1,
      "english": "All right, next!",
      "_offset": 5220,
      "_length": 16,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 2,
      "english": "You understand, right? If you lie\nto me, I'll massacre these\nchildren!",
      "_offset": 5237,
      "_length": 70,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 3,
      "english": "PicoDevimon!",
      "_offset": 5316,
      "_length": 12,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 4,
      "english": "PicoDevimon!",
      "_offset": 5329,
      "_length": 12,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 5,
      "english": "Lord Vamdemon!",
      "_offset": 5342,
      "_length": 14,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 6,
      "english": "What now?",
      "_offset": 5357,
      "_length": 9,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 7,
      "english": "We have found the eighth child.",
      "_offset": 5367,
      "_length": 31,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 8,
      "english": "What?!",
      "_offset": 5399,
      "_length": 6,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 9,
      "english": "What?!",
      "_offset": 5406,
      "_length": 6,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 10,
      "english": "What?! They found them?!",
      "_offset": 5413,
      "_length": 24,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 11,
      "english": "Hikari!",
      "_offset": 5438,
      "_length": 7,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 12,
      "english": "Did you hear that, Tailmon? Now\nthat we know this, there's no need \nto remain here anymore!",
      "_offset": 5446,
      "_length": 91,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 13,
      "english": "Yes, sir! What should we do with\nour captives?",
      "_offset": 5538,
      "_length": 46,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 14,
      "english": "Put them to sleep. I'll dine on\nthem later.",
      "_offset": 5585,
      "_length": 43,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 15,
      "english": "Okay, Taichi. Let's hurry up and\ngo to the International Exhibition\nCenter!",
      "_offset": 5629,
      "_length": 75,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 16,
      "english": "Yeah. But Agumon, can you really\ntake all those Digimon in there by\nyourself?",
      "_offset": 5705,
      "_length": 77,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 17,
      "english": "Don't worry. If we contact the \nothers, *we'll* be the unbeatable \nones. For now, save your energy.",
      "_offset": 5787,
      "_length": 99,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 18,
      "english": "Now's not the time to be going\nhome! We have to hurry to the\nInternational Exhibition Center!",
      "_offset": 5887,
      "_length": 93,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 19,
      "english": "Leave Hikari to Yamato and Sora. I \nhave to get to the International \nExhibition Center right away...",
      "_offset": 5981,
      "_length": 101,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 20,
      "english": "Vamdemon...",
      "_offset": 6083,
      "_length": 11,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 21,
      "english": "I wonder where he's going?",
      "_offset": 6095,
      "_length": 26,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 22,
      "english": "They're trapped in there. Let's go\nfind them!",
      "_offset": 6122,
      "_length": 45,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 23,
      "english": "Ah! Taichiiiiiiiiii!",
      "_offset": 6168,
      "_length": 20,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 24,
      "english": "Where are they keeping everyone?",
      "_offset": 6189,
      "_length": 32,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 25,
      "english": "They were put to sleep!",
      "_offset": 6222,
      "_length": 23,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 26,
      "english": "More importantly, Vamdemon said\nthat they found the eighth child!",
      "_offset": 6246,
      "_length": 65,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 27,
      "english": "What?! Could Hikari have been...",
      "_offset": 6312,
      "_length": 32,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 28,
      "english": "Huh?! Hikari?!",
      "_offset": 6345,
      "_length": 14,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 29,
      "english": "I'll fill you in on the details\nlater. Let's go!",
      "_offset": 6360,
      "_length": 48,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 30,
      "english": "Y-Yeah!",
      "_offset": 6409,
      "_length": 7,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 31,
      "english": "Ah, there's Yamato! Sora, too!",
      "_offset": 6417,
      "_length": 30,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 32,
      "english": "What, Yamato?! Why's he here?!",
      "_offset": 6448,
      "_length": 30,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 33,
      "english": "M-Monsters?!",
      "_offset": 6479,
      "_length": 12,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 34,
      "english": "They're not monsters, they're\nDigimon. Please don't worry;\nthey're our allies!",
      "_offset": 6492,
      "_length": 78,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 35,
      "english": "A-Allies?!",
      "_offset": 6571,
      "_length": 10,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 36,
      "english": "Yamato! Sora!",
      "_offset": 6582,
      "_length": 13,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 37,
      "english": "Koushirou! So you were here?!",
      "_offset": 6596,
      "_length": 29,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 38,
      "english": "Yamato!",
      "_offset": 6626,
      "_length": 7,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 39,
      "english": "Dad!",
      "_offset": 6634,
      "_length": 4,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 40,
      "english": "Heeeeeeey!",
      "_offset": 6639,
      "_length": 10,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 41,
      "english": "...Jou?",
      "_offset": 6650,
      "_length": 7,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 42,
      "english": "Takeru!",
      "_offset": 6658,
      "_length": 7,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 43,
      "english": "Takeru...",
      "_offset": 6666,
      "_length": 9,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 44,
      "english": "Daddy!",
      "_offset": 6676,
      "_length": 6,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 45,
      "english": "Why are you here?",
      "_offset": 6683,
      "_length": 17,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 46,
      "english": "I was so worried about you and\nYamato. I had to come here and\ncheck up on you.",
      "_offset": 6701,
      "_length": 78,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 47,
      "english": "Mommy brought me part of the way\nhere, too.",
      "_offset": 6780,
      "_length": 43,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 48,
      "english": "That Digimon is...",
      "_offset": 6828,
      "_length": 18,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 49,
      "english": "What are you planning to do?",
      "_offset": 6851,
      "_length": 28,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 50,
      "english": "Was she hit by Vamdemon's Dead\nScream?",
      "_offset": 6880,
      "_length": 38,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 51,
      "english": "So what if she was?",
      "_offset": 6919,
      "_length": 19,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 52,
      "english": "...mmmfh.",
      "_offset": 6939,
      "_length": 9,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 53,
      "english": "Lilimon?",
      "_offset": 6949,
      "_length": 8,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 54,
      "english": "Huh? What was I...?",
      "_offset": 6958,
      "_length": 19,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 55,
      "english": "He's not a bad Digimon!",
      "_offset": 6978,
      "_length": 23,
      "speaker_id": 0,
      "translation": ""
    },
