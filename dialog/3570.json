{
  "file_id": "3570",
  "text_count": 161,
  "dialog": [
    {
      "index": 0,
      "english": "Not this one, not this one...",
      "_offset": 5190,
      "_length": 29,
      "speaker_id": 0,
      "translation": "Esta no, esta no..."
    },
    {
      "index": 1,
      "english": "All right, next!",
      "_offset": 5220,
      "_length": 16,
      "speaker_id": 0,
      "translation": "Vale, siguiente!"
    },
    {
      "index": 2,
      "english": "You understand, right? If you lie\nto me, I'll massacre these\nchildren!",
      "_offset": 5237,
      "_length": 70,
      "speaker_id": 0,
      "translation": "Lo entiendes, verdad? Si me\nmientes, masacraré a\nestos niños!"
    },
    {
      "index": 3,
      "english": "PicoDevimon!",
      "_offset": 5316,
      "_length": 12,
      "speaker_id": 0,
      "translation": "DemiDevimon!"
    },
    {
      "index": 4,
      "english": "PicoDevimon!",
      "_offset": 5329,
      "_length": 12,
      "speaker_id": 0,
      "translation": "DemiDevimon!"
    },
    {
      "index": 5,
      "english": "Lord Vamdemon!",
      "_offset": 5342,
      "_length": 14,
      "speaker_id": 0,
      "translation": "Amo Myotismon!"
    },
    {
      "index": 6,
      "english": "What now?",
      "_offset": 5357,
      "_length": 9,
      "speaker_id": 0,
      "translation": "Qué pasa?"
    },
    {
      "index": 7,
      "english": "We have found the eighth child.",
      "_offset": 5367,
      "_length": 31,
      "speaker_id": 0,
      "translation": "Hemos encontrado al octavo niño"
    },
    {
      "index": 8,
      "english": "What?!",
      "_offset": 5399,
      "_length": 6,
      "speaker_id": 0,
      "translation": "Qué?!"
    },
    {
      "index": 9,
      "english": "What?!",
      "_offset": 5406,
      "_length": 6,
      "speaker_id": 0,
      "translation": "Qué?!"
    },
    {
      "index": 10,
      "english": "What?! They found them?!",
      "_offset": 5413,
      "_length": 24,
      "speaker_id": 0,
      "translation": "Qué?! Los encontraron?!"
    },
    {
      "index": 11,
      "english": "Kari!",
      "_offset": 5438,
      "_length": 7,
      "speaker_id": 0,
      "translation": "Kari!"
    },
    {
      "index": 12,
      "english": "Did you hear that, Tailmon? Now\nthat we know this, there's no need \nto remain here anymore!",
      "_offset": 5446,
      "_length": 91,
      "speaker_id": 0,
      "translation": "Oíste eso, Gatomon? Ahora\nque lo sabemos, ya no hace\nfalta seguir aquí!"
    },
    {
      "index": 13,
      "english": "Yes, sir! What should we do with\nour captives?",
      "_offset": 5538,
      "_length": 46,
      "speaker_id": 0,
      "translation": "Sí, señor! Qué hacemos con\nlos cautivos?"
    },
    {
      "index": 14,
      "english": "Put them to sleep. I'll dine on\nthem later.",
      "_offset": 5585,
      "_length": 43,
      "speaker_id": 0,
      "translation": "Ponlos a dormir. Los cenaré\nmás tarde."
    },
    {
      "index": 15,
      "english": "Okay, Tai. Let's hurry up and\ngo to the International Exhibition\nCenter!",
      "_offset": 5629,
      "_length": 75,
      "speaker_id": 0,
      "translation": "Vale, Tai. Vamos deprisa al\nTokyo Big Sight!"
    },
    {
      "index": 16,
      "english": "Yeah. But Agumon, can you really\ntake all those Digimon in there by\nyourself?",
      "_offset": 5705,
      "_length": 77,
      "speaker_id": 0,
      "translation": "Sí. Pero Agumon, podrás tú\nsolo con todos esos\nDigimon de ahí?"
    },
    {
      "index": 17,
      "english": "Don't worry. If we contact the \nothers, *we'll* be the unbeatable \nones. For now, save your energy.",
      "_offset": 5787,
      "_length": 99,
      "speaker_id": 0,
      "translation": "Tranquilo. Si avisamos a\nlos demás, nosotros seremos\nlos invencibles. Ahorra energía"
    },
    {
      "index": 18,
      "english": "Now's not the time to be going\nhome! We have to hurry to the\nInternational Exhibition Center!",
      "_offset": 5887,
      "_length": 93,
      "speaker_id": 0,
      "translation": "No es hora de volver a casa!\nHay que ir corriendo al\nTokyo Big Sight!"
    },
    {
      "index": 19,
      "english": "Leave Kari to Matt and Sora. I \nhave to get to the International \nExhibition Center right away...",
      "_offset": 5981,
      "_length": 101,
      "speaker_id": 0,
      "translation": "Dejad a Kari con Matt y Sora.\nTengo que ir ya al\nTokyo Big Sight."
    },
    {
      "index": 20,
      "english": "Vamdemon...",
      "_offset": 6083,
      "_length": 11,
      "speaker_id": 0,
      "translation": "Myotismon.."
    },
    {
      "index": 21,
      "english": "I wonder where he's going?",
      "_offset": 6095,
      "_length": 26,
      "speaker_id": 0,
      "translation": "Me pregunto adónde irá?"
    },
    {
      "index": 22,
      "english": "They're trapped in there. Let's go\nfind them!",
      "_offset": 6122,
      "_length": 45,
      "speaker_id": 0,
      "translation": "Están atrapados ahí. Vamos a\nbuscarlos!"
    },
    {
      "index": 23,
      "english": "Ah! Taiiiiiiiiii!",
      "_offset": 6168,
      "_length": 20,
      "speaker_id": 0,
      "translation": "Ah! Taiiiiiiiiii!"
    },
    {
      "index": 24,
      "english": "Where are they keeping everyone?",
      "_offset": 6189,
      "_length": 32,
      "speaker_id": 0,
      "translation": "Dónde tienen a todos?"
    },
    {
      "index": 25,
      "english": "They were put to sleep!",
      "_offset": 6222,
      "_length": 23,
      "speaker_id": 0,
      "translation": "Los durmieron a todos!"
    },
    {
      "index": 26,
      "english": "More importantly, Vamdemon said\nthat they found the eighth child!",
      "_offset": 6246,
      "_length": 65,
      "speaker_id": 0,
      "translation": "Más importante, Myotismon dijo\nque encontraron al octavo niño!"
    },
    {
      "index": 27,
      "english": "What?! Could Kari have been...",
      "_offset": 6312,
      "_length": 32,
      "speaker_id": 0,
      "translation": "Qué?! No será Kari...?"
    },
    {
      "index": 28,
      "english": "Huh?! Kari?!",
      "_offset": 6345,
      "_length": 14,
      "speaker_id": 0,
      "translation": "Eh?! Kari?!"
    },
    {
      "index": 29,
      "english": "I'll fill you in on the details\nlater. Let's go!",
      "_offset": 6360,
      "_length": 48,
      "speaker_id": 0,
      "translation": "Os lo explico luego con\ndetalle. Vamos!"
    },
    {
      "index": 30,
      "english": "Y-Yeah!",
      "_offset": 6409,
      "_length": 7,
      "speaker_id": 0,
      "translation": "S-Sí!"
    },
    {
      "index": 31,
      "english": "Ah, there's Matt! Sora, too!",
      "_offset": 6417,
      "_length": 30,
      "speaker_id": 0,
      "translation": "Ah, ahí está Matt! Y Sora!"
    },
    {
      "index": 32,
      "english": "What, Matt?! Why's he here?!",
      "_offset": 6448,
      "_length": 30,
      "speaker_id": 0,
      "translation": "Qué, Matt?! Qué hace aquí?!"
    },
    {
      "index": 33,
      "english": "M-Monsters?!",
      "_offset": 6479,
      "_length": 12,
      "speaker_id": 0,
      "translation": "M-Monstruos?"
    },
    {
      "index": 34,
      "english": "They're not monsters, they're\nDigimon. Please don't worry;\nthey're our allies!",
      "_offset": 6492,
      "_length": 78,
      "speaker_id": 0,
      "translation": "No son monstruos, son\nDigimon. Tranquilos,\nson nuestros aliados!"
    },
    {
      "index": 35,
      "english": "A-Allies?!",
      "_offset": 6571,
      "_length": 10,
      "speaker_id": 0,
      "translation": "Aliados?!"
    },
    {
      "index": 36,
      "english": "Matt! Sora!",
      "_offset": 6582,
      "_length": 13,
      "speaker_id": 0,
      "translation": "Matt! Sora!"
    },
    {
      "index": 37,
      "english": "Izzy! So you were here?!",
      "_offset": 6596,
      "_length": 29,
      "speaker_id": 0,
      "translation": "Izzy! Tú también aquí?!"
    },
    {
      "index": 38,
      "english": "Matt!",
      "_offset": 6626,
      "_length": 7,
      "speaker_id": 0,
      "translation": "Matt!"
    },
    {
      "index": 39,
      "english": "Dad!",
      "_offset": 6634,
      "_length": 4,
      "speaker_id": 0,
      "translation": "Pa!"
    },
    {
      "index": 40,
      "english": "Heeeeeeey!",
      "_offset": 6639,
      "_length": 10,
      "speaker_id": 0,
      "translation": "Eeeeeeeeh!"
    },
    {
      "index": 41,
      "english": "...Joe?",
      "_offset": 6650,
      "_length": 7,
      "speaker_id": 0,
      "translation": "...Joe?"
    },
    {
      "index": 42,
      "english": "T.K!",
      "_offset": 6658,
      "_length": 7,
      "speaker_id": 0,
      "translation": "T.K!"
    },
    {
      "index": 43,
      "english": "T.K...",
      "_offset": 6666,
      "_length": 9,
      "speaker_id": 0,
      "translation": "T.K..."
    },
    {
      "index": 44,
      "english": "Daddy!",
      "_offset": 6676,
      "_length": 6,
      "speaker_id": 0,
      "translation": "Papá!"
    },
    {
      "index": 45,
      "english": "Why are you here?",
      "_offset": 6683,
      "_length": 17,
      "speaker_id": 0,
      "translation": "Qué haces aquí?"
    },
    {
      "index": 46,
      "english": "I was so worried about you and\nMatt. I had to come here and\ncheck up on you.",
      "_offset": 6701,
      "_length": 78,
      "speaker_id": 0,
      "translation": "Estaba preocupado por ti y\npor Matt. Tenía que venir\na veros."
    },
    {
      "index": 47,
      "english": "Mommy brought me part of the way\nhere, too.",
      "_offset": 6780,
      "_length": 43,
      "speaker_id": 0,
      "translation": "Mamá también me trajo parte\ndel camino."
    },
    {
      "index": 48,
      "english": "That Digimon is...",
      "_offset": 6828,
      "_length": 18,
      "speaker_id": 0,
      "translation": "Ese Digimon es..."
    },
    {
      "index": 49,
      "english": "What are you planning to do?",
      "_offset": 6851,
      "_length": 28,
      "speaker_id": 0,
      "translation": "Qué es lo que piensas hacer?"
    },
    {
      "index": 50,
      "english": "Was she hit by Vamdemon's Dead\nScream?",
      "_offset": 6880,
      "_length": 38,
      "speaker_id": 0,
      "translation": "Le dio el Grito Mortal de\nMyotismon?"
    },
    {
      "index": 51,
      "english": "So what if she was?",
      "_offset": 6919,
      "_length": 19,
      "speaker_id": 0,
      "translation": "Y qué si lo fue?"
    },
    {
      "index": 52,
      "english": "...mmmfh.",
      "_offset": 6939,
      "_length": 9,
      "speaker_id": 0,
      "translation": "...mmmfh."
    },
    {
      "index": 53,
      "english": "Lilimon?",
      "_offset": 6949,
      "_length": 8,
      "speaker_id": 0,
      "translation": "Lilimon?"
    },
    {
      "index": 54,
      "english": "Huh? What was I...?",
      "_offset": 6958,
      "_length": 19,
      "speaker_id": 0,
      "translation": "Eh? Qué estaba...?"
    },
    {
      "index": 55,
      "english": "He's not a bad Digimon!",
      "_offset": 6978,
      "_length": 23,
      "speaker_id": 0,
      "translation": "No es un Digimon malo!"
    },
    {
      "index": 56,
      "english": "He's got a Tag and a Crest.",
      "_offset": 7002,
      "_length": 27,
      "speaker_id": 0,
      "translation": "Tiene Circuito y Emblema."
    },
    {
      "index": 57,
      "english": "So that's...",
      "_offset": 7030,
      "_length": 12,
      "speaker_id": 0,
      "translation": "Entonces..."
    },
    {
      "index": 58,
      "english": "Kari's Tag and Crest.",
      "_offset": 7043,
      "_length": 23,
      "speaker_id": 0,
      "translation": "Circ. y Emblema de Kari"
    },
    {
      "index": 59,
      "english": "I want to rescue Tailmon. She's\nbeen captured by Vamdemon.",
      "_offset": 7070,
      "_length": 58,
      "speaker_id": 0,
      "translation": "Quiero rescatar a Gatomon.\nMyotismon la capturó."
    },
    {
      "index": 60,
      "english": "Tailmon is the eighth child's\nDigimon!",
      "_offset": 7129,
      "_length": 38,
      "speaker_id": 0,
      "translation": "Gatomon es el Digimon del\noctavo niño!"
    },
    {
      "index": 61,
      "english": "What?!",
      "_offset": 7168,
      "_length": 6,
      "speaker_id": 0,
      "translation": "Qué?!"
    },
    {
      "index": 62,
      "english": "Are you serious?!",
      "_offset": 7175,
      "_length": 17,
      "speaker_id": 0,
      "translation": "Hablas en serio?!"
    },
    {
      "index": 63,
      "english": "No way...",
      "_offset": 7193,
      "_length": 9,
      "speaker_id": 0,
      "translation": "Qué va..."
    },
    {
      "index": 64,
      "english": "Where is Kari right now?",
      "_offset": 7203,
      "_length": 26,
      "speaker_id": 0,
      "translation": "Dónde está Kari ahora?"
    },
    {
      "index": 65,
      "english": "She... she was captured and taken\nto Vamdemon.",
      "_offset": 7230,
      "_length": 46,
      "speaker_id": 0,
      "translation": "Ella... la capturó Myotismon."
    },
    {
      "index": 66,
      "english": "According to Gennai, it appears\nthat the center of the barrier is\non this rooftop.",
      "_offset": 7277,
      "_length": 82,
      "speaker_id": 0,
      "translation": "Según Gennai, el centro de\nla barrera parece estar\nen esta azotea."
    },
    {
      "index": 67,
      "english": "It shouldn't be long before\nVamdemon arrives there, too...",
      "_offset": 7360,
      "_length": 58,
      "speaker_id": 0,
      "translation": "No tardará en llegar\nMyotismon también..."
    },
    {
      "index": 68,
      "english": "Let's go, guys!",
      "_offset": 7419,
      "_length": 15,
      "speaker_id": 0,
      "translation": "Vamos, chicos!"
    },
    {
      "index": 69,
      "english": "All right, I'll lead you there!",
      "_offset": 7435,
      "_length": 31,
      "speaker_id": 0,
      "translation": "Vale, os llevo hasta allí!"
    },
    {
      "index": 70,
      "english": "Grrrrrrrr!",
      "_offset": 7467,
      "_length": 10,
      "speaker_id": 0,
      "translation": "Grrrrrrrr!"
    },
    {
      "index": 71,
      "english": "Gsssshaaaaaaah!",
      "_offset": 7478,
      "_length": 15,
      "speaker_id": 0,
      "translation": "Gsssshaaaaaaah!"
    },
    {
      "index": 72,
      "english": "Aaaaaaaah!",
      "_offset": 7494,
      "_length": 10,
      "speaker_id": 0,
      "translation": "Aaaaaaaah!"
    },
    {
      "index": 73,
      "english": "Gh! Don't get in our way!",
      "_offset": 7505,
      "_length": 25,
      "speaker_id": 0,
      "translation": "Gh! No os interpongáis!"
    },
    {
      "index": 74,
      "english": "We're saved. Thank you, everyone!",
      "_offset": 7531,
      "_length": 33,
      "speaker_id": 0,
      "translation": "Nos habéis salvado. Gracias!"
    },
    {
      "index": 75,
      "english": "Heh heh heh!",
      "_offset": 7565,
      "_length": 12,
      "speaker_id": 0,
      "translation": "Je je je!"
    },
    {
      "index": 76,
      "english": "Come on, let's hurry to the roof!",
      "_offset": 7578,
      "_length": 33,
      "speaker_id": 0,
      "translation": "Venga, subamos ya a la azotea!"
    },
    {
      "index": 77,
      "english": "Matt, we have to hurry to the\nroof!",
      "_offset": 7612,
      "_length": 37,
      "speaker_id": 0,
      "translation": "Matt, hay que subir ya\na la azotea!"
    },
    {
      "index": 78,
      "english": "Yeah, you're right.",
      "_offset": 7650,
      "_length": 19,
      "speaker_id": 0,
      "translation": "Sí, tienes razón."
    },
    {
      "index": 79,
      "english": "Why did you come forward by your\nown will, little girl?",
      "_offset": 7670,
      "_length": 55,
      "speaker_id": 0,
      "translation": "Por qué has venido tú sola,\npequeña?"
    },
    {
      "index": 80,
      "english": "Because you were hurting everyone.",
      "_offset": 7726,
      "_length": 34,
      "speaker_id": 0,
      "translation": "Porque hacías daño a todos."
    },
    {
      "index": 81,
      "english": "Hahaha. Tailmon, why won't you\nlook at the eighth child?",
      "_offset": 7761,
      "_length": 56,
      "speaker_id": 0,
      "translation": "Jajaja. Gatomon, por qué no\nmiras al octavo niño?"
    },
    {
      "index": 82,
      "english": "I don't know that girl. She's not\nthe eighth child.",
      "_offset": 7818,
      "_length": 51,
      "speaker_id": 0,
      "translation": "No conozco a esa niña. No es\nel octavo niño."
    },
    {
      "index": 83,
      "english": "I see...",
      "_offset": 7874,
      "_length": 8,
      "speaker_id": 0,
      "translation": "Vaya..."
    },
    {
      "index": 84,
      "english": "Gyaaaaaaah!",
      "_offset": 7883,
      "_length": 11,
      "speaker_id": 0,
      "translation": "Gyaaaaaaah!"
    },
    {
      "index": 85,
      "english": "Kari!",
      "_offset": 7895,
      "_length": 7,
      "speaker_id": 0,
      "translation": "Kari!"
    },
    {
      "index": 86,
      "english": "I see, so the eighth child's name\nis Kari. Kari, Tailmon...\nprepare yourselves.",
      "_offset": 7903,
      "_length": 83,
      "speaker_id": 0,
      "translation": "Ya veo, el octavo niño se\nllama Kari. Kari, Gatomon...\npreparaos."
    },
    {
      "index": 87,
      "english": "Stop right there!",
      "_offset": 7987,
      "_length": 17,
      "speaker_id": 0,
      "translation": "Alto ahí mismo!"
    },
    {
      "index": 88,
      "english": "Kari!",
      "_offset": 8005,
      "_length": 7,
      "speaker_id": 0,
      "translation": "Kari!"
    },
    {
      "index": 89,
      "english": "Everyone!",
      "_offset": 8013,
      "_length": 9,
      "speaker_id": 0,
      "translation": "Todos!"
    },
    {
      "index": 90,
      "english": "Hahaha, the pesky ones have\narrived.",
      "_offset": 8023,
      "_length": 36,
      "speaker_id": 0,
      "translation": "Jajaja, ya llegaron los\nmolestos."
    },
    {
      "index": 91,
      "english": "This is no time to laugh!",
      "_offset": 8060,
      "_length": 25,
      "speaker_id": 0,
      "translation": "No es hora de reír!"
    },
    {
      "index": 92,
      "english": "Guys!",
      "_offset": 8086,
      "_length": 5,
      "speaker_id": 0,
      "translation": "Hola!"
    },
    {
      "index": 93,
      "english": "Sorry to keep you waiting!",
      "_offset": 8092,
      "_length": 26,
      "speaker_id": 0,
      "translation": "Perdón por la espera!"
    },
    {
      "index": 94,
      "english": "Mimi!",
      "_offset": 8119,
      "_length": 5,
      "speaker_id": 0,
      "translation": "Mimi!"
    },
    {
      "index": 95,
      "english": "Everyone's here!",
      "_offset": 8125,
      "_length": 16,
      "speaker_id": 0,
      "translation": "Ya están todos!"
    },
    {
      "index": 96,
      "english": "Everyone's here!",
      "_offset": 8142,
      "_length": 16,
      "speaker_id": 0,
      "translation": "Ya están todos!"
    },
    {
      "index": 97,
      "english": "I won't allow you to lay a hand on\nmy sister! Kari, take the\nDigivice!",
      "_offset": 8159,
      "_length": 72,
      "speaker_id": 0,
      "translation": "No dejaré que toques a mi\nhermana! Kari, toma el\nDigivice!"
    },
    {
      "index": 98,
      "english": "Ah!",
      "_offset": 8232,
      "_length": 3,
      "speaker_id": 0,
      "translation": "Ah!"
    },
    {
      "index": 99,
      "english": "Lord Vamdemon! There's nothing to\nfear now!",
      "_offset": 8236,
      "_length": 43,
      "speaker_id": 0,
      "translation": "Amo Myotismon! Ya no hay\nnada que temer!"
    },
    {
      "index": 100,
      "english": "Good job! Now none of you will be\nable to oppose me!",
      "_offset": 8280,
      "_length": 52,
      "speaker_id": 0,
      "translation": "Bien hecho! Ahora ninguno\npodrá oponerse a mí!"
    },
    {
      "index": 101,
      "english": "Haaaaaah!",
      "_offset": 8333,
      "_length": 9,
      "speaker_id": 0,
      "translation": "Haaaaaah!"
    },
    {
      "index": 102,
      "english": "Let's go, guys!",
      "_offset": 8343,
