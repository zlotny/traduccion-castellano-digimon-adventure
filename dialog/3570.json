      "index": 69,
      "english": "All right, I'll lead you there!",
      "_offset": 7435,
      "_length": 31,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 70,
      "english": "Grrrrrrrr!",
      "_offset": 7467,
      "_length": 10,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 71,
      "english": "Gsssshaaaaaaah!",
      "_offset": 7478,
      "_length": 15,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 72,
      "english": "Aaaaaaaah!",
