      "index": 75,
      "english": "Heh heh heh!",
      "_offset": 7565,
      "_length": 12,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 76,
      "english": "Come on, let's hurry to the roof!",
      "_offset": 7578,
      "_length": 33,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 77,
      "english": "Yamato, we have to hurry to the\nroof!",
      "_offset": 7612,
      "_length": 37,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 78,
      "english": "Yeah, you're right.",
      "_offset": 7650,
      "_length": 19,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 79,
      "english": "Why did you come forward by your\nown will, little girl?",
      "_offset": 7670,
      "_length": 55,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 80,
      "english": "Because you were hurting everyone.",
      "_offset": 7726,
      "_length": 34,
      "speaker_id": 0,
      "translation": ""
