{
  "file_id": "3570",
  "format": "etdf",
  "kind": "ETDF",
  "text_count": 170,
  "dialog": [
    {
      "index": 0,
      "english": "Not this one, not this one...",
      "speaker_id": 2831,
      "line_type": 2,
      "_offset": 16168,
      "_bytes": 29,
      "translation": "Esta no, esta no..."
    },
    {
      "index": 1,
      "english": "All right, next!",
      "speaker_id": 4121,
      "line_type": 2,
      "_offset": 16198,
      "_bytes": 16,
      "translation": "¡Vale, siguiente!"
    },
    {
      "index": 2,
      "english": "You understand, right? If you lie\nto me, I'll massacre these\nchildren!",
      "speaker_id": 3031,
      "line_type": 2,
      "_offset": 16215,
      "_bytes": 70,
      "translation": "Lo entiendes, ¿verdad? ¡Si me\nmientes, masacraré a\nestos niños!"
    },
    {
      "index": 3,
      "english": "...",
      "speaker_id": 2831,
      "line_type": 2,
      "_offset": 16286,
      "_bytes": 3,
      "translation": "..."
    },
    {
      "index": 4,
      "english": "...",
      "speaker_id": 9003,
      "line_type": 2,
      "_offset": 16290,
      "_bytes": 3,
      "translation": "..."
    },
    {
      "index": 5,
      "english": "PicoDevimon!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 16294,
      "_bytes": 12,
      "translation": "¡DemiDevimon!"
    },
    {
      "index": 6,
      "english": "PicoDevimon!",
      "speaker_id": 9003,
      "line_type": 2,
      "_offset": 16307,
      "_bytes": 12,
      "translation": "¡DemiDevimon!"
    },
    {
      "index": 7,
      "english": "Lord Myotismon!",
      "speaker_id": 4221,
      "line_type": 2,
      "_offset": 16320,
      "_bytes": 14,
      "translation": "¡Amo Myotismon!"
    },
    {
      "index": 8,
      "english": "What now?",
      "speaker_id": 3031,
      "line_type": 2,
      "_offset": 16335,
      "_bytes": 9,
      "translation": "¿Qué pasa?"
    },
    {
      "index": 9,
      "english": "We have found the eighth child.",
      "speaker_id": 4221,
      "line_type": 2,
      "_offset": 16345,
      "_bytes": 31,
      "translation": "Hemos encontrado al octavo niño."
    },
    {
      "index": 10,
      "english": "What?!",
      "speaker_id": 3031,
      "line_type": 2,
      "_offset": 16377,
      "_bytes": 6,
      "translation": "¡¿Qué?!"
    },
    {
      "index": 11,
      "english": "What?!",
      "speaker_id": 9003,
      "line_type": 2,
      "_offset": 16384,
      "_bytes": 6,
      "translation": "¡¿Qué?!"
    },
    {
      "index": 12,
      "english": "What?! They found them?!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 16391,
      "_bytes": 24,
      "translation": "¡¿Qué?! ¡¿Los encontraron?!"
    },
    {
      "index": 13,
      "english": "Kari!",
      "speaker_id": 2831,
      "line_type": 2,
      "_offset": 16416,
      "_bytes": 7,
      "translation": "¡Kari!"
    },
    {
      "index": 14,
      "english": "Did you hear that, Tailmon? Now\nthat we know this, there's no need \nto remain here anymore!",
      "speaker_id": 3031,
      "line_type": 2,
      "_offset": 16424,
      "_bytes": 91,
      "translation": "¿Oíste eso, Gatomon? ¡Ahora\nque lo sabemos, ya no hace\nfalta seguir aquí!"
    },
    {
      "index": 15,
      "english": "Yes, sir! What should we do with\nour captives?",
      "speaker_id": 4221,
      "line_type": 2,
      "_offset": 16516,
      "_bytes": 46,
      "translation": "¡Sí, señor! ¿Qué hacemos con\nlos cautivos?"
    },
    {
      "index": 16,
      "english": "Put them to sleep. I'll dine on\nthem later.",
      "speaker_id": 3031,
      "line_type": 2,
      "_offset": 16563,
      "_bytes": 43,
      "translation": "Ponlos a dormir. Los cenaré\nmás tarde."
    },
    {
      "index": 17,
      "english": "Okay, Tai. Let's hurry up and\ngo to the International Exhibition\nCenter!",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 16607,
      "_bytes": 75,
      "translation": "Vale, Tai. ¡Vamos deprisa al\nTokyo Big Sight!"
    },
    {
      "index": 18,
      "english": "Yeah. But Agumon, can you really\ntake all those Digimon in there by\nyourself?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16683,
      "_bytes": 77,
      "translation": "Sí. Pero Agumon, ¿podrás tú\nsolo con todos esos\nDigimon de ahí?"
    },
    {
      "index": 19,
      "english": "...",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 16761,
      "_bytes": 3,
      "translation": "..."
    },
    {
      "index": 20,
      "english": "Don't worry. If we contact the \nothers, *we'll* be the unbeatable \nones. For now, save your energy.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16765,
      "_bytes": 99,
      "translation": "Tranquilo. Si avisamos a\nlos demás, nosotros seremos\nlos invencibles. Ahorra energía."
    },
    {
      "index": 21,
      "english": "Now's not the time to be going\nhome! We have to hurry to the\nInternational Exhibition Center!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16865,
      "_bytes": 93,
      "translation": "¡No es hora de volver a casa!\n¡Hay que ir corriendo al\nTokyo Big Sight!"
    },
    {
      "index": 22,
      "english": "Leave Kari to Matt and Sora. I \nhave to get to the International \nExhibition Center right away...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16959,
      "_bytes": 101,
      "translation": "Kari está con Matt y Sora.\nTengo que ir ya al\nTokyo Big Sight."
    },
    {
      "index": 23,
      "english": "Myotismon...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17061,
      "_bytes": 11,
      "translation": "Myotismon..."
    },
    {
      "index": 24,
      "english": "I wonder where he's going?",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 17073,
      "_bytes": 26,
      "translation": "Me pregunto adónde irá."
    },
    {
      "index": 25,
      "english": "They're trapped in there. Let's go\nfind them!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17100,
      "_bytes": 45,
      "translation": "Están atrapados ahí. ¡Vamos a\nbuscarlos!"
    },
    {
      "index": 26,
      "english": "Ah! Taiiiiiiiiii!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 17146,
      "_bytes": 20,
      "translation": "¡Ah! ¡Taiiiiiiiiii!"
    },
    {
      "index": 27,
      "english": "Where are they keeping everyone?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17167,
      "_bytes": 32,
      "translation": "¿Dónde tienen a todos?"
    },
    {
      "index": 28,
      "english": "They were put to sleep!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 17200,
      "_bytes": 23,
      "translation": "¡Los durmieron a todos!"
    },
    {
      "index": 29,
      "english": "More importantly, Myotismon said\nthat they found the eighth child!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 17224,
      "_bytes": 65,
      "translation": "¡Y lo más importante: Myotismon\ndijo que encontraron al octavo niño!"
    },
    {
      "index": 30,
      "english": "What?! Could Kari have been...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17290,
      "_bytes": 32,
      "translation": "¡¿Qué?! ¿No será Kari...?"
    },
    {
      "index": 31,
      "english": "Huh?! Kari?!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 17323,
      "_bytes": 14,
      "translation": "¡¿Eh?! ¡¿Kari?!"
    },
    {
      "index": 32,
      "english": "I'll fill you in on the details\nlater. Let's go!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17338,
      "_bytes": 48,
      "translation": "Os lo explico luego con\ndetalle. ¡Vamos!"
    },
    {
      "index": 33,
      "english": "Y-Yeah!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 17387,
      "_bytes": 7,
      "translation": "¡S-Sí!"
    },
    {
      "index": 34,
      "english": "Ah, there's Matt! Sora, too!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 17395,
      "_bytes": 30,
      "translation": "¡Ah, ahí está Matt! ¡Y Sora!"
    },
    {
      "index": 35,
      "english": "What, Matt?! Why's he here?!",
      "speaker_id": 6111,
      "line_type": 2,
      "_offset": 17426,
      "_bytes": 30,
      "translation": "¡¿Qué, Matt?! ¡¿Qué hace aquí?!"
    },
    {
      "index": 36,
      "english": "M-Monsters?!",
      "speaker_id": 6111,
      "line_type": 2,
      "_offset": 17457,
      "_bytes": 12,
      "translation": "¿M-Monstruos?"
    },
    {
      "index": 37,
      "english": "They're not monsters, they're\nDigimon. Please don't worry;\nthey're our allies!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 17470,
      "_bytes": 78,
      "translation": "No son monstruos, son\nDigimon. ¡Tranquilos,\nson nuestros aliados!"
    },
    {
      "index": 38,
      "english": "A-Allies?!",
      "speaker_id": 6111,
      "line_type": 2,
      "_offset": 17549,
      "_bytes": 10,
      "translation": "¡¿Aliados?!"
    },
    {
      "index": 39,
      "english": "Matt! Sora!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 17560,
      "_bytes": 13,
      "translation": "¡Matt! ¡Sora!"
    },
    {
      "index": 40,
      "english": "Izzy! So you were here?!",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 17574,
      "_bytes": 29,
      "translation": "¡Izzy! ¡¿Tú también aquí?!"
    },
    {
      "index": 41,
      "english": "Matt!",
      "speaker_id": 6111,
      "line_type": 2,
      "_offset": 17604,
      "_bytes": 7,
      "translation": "¡Matt!"
    },
    {
      "index": 42,
      "english": "Dad!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 17612,
      "_bytes": 4,
      "translation": "¡Papá!"
    },
    {
      "index": 43,
      "english": "Heeeeeeey!",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 17617,
      "_bytes": 10,
      "translation": "¡Eeeeeeeeh!"
    },
    {
      "index": 44,
      "english": "...Joe?",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 17628,
      "_bytes": 7,
      "translation": "...¿Joe?"
    },
    {
      "index": 45,
      "english": "T.K!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 17636,
      "_bytes": 7,
      "translation": "¡T.K.!"
    },
    {
      "index": 46,
      "english": "T.K...",
      "speaker_id": 6111,
      "line_type": 2,
      "_offset": 17644,
      "_bytes": 9,
      "translation": "T.K..."
    },
    {
      "index": 47,
      "english": "Daddy!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 17654,
      "_bytes": 6,
      "translation": "¡Papá!"
    },
    {
      "index": 48,
      "english": "Why are you here?",
      "speaker_id": 6111,
      "line_type": 2,
      "_offset": 17661,
      "_bytes": 17,
      "translation": "¿Qué haces aquí?"
    },
    {
      "index": 49,
      "english": "I was so worried about you and\nMatt. I had to come here and\ncheck up on you.",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 17679,
      "_bytes": 78,
      "translation": "Estaba preocupado por ti y\npor Matt. Tenía que venir\na veros."
    },
    {
      "index": 50,
      "english": "Mommy brought me part of the way\nhere, too.",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 17758,
      "_bytes": 43,
      "translation": "Mamá también me trajo parte\ndel camino."
    },
    {
      "index": 51,
      "english": "...",
      "speaker_id": 6111,
      "line_type": 2,
      "_offset": 17802,
      "_bytes": 3,
      "translation": "..."
    },
    {
      "index": 52,
      "english": "That Digimon is...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 17806,
      "_bytes": 18,
      "translation": "Ese Digimon es..."
    },
    {
      "index": 53,
      "english": "...",
      "speaker_id": 4321,
      "line_type": 2,
      "_offset": 17825,
      "_bytes": 3,
      "translation": "..."
    },
    {
      "index": 54,
      "english": "What are you planning to do?",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 17829,
      "_bytes": 28,
      "translation": "¿Qué es lo que piensas hacer?"
    },
    {
      "index": 55,
      "english": "Was she hit by Myotismon's Dead\nScream?",
      "speaker_id": 4321,
      "line_type": 2,
      "_offset": 17858,
      "_bytes": 38,
      "translation": "¿Le dio el Grito Mortal de\nMyotismon?"
    },
    {
      "index": 56,
      "english": "So what if she was?",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 17897,
      "_bytes": 19,
      "translation": "¿Y qué si lo fue?"
    },
    {
      "index": 57,
      "english": "...mmmfh.",
      "speaker_id": 2541,
      "line_type": 2,
      "_offset": 17917,
      "_bytes": 9,
      "translation": "...mmmfh."
    },
    {
      "index": 58,
      "english": "Lilimon?",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 17927,
      "_bytes": 8,
      "translation": "¿Lilimon?"
    },
    {
      "index": 59,
      "english": "Huh? What was I...?",
      "speaker_id": 2541,
      "line_type": 2,
      "_offset": 17936,
      "_bytes": 19,
      "translation": "¿Eh? ¿Qué estaba...?"
    },
    {
      "index": 60,
      "english": "He's not a bad Digimon!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 17956,
      "_bytes": 23,
      "translation": "¡No es un Digimon malo!"
    },
    {
      "index": 61,
      "english": "He's got a Tag and a Crest.",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 17980,
      "_bytes": 27,
      "translation": "Tiene un Circuito y un Emblema."
    },
    {
      "index": 62,
      "english": "So that's...",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 18008,
      "_bytes": 12,
      "translation": "Entonces..."
    },
    {
      "index": 63,
      "english": "Kari's Tag and Crest.",
      "speaker_id": 4321,
      "line_type": 2,
      "_offset": 18021,
      "_bytes": 23,
      "translation": "El Circuito y el Emblema de Kari."
    },
    {
      "index": 64,
      "english": "?!",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 18045,
      "_bytes": 2,
      "translation": "?!"
    },
    {
      "index": 65,
      "english": "I want to rescue Tailmon. She's\nbeen captured by Myotismon.",
      "speaker_id": 4321,
      "line_type": 2,
      "_offset": 18048,
      "_bytes": 58,
      "translation": "Quiero rescatar a Gatomon.\nMyotismon la capturó."
    },
    {
      "index": 66,
      "english": "Tailmon is the eighth child's\nDigimon!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 18107,
      "_bytes": 38,
      "translation": "¡Gatomon es el Digimon del\noctavo niño!"
    },
    {
      "index": 67,
      "english": "What?!",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 18146,
      "_bytes": 6,
      "translation": "¡¿Qué?!"
    },
    {
      "index": 68,
      "english": "Are you serious?!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 18153,
      "_bytes": 17,
      "translation": "¡¿Hablas en serio?!"
    },
    {
      "index": 69,
      "english": "No way...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 18171,
      "_bytes": 9,
      "translation": "No puede ser..."
    },
    {
      "index": 70,
      "english": "Where is Kari right now?",
      "speaker_id": 4321,
      "line_type": 2,
      "_offset": 18181,
      "_bytes": 26,
      "translation": "¿Dónde está Kari ahora?"
    },
    {
      "index": 71,
      "english": "She... she was captured and taken\nto Myotismon.",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 18208,
      "_bytes": 46,
      "translation": "Ella... la capturó Myotismon."
    },
    {
      "index": 72,
      "english": "According to Gennai, it appears\nthat the center of the barrier is\non this rooftop.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 18255,
      "_bytes": 82,
      "translation": "Según Gennai, el centro de\nla barrera parece estar\nen esta azotea."
    },
    {
      "index": 73,
      "english": "It shouldn't be long before\nMyotismon arrives there, too...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 18338,
      "_bytes": 58,
      "translation": "No tardará en llegar\nMyotismon también..."
    },
    {
      "index": 74,
      "english": "Let's go, guys!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 18397,
      "_bytes": 15,
      "translation": "¡Vamos, chicos!"
    },
    {
      "index": 75,
      "english": "All right, I'll lead you there!",
      "speaker_id": 6111,
      "line_type": 2,
      "_offset": 18413,
      "_bytes": 31,
      "translation": "¡Vale, os llevo hasta allí!"
    },
    {
      "index": 76,
      "english": "Grrrrrrrr!",
      "speaker_id": 4912,
      "line_type": 2,
      "_offset": 18445,
      "_bytes": 10,
      "translation": "¡Grrrrrrrr!"
    },
    {
      "index": 77,
      "english": "Gsssshaaaaaaah!",
      "speaker_id": 4913,
      "line_type": 2,
      "_offset": 18456,
      "_bytes": 15,
      "translation": "¡Gsssshaaaaaaah!"
    },
    {
      "index": 78,
      "english": "Aaaaaaaah!",
      "speaker_id": 6111,
      "line_type": 2,
      "_offset": 18472,
      "_bytes": 10,
      "translation": "¡Aaaaaaaah!"
    },
    {
      "index": 79,
      "english": "Gh! Don't get in our way!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 18483,
      "_bytes": 25,
      "translation": "¡Gh! ¡No os interpongáis!"
    },
    {
      "index": 80,
      "english": "We're saved. Thank you, everyone!",
      "speaker_id": 6111,
      "line_type": 2,
      "_offset": 18509,
      "_bytes": 33,
      "translation": "Nos habéis salvado. ¡Gracias!"
    },
    {
      "index": 81,
      "english": "Heh heh heh!",
      "speaker_id": 2221,
      "line_type": 2,
      "_offset": 18543,
      "_bytes": 12,
      "translation": "¡Je je je!"
    },
    {
      "index": 82,
      "english": "Come on, let's hurry to the roof!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 18556,
      "_bytes": 33,
      "translation": "¡Venga, subamos ya a la azotea!"
    },
    {
      "index": 83,
      "english": "Matt, we have to hurry to the\nroof!",
      "speaker_id": 2221,
      "line_type": 2,
      "_offset": 18590,
      "_bytes": 37,
      "translation": "Matt, ¡hay que subir ya\na la azotea!"
    },
    {
      "index": 84,
      "english": "Yeah, you're right.",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 18628,
      "_bytes": 19,
      "translation": "Sí, tienes razón."
    },
    {
      "index": 85,
      "english": "Why did you come forward by your\nown will, little girl?",
      "speaker_id": 3031,
      "line_type": 2,
      "_offset": 18648,
      "_bytes": 55,
      "translation": "¿Por qué has venido tú sola,\npequeña?"
    },
    {
      "index": 86,
      "english": "Because you were hurting everyone.",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 18704,
      "_bytes": 34,
      "translation": "Porque hacías daño a todos."
    },
    {
      "index": 87,
      "english": "Hahaha. Tailmon, why won't you\nlook at the eighth child?",
      "speaker_id": 3031,
      "line_type": 2,
      "_offset": 18739,
      "_bytes": 56,
      "translation": "Jajaja. Gatomon, ¿por qué no\nmiras al octavo niño?"
    },
    {
      "index": 88,
      "english": "I don't know that girl. She's not\nthe eighth child.",
      "speaker_id": 2831,
      "line_type": 2,
      "_offset": 18796,
      "_bytes": 51,
      "translation": "No conozco a esa niña. No es\nel octavo niño."
    },
    {
      "index": 89,
      "english": "...",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 18848,
      "_bytes": 3,
      "translation": "..."
    },
    {
      "index": 90,
      "english": "I see...",
      "speaker_id": 3031,
      "line_type": 2,
      "_offset": 18852,
      "_bytes": 8,
      "translation": "Vaya..."
    },
    {
      "index": 91,
      "english": "Gyaaaaaaah!",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 18861,
      "_bytes": 11,
      "translation": "¡Gyaaaaaaah!"
    },
    {
      "index": 92,
      "english": "Kari!",
      "speaker_id": 2831,
      "line_type": 2,
      "_offset": 18873,
      "_bytes": 7,
      "translation": "¡Kari!"
    },
    {
      "index": 93,
      "english": "I see, so the eighth child's name\nis Kari. Kari, Tailmon...\nprepare yourselves.",
      "speaker_id": 3031,
      "line_type": 2,
      "_offset": 18881,
      "_bytes": 83,
      "translation": "Ya veo, el octavo niño se\nllama Kari. Kari, Gatomon...\npreparaos."
    },
    {
      "index": 94,
      "english": "Stop right there!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 18965,
      "_bytes": 17,
      "translation": "¡Alto ahí mismo!"
    },
    {
      "index": 95,
      "english": "Kari!",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 18983,
      "_bytes": 7,
      "translation": "¡Kari!"
    },
    {
      "index": 96,
      "english": "Everyone!",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 18991,
      "_bytes": 9,
      "translation": "¡Todos!"
    },
    {
      "index": 97,
      "english": "Hahaha, the pesky ones have\narrived.",
      "speaker_id": 3031,
      "line_type": 2,
      "_offset": 19001,
      "_bytes": 36,
      "translation": "Jajaja, ya llegaron los\nmolestos."
    },
    {
      "index": 98,
      "english": "This is no time to laugh!",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 19038,
      "_bytes": 25,
      "translation": "¡No es hora de reír!"
    },
    {
      "index": 99,
      "english": "Guys!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 19064,
      "_bytes": 5,
      "translation": "¡Chicos!"
    },
    {
      "index": 100,
      "english": "Sorry to keep you waiting!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 19070,
      "_bytes": 26,
      "translation": "¡Perdón por la espera!"
    },
    {
      "index": 101,
      "english": "Mimi!",
      "speaker_id": 2541,
      "line_type": 2,
      "_offset": 19097,
      "_bytes": 5,
      "translation": "¡Mimi!"
    },
    {
      "index": 102,
      "english": "Everyone's here!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 19103,
      "_bytes": 16,
      "translation": "¡Ya están todos!"
    },
    {
      "index": 103,
      "english": "Everyone's here!",
      "speaker_id": 3031,
      "line_type": 2,
      "_offset": 19120,
      "_bytes": 16,
      "translation": "¡Ya están todos!"
    },
    {
      "index": 104,
      "english": "I won't allow you to lay a hand on\nmy sister! Kari, take the\nDigivice!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 19137,
      "_bytes": 72,
      "translation": "¡No dejaré que toques a mi\nhermana! Kari, ¡toma el\nDigivice!"
    },
    {
      "index": 105,
      "english": "Ah!",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 19210,
      "_bytes": 3,
      "translation": "¡Ah!"
    },
    {
      "index": 106,
      "english": "Lord Myotismon! There's nothing to\nfear now!",
      "speaker_id": 4221,
      "line_type": 2,
      "_offset": 19214,
      "_bytes": 43,
      "translation": "¡Amo Myotismon! ¡Ya no hay\nnada que temer!"
    },
    {
      "index": 107,
      "english": "Good job! Now none of you will be\nable to oppose me!",
      "speaker_id": 3031,
      "line_type": 2,
      "_offset": 19258,
      "_bytes": 52,
      "translation": "¡Bien hecho! ¡Ahora ninguno\npodrá oponerse a mí!"
    },
    {
      "index": 108,
      "english": "Haaaaaah!",
      "speaker_id": 3031,
      "line_type": 2,
      "_offset": 19311,
      "_bytes": 9,
      "translation": "¡Haaaaaah!"
    },
    {
      "index": 109,
      "english": "Let's go, guys!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 19321,
      "_bytes": 15,
      "translation": "¡Vamos, chicos!"
    },
    {
      "index": 110,
      "english": "Giga Destroyer!",
      "speaker_id": 2141,
      "line_type": 2,
      "_offset": 19337,
      "_bytes": 15,
      "translation": "¡Giga Destructor!"
    },
    {
      "index": 111,
      "english": "Horn Buster!",
      "speaker_id": 2441,
      "line_type": 2,
      "_offset": 19353,
      "_bytes": 12,
      "translation": "¡Cuerno Rompedor!"
    },
    {
      "index": 112,
      "english": "Kaiser Nail!",
      "speaker_id": 2241,
      "line_type": 2,
      "_offset": 19366,
      "_bytes": 12,
      "translation": "¡Garra Kaiser!"
    },
    {
      "index": 113,
      "english": "Hammer Spark!",
      "speaker_id": 2641,
      "line_type": 2,
      "_offset": 19379,
      "_bytes": 13,
      "translation": "¡Chispa Martillo!"
    },
    {
      "index": 114,
      "english": "Shadow Wing!",
      "speaker_id": 2341,
      "line_type": 2,
      "_offset": 19393,
      "_bytes": 12,
      "translation": "¡Ala Sombra!"
    },
    {
      "index": 115,
      "english": "Flower Cannon!",
      "speaker_id": 2541,
      "line_type": 2,
      "_offset": 19406,
      "_bytes": 14,
      "translation": "¡Cañón Floral!"
    },
    {
      "index": 116,
      "english": "He's strong... he's too strong!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 19421,
      "_bytes": 31,
      "translation": "¡Es fuerte... muy fuerte!"
    },
    {
      "index": 117,
      "english": "Are all of you finished?",
      "speaker_id": 3031,
      "line_type": 2,
      "_offset": 19453,
      "_bytes": 24,
      "translation": "¿Ya habéis terminado?"
    },
    {
      "index": 118,
      "english": "I'm your opponent, Myotismon!\nHeaven's Knuckle!",
      "speaker_id": 2731,
      "line_type": 2,
      "_offset": 19478,
      "_bytes": 46,
      "translation": "¡Yo soy tu rival, Myotismon!\n¡Puño del Cielo!"
    },
    {
      "index": 119,
      "english": "Ggghhhhh! G-ghhh...",
      "speaker_id": 3031,
      "line_type": 2,
      "_offset": 19525,
      "_bytes": 19,
      "translation": "¡Ggghhhhh! G-ghhh..."
    },
    {
      "index": 120,
      "english": "Surrender, Myotismon!",
      "speaker_id": 2731,
      "line_type": 2,
      "_offset": 19545,
      "_bytes": 20,
      "translation": "¡Ríndete, Myotismon!"
    },
    {
      "index": 121,
      "english": "You won't be able to defeat me\nwith just that!",
      "speaker_id": 3031,
      "line_type": 2,
      "_offset": 19566,
      "_bytes": 46,
      "translation": "¡No podrás derrotarme\ncon solo eso!"
    },
    {
      "index": 122,
      "english": "Traitorous scum! Don't get in my\nway!",
      "speaker_id": 3031,
      "line_type": 2,
      "_offset": 19613,
      "_bytes": 37,
      "translation": "¡Escoria! ¡No te interpongas!"
    },
    {
      "index": 123,
      "english": "Wizarmon...",
      "speaker_id": 2831,
      "line_type": 2,
      "_offset": 19651,
      "_bytes": 11,
      "translation": "Wizardmon..."
    },
    {
      "index": 124,
      "english": "Wizarmon! Don't die!",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 19663,
      "_bytes": 20,
      "translation": "¡Wizardmon! ¡No mueras!"
    },
    {
      "index": 125,
      "english": "Are you okay, Tailmon?",
      "speaker_id": 4321,
      "line_type": 2,
      "_offset": 19684,
      "_bytes": 22,
      "translation": "¿Estás bien, Gatomon?"
    },
    {
      "index": 126,
      "english": "I'm sorry, Wizarmon. For involving\nyou in all of this...",
      "speaker_id": 2831,
      "line_type": 2,
      "_offset": 19707,
      "_bytes": 56,
      "translation": "Lo siento, Wizardmon. Por\nmeterte en todo esto..."
    },
    {
      "index": 127,
      "english": "It's fine. If I hadn't met you, I\nwould have lived a life without\nmeaning...",
      "speaker_id": 4321,
      "line_type": 2,
      "_offset": 19764,
      "_bytes": 76,
      "translation": "Está bien. Si no te hubiera\nconocido, mi vida no habría\ntenido sentido..."
    },
    {
      "index": 128,
      "english": "So I'm glad... to have met you...",
      "speaker_id": 4321,
      "line_type": 2,
      "_offset": 19841,
      "_bytes": 33,
      "translation": "Me alegro de haberte conocido..."
    },
    {
      "index": 129,
      "english": "Wizarmon...",
      "speaker_id": 2831,
      "line_type": 2,
      "_offset": 19875,
      "_bytes": 11,
      "translation": "Wizardmon..."
    },
    {
      "index": 130,
      "english": "Thank you...",
      "speaker_id": 4321,
      "line_type": 2,
      "_offset": 19887,
      "_bytes": 12,
      "translation": "Gracias..."
    },
    {
      "index": 131,
      "english": "No... Wizarmon! Nooooooooooo!!",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 19900,
      "_bytes": 30,
      "translation": "No... ¡Wizardmon! ¡Nooooooooooo!"
    },
    {
      "index": 132,
      "english": "Aaaaaaaargh!",
      "speaker_id": 4221,
      "line_type": 2,
      "_offset": 19931,
      "_bytes": 12,
      "translation": "¡Aaaaaaaargh!"
    },
    {
      "index": 133,
      "english": "Kari's Digivice!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 19944,
      "_bytes": 18,
      "translation": "¡El Digivice de Kari!"
    },
    {
      "index": 134,
      "english": "I-It huuuuuuurts!",
      "speaker_id": 4221,
      "line_type": 2,
      "_offset": 19963,
      "_bytes": 17,
      "translation": "¡D-Duele muuucho!"
    },
    {
      "index": 135,
      "english": "Kari! Take it!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 19981,
      "_bytes": 16,
      "translation": "¡Kari! ¡Tómalo!"
    },
    {
      "index": 136,
      "english": "No!",
      "speaker_id": 3031,
      "line_type": 2,
      "_offset": 19998,
      "_bytes": 3,
      "translation": "¡No!"
    },
    {
      "index": 137,
      "english": "Tailmon... became an angel?",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 20002,
      "_bytes": 27,
      "translation": "Gatomon...¿se hizo un ángel?"
    },
    {
      "index": 138,
      "english": "...!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 20030,
      "_bytes": 4,
      "translation": "...!"
    },
    {
      "index": 139,
      "english": "Myotismon. For interfering with the\nChosen Children's mission...",
      "speaker_id": 2841,
      "line_type": 2,
      "_offset": 20035,
      "_bytes": 63,
      "translation": "Myotismon. Por interferir en\nla misión de los Niños\nElegidos..."
    },
    {
      "index": 140,
      "english": "For trespassing upon the real\nworld and killing my friend\nWizarmon, repent your sins!",
      "speaker_id": 2841,
      "line_type": 2,
      "_offset": 20099,
      "_bytes": 85,
      "translation": "¡Por invadir el mundo real\ny matar a mi amigo\nWizardmon, arrepiéntete!"
    },
    {
      "index": 141,
      "english": "To fill this world with darkness,\nto merge it with the Digital\nWorld...",
      "speaker_id": 3031,
      "line_type": 2,
      "_offset": 20185,
      "_bytes": 71,
      "translation": "Llenar este mundo de\noscuridad, fusionarlo con\nel Digimundo..."
    },
    {
      "index": 142,
      "english": "and to rule over it as its king -\nall I did was what I was born to\ndo!",
      "speaker_id": 3031,
      "line_type": 2,
      "_offset": 20257,
      "_bytes": 70,
      "translation": "y reinar en él como su rey...\n¡solo hacía lo que nací\npara hacer!"
    },
    {
      "index": 143,
      "english": "So you have no intention of\nrepenting for your sins?",
      "speaker_id": 2731,
      "line_type": 2,
      "_offset": 20328,
      "_bytes": 52,
      "translation": "¿Así que no piensas\narrepentirte de tus pecados?"
    },
    {
      "index": 144,
      "english": "Hmph!",
      "speaker_id": 3031,
      "line_type": 2,
      "_offset": 20381,
      "_bytes": 5,
      "translation": "¡Hmp!"
    },
    {
      "index": 145,
      "english": "Saint Air!",
      "speaker_id": 2841,
      "line_type": 2,
      "_offset": 20387,
      "_bytes": 10,
      "translation": "¡Aire Santo!"
    },
    {
      "index": 146,
      "english": "Gggh! My body can't move!",
      "speaker_id": 3031,
      "line_type": 2,
      "_offset": 20398,
      "_bytes": 25,
      "translation": "¡Gggh! ¡No puedo moverme!"
    },
    {
      "index": 147,
      "english": "I can feel power flowing through\nme!",
      "speaker_id": 2141,
      "line_type": 2,
      "_offset": 20424,
      "_bytes": 36,
      "translation": "¡Siento un poder que fluye\npor mí!"
    },
    {
      "index": 148,
      "english": "Let's settle our score with\nMyotismon!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 20461,
      "_bytes": 37,
      "translation": "¡Ajustemos cuentas con\nMyotismon!"
    },
    {
      "index": 149,
      "english": "Go, Angewomon!",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 20499,
      "_bytes": 14,
      "translation": "¡Ve, Angewomon!"
    },
    {
      "index": 150,
      "english": "Now! Give your power to Angewomon!",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 20514,
      "_bytes": 34,
      "translation": "¡Dale tu poder a Angewomon!"
    },
    {
      "index": 151,
      "english": "Heaven's Knuckle!",
      "speaker_id": 2731,
      "line_type": 2,
      "_offset": 20549,
      "_bytes": 17,
      "translation": "¡Puño del Cielo!"
    },
    {
      "index": 152,
      "english": "Holy Arrow!",
      "speaker_id": 2841,
      "line_type": 2,
      "_offset": 20567,
      "_bytes": 11,
      "translation": "¡Flecha Sagrada!"
    },
    {
      "index": 153,
      "english": "Stop! Ughhhhh! Aaaaaaaaaarghhh!!",
      "speaker_id": 3031,
      "line_type": 2,
      "_offset": 20579,
      "_bytes": 32,
      "translation": "¡Para! ¡Ughhhhh! ¡¡Aaaaaaaaarghhh!!"
    },
    {
      "index": 154,
      "english": "Myotismon vanished!",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 20612,
      "_bytes": 18,
      "translation": "¡Myotismon se ha esfumado!"
    },
    {
      "index": 155,
      "english": "Kari!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 20631,
      "_bytes": 7,
      "translation": "¡Kari!"
    },
    {
      "index": 156,
      "english": "Kari!",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 20639,
      "_bytes": 7,
      "translation": "¡Kari!"
    },
    {
      "index": 157,
      "english": "Kari!",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 20647,
      "_bytes": 7,
      "translation": "¡Kari!"
    },
    {
      "index": 158,
      "english": "We did it!!",
      "speaker_id": 9001,
      "line_type": 2,
      "_offset": 20655,
      "_bytes": 11,
      "translation": "¡Lo hicimos!"
    },
    {
      "index": 159,
      "english": "We defeated Myotismon!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 20667,
      "_bytes": 21,
      "translation": "¡Vencimos a Myotismon!"
    },
    {
      "index": 160,
      "english": "So we *were* able to do it! Right?",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 20689,
      "_bytes": 34,
      "translation": "¡Entonces sí pudimos! ¿Verdad?"
    },
    {
      "index": 161,
      "english": "We did it!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 20724,
      "_bytes": 10,
      "translation": "¡Ya está!"
    },
    {
      "index": 162,
      "english": "So will the world return to normal\nnow?",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 20735,
      "_bytes": 39,
      "translation": "¿El mundo volverá a la\nnormalidad?"
    },
    {
      "index": 163,
      "english": "So will the world return to normal\nnow?",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 20775,
      "_bytes": 39,
      "translation": "¿El mundo volverá a la\nnormalidad?"
    },
    {
      "index": 164,
      "english": "...",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 20815,
      "_bytes": 3,
      "translation": "..."
    },
    {
      "index": 165,
      "english": "What's wrong, you two?",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 20819,
      "_bytes": 22,
      "translation": "¿Qué os pasa a los dos?"
    },
    {
      "index": 166,
      "english": "Look...",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 20842,
      "_bytes": 7,
      "translation": "Mirad..."
    },
    {
      "index": 167,
      "english": "What?",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 20850,
      "_bytes": 5,
      "translation": "¿Qué?"
    },
    {
      "index": 168,
      "english": "The fog's not clearing up.",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 20856,
      "_bytes": 26,
      "translation": "La niebla no se despeja."
    },
    {
      "index": 169,
      "english": "What?!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 20883,
      "_bytes": 6,
      "translation": "¡¿Qué?!"
    }
  ]
}