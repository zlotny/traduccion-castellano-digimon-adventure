      "_offset": 7903,
      "_length": 83,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 87,
      "english": "Stop right there!",
      "_offset": 7987,
      "_length": 17,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 88,
      "english": "Hikari!",
      "_offset": 8005,
      "_length": 7,
      "speaker_id": 0,
      "translation": ""
    },
