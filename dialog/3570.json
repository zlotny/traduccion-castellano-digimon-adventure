      "index": 56,
      "english": "He's got a Tag and a Crest.",
      "_offset": 7002,
      "_length": 27,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 57,
      "english": "So that's...",
      "_offset": 7030,
      "_length": 12,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 58,
      "english": "Hikari's Tag and Crest.",
      "_offset": 7043,
      "_length": 23,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 59,
      "english": "I want to rescue Tailmon. She's\nbeen captured by Vamdemon.",
      "_offset": 7070,
      "_length": 58,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 60,
      "english": "Tailmon is the eighth child's\nDigimon!",
      "_offset": 7129,
      "_length": 38,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 61,
      "english": "What?!",
      "_offset": 7168,
      "_length": 6,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 62,
      "english": "Are you serious?!",
      "_offset": 7175,
      "_length": 17,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 63,
      "english": "No way...",
      "_offset": 7193,
      "_length": 9,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 64,
      "english": "Where is Hikari right now?",
      "_offset": 7203,
      "_length": 26,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 65,
      "english": "She... she was captured and taken\nto Vamdemon.",
      "_offset": 7230,
      "_length": 46,
      "speaker_id": 0,
      "translation": ""
    },
    {
