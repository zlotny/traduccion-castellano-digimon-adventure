      "_length": 10,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 73,
      "english": "Gh! Don't get in our way!",
      "_offset": 7505,
      "_length": 25,
      "speaker_id": 0,
      "translation": ""
