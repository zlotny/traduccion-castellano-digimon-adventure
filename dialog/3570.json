      "_length": 5,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 93,
      "english": "Sorry to keep you waiting!",
      "_offset": 8092,
      "_length": 26,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 94,
      "english": "Mimi!",
      "_offset": 8119,
      "_length": 5,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 95,
      "english": "Everyone's here!",
      "_offset": 8125,
      "_length": 16,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 96,
      "english": "Everyone's here!",
      "_offset": 8142,
      "_length": 16,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 97,
