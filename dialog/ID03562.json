      "_length": 6,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 17,
      "english": "All I wanted was for you to\nunderstand a flower arrangement\nschool head's job a little.",
      "_offset": 633,
      "_length": 87,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 18,
      "english": "Yeah...",
      "_offset": 721,
      "_length": 7,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 19,
      "english": "Anyway, let's go home.",
