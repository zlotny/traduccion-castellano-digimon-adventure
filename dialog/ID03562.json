      "translation": ""
    },
    {
      "index": 11,
      "english": "Mom!",
      "_offset": 337,
      "_length": 4,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 12,
      "english": "I heard there was a child with a\nstrange stuffed animal causing a\nriot in front of the flower shop.",
      "_offset": 342,
      "_length": 99,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 13,
      "english": "I was worried you might have\ngotten caught up in it...",
      "_offset": 442,
      "_length": 54,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 14,
      "english": "Yeah, I'm fine. I finished what\nyou asked me to do.",
      "_offset": 497,
      "_length": 51,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 15,
      "english": "Sorry for putting you in such a\ndangerous situation, Sora. I\ndidn't mean to.",
      "_offset": 549,
      "_length": 76,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 16,
      "english": "Mom...",
