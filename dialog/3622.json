{
  "file_id": "3622",
  "text_count": 98,
  "dialog": [
    {
      "index": 0,
      "english": "��������We're here! The spatial control\ncore should be in the back!",
      "_offset": 6318,
      "_length": 67,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 1,
      "english": "Tai! Over there!",
      "_offset": 6386,
      "_length": 19,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 2,
      "english": "Daisuke! Takato!",
      "_offset": 6406,
      "_length": 16,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 3,
      "english": "Takuya! And Masaru!",
      "_offset": 6423,
      "_length": 19,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 4,
      "english": "Taiki and Tagiru!",
      "_offset": 6443,
      "_length": 17,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 5,
      "english": "Glad we're all together now!",
      "_offset": 6461,
      "_length": 28,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 6,
      "english": "We heard everything about you and\nGankuumon!",
      "_offset": 6490,
      "_length": 44,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 7,
      "english": "So that's why we're all here!",
      "_offset": 6535,
      "_length": 29,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 8,
      "english": "Well, a lot of stuff happened, but\nnow's not the time to be talking\nabout that.",
      "_offset": 6565,
      "_length": 79,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 9,
      "english": "I'm really sorry, Takuya!",
      "_offset": 6645,
      "_length": 27,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 10,
      "english": "Anyway, our first priority is to\ntake care of this.",
      "_offset": 6673,
      "_length": 51,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 11,
      "english": "Let's do it, guys!",
      "_offset": 6725,
      "_length": 18,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 12,
      "english": "I guess we're not gonna be able to\nget in that easily!",
      "_offset": 6744,
      "_length": 54,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 13,
      "english": "Why don't we all try to break in\nat once?",
      "_offset": 6799,
      "_length": 41,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 14,
      "english": "Well, we shouldn't all be wearing\nourselves out...",
      "_offset": 6841,
      "_length": 50,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 15,
      "english": "Why don't we split up into pairs,\nthen?",
      "_offset": 6892,
      "_length": 39,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 16,
      "english": "But if we split up into teams,\nwe're not gonna make it in time.",
      "_offset": 6932,
      "_length": 63,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 17,
      "english": "Why don't you go ahead then,\nTai?",
      "_offset": 6996,
      "_length": 36,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 18,
      "english": "Daisuke...",
      "_offset": 7033,
      "_length": 10,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 19,
      "english": "You're the leader here, Tai!",
      "_offset": 7044,
      "_length": 31,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 20,
      "english": "Takuya...",
      "_offset": 7076,
      "_length": 9,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 21,
      "english": "Tai, let's pick who we want to\ngo with us!",
      "_offset": 7086,
      "_length": 45,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 22,
      "english": "Hurry, Tai!",
      "_offset": 7132,
      "_length": 14,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 23,
      "english": "Guys! We're gonna protect the\nDigital World and our own worlds,\nwith our own hands!",
      "_offset": 7147,
      "_length": 83,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 24,
      "english": "Yeah!",
      "_offset": 7231,
      "_length": 5,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 25,
      "english": "That's the spatial control core...",
      "_offset": 7240,
      "_length": 34,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 26,
      "english": "It's coming!",
      "_offset": 7275,
      "_length": 12,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 27,
      "english": "...WarGreymon?!",
      "_offset": 7292,
      "_length": 15,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 28,
      "english": "It's the very last one!",
      "_offset": 7308,
      "_length": 23,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 29,
      "english": "Guys! This is the last one! If we\ndefeat him, we can stop the\nspatial control core!",
      "_offset": 7332,
      "_length": 83,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 30,
      "english": "Yeah! Let's go, guys!",
      "_offset": 7416,
      "_length": 21,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 31,
      "english": "We did it! We did it!",
      "_offset": 7444,
      "_length": 21,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 32,
      "english": "We're out of time! We have to stop\nthe spatial control core!",
      "_offset": 7466,
      "_length": 60,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 33,
      "english": "Hackmon!",
      "_offset": 7527,
      "_length": 8,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 34,
      "english": "N-No way! It shouldn't have this\nmuch power!",
      "_offset": 7536,
      "_length": 44,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 35,
      "english": "Hackmon!",
      "_offset": 7581,
      "_length": 8,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 36,
      "english": "Tai! Guys!",
      "_offset": 7590,
      "_length": 13,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 37,
      "english": "Hackmon...!",
      "_offset": 7604,
      "_length": 11,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 38,
      "english": "Deliver this message to Gankuumon:\nI successfully guided the Chosen\nChildren here!",
      "_offset": 7616,
      "_length": 82,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 39,
      "english": "Aaaaaaagh!",
      "_offset": 7699,
      "_length": 10,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 40,
      "english": "Are you okay, Hackmon?",
      "_offset": 7710,
      "_length": 22,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 41,
      "english": "Tai... Guys... What happened to\nthe spatial control core?",
      "_offset": 7733,
      "_length": 60,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 42,
      "english": "It's all good! The fake copies are\nall gone.",
      "_offset": 7794,
      "_length": 44,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 43,
      "english": "Thank goodness...",
      "_offset": 7839,
      "_length": 17,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 44,
      "english": "Splendid job, chosen ones. And\nyou, Hackmon...",
      "_offset": 7857,
      "_length": 46,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 45,
      "english": "Yes?",
      "_offset": 7904,
      "_length": 4,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 46,
      "english": "So the Digital World is safe now,\nright?",
      "_offset": 7909,
      "_length": 40,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 47,
      "english": "We can go home!",
      "_offset": 7950,
      "_length": 15,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 48,
      "english": "Man, this was one heck of a big\nthing!",
      "_offset": 7966,
      "_length": 38,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 49,
      "english": "I was hoping I could wreck some\nmore stuff around here...",
      "_offset": 8005,
      "_length": 57,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 50,
      "english": "All our friends back home must be\nworried about us.",
      "_offset": 8063,
      "_length": 51,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 51,
      "english": "Aww, I gotta go back to school...",
      "_offset": 8115,
      "_length": 33,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 52,
      "english": "As thanks for your work, I will\ngrant you all a reward.",
      "_offset": 8149,
      "_length": 55,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 53,
      "english": "What? Really?!",
      "_offset": 8205,
      "_length": 14,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 54,
      "english": "I... will be your opponent, as a\nRoyal Knight!",
      "_offset": 8220,
      "_length": 46,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 55,
      "english": "What?!",
      "_offset": 8267,
      "_length": 6,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 56,
      "english": "Now, come!",
      "_offset": 8274,
      "_length": 10,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 57,
      "english": "W-We won... We did it!",
      "_offset": 8285,
      "_length": 22,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 58,
      "english": "Splendid! Is this the true power\nof humans allied with Digimon?",
      "_offset": 8308,
      "_length": 63,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 59,
      "english": "But it looks like we've still got\na lot of training to do.",
      "_offset": 8372,
      "_length": 58,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 60,
      "english": "Indeed!",
      "_offset": 8431,
      "_length": 7,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 61,
      "english": "So, can we finally go home?",
      "_offset": 8439,
      "_length": 27,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 62,
      "english": "Of course! However...",
      "_offset": 8467,
      "_length": 21,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 63,
      "english": "Oh, no. What now?",
      "_offset": 8489,
      "_length": 17,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 64,
      "english": "The moment you leave this space,\nyou will lose all the memories you\nhave obtained here.",
      "_offset": 8507,
      "_length": 87,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 65,
      "english": "If you were to take any of your\nmemories from this place, which\nexists beyond spacetime...",
      "_offset": 8595,
      "_length": 90,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 66,
      "english": "...It would disturb the order of\nthe digital field.",
      "_offset": 8686,
      "_length": 51,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 67,
      "english": "It's a shame... we just got to\nknow each other!",
      "_offset": 8738,
      "_length": 47,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 68,
      "english": "Well, I guess we can't do anything\nabout that...",
      "_offset": 8786,
      "_length": 48,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 69,
      "english": "I'm just happy I got to meet\nTai!",
      "_offset": 8835,
      "_length": 36,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 70,
      "english": "Man, I really wanted to play\nsoccer with him...",
      "_offset": 8872,
      "_length": 47,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 71,
      "english": "Some lost memories won't get in\nthe way of a friendship between\nmen!",
      "_offset": 8920,
      "_length": 68,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 72,
      "english": "I get the feeling we'll meet\nagain, anyway.",
      "_offset": 8989,
      "_length": 43,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 73,
      "english": "I don't really get any kind of\n\"bye!\" feeling from this.",
      "_offset": 9033,
      "_length": 56,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 74,
      "english": "Yeah, that's right! We'll meet\nagain, someday!",
      "_offset": 9090,
      "_length": 46,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 75,
      "english": "Let's meet again someday!",
      "_offset": 9137,
      "_length": 25,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 76,
      "english": "Come with me, Daisuke!",
      "_offset": 9163,
      "_length": 22,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 77,
      "english": "Choose someone else",
      "_offset": 9186,
      "_length": 19,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 78,
      "english": "Come with me, Takato!",
      "_offset": 9206,
      "_length": 21,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 79,
      "english": "Choose someone else",
      "_offset": 9228,
      "_length": 19,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 80,
      "english": "Come with me, Takuya!",
      "_offset": 9248,
      "_length": 21,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 81,
      "english": "Choose someone else",
      "_offset": 9270,
      "_length": 19,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 82,
      "english": "Come with me, Masaru!",
      "_offset": 9290,
      "_length": 21,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 83,
      "english": "Choose someone else",
      "_offset": 9312,
      "_length": 19,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 84,
      "english": "Come with me, Taiki!",
      "_offset": 9332,
      "_length": 20,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 85,
      "english": "Choose someone else",
      "_offset": 9353,
      "_length": 19,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 86,
      "english": "Come with me, Tagiru!",
      "_offset": 9373,
      "_length": 21,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 87,
      "english": "Choose someone else",
      "_offset": 9395,
      "_length": 19,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 88,
      "english": "All right! Let's go to the spatial\ncontrol core!",
      "_offset": 9415,
      "_length": 48,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 89,
      "english": "Ugh, I can't decide...",
      "_offset": 9464,
      "_length": 22,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 90,
      "english": "Hey, hey! We don't have time!\nHurry up and pick someone!",
      "_offset": 9487,
      "_length": 56,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 91,
      "english": "Come with me, Daisuke!",
      "_offset": 9544,
      "_length": 22,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 92,
      "english": "Come with me, Takato!",
      "_offset": 9567,
      "_length": 21,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 93,
      "english": "Come with me, Takuya!",
      "_offset": 9589,
      "_length": 21,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 94,
      "english": "Come with me, Masaru!",
      "_offset": 9611,
      "_length": 21,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 95,
      "english": "Come with me, Taiki!",
      "_offset": 9633,
      "_length": 20,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 96,
      "english": "Come with me, Tagiru!",
      "_offset": 9654,
