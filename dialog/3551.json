    {
      "index": 137,
      "english": "Let's not go in that direction.",
      "_offset": 6951,
      "_length": 31,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 138,
      "english": "\"Beware of giant poop ahead\".",
      "_offset": 6983,
      "_length": 29,
      "speaker_id": 0,
