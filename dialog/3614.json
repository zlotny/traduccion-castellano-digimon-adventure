{
  "file_id": "3614",
  "format": "etdf",
  "kind": "ETDF",
  "text_count": 101,
  "dialog": [
    {
      "index": 0,
      "english": "Let's go, guys.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 8728,
      "_bytes": 15,
      "translation": "Vamos, chicos."
    },
    {
      "index": 1,
      "english": "Yeah!",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 8744,
      "_bytes": 5,
      "translation": "¡Sí!"
    },
    {
      "index": 2,
      "english": "All right!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 8750,
      "_bytes": 10,
      "translation": "¡Muy bien!"
    },
    {
      "index": 3,
      "english": "Wait, Tai!",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 8761,
      "_bytes": 13,
      "translation": "¡Espera, Tai!"
    },
    {
      "index": 4,
      "english": "What is it, Kari?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 8775,
      "_bytes": 19,
      "translation": "¿Qué pasa, Kari?"
    },
    {
      "index": 5,
      "english": "I want to make a grave for\nPiccolomon before we leave the\nforest.",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 8795,
      "_bytes": 65,
      "translation": "Quiero hacerle una tumba a\nPiccolomon antes de irnos\ndel bosque."
    },
    {
      "index": 6,
      "english": "I wasn't in the position to make a\nproper one for him at the time...",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 8861,
      "_bytes": 68,
      "translation": "No pude hacerle una como\ntoca en su momento..."
    },
    {
      "index": 7,
      "english": "You're right...",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 8930,
      "_bytes": 15,
      "translation": "Tienes razón..."
    },
    {
      "index": 8,
      "english": "I'll help!",
      "speaker_id": 2321,
      "line_type": 2,
      "_offset": 8946,
      "_bytes": 10,
      "translation": "¡Yo ayudo!"
    },
    {
      "index": 9,
      "english": "Me, too!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 8957,
      "_bytes": 8,
      "translation": "¡Yo también!"
    },
    {
      "index": 10,
      "english": "Me, too!",
      "speaker_id": 2421,
      "line_type": 2,
      "_offset": 8966,
      "_bytes": 8,
      "translation": "¡Yo también!"
    },
    {
      "index": 11,
      "english": "All right! Let's all get a bunch\nof flowers!",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 8975,
      "_bytes": 44,
      "translation": "¡Vale! ¡Vamos a recoger\nun montón de flores!"
    },
    {
      "index": 12,
      "english": "Can we, Tai?",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 9020,
      "_bytes": 15,
      "translation": "¿Podemos, Tai?"
    },
    {
      "index": 13,
      "english": "Of course!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 9036,
      "_bytes": 10,
      "translation": "¡Claro!"
    },
    {
      "index": 14,
      "english": "Thanks.",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 9047,
      "_bytes": 7,
      "translation": "Gracias."
    },
    {
      "index": 15,
      "english": "All right. Sora, you go with\nIzzy. Kari will come with\nme.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 9055,
      "_bytes": 65,
      "translation": "Vale. Sora, ve con Izzy.\nKari viene conmigo."
    },
    {
      "index": 16,
      "english": "Got it. Let's go, Izzy.",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 9121,
      "_bytes": 28,
      "translation": "Entendido. Vamos, Izzy."
    },
    {
      "index": 17,
      "english": "Yes!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 9150,
      "_bytes": 4,
      "translation": "¡Sí!"
    },
    {
      "index": 18,
      "english": "Let's go!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 9155,
      "_bytes": 9,
      "translation": "¡Vamos!"
    },
    {
      "index": 19,
      "english": "Yeah!",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 9165,
      "_bytes": 5,
      "translation": "¡Sí!"
    },
    {
      "index": 20,
      "english": "Hey, Tai...",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 9171,
      "_bytes": 14,
      "translation": "Oye, Tai..."
    },
    {
      "index": 21,
      "english": "What?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 9186,
      "_bytes": 5,
      "translation": "¿Qué?"
    },
    {
      "index": 22,
      "english": "What kind of Digimon was\nPiccolomon?",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 9192,
      "_bytes": 36,
      "translation": "¿Qué clase de Digimon era\nPiccolomon?"
    },
    {
      "index": 23,
      "english": "Well... when he first met us, he\ngot angry all of a sudden.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 9229,
      "_bytes": 59,
      "translation": "Bueno... cuando nos conoció,\nse enfadó de repente."
    },
    {
      "index": 24,
      "english": "When I couldn't get Agumon to\nevolve, he got me to take back\nwhat I'd lost...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 9289,
      "_bytes": 77,
      "translation": "Cuando no lograba que\nAgumon evolucionara, me\nhizo recuperar lo perdido..."
    },
    {
      "index": 25,
      "english": "Huh, so he was like a teacher to\nyou guys?",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 9367,
      "_bytes": 42,
      "translation": "Vaya, ¿era como un profesor\npara vosotros?"
    },
    {
      "index": 26,
      "english": "Yeah, he was looking after us.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 9410,
      "_bytes": 30,
      "translation": "Sí, cuidaba de nosotros."
    },
    {
      "index": 27,
      "english": "Obtained a flower!",
      "speaker_id": 9003,
      "line_type": 2,
      "_offset": 9441,
      "_bytes": 18,
      "translation": "¡Flor obtenida!"
    },
    {
      "index": 28,
      "english": "Obtained a flower!",
      "speaker_id": 9003,
      "line_type": 2,
      "_offset": 9460,
      "_bytes": 18,
      "translation": "¡Flor obtenida!"
    },
    {
      "index": 29,
      "english": "Just one left, pi!",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 9479,
      "_bytes": 18,
      "translation": "¡Solo queda una, pi!"
    },
    {
      "index": 30,
      "english": "Obtained a flower!",
      "speaker_id": 9003,
      "line_type": 2,
      "_offset": 9498,
      "_bytes": 18,
      "translation": "¡Flor obtenida!"
    },
    {
      "index": 31,
      "english": "All right, let's meet up with the\nothers.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 9517,
      "_bytes": 41,
      "translation": "Vale, vamos a reunirnos\ncon los demás."
    },
    {
      "index": 32,
      "english": "Izzy! Sora! You look like\nyou're ready.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 9559,
      "_bytes": 44,
      "translation": "¡Izzy! ¡Sora! Parece que\nya estáis listos."
    },
    {
      "index": 33,
      "english": "So do you!",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 9604,
      "_bytes": 10,
      "translation": "¡Y vosotros!"
    },
    {
      "index": 34,
      "english": "We found food, so we brought some.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 9615,
      "_bytes": 34,
      "translation": "Encontramos comida y\nhemos traído algo."
    },
    {
      "index": 35,
      "english": "There wasn't any time for\nPiccolomon to teach me anything...",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 9650,
      "_bytes": 60,
      "translation": "No hubo tiempo para que\nPiccolomon me enseñara\nnada..."
    },
    {
      "index": 36,
      "english": "But since I'm with Tai, I'll\nhave to do my best!",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 9711,
      "_bytes": 51,
      "translation": "¡Pero ya que estoy con Tai,\ntendré que esforzarme!"
    },
    {
      "index": 37,
      "english": "Food! Fooooooooood!",
      "speaker_id": 4241,
      "line_type": 2,
      "_offset": 9763,
      "_bytes": 19,
      "translation": "¡Comida! ¡Comidaaaaa!"
    },
    {
      "index": 38,
      "english": "That's...",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 9783,
      "_bytes": 9,
      "translation": "Eso es..."
    },
    {
      "index": 39,
      "english": "...Digitamamon!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 9793,
      "_bytes": 15,
      "translation": "...¡Digitamamon!"
    },
    {
      "index": 40,
      "english": "Food! Fooooooooood!",
      "speaker_id": 4241,
      "line_type": 2,
      "_offset": 9809,
      "_bytes": 19,
      "translation": "¡Comida! ¡Comidaaaaa!"
    },
    {
      "index": 41,
      "english": "He's succumbed to hunger!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 9829,
      "_bytes": 25,
      "translation": "¡Ha caído ante el hambre!"
    },
    {
      "index": 42,
      "english": "Tailmon! Give me a hand!",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 9855,
      "_bytes": 24,
      "translation": "¡Gatomon! ¡Echa una mano!"
    },
    {
      "index": 43,
      "english": "Yeah! Now calm down!",
      "speaker_id": 2831,
      "line_type": 2,
      "_offset": 9880,
      "_bytes": 20,
      "translation": "¡Sí! ¡Ahora, cálmate!"
    },
    {
      "index": 44,
      "english": "Looks like he's calmed down.",
      "speaker_id": 2421,
      "line_type": 2,
      "_offset": 9901,
      "_bytes": 28,
      "translation": "Parece que se ha calmado."
    },
    {
      "index": 45,
      "english": "I kinda feel bad for him.",
      "speaker_id": 2321,
      "line_type": 2,
      "_offset": 9930,
      "_bytes": 25,
      "translation": "Me da un poco de pena."
    },
    {
      "index": 46,
      "english": "...You!",
      "speaker_id": 4241,
      "line_type": 2,
      "_offset": 9956,
      "_bytes": 7,
      "translation": "...¡Tú!"
    },
    {
      "index": 47,
      "english": "Remember us? You're the one who\ngave us all that trouble at the\nrestaurant!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 9964,
      "_bytes": 75,
      "translation": "¿Nos recuerdas? ¡Eres el que\nnos dio problemas en el\nrestaurante!"
    },
    {
      "index": 48,
      "english": "Aren't you hungry? Now eat!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 10040,
      "_bytes": 27,
      "translation": "¿No tienes hambre? ¡Come ya!"
    },
    {
      "index": 49,
      "english": "...Is this okay?",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 10068,
      "_bytes": 16,
      "translation": "...¿Esto vale?"
    },
    {
      "index": 50,
      "english": "It's fine. I'm sure that's what\nPiccolomon would say.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 10085,
      "_bytes": 53,
      "translation": "Está bien. Seguro que eso\ndiría Piccolomon."
    },
    {
      "index": 51,
      "english": "Yeah!",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 10139,
      "_bytes": 5,
      "translation": "¡Sí!"
    },
    {
      "index": 52,
      "english": "Did they get Piccolomon, too?",
      "speaker_id": 4241,
      "line_type": 2,
      "_offset": 10145,
      "_bytes": 29,
      "translation": "¿También acabaron con\nPiccolomon?"
    },
    {
      "index": 53,
      "english": "Yeah, he took a hit for us...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 10175,
      "_bytes": 29,
      "translation": "Sí, recibió un golpe por\nnosotros..."
    },
    {
      "index": 54,
      "english": "Are you guys gonna fight the Dark\nMasters?",
      "speaker_id": 4241,
      "line_type": 2,
      "_offset": 10205,
      "_bytes": 42,
      "translation": "¿Vais a luchar contra los\nAmos Oscuros?"
    },
    {
      "index": 55,
      "english": "Wouldn't it be in your best\ninterests to forget it?",
      "speaker_id": 4241,
      "line_type": 2,
      "_offset": 10248,
      "_bytes": 51,
      "translation": "¿No sería mejor para\nvosotros olvidarlo?"
    },
    {
      "index": 56,
      "english": "A lot of Digimon have sacrificed\nthemselves for us.",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 10300,
      "_bytes": 51,
      "translation": "Muchos Digimon se han\nsacrificado por nosotros."
    },
    {
      "index": 57,
      "english": "We're fighting so that their\nsacrifices won't be in vain.",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 10352,
      "_bytes": 57,
      "translation": "Luchamos para que su\nsacrificio no sea en vano."
    },
    {
      "index": 58,
      "english": "Yeah!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 10410,
      "_bytes": 5,
      "translation": "¡Sí!"
    },
    {
      "index": 59,
      "english": "What they said!",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 10416,
      "_bytes": 15,
      "translation": "¡Lo que han dicho!"
    },
    {
      "index": 60,
      "english": "And I'm going to protect Kari.",
      "speaker_id": 2831,
      "line_type": 2,
      "_offset": 10432,
      "_bytes": 32,
      "translation": "Y yo voy a proteger a Kari."
    },
    {
      "index": 61,
      "english": "Well, I'm not gonna need this.\nGimme a sec.",
      "speaker_id": 4241,
      "line_type": 2,
      "_offset": 10465,
      "_bytes": 43,
      "translation": "Bueno, esto ya no me hace\nfalta. Un momento."
    },
    {
      "index": 62,
      "english": "Thanks, Digitamamon!",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 10509,
      "_bytes": 20,
      "translation": "¡Gracias, Digitamamon!"
    },
    {
      "index": 63,
      "english": "I can't help you, but good luck.",
      "speaker_id": 4241,
      "line_type": 2,
      "_offset": 10530,
      "_bytes": 32,
      "translation": "No puedo ayudaros, pero suerte."
    },
    {
      "index": 64,
      "english": "Okay!",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 10563,
      "_bytes": 5,
      "translation": "¡Vale!"
    },
    {
      "index": 65,
      "english": "If we lost, Piccolomon would get\nmad at us...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 10569,
      "_bytes": 45,
      "translation": "Si perdiéramos, Piccolomon\nse enfadaría..."
    },
    {
      "index": 66,
      "english": "What kind of flowers would be\nappropriate?",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 10615,
      "_bytes": 42,
      "translation": "¿Qué tipo de flores serían\nadecuadas?"
    },
    {
      "index": 67,
      "english": "It's the thought that counts.",
      "speaker_id": 4294967295,
      "line_type": 2,
      "_offset": 10658,
      "_bytes": 29,
      "translation": "Lo que cuenta es la intención."
    },
    {
      "index": 68,
      "english": "Why don't you look it up on the web?",
      "speaker_id": 4294967295,
      "line_type": 2,
      "_offset": 10688,
      "_bytes": 36,
      "translation": "¿Por qué no lo buscas en Internet?"
    },
    {
      "index": 69,
      "english": "I'm sure Piccolomon would be happy\nno matter what...",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 10725,
      "_bytes": 52,
      "translation": "Seguro que a Piccolomon le\ngustaría cualquier cosa..."
    },
    {
      "index": 70,
      "english": "You're right.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 10778,
      "_bytes": 13,
      "translation": "Tienes razón."
    },
    {
      "index": 71,
      "english": "Yeah!",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 10792,
      "_bytes": 5,
      "translation": "¡Sí!"
    },
    {
      "index": 72,
      "english": "I can't use the Internet here,\nthough...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 10798,
      "_bytes": 40,
      "translation": "Aunque aquí no tengo\nInternet..."
    },
    {
      "index": 73,
      "english": "Oh, right...",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 10839,
      "_bytes": 12,
      "translation": "Ah, es verdad..."
    },
    {
      "index": 74,
      "english": "I'm sorry you had to get caught up\nin all this fighting, Kari.",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 10852,
      "_bytes": 64,
      "translation": "Siento que te vieras\nmetida en toda esta\nlucha, Kari."
    },
    {
      "index": 75,
      "english": "I don't think of it as \"caught up\".",
      "speaker_id": 4294967295,
      "line_type": 2,
      "_offset": 10917,
      "_bytes": 35,
      "translation": "No lo veo como \"meterme\"."
    },
    {
      "index": 76,
      "english": "If Tai'll fight, then I will too.",
      "speaker_id": 4294967295,
      "line_type": 2,
      "_offset": 10953,
      "_bytes": 36,
      "translation": "Si Tai lucha, yo también lucho."
    },
    {
      "index": 77,
      "english": "I came here because I wanted to.",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 10990,
      "_bytes": 32,
      "translation": "Vine aquí porque quise."
    },
    {
      "index": 78,
      "english": "So don't be sorry, Sora.",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 11023,
      "_bytes": 24,
      "translation": "No lo sientas, Sora."
    },
    {
      "index": 79,
      "english": "Kari...",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 11048,
      "_bytes": 9,
      "translation": "Kari..."
    },
    {
      "index": 80,
      "english": "So I won't run away...",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 11058,
      "_bytes": 22,
      "translation": "Por eso no huiré..."
    },
    {
      "index": 81,
      "english": "I'm really sorry, Kari...",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 11081,
      "_bytes": 27,
      "translation": "Lo siento mucho, Kari..."
    },
    {
      "index": 82,
      "english": "Sora...",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 11109,
      "_bytes": 7,
      "translation": "Sora..."
    },
    {
      "index": 83,
      "english": "It's surprisingly hard to gather\nflowers...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 11117,
      "_bytes": 43,
      "translation": "Cuesta más de lo\npensado recoger flores..."
    },
    {
      "index": 84,
      "english": "You can do it, Tai!",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 11161,
      "_bytes": 22,
      "translation": "¡Tú puedes, Tai!"
    },
    {
      "index": 85,
      "english": "That reminds me of something\nPiccolomon said...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 11184,
      "_bytes": 47,
      "translation": "Eso me recuerda a algo\nque decía Piccolomon..."
    },
    {
      "index": 86,
      "english": "\"You lack exertion and guts, pi!\"",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 11232,
      "_bytes": 33,
      "translation": "\"¡Te falta esfuerzo y agallas, pi!\""
    },
    {
      "index": 87,
      "english": "What's that?",
      "speaker_id": 4294967295,
      "line_type": 2,
      "_offset": 11266,
      "_bytes": 12,
      "translation": "¿Eso qué es?"
    },
    {
      "index": 88,
      "english": "You can do it, Tai, pi!",
      "speaker_id": 4294967295,
      "line_type": 2,
      "_offset": 11279,
      "_bytes": 26,
      "translation": "¡Tú puedes, Tai, pi!"
    },
    {
      "index": 89,
      "english": "It was like Piccolomon's\ncatchphrase.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 11306,
      "_bytes": 37,
      "translation": "Era como la frase de\nPiccolomon."
    },
    {
      "index": 90,
      "english": "But it doesn't really suit you.",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 11344,
      "_bytes": 31,
      "translation": "Pero no te pega mucho."
    },
    {
      "index": 91,
      "english": "Really?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 11376,
      "_bytes": 7,
      "translation": "Ah, ¿sí?"
    },
    {
      "index": 92,
      "english": "Really?",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 11384,
      "_bytes": 7,
      "translation": "Ah, ¿sí?"
    },
    {
      "index": 93,
      "english": "Don't copy him!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 11392,
      "_bytes": 15,
      "translation": "¡No lo imites!"
    },
    {
      "index": 94,
      "english": "Heehee!",
      "speaker_id": 1081,
      "line_type": 2,
      "_offset": 11408,
      "_bytes": 7,
      "translation": "¡Jeje!"
    },
    {
      "index": 95,
      "english": "...Ah, I'm sorry.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 11416,
      "_bytes": 17,
      "translation": "...Ah, perdón."
    },
    {
      "index": 96,
      "english": "I remember when Matt and I went\nto go look for our Crests...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 11434,
      "_bytes": 62,
      "translation": "Recuerdo cuando Matt y yo\nfuimos a buscar nuestros\nEmblemas..."
    },
    {
      "index": 97,
      "english": "Oh yeah, that was the same day we\nmet Piccolomon.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 11497,
      "_bytes": 49,
      "translation": "Ah sí, ese mismo día\nconocimos a Piccolomon."
    },
    {
      "index": 98,
      "english": "Yes... I think Piccolomon's death\nmust have been a great shock to\nMatt.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 11547,
      "_bytes": 73,
      "translation": "Sí... la muerte de\nPiccolomon debió de ser un\ngran golpe para Matt."
    },
    {
      "index": 99,
      "english": "It's not a good idea to be\ncontinually reflecting on this,\nbut...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 11621,
      "_bytes": 65,
      "translation": "No es buena idea seguir\ndándole vueltas a esto,\npero..."
    },
    {
      "index": 100,
      "english": "Kari, it's okay to say you're in\npain if you really do feel that\nway.",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 11687,
      "_bytes": 71,
      "translation": "Kari, está bien decir que\nte duele si de verdad lo\nsientes así."
    }
  ]
}