{
  "file_id": "3556",
  "format": "etdf",
  "kind": "ETDF",
  "text_count": 119,
  "dialog": [
    {
      "index": 0,
      "english": "All right, let's hurry to the\ngate!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 13800,
      "_bytes": 35,
      "translation": "¡Venga, vamos deprisa a la\npuerta!"
    },
    {
      "index": 1,
      "english": "Yeah!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 13836,
      "_bytes": 5,
      "translation": "¡Sí!"
    },
    {
      "index": 2,
      "english": "Enlistment Conscription",
      "speaker_id": 9003,
      "line_type": 2,
      "_offset": 13842,
      "_bytes": 23,
      "translation": "Reclutamiento forzoso"
    },
    {
      "index": 3,
      "english": "...Can those Digimon even read\nthis?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 13866,
      "_bytes": 36,
      "translation": "...¿Sabrán leer esto esos\nDigimon?"
    },
    {
      "index": 4,
      "english": "Come on, Tai! Lay out the\ncards!",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 13903,
      "_bytes": 35,
      "translation": "¡Venga, Tai! ¡Coloca las\ncartas!"
    },
    {
      "index": 5,
      "english": "Huh? Are you sure you want me to\ndo it?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 13939,
      "_bytes": 39,
      "translation": "¿Eh? ¿Seguro que queréis que lo\nhaga yo?"
    },
    {
      "index": 6,
      "english": "I'll leave this to you, Tai!",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 13979,
      "_bytes": 31,
      "translation": "¡Te lo dejamos a ti, Tai!"
    },
    {
      "index": 7,
      "english": "W-what's this all of a sudden?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 14011,
      "_bytes": 30,
      "translation": "¿Q-qué es esto tan de repente?"
    },
    {
      "index": 8,
      "english": "I'm not just trying to shove all\nthe responsibility onto you. I\nreally believe in you!",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 14042,
      "_bytes": 86,
      "translation": "No es que quiera cargarte con\ntoda la responsabilidad. ¡De\nverdad confío en ti!"
    },
    {
      "index": 9,
      "english": "Huuuuuuuuuh?!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 14129,
      "_bytes": 13,
      "translation": "¡¿Ehhhhhhhhh?!"
    },
    {
      "index": 10,
      "english": "Me, too! At a time like this, we\nshould be following the leader!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 14143,
      "_bytes": 64,
      "translation": "¡Yo también! ¡En un momento así,\ndebemos seguir al líder!"
    },
    {
      "index": 11,
      "english": "Hey, hey! When did I become the\nleader?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 14208,
      "_bytes": 39,
      "translation": "¡Eh, eh! ¿Desde cuándo soy yo el\nlíder?"
    },
    {
      "index": 12,
      "english": "The group fell apart the moment\nyou disappeared!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 14248,
      "_bytes": 48,
      "translation": "¡El grupo se vino abajo en cuanto\ndesapareciste!"
    },
    {
      "index": 13,
      "english": "And you're the one who brought us\nall together again!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 14297,
      "_bytes": 53,
      "translation": "¡Y fuiste tú quien nos volvió a\nunir a todos!"
    },
    {
      "index": 14,
      "english": "Well, I don't care about that!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 14351,
      "_bytes": 30,
      "translation": "¡Bueno, a mí eso me da igual!"
    },
    {
      "index": 15,
      "english": "Mimi...",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 14382,
      "_bytes": 7,
      "translation": "Mimi..."
    },
    {
      "index": 16,
      "english": "Get me home! Do whatever you can!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 14390,
      "_bytes": 33,
      "translation": "¡Llevadme a casa, sea como sea!"
    },
    {
      "index": 17,
      "english": "..that's what I'd have said back \nthen, but I'm not gonna say \nselfish things like that anymore!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 14424,
      "_bytes": 96,
      "translation": "...eso habría dicho antes, pero\n¡ya no pienso decir cosas\negoístas como esas!"
    },
    {
      "index": 18,
      "english": "You're right. If we don't change\nourselves, nothing else will\nchange.",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 14521,
      "_bytes": 69,
      "translation": "Tienes razón. Si no cambiamos\nnosotros, nada más cambiará."
    },
    {
      "index": 19,
      "english": "I'll believe in my friends!",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 14591,
      "_bytes": 27,
      "translation": "¡Confiaré en mis amigos!"
    },
    {
      "index": 20,
      "english": "Guys...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 14619,
      "_bytes": 7,
      "translation": "Tíos..."
    },
    {
      "index": 21,
      "english": "Don't you agree, T.K?",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 14627,
      "_bytes": 24,
      "translation": "¿No crees, T.K.?"
    },
    {
      "index": 22,
      "english": "Yeah! We'll still be together even\nif we end up in the wrong world,\nright?",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 14652,
      "_bytes": 74,
      "translation": "¡Sí! Seguiremos juntos aunque\nacabemos en el mundo\nequivocado, ¿no?"
    },
    {
      "index": 23,
      "english": "I'm not scared at all!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 14727,
      "_bytes": 22,
      "translation": "¡No tengo ningún miedo!"
    },
    {
      "index": 24,
      "english": "Yeah...",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 14750,
      "_bytes": 7,
      "translation": "Sí..."
    },
    {
      "index": 25,
      "english": "What about you, Izzy?",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 14758,
      "_bytes": 26,
      "translation": "¿Y tú qué dices, Izzy?"
    },
    {
      "index": 26,
      "english": "Ah, yes. As always, I believe in\nTai.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 14785,
      "_bytes": 40,
      "translation": "Ah, sí. Como siempre, confío en\nTai."
    },
    {
      "index": 27,
      "english": "Do it, Tai!",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 14826,
      "_bytes": 14,
      "translation": "¡Hazlo, Tai!"
    },
    {
      "index": 28,
      "english": "...Okay.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 14841,
      "_bytes": 8,
      "translation": "...Vale."
    },
    {
      "index": 29,
      "english": "Hm?! This is...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 14850,
      "_bytes": 15,
      "translation": "¡¿Eh?! Esto es..."
    },
    {
      "index": 30,
      "english": "What's wrong?",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 14866,
      "_bytes": 13,
      "translation": "¿Qué pasa?"
    },
    {
      "index": 31,
      "english": "There's something written in the\narea where you put the cards.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 14880,
      "_bytes": 62,
      "translation": "Hay algo escrito en la zona\ndonde se ponen las cartas."
    },
    {
      "index": 32,
      "english": "It must be a hint about what cards\nto choose!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 14943,
      "_bytes": 45,
      "translation": "¡Debe ser una pista sobre qué\ncartas elegir!"
    },
    {
      "index": 33,
      "english": "They're the same characters we've \nseen elsewhere in this world. I'll \ntranslate them with my computer.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 14989,
      "_bytes": 103,
      "translation": "Son los mismos caracteres de\notras zonas de este mundo.\nLos traduzco con el ordenador."
    },
    {
      "index": 34,
      "english": "Okay, I'll leave it to you!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15093,
      "_bytes": 27,
      "translation": "¡Vale, te lo dejo a ti!"
    },
    {
      "index": 35,
      "english": "Here's the first sentence.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 15121,
      "_bytes": 26,
      "translation": "Aquí está la primera frase."
    },
    {
      "index": 36,
      "english": "\"From the Virus-types, present a\nChild form.\"",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 15148,
      "_bytes": 45,
      "translation": "\"Tipo Virus, mostrad un\nNovato.\""
    },
    {
      "index": 37,
      "english": "A Child form from the\nVirus-types... um...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15194,
      "_bytes": 42,
      "translation": "Un Novato de tipo\nVirus... a ver..."
    },
    {
      "index": 38,
      "english": "It's Kuwagamon!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15237,
      "_bytes": 15,
      "translation": "¡Es Kuwagamon!"
    },
    {
      "index": 39,
      "english": "It's Gazimon!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15253,
      "_bytes": 13,
      "translation": "¡Es Gazimon!"
    },
    {
      "index": 40,
      "english": "It's TonosamaGekomon!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15267,
      "_bytes": 21,
      "translation": "¡Es ShogunGekomon!"
    },
    {
      "index": 41,
      "english": "Next one, Izzy.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15289,
      "_bytes": 20,
      "translation": "El siguiente, Izzy."
    },
    {
      "index": 42,
      "english": "Yes. Here's the second hint.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 15310,
      "_bytes": 28,
      "translation": "Sí, la segunda pista."
    },
    {
      "index": 43,
      "english": "\"From the Data-types, present an\nAdult form.\"",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 15339,
      "_bytes": 45,
      "translation": "\"Tipo Datos, mostrad un\nCampeón.\""
    },
    {
      "index": 44,
      "english": "An Adult form from the Data-types,\nthat's...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15385,
      "_bytes": 44,
      "translation": "Un Campeón de tipo Datos,\neso es..."
    },
    {
      "index": 45,
      "english": "It's Unimon!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15430,
      "_bytes": 12,
      "translation": "¡Es Unimon!"
    },
    {
      "index": 46,
      "english": "It's Digitamamon!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15443,
      "_bytes": 17,
      "translation": "¡Es Digitamamon!"
    },
    {
      "index": 47,
      "english": "It's Drimogemon!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15461,
      "_bytes": 16,
      "translation": "¡Es Drimogemon!"
    },
    {
      "index": 48,
      "english": "That brings us to the third\nsentence.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 15478,
      "_bytes": 37,
      "translation": "Y eso nos lleva a la tercera\nfrase."
    },
    {
      "index": 49,
      "english": "\"From the Vaccine-types, present a\nPerfect form.\"",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 15516,
      "_bytes": 49,
      "translation": "\"Tipo Vacuna, mostrad un Cuerpo\nPerfecto.\""
    },
    {
      "index": 50,
      "english": "A Perfect form from the\nVaccine-types, that's...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15566,
      "_bytes": 48,
      "translation": "Un Cuerpo Perfecto de tipo\nVacuna, eso es..."
    },
    {
      "index": 51,
      "english": "It's Unimon!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15615,
      "_bytes": 12,
      "translation": "¡Es Unimon!"
    },
    {
      "index": 52,
      "english": "It's Digitamamon!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15628,
      "_bytes": 17,
      "translation": "¡Es Digitamamon!"
    },
    {
      "index": 53,
      "english": "It's Andromon!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15646,
      "_bytes": 14,
      "translation": "¡Es Andromon!"
    },
    {
      "index": 54,
      "english": "Got it! Izzy, the last hint.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15661,
      "_bytes": 33,
      "translation": "¡Entendido! Izzy, la última pista."
    },
    {
      "index": 55,
      "english": "It's still translating. Just a\nlittle longer...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 15695,
      "_bytes": 47,
      "translation": "Todavía está traduciendo. Un\npoco más..."
    },
    {
      "index": 56,
      "english": "I won't let you do that!",
      "speaker_id": 9002,
      "line_type": 2,
      "_offset": 15743,
      "_bytes": 24,
      "translation": "¡No os lo voy a permitir!"
    },
    {
      "index": 57,
      "english": "!!",
      "speaker_id": 9001,
      "line_type": 2,
      "_offset": 15768,
      "_bytes": 2,
      "translation": "!!"
    },
    {
      "index": 58,
      "english": "What's that?",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 15771,
      "_bytes": 12,
      "translation": "¿Qué es eso?"
    },
    {
      "index": 59,
      "english": "I won't let you intrude in Lord\nMyotismon's castle!",
      "speaker_id": 4914,
      "line_type": 2,
      "_offset": 15784,
      "_bytes": 50,
      "translation": "¡No entraréis en el castillo\ndel Amo Myotismon!"
    },
    {
      "index": 60,
      "english": "Aaaaaaaaaaaah!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 15835,
      "_bytes": 14,
      "translation": "¡Aaaaaaaaaaaah!"
    },
    {
      "index": 61,
      "english": "Tai, we can't do anything else\nhere!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 15850,
      "_bytes": 39,
      "translation": "Tai, ¡no podemos hacer nada más\naquí!"
    },
    {
      "index": 62,
      "english": "Wh...what?!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 15890,
      "_bytes": 11,
      "translation": "¡¿Q...qué?!"
    },
    {
      "index": 63,
      "english": "This is bad! The castle's\nbeginning to fall apart!",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 15902,
      "_bytes": 50,
      "translation": "¡Esto es malo! ¡El castillo\nempieza a desmoronarse!"
    },
    {
      "index": 64,
      "english": "Tai, we're out of time! Hurry!",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 15953,
      "_bytes": 33,
      "translation": "Tai, ¡no queda tiempo! ¡Deprisa!"
    },
    {
      "index": 65,
      "english": "Ah, okay!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15987,
      "_bytes": 9,
      "translation": "¡Ah, vale!"
    },
    {
      "index": 66,
      "english": "Tai, can I have a moment?",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 15997,
      "_bytes": 28,
      "translation": "Tai, ¿tienes un momento?"
    },
    {
      "index": 67,
      "english": "What's wrong, Izzy? At a time\nlike this...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16026,
      "_bytes": 47,
      "translation": "¿Qué pasa, Izzy? ¿Justo\nahora...?"
    },
    {
      "index": 68,
      "english": "You made a mistake in the cards\nyou chose, so I went ahead and\ncorrected it.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 16074,
      "_bytes": 76,
      "translation": "Te equivocaste con las cartas\nque elegiste, así que lo he\ncorregido."
    },
    {
      "index": 69,
      "english": "Gh! Thank you...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16151,
      "_bytes": 16,
      "translation": "¡Ah! Gracias..."
    },
    {
      "index": 70,
      "english": "...Translation complete!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 16168,
      "_bytes": 24,
      "translation": "...¡Traducción completa!"
    },
    {
      "index": 71,
      "english": "\"From the Vaccine-types, present a\nChild form.\"",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 16193,
      "_bytes": 47,
      "translation": "\"Tipo Vacuna, mostrad un\nNovato.\""
    },
    {
      "index": 72,
      "english": "A Child form from the\nVaccine-types! That's...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16241,
      "_bytes": 46,
      "translation": "¡Un Novato de tipo\nVacuna! Eso es..."
    },
    {
      "index": 73,
      "english": "What's wrong...",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 16288,
      "_bytes": 15,
      "translation": "¿Qué pasa...?"
    },
    {
      "index": 74,
      "english": "There are two cards that work!\nAgumon and Gomamon...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16304,
      "_bytes": 52,
      "translation": "¡Hay dos cartas que sirven!\nAgumon y Gomamon..."
    },
    {
      "index": 75,
      "english": "N-no way...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 16357,
      "_bytes": 11,
      "translation": "¡Imposible!"
    },
    {
      "index": 76,
      "english": "What do we do? Tai?",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 16369,
      "_bytes": 22,
      "translation": "¿Qué hacemos? ¿Tai?"
    },
    {
      "index": 77,
      "english": "...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16392,
      "_bytes": 3,
      "translation": "..."
    },
    {
      "index": 78,
      "english": "Agumon",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16396,
      "_bytes": 6,
      "translation": "Agumon"
    },
    {
      "index": 79,
      "english": "Gomamon",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16403,
      "_bytes": 7,
      "translation": "Gomamon"
    },
    {
      "index": 80,
      "english": "I can't choose...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16411,
      "_bytes": 17,
      "translation": "¡No puedo elegir!"
    },
    {
      "index": 81,
      "english": "All right! I've decided!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16429,
      "_bytes": 24,
      "translation": "¡Muy bien! ¡Ya lo decidí!"
    },
    {
      "index": 82,
      "english": "It's the Agumon card! Open the\ndoor!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16454,
      "_bytes": 36,
      "translation": "¡La carta de Agumon! ¡Abre la\npuerta!"
    },
    {
      "index": 83,
      "english": "All right! I've decided!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16491,
      "_bytes": 24,
      "translation": "¡Muy bien! ¡Ya lo decidí!"
    },
    {
      "index": 84,
      "english": "It's this one! Open the door,\nGomamon!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16516,
      "_bytes": 38,
      "translation": "¡Es esta! ¡Abre la puerta,\nGomamon!"
    },
    {
      "index": 85,
      "english": "It's no good, I can't choose!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16555,
      "_bytes": 29,
      "translation": "No hay forma, ¡no puedo elegir!"
    },
    {
      "index": 86,
      "english": "I'll do it!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 16585,
      "_bytes": 11,
      "translation": "¡Lo haré yo!"
    },
    {
      "index": 87,
      "english": "It's this one! Open the door,\nGomamon!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 16597,
      "_bytes": 38,
      "translation": "¡Es esta! ¡Abre la puerta,\nGomamon!"
    },
    {
      "index": 88,
      "english": "Please!",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 16636,
      "_bytes": 7,
      "translation": "¡Porfa!"
    },
    {
      "index": 89,
      "english": "Open!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 16644,
      "_bytes": 5,
      "translation": "¡Abre!"
    },
    {
      "index": 90,
      "english": "It's opening...",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 16650,
      "_bytes": 15,
      "translation": "Ya se abre..."
    },
    {
      "index": 91,
      "english": "We did it!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 16666,
      "_bytes": 10,
      "translation": "¡Ya está!"
    },
    {
      "index": 92,
      "english": "Ah..!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16677,
      "_bytes": 5,
      "translation": "¡Ah...!"
    },
    {
      "index": 93,
      "english": "What's wrong, Tai?",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 16683,
      "_bytes": 21,
      "translation": "¿Qué pasa, Tai?"
    },
    {
      "index": 94,
      "english": "I put down the wrong card! I\naccidentally put in the Gomamon\ncard!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16705,
      "_bytes": 66,
      "translation": "¡Puse la carta equivocada! ¡Metí\npor error la carta de\nGomamon!"
    },
    {
      "index": 95,
      "english": "Well, the result turned out fine.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 16772,
      "_bytes": 33,
      "translation": "Bueno, al final salió bien."
    },
    {
      "index": 96,
      "english": "We'll keep this a secret.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16806,
      "_bytes": 25,
      "translation": "Esto quedará en secreto."
    },
    {
      "index": 97,
      "english": "Y-yes...",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 16832,
      "_bytes": 8,
      "translation": "S-sí..."
    },
    {
      "index": 98,
      "english": "Come on, everyone! Go through the\ndoor!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16841,
      "_bytes": 39,
      "translation": "¡Venga, todos! ¡Cruzad la\npuerta!"
    },
    {
      "index": 99,
      "english": "Let's go, guys!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 16881,
      "_bytes": 15,
      "translation": "¡Vamos, chicos!"
    },
    {
      "index": 100,
      "english": "!!",
