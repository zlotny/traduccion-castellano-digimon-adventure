      "english": "It's this one! Open the door,\nGomamon!",
      "_offset": 8497,
      "_length": 38,
      "speaker_id": 6,
      "translation": ""
    },
    {
      "index": 83,
      "english": "It's no good, I can't choose!",
      "_offset": 8536,
      "_length": 29,
      "speaker_id": 18,
      "translation": ""
