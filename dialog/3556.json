    {
      "index": 84,
      "english": "I'll do it!",
      "_offset": 8566,
      "_length": 11,
      "speaker_id": 6,
      "translation": ""
    },
    {
      "index": 85,
      "english": "It's this one! Open the door,\nGomamon!",
      "_offset": 8578,
      "_length": 38,
      "speaker_id": 6,
      "translation": ""
    },
    {
      "index": 86,
      "english": "Please!",
      "_offset": 8617,
      "_length": 7,
      "speaker_id": 0,
      "translation": ""
    },
