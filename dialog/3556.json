      "_offset": 8686,
      "_length": 66,
      "speaker_id": 21,
      "translation": ""
    },
    {
      "index": 93,
      "english": "Well, the result turned out fine.",
      "_offset": 8753,
      "_length": 33,
      "speaker_id": 7,
      "translation": ""
    },
    {
      "index": 94,
      "english": "We'll keep this a secret.",
      "_offset": 8787,
      "_length": 25,
      "speaker_id": 21,
      "translation": ""
    },
    {
      "index": 95,
      "english": "Y-yes...",
      "_offset": 8813,
      "_length": 8,
      "speaker_id": 21,
      "translation": ""
    },
    {
      "index": 96,
      "english": "Come on, everyone! Go through the\ndoor!",
      "_offset": 8822,
      "_length": 39,
      "speaker_id": 6,
      "translation": ""
