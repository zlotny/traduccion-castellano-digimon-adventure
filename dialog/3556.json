      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16919,
      "_bytes": 9,
      "translation": "¿Japón...?"
    },
    {
      "index": 103,
      "english": "The shrine! The campgrounds! We're\nback!",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 16929,
      "_bytes": 40,
      "translation": "¡El templo! ¡El camping! ¡Hemos\nvuelto!"
    },
    {
