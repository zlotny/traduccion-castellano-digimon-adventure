      "_length": 17,
      "speaker_id": 255,
      "translation": ""
    },
    {
      "index": 40,
      "english": "Yamato, you should stay here and\nprotect the others! We can't risk \nendangering everyone right now.",
      "_offset": 5290,
      "_length": 99,
      "speaker_id": 255,
      "translation": ""
    },
    {
      "index": 41,
      "english": "Taichi...!\nGot it. Be careful!",
