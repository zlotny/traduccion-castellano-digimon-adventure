      "index": 125,
      "english": "What's wrong?",
      "_offset": 5119,
      "_length": 13,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 126,
      "english": "I just wanted to tell you that you\nshould follow your own path, and\nhave faith in it...",
      "_offset": 5133,
      "_length": 87,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 127,
