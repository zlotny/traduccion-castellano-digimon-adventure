      "_length": 11,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 115,
      "english": "I'm not gonna just sit around and\ncomplain anymore.",
      "_offset": 4810,
      "_length": 51,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 116,
      "english": "I don't mind if you do, as long as\nI'm the only one you do it to!",
      "_offset": 4862,
      "_length": 65,
      "speaker_id": 0,
      "translation": ""
    },
    {
      "index": 117,
      "english": "Fine! Then I'll save my\ncomplaints, just for you!",
      "_offset": 4928,
      "_length": 49,
      "speaker_id": 0,
      "translation": ""
    },
