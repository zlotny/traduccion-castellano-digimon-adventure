{
  "file_id": "3553",
  "format": "etdf",
  "kind": "ETDF",
  "text_count": 193,
  "dialog": [
    {
      "index": 0,
      "english": "So, princess, where should we go?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 14120,
      "_bytes": 33,
      "translation": "Bueno, princesa, ¿a dónde vamos?"
    },
    {
      "index": 1,
      "english": "Ugh! Don't call me \"princess\"!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 14154,
      "_bytes": 30,
      "translation": "¡Uf! ¡No me llames \"princesa\"!"
    },
    {
      "index": 2,
      "english": "I was joking! Joking!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 14185,
      "_bytes": 21,
      "translation": "¡Era broma! ¡Era broma!"
    },
    {
      "index": 3,
      "english": "Heeeeeeeeeey!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 14207,
      "_bytes": 13,
      "translation": "¡Eooooooo!"
    },
    {
      "index": 4,
      "english": "It's Matt!",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 14221,
      "_bytes": 12,
      "translation": "¡Es Matt!"
    },
    {
      "index": 5,
      "english": "Have you seen Sora?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 14234,
      "_bytes": 19,
      "translation": "¿Habéis visto a Sora?"
    },
    {
      "index": 6,
      "english": "No, we haven't been able to find\nher.",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 14254,
      "_bytes": 37,
      "translation": "No, no hemos podido encontrarla."
    },
    {
      "index": 7,
      "english": "Really? I wonder where she went.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 14292,
      "_bytes": 32,
      "translation": "¿En serio? Me pregunto adónde fue."
    },
    {
      "index": 8,
      "english": "I...saw Sora.",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 14325,
      "_bytes": 13,
      "translation": "Vi...a Sora."
    },
    {
      "index": 9,
      "english": "Huh? Where'd you see her?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 14339,
      "_bytes": 25,
      "translation": "¿Eh? ¿Dónde la viste?"
    },
    {
      "index": 10,
      "english": "At the Gekomon castle. I thought\nit might have been a dream, but...",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 14365,
      "_bytes": 67,
      "translation": "En el castillo de Gekomon. Pensé\nque sería un sueño, pero..."
    },
    {
      "index": 11,
      "english": "I have a feeling...the voice that\ntold me not to eat the mushrooms\nwas also Sora's.",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 14433,
      "_bytes": 83,
      "translation": "Tengo la sensación de que la voz\nque me dijo que no comiera setas\ntambién era de Sora."
    },
    {
      "index": 12,
      "english": "Really?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 14517,
      "_bytes": 7,
      "translation": "¿Seguro?"
    },
    {
      "index": 13,
      "english": "But why isn't Sora showing herself\nto us?",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 14525,
      "_bytes": 41,
      "translation": "Pero ¿por qué Sora no se muestra?"
    },
    {
      "index": 14,
      "english": "Worrying about it won't solve\nanything. We have to find her in\nthe flesh first.",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 14567,
      "_bytes": 79,
      "translation": "Preocuparnos no soluciona nada.\nTenemos que encontrarla ya,\nen persona."
    },
    {
      "index": 15,
      "english": "Heeeeey! Soraaaaaaaa!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 14647,
      "_bytes": 21,
      "translation": "¡Eh! ¡Soraaaaaaaa!"
    },
    {
      "index": 16,
      "english": "Soraaaaaaaaa!",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 14669,
      "_bytes": 13,
      "translation": "¡Soraaaaaaa!"
    },
    {
      "index": 17,
      "english": "!!",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 14683,
      "_bytes": 2,
      "translation": "!!"
    },
    {
      "index": 18,
      "english": "What's going on?",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 14686,
      "_bytes": 16,
      "translation": "¿Qué pasa?"
    },
    {
      "index": 19,
      "english": "I hear something.",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 14703,
      "_bytes": 17,
      "translation": "Oigo algo."
    },
    {
      "index": 20,
      "english": "Huh? Maybe it's Sora.",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 14721,
      "_bytes": 21,
      "translation": "¿Eh? ¿Será Sora?"
    },
    {
      "index": 21,
      "english": "It's a Flymon!",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 14743,
      "_bytes": 14,
      "translation": "¡Es un Flymon!"
    },
    {
      "index": 22,
      "english": "Not good! Flymon are real fast!",
      "speaker_id": 2421,
      "line_type": 2,
      "_offset": 14758,
      "_bytes": 31,
      "translation": "¡Mal asunto! ¡Los Flymon son\nmuy rápidos!"
    },
    {
      "index": 23,
      "english": "Birdramon! She saved us!",
      "speaker_id": 2421,
      "line_type": 2,
      "_offset": 14790,
      "_bytes": 24,
      "translation": "¡Birdramon! ¡Nos salvó!"
    },
    {
      "index": 24,
      "english": "If Birdramon is here, then so is\nSora!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 14815,
      "_bytes": 38,
      "translation": "¡Si Birdramon está aquí,\nSora también!"
    },
    {
      "index": 25,
      "english": "She's there! Over there!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 14854,
      "_bytes": 24,
      "translation": "¡Está ahí! ¡Ahí mismo!"
    },
    {
      "index": 26,
      "english": "Soraaaaaa! Wait for us!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 14879,
      "_bytes": 23,
      "translation": "¡Soraaaaa! ¡Espéranos!"
    },
    {
      "index": 27,
      "english": "Soraaaaaa! Wait for us!",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 14903,
      "_bytes": 23,
      "translation": "¡Soraaaaa! ¡Espéranos!"
    },
    {
      "index": 28,
      "english": "Wait, Sora!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 14927,
      "_bytes": 11,
      "translation": "¡Espera!"
    },
    {
      "index": 29,
      "english": "Why are you running away?!",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 14939,
      "_bytes": 26,
      "translation": "¡¿Por qué huyes?!"
    },
    {
      "index": 30,
      "english": "Sora, do you hate us?",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 14966,
      "_bytes": 21,
      "translation": "Sora, ¿nos odias?"
    },
    {
      "index": 31,
      "english": "No...I don't.",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 14988,
      "_bytes": 13,
      "translation": "No, para nada..."
    },
    {
      "index": 32,
      "english": "Sora, go ahead. Tell them.",
      "speaker_id": 2321,
      "line_type": 2,
      "_offset": 15002,
      "_bytes": 26,
      "translation": "Sora, venga. Cuéntaselo."
    },
    {
      "index": 33,
      "english": "The night Piyomon and I left to\nlook for Tai, I saw them.",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 15029,
      "_bytes": 60,
      "translation": "La noche que Piyomon y yo\nfuimos a buscar a Tai, los vi."
    },
    {
      "index": 34,
      "english": "PicoDevimon was talking to\nsomeone.",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 15090,
      "_bytes": 35,
      "translation": "DemiDevimon hablaba con\nalguien."
    },
    {
      "index": 35,
      "english": "What were they talking about?",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 15126,
      "_bytes": 29,
      "translation": "¿De qué estaban hablando?"
    },
    {
      "index": 36,
      "english": "Everyone's Crests have a meaning.\nFor example, Tai has the Crest\nof Courage...",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 15156,
      "_bytes": 81,
      "translation": "Los Emblemas tienen un\nsignificado. Tai tiene el\nEmblema del Valor..."
    },
    {
      "index": 37,
      "english": "The Crest of Courage...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15238,
      "_bytes": 23,
      "translation": "El Emblema del Valor..."
    },
    {
      "index": 38,
      "english": "Matt has the Crest of\nFriendship.",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 15262,
      "_bytes": 35,
      "translation": "Matt tiene el Emblema\nde la Amistad."
    },
    {
      "index": 39,
      "english": "Friendship...",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 15298,
      "_bytes": 13,
      "translation": "Amistad..."
    },
    {
      "index": 40,
      "english": "What about me?",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 15312,
      "_bytes": 14,
      "translation": "¿Y yo qué?"
    },
    {
      "index": 41,
      "english": "You have the Crest of Hope.",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 15327,
      "_bytes": 27,
      "translation": "Tu Emblema es la Esperanza."
    },
    {
      "index": 42,
      "english": "The Crest of Hope...Huh.",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 15355,
      "_bytes": 24,
      "translation": "La Esperanza...vaya."
    },
    {
      "index": 43,
      "english": "Izzy has the Crest of\nKnowledge, Joe has the Crest of\nHonesty...",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 15380,
      "_bytes": 69,
      "translation": "Izzy tiene el Emblema del\nConocimiento, Joe el de la\nSinceridad..."
    },
    {
      "index": 44,
      "english": "Mimi has the Crest of Purity, and\nI...have the Crest of Love.",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 15450,
      "_bytes": 61,
      "translation": "Mimi tiene el Emblema de la\nPureza, y yo... el del Amor."
    },
    {
      "index": 45,
      "english": "Huh. The Crest of Love suits you,\nSora.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15512,
      "_bytes": 39,
      "translation": "Vaya. El Emblema del Amor te\npega, Sora."
    },
    {
      "index": 46,
      "english": "No, it doesn't! It doesn't suit me\nat all!",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 15552,
      "_bytes": 42,
      "translation": "¡No, para nada! ¡No me pega\nnada de nada!"
    },
    {
      "index": 47,
      "english": "But Sora, you're always worrying\nabout us...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15595,
      "_bytes": 44,
      "translation": "Pero Sora, te preocupas\npor todos nosotros..."
    },
    {
      "index": 48,
      "english": "I don't care about everyone! You\ndon't know what I'm *really* like!",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 15640,
      "_bytes": 67,
      "translation": "¡No me importa nadie! ¡No sabéis\ncómo soy REALMENTE!"
    },
    {
      "index": 49,
      "english": "...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15708,
      "_bytes": 3,
      "translation": "..."
    },
    {
      "index": 50,
      "english": "I'm sorry...",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 15712,
      "_bytes": 12,
      "translation": "Lo siento..."
    },
    {
      "index": 51,
      "english": "W-what's wrong?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15725,
      "_bytes": 15,
      "translation": "¿Q-qué pasa?"
    },
    {
      "index": 52,
      "english": "My Crest will never glow.",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 15741,
      "_bytes": 25,
      "translation": "Mi Emblema nunca brillará."
    },
    {
      "index": 53,
      "english": "Huh?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15767,
      "_bytes": 4,
      "translation": "¿Eh?"
    },
    {
      "index": 54,
      "english": "Because I don't have any love.",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 15772,
      "_bytes": 30,
      "translation": "Porque no tengo amor."
    },
    {
      "index": 55,
      "english": "What do you mean, you don't have\nany love?",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 15803,
      "_bytes": 42,
      "translation": "¿Cómo que no tienes amor?"
    },
    {
      "index": 56,
      "english": "PicoDevimon said that I was raised\nwithout any real love...",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 15846,
      "_bytes": 59,
      "translation": "DemiDevimon dijo que me criaron\nsin amor de verdad..."
    },
    {
      "index": 57,
      "english": "He said, because of that, my Crest\nwill never glow!",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 15906,
      "_bytes": 51,
      "translation": "¡Por eso, dijo, mi Emblema no\nbrillará nunca!"
    },
    {
      "index": 58,
      "english": "Don't be silly. PicoDevimon was\njust lying.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 15958,
      "_bytes": 43,
      "translation": "No seas tonta. DemiDevimon\nsolo mentía."
    },
    {
      "index": 59,
      "english": "It's not a lie. When I was on the\ngirls' soccer team...",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 16002,
      "_bytes": 55,
      "translation": "No es mentira. Jugaba al fútbol\nfemenino..."
    },
    {
      "index": 60,
      "english": "I was injured, but no matter how\nmuch I asked, my mother wouldn't \nlet me go to an important match.",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 16058,
      "_bytes": 99,
      "translation": "Me lesioné, pero por más que\nse lo pedí, mi madre no me dejó\nir a un partido importante."
    },
    {
      "index": 61,
      "english": "...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16158,
      "_bytes": 3,
      "translation": "..."
    },
    {
      "index": 62,
      "english": "She only sees me as the daughter\nof a flower arrangement school\nhead.",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 16162,
      "_bytes": 69,
      "translation": "Solo me ve como la hija de\nla directora de una escuela\nde arreglos florales."
    },
    {
      "index": 63,
      "english": "What's that? A school head?",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 16232,
      "_bytes": 27,
      "translation": "¿Qué es eso? ¿Directora?"
    },
    {
      "index": 64,
      "english": "A hereditary teacher of flower\narrangement.",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 16260,
      "_bytes": 43,
      "translation": "Una maestra floral, cargo\nhereditario."
    },
    {
      "index": 65,
      "english": "So if I grew up without love, I\ncan't do anything about that!",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 16304,
      "_bytes": 61,
      "translation": "¡Si crecí sin amor, no puedo\nhacer nada al respecto!"
    },
    {
      "index": 66,
      "english": "But even if that's true, you can't\njust believe everything\nPicoDevimon says!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16366,
      "_bytes": 76,
      "translation": "¡Aunque eso sea verdad, no puedes\ncreerte todo lo que\ndice DemiDevimon!"
    },
    {
      "index": 67,
      "english": "W-waaaaaaaaaaaaah!",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 16443,
      "_bytes": 18,
      "translation": "¡B-buaaaaaaaaaa!"
    },
    {
      "index": 68,
      "english": "H-hey, Matt. What am I supposed\nto do at a time like this?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16462,
      "_bytes": 60,
      "translation": "O-oye, Matt. ¿Qué se supone que\nhago en un momento así?"
    },
    {
      "index": 69,
      "english": "If she wants to cry, let her cry.",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 16523,
      "_bytes": 33,
      "translation": "Si quiere llorar, que llore."
    },
    {
      "index": 70,
      "english": "Matt's such an adult.",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 16557,
      "_bytes": 23,
      "translation": "Matt es tan adulto."
    },
    {
      "index": 71,
      "english": "Well, more than Tai, anyway.",
      "speaker_id": 2221,
      "line_type": 2,
      "_offset": 16581,
      "_bytes": 31,
      "translation": "Bueno, más que Tai, al menos."
    },
    {
      "index": 72,
      "english": "Thank you, Sora. You were secretly\nhelping us, weren't you?",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 16613,
      "_bytes": 59,
      "translation": "Gracias, Sora. Nos ayudabas\nen secreto, ¿verdad?"
    },
    {
      "index": 73,
      "english": "She knew PicoDevimon was up to\nsomething, so she decided to help\nyou in secret.",
      "speaker_id": 2321,
      "line_type": 2,
      "_offset": 16673,
      "_bytes": 79,
      "translation": "Sabía que DemiDevimon tramaba\nalgo, así que decidió ayudaros\nen secreto."
    },
    {
      "index": 74,
      "english": "I didn't know.",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 16753,
      "_bytes": 14,
      "translation": "No lo sabía."
    },
    {
      "index": 75,
      "english": "I...like having you around, Sora.",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 16768,
      "_bytes": 33,
      "translation": "Me... gusta tenerte cerca, Sora."
    },
    {
      "index": 76,
      "english": "Huh?",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 16802,
      "_bytes": 4,
      "translation": "¿Eh?"
    },
    {
      "index": 77,
      "english": "Huh?",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 16807,
      "_bytes": 4,
      "translation": "¿Eh?"
    },
    {
      "index": 78,
      "english": "So, don't leave us anymore. I\ndon't want my family...",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 16812,
      "_bytes": 53,
      "translation": "Así que no nos dejes más. No\nquiero que mi familia..."
    },
    {
      "index": 79,
      "english": "I mean, I don't want everyone to\nsplit up.",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 16866,
      "_bytes": 42,
      "translation": "O sea, no quiero que nos\nseparemos."
    },
    {
      "index": 80,
      "english": "T.K... Okay, I understand.",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 16909,
      "_bytes": 29,
      "translation": "T.K... Vale, lo entiendo."
    },
    {
      "index": 81,
      "english": "Things have calmed down a bit.",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 16939,
      "_bytes": 30,
      "translation": "Las cosas se han calmado algo."
    },
    {
      "index": 82,
      "english": "You're our friend no matter what",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 16970,
      "_bytes": 32,
      "translation": "Siempre serás nuestra amiga"
    },
    {
      "index": 83,
      "english": "Your Crest will surely glow someday",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17003,
      "_bytes": 35,
      "translation": "Tu Emblema brillará algún día"
    },
    {
      "index": 84,
      "english": "Even if your Crest doesn't glow,\nSora, you're still our friend.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17039,
      "_bytes": 63,
      "translation": "Aunque tu Emblema no brille,\nSora, sigues siendo nuestra amiga."
    },
    {
      "index": 85,
      "english": "Thanks, but then how are we gonna\nsave the world?",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 17103,
      "_bytes": 49,
      "translation": "Gracias, pero ¿cómo\nvamos a salvar el mundo?"
    },
    {
      "index": 86,
      "english": "We'll all think of a way.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17153,
      "_bytes": 25,
      "translation": "Ya se nos ocurrirá algo."
    },
    {
      "index": 87,
      "english": "Yeah. I understand.",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 17179,
      "_bytes": 19,
      "translation": "Sí. Lo entiendo."
    },
    {
      "index": 88,
      "english": "Your Crest will glow someday,\nSora. I'm sure of it.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17199,
      "_bytes": 51,
      "translation": "Tu Emblema brillará algún día,\nSora. Estoy seguro."
    },
    {
      "index": 89,
      "english": "Haha! It's weird for you to say\nthings like \"I'm sure of it\".",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 17251,
      "_bytes": 61,
      "translation": "¡Jaja! Qué raro que digas\ncosas como \"estoy seguro\"."
    },
    {
      "index": 90,
      "english": "My intuition's always right on the\nmark, you know.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17313,
      "_bytes": 50,
      "translation": "Mi intuición siempre acierta,\nya lo sabes."
    },
    {
      "index": 91,
      "english": "I get the feeling your Crest will\nglow, too.",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 17364,
      "_bytes": 44,
      "translation": "Presiento que tu Emblema\ntambién brillará."
    },
    {
      "index": 92,
      "english": "Me too!",
      "speaker_id": 2321,
      "line_type": 2,
      "_offset": 17409,
      "_bytes": 7,
      "translation": "¡Y yo!"
    },
    {
      "index": 93,
      "english": "Thanks, guys.",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 17417,
      "_bytes": 13,
      "translation": "¡Gracias!"
    },
    {
      "index": 94,
      "english": "Sora's been deep in thought over\nthere.",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 17431,
      "_bytes": 39,
      "translation": "Sora está muy pensativa\npor ahí."
    },
    {
      "index": 95,
      "english": "Yeah, she's dealing with a lot of\nstuff.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17471,
      "_bytes": 40,
      "translation": "Sí, está lidiando con muchas\ncosas."
    },
    {
      "index": 96,
      "english": "Sora will cheer up.",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 17512,
      "_bytes": 19,
      "translation": "Sora se animará."
    },
    {
      "index": 97,
      "english": "Yeah! She's just a bit tired.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17532,
      "_bytes": 29,
      "translation": "¡Sí! Solo está un poco cansada."
    },
    {
      "index": 98,
      "english": "Thank you for earlier, T.K!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17562,
      "_bytes": 30,
      "translation": "¡Gracias por antes, T.K.!"
    },
    {
      "index": 99,
      "english": "What do you mean?",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 17593,
      "_bytes": 17,
      "translation": "¿Qué dices?"
    },
    {
      "index": 100,
      "english": "For convincing Sora.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17611,
      "_bytes": 20,
      "translation": "Por convencer a Sora."
    },
    {
      "index": 101,
      "english": "Your words cheered her up, T.K!",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 17632,
      "_bytes": 34,
      "translation": "¡Tus palabras la animaron, T.K.!"
    },
    {
      "index": 102,
      "english": "Yeah! I think so, too!",
      "speaker_id": 2721,
      "line_type": 2,
      "_offset": 17667,
      "_bytes": 22,
      "translation": "¡Sí! ¡Yo también!"
    },
    {
      "index": 103,
      "english": "I just said what I was thinking.",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 17690,
      "_bytes": 32,
      "translation": "Solo dije lo que pensaba."
    },
    {
      "index": 104,
      "english": "That's good.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17723,
      "_bytes": 12,
      "translation": "Qué bien."
    },
    {
      "index": 105,
      "english": "I have to do something impressive\nbefore Lord Myotismon gets here!",
      "speaker_id": 4221,
      "line_type": 2,
      "_offset": 17736,
      "_bytes": 65,
      "translation": "¡Tengo que hacer algo genial\nantes de que llegue el Amo\nMyotismon!"
    },
    {
      "index": 106,
      "english": "Sora! Watch out!",
      "speaker_id": 2321,
      "line_type": 2,
      "_offset": 17802,
      "_bytes": 16,
      "translation": "¡Sora! ¡Cuidado!"
    },
    {
      "index": 107,
      "english": "Piyomon!",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 17819,
      "_bytes": 8,
      "translation": "¡Piyomon!"
    },
    {
      "index": 108,
      "english": "Gh!",
      "speaker_id": 2321,
      "line_type": 2,
      "_offset": 17828,
      "_bytes": 3,
      "translation": "¡Gh!"
    },
    {
      "index": 109,
      "english": "Piyomon! Hang in there, Piyomon!",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 17832,
      "_bytes": 32,
      "translation": "¡Piyomon! ¡Aguanta, Piyomon!"
    },
    {
      "index": 110,
      "english": "I'll...protect Sora...",
      "speaker_id": 2321,
      "line_type": 2,
      "_offset": 17865,
      "_bytes": 22,
      "translation": "Protegeré a Sora..."
    },
    {
      "index": 111,
      "english": "Mm, what's going on?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17888,
      "_bytes": 20,
      "translation": "Mm, ¿qué pasa?"
    },
    {
      "index": 112,
      "english": "Aaaaah! PicoDevimon!",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 17909,
      "_bytes": 20,
      "translation": "¡Aaaaah! ¡DemiDevimon!"
    },
    {
      "index": 113,
      "english": "Uh-oh!",
      "speaker_id": 4221,
      "line_type": 2,
      "_offset": 17930,
      "_bytes": 6,
      "translation": "¡Oh no!"
    },
    {
      "index": 114,
      "english": "W-what?!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17937,
      "_bytes": 8,
      "translation": "¡¿Q-qué?!"
    },
    {
      "index": 115,
      "english": "?!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 17946,
      "_bytes": 2,
      "translation": "?!"
    },
    {
      "index": 116,
      "english": "Chosen Children...",
      "speaker_id": 3031,
      "line_type": 2,
      "_offset": 17949,
      "_bytes": 18,
      "translation": "Niños Elegidos..."
    },
    {
      "index": 117,
      "english": "PicoDevimon was talking to this\nguy!",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 17968,
      "_bytes": 36,
      "translation": "¡DemiDevimon hablaba con este\ntipo!"
    },
    {
      "index": 118,
      "english": "He's not \"this guy\"! He's Lord\nMyotismon!",
      "speaker_id": 4221,
      "line_type": 2,
      "_offset": 18005,
      "_bytes": 40,
      "translation": "¡No es \"ese tipo\"! ¡Es el Amo\nMyotismon!"
    },
    {
      "index": 119,
      "english": "Myotismon...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 18046,
      "_bytes": 11,
      "translation": "Myotismon..."
    },
    {
      "index": 120,
      "english": "Hahaha. Your journey ends here!",
      "speaker_id": 3031,
      "line_type": 2,
      "_offset": 18058,
      "_bytes": 31,
      "translation": "¡Ja! ¡Aquí acaba vuestro viaje!"
    },
    {
      "index": 121,
      "english": "Agumon!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 18090,
      "_bytes": 7,
      "translation": "¡Agumon!"
    },
    {
      "index": 122,
      "english": "Yeah! Let's go, everyone!",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 18098,
      "_bytes": 25,
      "translation": "¡Sí! ¡Vamos todos!"
    },
    {
      "index": 123,
      "english": "He's strong, Tai.",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 18124,
      "_bytes": 20,
      "translation": "Es fuerte, Tai."
    },
    {
      "index": 124,
      "english": "No way...",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 18145,
      "_bytes": 9,
      "translation": "No puede ser..."
    },
    {
      "index": 125,
      "english": "I have to go...",
      "speaker_id": 2321,
      "line_type": 2,
      "_offset": 18155,
      "_bytes": 15,
      "translation": "Tengo que ir..."
    },
    {
      "index": 126,
      "english": "What?!",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 18171,
      "_bytes": 6,
      "translation": "¡¿Qué?!"
    },
    {
      "index": 127,
      "english": "I'm the only one left.",
      "speaker_id": 2321,
      "line_type": 2,
      "_offset": 18178,
      "_bytes": 22,
      "translation": "Soy la única que queda."
    },
    {
      "index": 128,
      "english": "You can't, not in that state!",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 18201,
      "_bytes": 29,
      "translation": "¡No puedes, no en ese estado!"
    },
    {
      "index": 129,
      "english": "I know, Sora, but I have to go!",
      "speaker_id": 2321,
      "line_type": 2,
      "_offset": 18231,
      "_bytes": 31,
      "translation": "¡Lo sé, Sora, pero tengo que ir!"
    },
    {
      "index": 130,
      "english": "You can't!",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 18263,
      "_bytes": 10,
      "translation": "¡No puedes!"
    },
    {
      "index": 131,
      "english": "Let me go!",
      "speaker_id": 2321,
      "line_type": 2,
      "_offset": 18274,
      "_bytes": 10,
      "translation": "¡Déjame ir!"
    },
    {
      "index": 132,
      "english": "No! You can't go!",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 18285,
      "_bytes": 17,
      "translation": "¡No! ¡No puedes ir!"
    },
    {
      "index": 133,
      "english": "Why can't you understand?!",
      "speaker_id": 2321,
      "line_type": 2,
      "_offset": 18303,
      "_bytes": 26,
      "translation": "¡¿Por qué no lo entiendes?!"
    },
    {
      "index": 134,
      "english": "Those are...the words I said to my\nmother back then....",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 18330,
      "_bytes": 55,
      "translation": "Esas son las palabras\nque le dije a mi madre\nentonces..."
    },
    {
      "index": 135,
      "english": "My mother...was putting me before\neverything else...",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 18386,
      "_bytes": 52,
      "translation": "Mi madre...me ponía a mí\npor delante de todo..."
    },
    {
      "index": 136,
      "english": "Take that!",
      "speaker_id": 2331,
      "line_type": 2,
      "_offset": 18439,
      "_bytes": 10,
      "translation": "¡Toma esto!"
    },
    {
      "index": 137,
      "english": "Is that all you've got?",
      "speaker_id": 3031,
      "line_type": 2,
      "_offset": 18450,
      "_bytes": 23,
      "translation": "¿Es lo único que tienes?"
    },
    {
      "index": 138,
      "english": "Birdramoooooooooon!",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 18474,
      "_bytes": 19,
      "translation": "¡Birdramoooooooon!"
    },
    {
      "index": 139,
      "english": "W-what's this light?!",
      "speaker_id": 3031,
      "line_type": 2,
      "_offset": 18494,
      "_bytes": 21,
      "translation": "¡¿Q-qué es esta luz?!"
    },
    {
      "index": 140,
      "english": "My Crest glowed!",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 18516,
      "_bytes": 16,
      "translation": "¡Ya brilló!"
    },
    {
      "index": 141,
      "english": "I can feel the depths of Sora's\nlove!",
      "speaker_id": 2341,
      "line_type": 2,
      "_offset": 18533,
      "_bytes": 37,
      "translation": "¡Siento la fuerza del amor\nde Sora!"
    },
    {
      "index": 142,
      "english": "Yeah...",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 18571,
      "_bytes": 7,
      "translation": "Sí..."
    },
    {
      "index": 143,
      "english": "Aaaaargh! The Crest of Love just\nhad to activate at the worst\npossible time!",
      "speaker_id": 3031,
      "line_type": 2,
      "_offset": 18579,
      "_bytes": 76,
      "translation": "¡Aaaargh! ¡El Emblema del Amor\ntenía que activarse en el\npeor momento posible!"
    },
    {
      "index": 144,
      "english": "I will protect Sora!",
      "speaker_id": 2341,
      "line_type": 2,
      "_offset": 18656,
      "_bytes": 20,
      "translation": "¡Protegeré a Sora!"
    },
    {
      "index": 145,
      "english": "You look so cool, Piyomon!",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 18677,
      "_bytes": 26,
      "translation": "¡Estás genial, Piyomon!"
    },
    {
      "index": 146,
      "english": "Shadow Wing!",
      "speaker_id": 2341,
      "line_type": 2,
      "_offset": 18704,
      "_bytes": 12,
      "translation": "¡Ala Sombra!"
    },
    {
      "index": 147,
      "english": "Tch!",
      "speaker_id": 3031,
      "line_type": 2,
      "_offset": 18717,
      "_bytes": 4,
      "translation": "¡Tch!"
    },
    {
      "index": 148,
      "english": "Here's your chance!",
      "speaker_id": 2341,
      "line_type": 2,
      "_offset": 18722,
      "_bytes": 19,
      "translation": "¡Es tu oportunidad!"
    },
    {
      "index": 149,
      "english": "Everyone, run for it!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 18742,
      "_bytes": 21,
      "translation": "Todos, ¡corred!"
    },
    {
      "index": 150,
      "english": "The sun will be rising soon.\nYou've barely escaped, children...",
      "speaker_id": 3031,
      "line_type": 2,
      "_offset": 18764,
      "_bytes": 63,
      "translation": "El sol saldrá pronto.\nHabéis escapado por poco..."
    },
    {
      "index": 151,
      "english": "See? Your Crest glowed!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 18828,
      "_bytes": 23,
      "translation": "¿Ves? ¡Tu Emblema brilló!"
    },
    {
      "index": 152,
      "english": "I realized, I...was acting exactly\nlike my mother.",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 18852,
      "_bytes": 50,
      "translation": "Me di cuenta de que actuaba\nigual que mi madre."
    },
    {
      "index": 153,
      "english": "Sora...",
      "speaker_id": 2311,
      "line_type": 2,
      "_offset": 18903,
      "_bytes": 7,
      "translation": "Sora..."
    },
    {
      "index": 154,
      "english": "And then I realized that my mother\nreally does love me.",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 18911,
      "_bytes": 55,
      "translation": "Y entonces entendí que mi madre\nsí me quiere de verdad."
    },
    {
      "index": 155,
      "english": "Aaaah, I want Sora's love, too.",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 18967,
      "_bytes": 31,
      "translation": "Aaah, yo también quiero el amor\nde Sora."
    },
    {
      "index": 156,
      "english": "Y-you idiot! Tai, you can't\njust *say* that!",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 18999,
      "_bytes": 47,
      "translation": "¡I-idiota! Tai, ¡eso no se\nDICE así como así!"
    },
    {
      "index": 157,
      "english": "Huh? Joe, your face is red.",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 19047,
      "_bytes": 27,
      "translation": "¿Eh? Joe, estás rojo."
    },
    {
      "index": 158,
      "english": "Joe, I'll give you my love, too.",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 19075,
      "_bytes": 32,
      "translation": "Joe, yo también te doy mi amor."
    },
    {
      "index": 159,
      "english": "Huh?",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 19108,
      "_bytes": 4,
      "translation": "¿Eh?"
    },
    {
      "index": 160,
      "english": "Here!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 19113,
      "_bytes": 5,
      "translation": "¡Toma!"
    },
    {
      "index": 161,
      "english": "These are just tree nuts.\nSeriously...",
      "speaker_id": 1051,
      "line_type": 2,
      "_offset": 19119,
      "_bytes": 38,
      "translation": "Son solo frutos secos.\nEn serio..."
    },
    {
      "index": 162,
      "english": "Hahaha!",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 19158,
      "_bytes": 7,
      "translation": "¡Jajaja!"
    },
    {
      "index": 163,
      "english": "Haha!",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 19166,
      "_bytes": 5,
      "translation": "¡Jaja!"
    },
    {
      "index": 164,
      "english": "Chosen Children...",
      "speaker_id": 5011,
      "line_type": 2,
      "_offset": 19172,
      "_bytes": 18,
      "translation": "Niños Elegidos..."
    },
    {
      "index": 165,
      "english": "Hey, old man. What do you want\nthis time?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 19191,
      "_bytes": 41,
      "translation": "Oye, viejo. ¿Qué quieres\nesta vez?"
    },
    {
      "index": 166,
      "english": "Well, I've got good news and bad\nnews. Which do you want to hear?",
      "speaker_id": 5011,
      "line_type": 2,
      "_offset": 19233,
      "_bytes": 65,
      "translation": "Bueno, tengo buenas y malas\nnoticias. ¿Cuál quieres oír\nprimero?"
    },
    {
      "index": 167,
      "english": "We're going to be disappointed\nanyway, so let's hear the good\nnews.",
      "speaker_id": 1021,
      "line_type": 2,
      "_offset": 19299,
      "_bytes": 67,
      "translation": "Nos vamos a decepcionar igual,\nasí que oigamos las buenas\nnoticias."
    },
    {
      "index": 168,
      "english": "Then here's the good news. I've\nfound a comrade for you.",
      "speaker_id": 5011,
      "line_type": 2,
      "_offset": 19367,
      "_bytes": 56,
      "translation": "Esta es la buena noticia:\nos he encontrado un compañero."
    },
    {
      "index": 169,
      "english": "A comrade? You mean a Chosen\nChild?",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 19424,
      "_bytes": 35,
      "translation": "¿Un compañero? ¿Un Niño\nElegido?"
    },
    {
      "index": 170,
      "english": "Yes. In truth, there are actually\neight Chosen Children.",
      "speaker_id": 5011,
      "line_type": 2,
      "_offset": 19460,
      "_bytes": 56,
      "translation": "Sí. En realidad, hay ocho\nNiños Elegidos."
    },
    {
      "index": 171,
      "english": "actually eight Chosen Children.",
      "speaker_id": 1061,
      "line_type": 2,
      "_offset": 19517,
      "_bytes": 31,
      "translation": "en realidad, ocho Niños Elegidos."
    },
    {
      "index": 172,
      "english": "actually eight Chosen Children.",
      "speaker_id": 1031,
      "line_type": 2,
      "_offset": 19549,
      "_bytes": 31,
      "translation": "en realidad, ocho Niños Elegidos."
    },
    {
      "index": 173,
      "english": "Whaaaaaaaat?!!",
      "speaker_id": 9001,
      "line_type": 2,
      "_offset": 19581,
      "_bytes": 14,
      "translation": "¡¿Queeeeeeé?!"
    },
    {
      "index": 174,
      "english": "You can't fix the distortions in \nthis world unless all eight of you \nare together.",
      "speaker_id": 5011,
      "line_type": 2,
      "_offset": 19596,
      "_bytes": 83,
      "translation": "No podéis arreglar las\ndistorsiones de este mundo\nsi no estáis los ocho juntos."
    },
    {
      "index": 175,
      "english": "And the distortions will affect\nyour world as well. Understand?",
      "speaker_id": 5011,
      "line_type": 2,
      "_offset": 19680,
      "_bytes": 63,
      "translation": "Y las distorsiones también\nafectarán a vuestro mundo.\n¿Entendido?"
    },
    {
      "index": 176,
      "english": "Of course!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 19744,
      "_bytes": 10,
      "translation": "¡Claro!"
    },
    {
      "index": 177,
      "english": "I wonder what kind of person they\nare.",
      "speaker_id": 1071,
      "line_type": 2,
      "_offset": 19755,
      "_bytes": 38,
      "translation": "Me pregunto qué clase de\npersona será."
    },
    {
      "index": 178,
      "english": "So where are they? What's their\nname?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 19794,
      "_bytes": 37,
      "translation": "¿Dónde está? ¿Cómo se llama?"
    },
    {
      "index": 179,
      "english": "As for their name... I don't know!",
      "speaker_id": 5011,
      "line_type": 2,
      "_offset": 19832,
      "_bytes": 34,
      "translation": "¡Su nombre... ni idea!"
    },
    {
      "index": 180,
      "english": "...hey, old man!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 19867,
      "_bytes": 16,
      "translation": "...¡oye, viejo!"
    },
    {
      "index": 181,
      "english": "But I do know where they are.\nThey're in Japan.",
      "speaker_id": 5011,
      "line_type": 2,
      "_offset": 19884,
      "_bytes": 47,
      "translation": "Pero sí sé dónde están.\nEstán en Japón."
    },
    {
      "index": 182,
      "english": "Japan?!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 19932,
      "_bytes": 7,
      "translation": "¡¿Japón?!"
    },
    {
      "index": 183,
      "english": "Where's that?",
      "speaker_id": 2221,
      "line_type": 2,
      "_offset": 19940,
      "_bytes": 13,
      "translation": "Y eso, ¿dónde?"
    },
    {
      "index": 184,
      "english": "It's Tai's world.",
      "speaker_id": 2121,
      "line_type": 2,
      "_offset": 19954,
      "_bytes": 20,
      "translation": "Es el mundo de Tai."
    },
    {
      "index": 185,
      "english": "Ah, right, you've been there\nbefore, Agumon.",
      "speaker_id": 1041,
      "line_type": 2,
      "_offset": 19975,
      "_bytes": 44,
      "translation": "Ah, cierto, tú ya has\nestado allí, Agumon."
    },
    {
      "index": 186,
      "english": "So, what's the bad news?",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 20020,
      "_bytes": 24,
      "translation": "¿Y la mala noticia?"
    },
    {
      "index": 187,
      "english": "Myotismon already knows about what\nI just said, and he's heading to\nJapan to reach them first.",
      "speaker_id": 5011,
      "line_type": 2,
      "_offset": 20045,
      "_bytes": 93,
      "translation": "Myotismon ya sabe lo que acabo\nde decir, y va camino a Japón\npara llegar antes que vosotros."
    },
    {
      "index": 188,
      "english": "He's raising an army so that he\ncan find and kill the child.",
      "speaker_id": 5011,
      "line_type": 2,
      "_offset": 20139,
      "_bytes": 60,
      "translation": "Está reuniendo un ejército para\nencontrar y matar al niño."
    },
    {
      "index": 189,
      "english": "Huh?! Myotismon's going to Japan?!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 20200,
      "_bytes": 33,
      "translation": "¡¿Qué?! ¡¿Myotismon va a Japón?!"
    },
    {
      "index": 190,
      "english": "There should be a gate leading to\nJapan in Myotismon's castle.",
      "speaker_id": 5011,
      "line_type": 2,
      "_offset": 20234,
      "_bytes": 61,
      "translation": "Debe haber una puerta a Japón\nen el castillo de Myotismon."
    },
    {
      "index": 191,
      "english": "I'm counting on you to stop his\nplans and protect your comrade...",
      "speaker_id": 5011,
      "line_type": 2,
      "_offset": 20296,
      "_bytes": 65,
      "translation": "Cuento con vosotros para\nfrenarle y proteger a\nvuestro compañero..."
    },
    {
      "index": 192,
      "english": "...!",
      "speaker_id": 1011,
      "line_type": 2,
      "_offset": 20362,
      "_bytes": 4,
      "translation": "...!"
    }
  ]
}